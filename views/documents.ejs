<%- include('partials/header', { title: 'Documents', user, ws, active: 'documents' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">ISMS documents</h1>
    <div class="page-subtitle">Generate policies and procedures from templates. Edit, version, approve, export.</div>
  </div>
  <div style="display:flex;gap:6px;">
    <button onclick="document.getElementById('newFromTpl').classList.toggle('hidden')" class="btn btn-primary">From template</button>
    <button onclick="document.getElementById('newBlank').classList.toggle('hidden')" class="btn btn-secondary">Blank</button>
  </div>
</div>

<div id="newFromTpl" class="hidden panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>Generate from template</h2><span class="meta">Placeholders auto-filled</span></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/documents/from-template" class="panel-pad" style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px;">
    <div style="grid-column:1/-1">
      <label class="label">Template</label>
      <select class="select" name="template_id" required>
        <option value="">— pick a template —</option>
        <% const cats = {}; templates.forEach(t => { (cats[t.category] = cats[t.category] || []).push(t); }); %>
        <% Object.keys(cats).forEach(cat => { %>
          <optgroup label="<%= cat %>">
            <% cats[cat].forEach(t => { %><option value="<%= t.id %>"><%= t.name %></option><% }) %>
          </optgroup>
        <% }) %>
      </select>
    </div>
    <div><label class="label">Document owner</label><input class="input" name="document_owner" value="CISO"></div>
    <div><label class="label">Approval authority</label><input class="input" name="approval_authority" value="Top Management"></div>
    <div><label class="label">Review period</label><input class="input" name="review_period" value="Annual"></div>
    <div></div>
    <div style="grid-column:1/-1"><button class="btn btn-primary">Generate document</button></div>
  </form>
</div>

<div id="newBlank" class="hidden panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>Create blank</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/documents/blank" class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
    <div><label class="label">Name</label><input class="input" name="name" required></div>
    <div><label class="label">Category</label>
      <select class="select" name="category">
        <option value="policy">Policy</option><option value="procedure">Procedure</option>
        <option value="plan">Plan</option><option value="record">Record</option><option value="other">Other</option>
      </select>
    </div>
    <div style="grid-column:1/-1"><button class="btn btn-primary">Create</button></div>
  </form>
</div>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr>
      <th>Name</th><th style="width:120px">Category</th><th style="width:140px">Status</th>
      <th style="width:80px">Version</th><th style="width:160px">Updated</th><th style="width:120px"></th>
    </tr></thead>
    <tbody>
      <% docs.forEach(d => { %>
        <tr>
          <td><a href="/workspaces/<%= ws.id %>/documents/<%= d.id %>" class="link-muted" style="color:var(--text);font-weight:500;"><%= d.name %></a></td>
          <td style="color:var(--text-secondary);font-size:12px;text-transform:capitalize;"><%= d.category || '—' %></td>
          <td><span class="status s-<%= d.status === 'approved' || d.status === 'published' ? 'done' : d.status %>"><%= d.status %></span></td>
          <td class="num meta">v<%= d.version %></td>
          <td class="num meta"><%= d.updated_at %></td>
          <td style="text-align:right">
            <a href="/workspaces/<%= ws.id %>/documents/<%= d.id %>/docx" class="link-muted" style="font-size:12px;font-weight:500;color:var(--accent);">.docx</a>
            <span style="color:var(--text-tertiary);">·</span>
            <a href="/workspaces/<%= ws.id %>/documents/<%= d.id %>/print" target="_blank" class="link-muted" style="font-size:12px;">Print</a>
            <span style="color:var(--text-tertiary);">·</span>
            <a href="/workspaces/<%= ws.id %>/documents/<%= d.id %>/download" class="link-muted" style="font-size:12px;">.md</a>
          </td>
        </tr>
      <% }) %>
      <% if (docs.length === 0) { %>
        <tr><td colspan="6" style="padding:0;">
          <div class="empty-state">
            <div class="empty-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <div class="empty-title">Generate your first document</div>
            <div class="empty-sub"><%= templates.length %> ISO 27001:2022-aligned starter templates are available. Pick one, fill in the metadata fields, and the tool produces a draft you can edit and approve.</div>
            <button onclick="document.getElementById('newFromTpl').classList.toggle('hidden')" class="btn btn-primary">From template</button>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
