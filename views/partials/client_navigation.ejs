<%
  const navActive = typeof active !== 'undefined' ? active : '';
  const navReviewCount = typeof openReviewCount !== 'undefined' ? openReviewCount : 0;
  let navFrameworks = ws.frameworks || [];
  if (!Array.isArray(navFrameworks)) {
    try { navFrameworks = JSON.parse(navFrameworks || '[]'); } catch (_) { navFrameworks = []; }
  }
  const hasIso27001 = navFrameworks.includes('iso27001');
  const hasCsf = navFrameworks.includes('csf');
  const hasIso42001 = navFrameworks.includes('iso42001');
  const csfOnly = hasCsf && !hasIso27001 && !hasIso42001;
  const showClientSetup = !ws.scope_confirmed_at && !['audit_ready', 'certified'].includes(ws.stage);

  const navDomains = [
    {
      id: 'work', label: csfOnly ? 'Delivery' : 'Work queue',
      icon: '<polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
      active: ['delivery', 'client-portal', 'inbox', 'review-queue'],
      items: [
        ...(user && user.user_type === 'firm' ? [{ label: 'Delivery cockpit', href: `/workspaces/${ws.id}/delivery`, active: ['delivery'] }] : []),
        { label: 'Client collaboration', href: `/workspaces/${ws.id}/client-portal`, active: ['client-portal'] },
        { label: 'Inbox & notifications', href: `/workspaces/${ws.id}/inbox`, active: ['inbox'] },
        ...(!csfOnly ? [{ label: 'Review queue', href: `/workspaces/${ws.id}/review-queue`, active: ['review-queue'], badge: navReviewCount }] : [])
      ]
    },
    ...(!csfOnly ? [{
      id: 'plan', label: csfOnly ? 'Plan & roadmap' : 'Plan & work',
      icon: '<polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
      active: ['engagement-plan', 'roadmap', 'tasks', 'calendar'],
      items: [
        { label: 'Engagement plan', href: `/workspaces/${ws.id}/engagement-plan`, active: ['engagement-plan'] },
        { label: 'Tasks', href: `/workspaces/${ws.id}/tasks`, active: ['tasks'], shortcut: 'g t' },
        ...(!csfOnly ? [{ label: 'Compliance calendar', href: `/workspaces/${ws.id}/calendar`, active: ['calendar'] }] : [])
      ]
    }] : []),
    ...(hasIso27001 ? [{
      id: 'assessment', label: 'ISO 27001 programme',
      icon: '<path d="M22 12A10 10 0 1 1 12 2"/><polyline points="22 4 12 14 9 11"/>',
      active: ['readiness', 'data-quality', 'gap-assessment', 'gap-assessment-summary'],
      items: [
        { label: 'Readiness', href: `/workspaces/${ws.id}/readiness`, active: ['readiness'], shortcut: 'g e' },
        { label: 'Data quality & truth', href: `/workspaces/${ws.id}/data-quality`, active: ['data-quality'] },
        { label: 'Gap assessment', href: `/workspaces/${ws.id}/gap-assessment`, active: ['gap-assessment'] },
        { label: 'Assessment findings', href: `/workspaces/${ws.id}/controls/assess/summary`, active: ['gap-assessment-summary'] }
      ]
    }] : []),
    ...(hasCsf ? [{
      id: 'cyber-maturity', label: 'Cybersecurity maturity',
      icon: '<path d="M12 2 3 6v6c0 5 3.8 9.7 9 10 5.2-.3 9-5 9-10V6z"/><path d="m8.5 12 2.2 2.2 4.8-5"/>',
      active: ['csf', 'csf-catalog'],
      items: csfOnly ? [
        { label: 'Programme', href: `/workspaces/${ws.id}/csf`, active: ['csf', 'csf-catalog'] },
        { label: 'Business profile', href: `/workspaces/${ws.id}/csf/current/scope`, active: [] },
        { label: 'Maturity workbench', href: `/workspaces/${ws.id}/csf/current/assessment`, active: [] },
        { label: 'Quality review', href: `/workspaces/${ws.id}/csf/current/review`, active: [] },
        { label: 'Priorities & roadmap', href: `/workspaces/${ws.id}/csf/current/findings`, active: [] },
        { label: 'Executive reporting', href: `/workspaces/${ws.id}/csf/current/report`, active: [] }
      ] : [
        { label: 'Programme dashboard', href: `/workspaces/${ws.id}/csf`, active: ['csf', 'csf-catalog'] }
      ]
    }] : []),
    ...(hasIso42001 ? [{
      id: 'ai-programme', label: 'AI management system',
      icon: '<path d="M12 3a4 4 0 0 0-4 4v1H7a3 3 0 0 0-3 3v2a3 3 0 0 0 3 3h1v1a4 4 0 0 0 8 0v-1h1a3 3 0 0 0 3-3v-2a3 3 0 0 0-3-3h-1V7a4 4 0 0 0-4-4z"/><path d="M9 10h6M9 14h6"/>',
      active: ['iso42001-intake', 'iso42001-engagement-plan', 'iso42001-gap', 'iso42001-readiness', 'iso42001-catalog', 'iso42001-controls', 'iso42001-roadmap', 'iso42001-soa', 'iso42001-cert-cycle'],
      items: [
