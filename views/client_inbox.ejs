<%- include('partials/header', { title: 'Inbox', user, ws, active: 'inbox' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Inbox</h1>
    <div class="page-subtitle">Everything due on this client in the next 30 days, plus a free-form notepad for your monthly plan. Auto-computed from NCs, doc reviews, scheduled audits, MRMs, and tasks.</div>
  </div>
</div>

<%# Headline strip: overdue / due-this-month / clear inbox %>
<div style="display:flex;gap:14px;flex-wrap:wrap;font-size:13px;color:var(--text-secondary);margin:0 0 18px;padding:10px 14px;border:1px solid var(--border);border-radius:6px;background:var(--bg);">
  <span><strong style="color:<%= overdue.length > 0 ? '#b91c1c' : 'var(--text-secondary)' %>;font-weight:600;font-size:14px;"><%= overdue.length %></strong> overdue</span>
  <span style="color:var(--text-tertiary);">·</span>
  <span><strong style="color:<%= due.length > 0 ? '#b45309' : 'var(--text-secondary)' %>;font-weight:600;font-size:14px;"><%= due.length %></strong> due in next 30 days</span>
  <span style="flex:1;"></span>
  <span class="meta text-xs">window ends <%= horizonStr %></span>
</div>

<%# Two-column: deliverables list left, plan notepad right %>
<div style="display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:18px;align-items:start;">
  <div style="display:flex;flex-direction:column;gap:14px;">
    <% if (overdue.length === 0 && due.length === 0) { %>
      <div class="panel">
        <div class="t-empty" style="padding:32px 20px;line-height:1.6;">
          Nothing scheduled in the next 30 days. Either you're clear, or this client doesn't have due dates set on its NCs / scheduled audits / MRMs / docs / tasks. Set some so the inbox can populate.
        </div>
      </div>
    <% } %>

    <% if (overdue.length > 0) { %>
      <div class="panel" style="padding:0;border-left:3px solid #b91c1c;">
        <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:baseline;justify-content:space-between;background:rgba(220,38,38,0.04);">
          <h2 style="margin:0;font-size:13px;color:#b91c1c;">Overdue · <%= overdue.length %></h2>
          <span class="meta text-xs">past due_date as of <%= today %></span>
        </div>
        <% overdue.forEach(item => { %>
          <a href="<%= item.href %>" style="display:grid;grid-template-columns:90px 1fr 110px;gap:12px;padding:10px 16px;border-bottom:1px solid var(--border);text-decoration:none;color:inherit;align-items:center;">
            <span class="num text-xs" style="font-family:'SF Mono',Menlo,monospace;color:#b91c1c;font-weight:600;"><%= item.due %></span>
            <span style="font-size:13.5px;">
              <span class="text-eyebrow" style="font-weight:600;color:var(--text-tertiary);margin-right:6px;"><%= item.label %></span>
              <span style="color:var(--text);"><%= item.title %></span>
            </span>
            <span class="meta text-xs" style="text-align:right;"><%= item.meta %></span>
          </a>
        <% }) %>
      </div>
    <% } %>

    <% if (due.length > 0) { %>
      <div class="panel" style="padding:0;">
        <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:baseline;justify-content:space-between;">
          <h2 style="margin:0;font-size:13px;">Due in the next 30 days · <%= due.length %></h2>
          <span class="meta text-xs">window <%= today %> → <%= horizonStr %></span>
        </div>
        <% due.forEach(item => { %>
          <a href="<%= item.href %>" style="display:grid;grid-template-columns:90px 1fr 110px;gap:12px;padding:10px 16px;border-bottom:1px solid var(--border);text-decoration:none;color:inherit;align-items:center;">
            <span class="num text-xs" style="font-family:'SF Mono',Menlo,monospace;color:var(--text-secondary);font-weight:600;"><%= item.due %></span>
            <span style="font-size:13.5px;">
              <span class="text-eyebrow" style="font-weight:600;color:var(--text-tertiary);margin-right:6px;"><%= item.label %></span>
              <span style="color:var(--text);"><%= item.title %></span>
            </span>
            <span class="meta text-xs" style="text-align:right;"><%= item.meta %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <%# Right column: 30-day plan notepad. Auto-submits on blur so you never lose work. %>
  <aside style="position:sticky;top:18px;">
    <form method="POST" action="/workspaces/<%= ws.id %>/inbox/plan" class="panel" style="padding:0;" id="planForm">
      <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <div style="padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:baseline;justify-content:space-between;">
        <h2 style="margin:0;font-size:13px;">30-day plan</h2>
        <span class="meta text-xs" id="planSavedBadge">&nbsp;</span>
      </div>
      <div style="padding:12px 14px;">
        <textarea name="monthly_plan" id="monthlyPlan" rows="14" placeholder="What you want to get done on this client over the next 30 days. Free-form — checklist, narrative, copy-paste from email, whatever fits. Auto-saves on blur.
- [ ] Walk Vijay through SoA bulk decisions Tue
- [ ] Draft AUP rev 3 by Friday
- [ ] Schedule internal audit dry-run with client team by 15th
- [ ] MRM pre-read sent to CISO 3 days before review" style="width:100%;border:1px solid var(--border);border-radius:6px;padding:10px 12px;font-family:inherit;font-size:13px;line-height:1.6;color:var(--text);background:var(--bg);resize:vertical;"><%= monthlyPlan %></textarea>
        <div class="meta text-xs" style="margin-top:8px;">Saves on blur. Markdown-style checkboxes render as plain text — visual rendering is a future option if you want it.</div>
      </div>
    </form>
  </aside>
</div>

<script>
(function () {
  const form = document.getElementById('planForm');
  const ta = document.getElementById('monthlyPlan');
  const badge = document.getElementById('planSavedBadge');
  if (!form || !ta || !badge) return;
  let lastValue = ta.value;
  ta.addEventListener('blur', () => {
    if (ta.value === lastValue) return;
    const body = new FormData(form);
    fetch(form.action, { method: 'POST', body }).then(r => {
      if (r.ok) {
        const now = new Date();
        badge.textContent = `Saved · ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
        badge.style.color = '#15803d';
        lastValue = ta.value;
      } else {
        badge.textContent = 'Save failed';
        badge.style.color = '#b91c1c';
      }
    });
  });
})();
</script>

<%- include('partials/footer') %>
