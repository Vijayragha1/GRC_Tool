<%- include('partials/header', { title: 'Exec brief', user, ws, active: 'exec-brief' }) %>

<style>
  .exec-num { font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  @media print {
    .sidebar, .topbar, .no-print { display: none !important; }
    .main-inner { padding: 12mm !important; max-width: none !important; }
    .panel { box-shadow: none !important; border: 1px solid #ccc !important; page-break-inside: avoid; margin-bottom: 8mm !important; }
    body { font-size: 10.5px; }
    .exec-num { font-size: 22px !important; }
  }
</style>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= ws.brand_display_name || ws.client_name %> - Executive brief</h1>
    <div class="page-subtitle">One-page health summary for the sponsor / board. Prints to one A4. Generated <%= new Date().toISOString().slice(0, 10) %>.</div>
  </div>
  <button onclick="window.print()" class="btn btn-secondary btn-xs no-print">Print</button>
</div>

<!-- Top KPI band -->
<div style="display:grid;grid-template-columns:repeat(4, 1fr);gap:10px;margin-bottom:14px;">
  <%
    const s1Cls = readiness.stage1 >= 80 ? 'kpi-good' : readiness.stage1 >= 50 ? 'kpi-warn' : 'kpi-bad';
    const s2Cls = readiness.stage2 >= 80 ? 'kpi-good' : readiness.stage2 >= 50 ? 'kpi-warn' : 'kpi-bad';
    let velCls = 'kpi-warn';
    if (velocityNow > velocityPrior) velCls = 'kpi-good';
    else if (velocityNow < velocityPrior && velocityNow < 3) velCls = 'kpi-bad';
    const aleCls = residualAle > 1000000 ? 'kpi-bad' : residualAle > 250000 ? 'kpi-warn' : 'kpi-good';
  %>
  <div class="panel kpi <%= s1Cls %>" style="padding:12px 14px;">
    <div class="kpi-label text-eyebrow">Stage 1 readiness</div>
    <div class="kpi-num exec-num"><%= readiness.stage1 %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-meta">target ≥ 80% before Stage 1 audit</div>
  </div>
  <div class="panel kpi <%= s2Cls %>" style="padding:12px 14px;">
    <div class="kpi-label text-eyebrow">Stage 2 readiness</div>
    <div class="kpi-num exec-num"><%= readiness.stage2 %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-meta">3 months operational evidence required</div>
  </div>
  <div class="panel kpi <%= velCls %>" style="padding:12px 14px;">
    <div class="kpi-label text-eyebrow">Velocity (last 30d)</div>
    <div class="kpi-num exec-num"><%= velocityNow %><span class="text-lg text-tertiary" style="font-weight:400;"> closed</span></div>
    <div class="kpi-meta">prev 30d: <%= velocityPrior %> · <%= velocityDelta >= 0 ? '+' : '' %><%= velocityDelta %> change</div>
  </div>
  <div class="panel kpi <%= aleCls %>" style="padding:12px 14px;">
    <div class="kpi-label text-eyebrow">Residual annual loss</div>
    <div class="kpi-num exec-num">$<%= residualAle.toLocaleString() %></div>
    <div class="kpi-meta">ALE = Σ (likelihood/5 × impact × $50k) over <%= openRiskCount %> open risks</div>
  </div>
</div>

<!-- Plan + days-to-target band -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;">
  <div class="panel" style="padding:12px 14px;">
    <div class="text-xs text-tertiary" style="font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">12-week engagement plan</div>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:14px;">
      <div>
        <div class="exec-num" style="font-size:22px;font-weight:600;"><%= planDone %><span class="text-xl text-tertiary" style="font-weight:400;">/<%= planTotal %></span></div>
        <div class="kpi-meta">milestones complete · <%= planPct %>%</div>
      </div>
      <div style="flex:1;height:6px;background:var(--bg-muted);border-radius:3px;overflow:hidden;">
        <div style="height:100%;background:var(--accent);width:<%= planPct %>%;"></div>
      </div>
    </div>
  </div>
  <div class="panel" style="padding:12px 14px;">
    <div class="text-xs text-tertiary" style="font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">Cert target</div>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:14px;">
      <div>
        <div class="exec-num" style="font-size:22px;font-weight:600;color:<%= readiness.daysToTarget !== null && readiness.daysToTarget < 30 ? '#b91c1c' : 'var(--text)' %>"><%= readiness.daysToTarget !== null ? readiness.daysToTarget : '-' %><span class="text-xl text-tertiary" style="font-weight:400;"> days</span></div>
        <div class="kpi-meta"><%= ws.target_cert_date || 'no target set' %></div>
      </div>
      <div class="text-xs text-secondary" style="text-align:right;line-height:1.5;">
        Open NCs: <strong><%= ncTotals.major || 0 %></strong> major / <strong><%= ncTotals.minor || 0 %></strong> minor<br>
        Overdue: <strong style="color:<%= ncTotals.overdue ? '#b91c1c' : 'var(--text)' %>;"><%= ncTotals.overdue || 0 %></strong>
      </div>
    </div>
  </div>
</div>

<!-- Top risks + top NCs side-by-side -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;">
  <div class="panel">
    <div class="panel-head" style="padding:10px 14px;"><h2 class="text-lg" style="margin:0;">Top 5 open risks</h2></div>
    <% if (topRisks.length === 0) { %>
      <div class="t-empty text-base" style="padding:20px;">No open risks.</div>
    <% } else { %>
      <table class="t text-sm">
        <thead><tr><th style="padding:6px 14px;">Risk</th><th style="width:70px;text-align:right;padding:6px 14px;">L×I</th><th style="width:90px;padding:6px 14px;">Owner</th></tr></thead>
        <tbody>
          <% topRisks.forEach(r => { %>
            <tr>
              <td style="padding:6px 14px;"><%= r.title %></td>
              <td class="num" style="text-align:right;padding:6px 14px;font-weight:600;color:<%= r.score >= 15 ? '#b91c1c' : r.score >= 8 ? '#a16207' : 'var(--text)' %>;"><%= r.likelihood %>×<%= r.impact %>=<%= r.score %></td>
              <td class="meta text-eyebrow" style="padding:6px 14px;"><%= r.owner_name || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
  <div class="panel">
    <div class="panel-head" style="padding:10px 14px;"><h2 class="text-lg" style="margin:0;">Top open nonconformities</h2></div>
    <% if (topNCs.length === 0) { %>
      <div class="t-empty text-base" style="padding:20px;">No open NCs - clean bill of health.</div>
    <% } else { %>
      <table class="t text-sm">
        <thead><tr><th style="padding:6px 14px;">Finding</th><th style="width:60px;padding:6px 14px;">Sev</th><th style="width:85px;text-align:right;padding:6px 14px;">Due</th></tr></thead>
        <tbody>
          <% topNCs.forEach(n => { %>
            <tr>
              <td style="padding:6px 14px;"><%= n.title %></td>
              <td style="padding:6px 14px;"><span class="status s-<%= n.severity %> text-xxs"><%= n.severity %></span></td>
              <td class="num meta" style="text-align:right;padding:6px 14px;font-size:10.5px;color:<%= n.due_date && n.due_date < new Date().toISOString().slice(0,10) ? '#b91c1c' : 'var(--text-tertiary)' %>;"><%= n.due_date || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<!-- Footer note for the sponsor -->
<div class="panel text-xs text-secondary" style="padding:10px 14px;background:var(--bg-subtle);line-height:1.5;">
  <strong>Reading the numbers:</strong>
  Stage 1 readiness blends mandatory documents (30%), Annex A controls implemented (35%), absence of high-severity flags (15%), MRM complete (10%), internal audit complete (10%). Stage 2 adds operational-evidence depth (10%). Velocity is the count of controls moved to "Implemented" in the last 30 days. Residual ALE is a heuristic - actuals depend on impact tiers your insurer assigns. Generated automatically; refresh by re-loading.
</div>

<%- include('partials/footer') %>
