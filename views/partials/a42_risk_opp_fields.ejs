<%# Fields for a risk or opportunity for the AIMS (clause 6.1.1), shared by the
    add and edit forms on the context page. Takes r (null when adding), K
    (lib/aims-context.js), context and overdue. %>
<% const ro = r || {}; const id = ro.id ? `ro${ro.id}` : 'roNew'; %>
<div><label class="label" for="<%= id %>Kind">Risk or opportunity</label><select id="<%= id %>Kind" class="select" name="kind"><% K.RO_KINDS.forEach(k => { %><option value="<%= k.key %>" <%= ro.kind === k.key ? 'selected' : '' %>><%= k.label %></option><% }) %></select></div>
<div style="grid-column:span 2;"><label class="label" for="<%= id %>Desc">Description</label><input id="<%= id %>Desc" class="input" name="description" value="<%= ro.description || '' %>" required maxlength="1000" placeholder="e.g. Only one person can run an impact assessment"></div>
<div><label class="label" for="<%= id %>Issue">Arises from the issue</label><select id="<%= id %>Issue" class="select" name="context_issue_id"><option value="">None</option><% context.issues.forEach(i => { %><option value="<%= i.id %>" <%= Number(ro.context_issue_id) === i.id ? 'selected' : '' %>><%= i.issue.length > 70 ? i.issue.slice(0, 69) + '…' : i.issue %></option><% }) %></select></div>
<div><label class="label" for="<%= id %>Party">Or from the requirement of</label><select id="<%= id %>Party" class="select" name="interested_party_id"><option value="">None</option><% context.parties.forEach(p => { %><option value="<%= p.id %>" <%= Number(ro.interested_party_id) === p.id ? 'selected' : '' %>><%= p.party %></option><% }) %></select></div>
<div><label class="label" for="<%= id %>Status">Status</label><select id="<%= id %>Status" class="select" name="status"><% K.RO_STATUSES.forEach(k => { %><option value="<%= k.key %>" <%= (ro.status || 'open') === k.key ? 'selected' : '' %>><%= k.label %></option><% }) %></select></div>
<div style="grid-column:span 3;"><label class="label" for="<%= id %>Action">Action planned</label><input id="<%= id %>Action" class="input" name="action" value="<%= ro.action || '' %>" maxlength="4000"></div>
<div style="grid-column:span 3;"><label class="label" for="<%= id %>Integ">How it is built into the AIMS</label><input id="<%= id %>Integ" class="input" name="integration" value="<%= ro.integration || '' %>" maxlength="4000" placeholder="e.g. Added to the impact assessment procedure and the training plan"></div>
<div><label class="label" for="<%= id %>Owner">Owner</label><input id="<%= id %>Owner" class="input" name="owner" value="<%= ro.owner || '' %>" maxlength="200"></div>
<div><label class="label" for="<%= id %>Due">Due</label><input id="<%= id %>Due" class="input<%= ro.status !== 'done' && overdue(ro.due_date) ? ' is-late' : '' %>" type="date" name="due_date" value="<%= ro.due_date || '' %>"></div>
<div></div>
<div style="grid-column:span 3;"><label class="label" for="<%= id %>Method">How its effectiveness is judged</label><input id="<%= id %>Method" class="input" name="effectiveness_method" value="<%= ro.effectiveness_method || '' %>" maxlength="1000" placeholder="e.g. A second assessor completes an assessment unaided by the next management review"></div>
<div style="grid-column:span 3;"><label class="label" for="<%= id %>Result">Result of that judgement</label><input id="<%= id %>Result" class="input" name="effectiveness_result" value="<%= ro.effectiveness_result || '' %>" maxlength="4000" placeholder="Needed before it can be marked done"></div>
