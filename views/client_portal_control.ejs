<%- include('partials/header', { title, user, ws, active }) %>
<a class="link-muted text-base" href="/workspaces/<%= ws.id %>/client-portal">← Client collaboration</a>
<div class="page-head" style="margin-top:10px;"><div><div class="eyebrow"><%= item.type === 'clause' ? 'ISO 27001 clause' : 'ISO 27001 Annex A control' %></div><h1><span class="iso-ref"><%= item.id.replace('annex-','').replace('clause-','').toUpperCase() %></span> <%= item.title %></h1><div class="page-subtitle"><%= item.summary || '' %></div></div><span class="status status-neutral"><%= state.status || 'Not assessed' %></span></div>
<div class="grid-2" style="align-items:start;">
  <div>
    <div class="panel" style="margin-bottom:14px;"><div class="panel-head"><h2>Shared assessment context</h2><span class="meta">Maturity <%= state.maturity || 0 %>/5</span></div><div class="panel-pad"><div class="label">Consultant notes</div><div style="white-space:pre-wrap;line-height:1.6;"><%= state.notes || 'No client-visible assessment notes have been recorded.' %></div><% if (item.evidence_needed) { %><div class="label" style="margin-top:14px;">Evidence expected</div><div style="white-space:pre-wrap;line-height:1.6;"><%= item.evidence_needed %></div><% } %></div></div>
    <div class="panel"><div class="panel-head"><h2>Linked evidence</h2><span class="tag tag-neutral"><%= evidence.length %></span></div><% if (!evidence.length) { %><div class="panel-pad meta">No active evidence is linked to this control yet.</div><% } else { evidence.forEach(e => { %><div style="padding:10px 14px;border-bottom:1px solid var(--border);"><strong><%= e.filename %></strong><div class="meta"><%= e.uploader || 'Unknown' %> · <%= e.uploaded_at %></div></div><% }) } %></div>
  </div>
  <div class="panel" id="discussion"><div class="panel-head"><h2>Control discussion</h2><span class="tag tag-neutral"><%= comments.length %></span></div><% if (!comments.length) { %><div class="panel-pad meta">No client-visible discussion yet.</div><% } else { comments.forEach(c => { %><div style="padding:10px 14px;border-bottom:1px solid var(--border);"><div style="display:flex;justify-content:space-between;"><strong class="text-sm"><%= c.user_name %></strong><span class="meta"><%= c.created_at %></span></div><div style="white-space:pre-wrap;line-height:1.55;margin-top:4px;"><%= c.body %></div></div><% }) } %><form method="POST" action="/workspaces/<%= ws.id %>/client-portal/controls/<%= encodeURIComponent(item.id) %>/comments" class="panel-pad" style="border-top:1px solid var(--border);"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><textarea class="textarea" name="body" rows="4" maxlength="8000" required placeholder="Ask a question or explain how this control operates in practice."></textarea><div style="text-align:right;margin-top:8px;"><button class="btn btn-primary btn-xs">Post comment</button></div></form></div>
</div>
<%- include('partials/footer') %>
