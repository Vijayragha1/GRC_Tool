<%- include('partials/header', { title: 'Interested parties', user, ws, active: 'interested-parties' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Interested parties</h1>
    <div class="page-subtitle">Clause 4.2 - the people and organisations whose needs and expectations affect the ISMS. Identify, document needs, link how the ISMS addresses them, and review on cadence.</div>
  </div>
</div>

<details class="panel" style="margin-bottom:14px;" <%= rows.length === 0 ? 'open' : '' %>>
  <summary class="panel-pad" style="cursor:pointer;font-size:13px;font-weight:500;">+ Add interested party</summary>
  <form method="POST" action="/workspaces/<%= ws.id %>/interested-parties" class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);display:grid;grid-template-columns:1fr 1fr;gap:10px;">
    <div><label class="label">Party <span class="meta">required</span></label><input class="input" name="party" required placeholder="e.g., Customers, Regulator (ICO), Employees, Investors"></div>
    <div><label class="label">Type</label>
      <select class="select" name="party_type">
        <option value="">-</option>
        <% ['Customer','Regulator','Employee','Supplier','Investor','Partner','Auditor','Public','Other'].forEach(t => { %><option value="<%= t %>"><%= t %></option><% }) %>
      </select>
    </div>
    <div class="col-full"><label class="label">Needs / expectations</label><textarea class="textarea" name="needs" rows="2" placeholder="What this party needs from the ISMS - confidentiality of personal data, contractual security clauses, regulatory compliance, etc."></textarea></div>
    <div class="col-full"><label class="label">How addressed</label><textarea class="textarea" name="how_addressed" rows="2" placeholder="Reference the controls, policies, or processes that meet the need - e.g., 'Encryption at rest A.8.24, Privacy Notice v1.2, contractual DPAs'."></textarea></div>
    <div><label class="label">Owner</label><input class="input" name="owner" placeholder="e.g., DPO, Legal, CISO"></div>
    <div><label class="label">Review cadence</label>
      <select class="select" name="review_cadence">
        <option value="">-</option>
        <% ['monthly','quarterly','semi-annual','annual','biennial'].forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Last reviewed</label><input type="date" class="input" name="last_reviewed"></div>
    <div><label class="label">Next review</label><input type="date" class="input" name="next_review"></div>
    <div class="col-full"><button class="btn btn-primary">Add</button></div>
  </form>
</details>

<div class="panel" style="overflow:hidden;">
  <% if (rows.length === 0) { %>
    <div class="empty-state">
      <div class="empty-title">No interested parties yet</div>
      <div class="empty-sub">Required by clause 4.2. Use the form above to start with the obvious ones - customers, regulator, employees.</div>
    </div>
  <% } else { %>
    <table class="t">
      <thead><tr>
        <th style="width:160px;">Party</th>
        <th style="width:100px;">Type</th>
        <th>Needs</th>
        <th>How addressed</th>
        <th style="width:120px;">Owner</th>
        <th style="width:120px;">Next review</th>
        <th style="width:90px;"></th>
      </tr></thead>
      <tbody>
        <% rows.forEach(r => {
             const today = new Date().toISOString().slice(0,10);
             const overdue = r.next_review && r.next_review < today;
        %>
          <tr style="<%= overdue ? 'background:rgba(185,28,28,0.04);' : '' %>">
            <td><strong class="text-lg"><%= r.party %></strong></td>
            <td><% if (r.party_type) { %><span class="tag tag-neutral text-xs"><%= r.party_type %></span><% } %></td>
            <td style="font-size:12.5px;line-height:1.45;"><%= r.needs || '' %></td>
            <td style="font-size:12.5px;line-height:1.45;"><%= r.how_addressed || '' %></td>
            <td class="text-base"><%= r.owner || '' %></td>
            <td class="text-sm">
              <% if (r.next_review) { %>
                <span class="<%= overdue ? '' : '' %>" style="<%= overdue ? 'color:#b91c1c;font-weight:600;' : '' %>"><%= r.next_review %><% if (overdue) { %> · overdue<% } %></span>
              <% } else { %><span class="meta">-</span><% } %>
            </td>
            <td>
              <details>
                <summary class="btn btn-ghost btn-xs" style="font-size:11px;list-style:none;cursor:pointer;">Edit</summary>
                <form method="POST" action="/workspaces/<%= ws.id %>/interested-parties/<%= r.id %>" style="position:absolute;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:10px;z-index:30;box-shadow:var(--shadow-md);width:380px;display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:4px;">
                  <input type="text" name="party" value="<%= r.party %>" class="input" style="font-size:12px;grid-column:1/-1;">
                  <select class="select text-base" name="party_type">
                    <option value="">-</option>
                    <% ['Customer','Regulator','Employee','Supplier','Investor','Partner','Auditor','Public','Other'].forEach(t => { %><option value="<%= t %>" <%= r.party_type === t ? 'selected' : '' %>><%= t %></option><% }) %>
                  </select>
                  <input type="text" name="owner" value="<%= r.owner || '' %>" placeholder="Owner" class="input text-base">
                  <textarea name="needs" rows="2" class="textarea" placeholder="Needs" style="font-size:12px;grid-column:1/-1;"><%= r.needs || '' %></textarea>
                  <textarea name="how_addressed" rows="2" class="textarea" placeholder="How addressed" style="font-size:12px;grid-column:1/-1;"><%= r.how_addressed || '' %></textarea>
                  <select class="select text-base" name="review_cadence">
                    <option value="">cadence</option>
                    <% ['monthly','quarterly','semi-annual','annual','biennial'].forEach(c => { %><option value="<%= c %>" <%= r.review_cadence === c ? 'selected' : '' %>><%= c %></option><% }) %>
                  </select>
                  <input type="date" name="last_reviewed" value="<%= r.last_reviewed || '' %>" class="input text-base">
                  <input type="date" name="next_review" value="<%= r.next_review || '' %>" class="input" style="font-size:12px;grid-column:1/-1;">
                  <button class="btn btn-primary btn-xs col-full">Save</button>
                </form>
              </details>
              <form method="POST" action="/workspaces/<%= ws.id %>/interested-parties/<%= r.id %>/delete" style="display:inline;" onsubmit="return appConfirmForm(event, 'Delete this party?')">
                <button class="btn btn-ghost btn-xs" style="font-size:11px;color:#b91c1c;">×</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/footer') %>
