<%- include('partials/header', { title: 'API tokens', user, ws, active: 'access' }) %>

<a href="/workspaces/<%= ws.id %>/access" class="link-muted" style="font-size:12px;">← Access &amp; permissions</a>

<div class="page-head" style="margin-top:8px">
  <div><h1 class="page-title">API tokens</h1>
    <div class="page-subtitle">Local-network REST API. Endpoints under <code>/api/v1/</code>. Tokens are stored hashed; the plaintext is shown once below if you create a new one.</div></div>
</div>

<% if (toastSecret) { %>
<div class="callout" style="margin-bottom:16px;background:rgba(202,138,4,0.08);border-color:#ca8a04;">
  <div class="callout-title" style="color:#a16207;">New token — copy now, it will not be shown again</div>
  <div class="mono" style="word-break:break-all;background:var(--bg-muted);padding:10px;border-radius:6px;margin-top:6px;font-size:12.5px;"><%= toastSecret %></div>
</div>
<% } %>

<div class="panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>New token</h2></div>
  <form method="POST" class="panel-pad" style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;align-items:end;">
    <div><label class="label">Name</label><input class="input" name="name" required placeholder="e.g., CI risk-import"></div>
    <div><label class="label">Scopes (comma-sep, * = all)</label><input class="input" name="scopes" value="read:risks,read:controls,write:risks" placeholder="*"></div>
    <div><label class="label">Expires</label><input class="input" name="expires_at" type="date"></div>
    <div><label class="label">IP lock</label><input class="input" name="ip_lock" placeholder="optional"></div>
    <div style="grid-column:1/-1"><button class="btn btn-primary btn-xs">Generate token</button></div>
  </form>
</div>

<div class="panel"><table class="t">
  <thead><tr><th>Name</th><th>Prefix</th><th>Scopes</th><th>Expires</th><th>Last used</th><th>IP lock</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% if (!tokens.length) { %><tr><td colspan="8" class="t-empty">No tokens yet.</td></tr><% } %>
    <% tokens.forEach(t => { %>
      <tr>
        <td><strong><%= t.name %></strong></td>
        <td class="mono meta"><%= t.prefix %>…</td>
        <td class="meta"><%= JSON.parse(t.scopes).join(' ') %></td>
        <td class="meta"><%= t.expires_at || '—' %></td>
        <td class="meta"><%= t.last_used_at || 'never' %></td>
        <td class="meta mono"><%= t.ip_lock || '—' %></td>
        <td><span class="tag <%= t.revoked_at ? 'tag-danger' : 'tag-success' %>"><%= t.revoked_at ? 'revoked' : 'active' %></span></td>
        <td><% if (!t.revoked_at) { %><form method="POST" action="/workspaces/<%= ws.id %>/api-tokens/<%= t.id %>/revoke"><button class="btn btn-danger btn-xs">Revoke</button></form><% } %></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>

<div class="panel" style="margin-top:14px">
  <div class="panel-head"><h2>Quick reference</h2></div>
  <div class="panel-pad" style="font-size:12.5px;line-height:1.6;">
    <strong>Authentication.</strong> Pass <code>Authorization: Bearer &lt;token&gt;</code> on every request.<br>
    <strong>Endpoints.</strong>
    <ul style="margin:6px 0 0 18px;font-family:ui-monospace,monospace;font-size:12px;">
      <li>GET <code>/api/v1/me</code> — token info</li>
      <li>GET <code>/api/v1/risks</code> — list</li>
      <li>POST <code>/api/v1/risks</code> — create</li>
      <li>GET <code>/api/v1/controls</code> — list</li>
      <li>PATCH <code>/api/v1/controls/&lt;id&gt;</code> — update status / applicability / maturity / notes</li>
      <li>POST <code>/api/v1/evidence</code> (multipart) — upload evidence file</li>
      <li>GET <code>/api/v1/readiness</code> — readiness scorecard</li>
      <li>GET <code>/api/v1/search?q=…</code> — full-text search</li>
    </ul>
  </div>
</div>

<%- include('partials/footer') %>
