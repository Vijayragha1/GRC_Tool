<%- include('partials/header', { title: 'NIST CSF 2.0', user, ws, active: 'csf' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">NIST CSF <%= catalogVersion %></h1>
    <div class="page-subtitle">
      <%= totalFns %> Functions / <%= totalCats %> Categories / <%= totalSubs %> Subcategories.
      Source: <span class="mono">NIST.CSWP.29</span> (published 2024-02-26). Implementation examples and ISO 27001 cross-references via the CSF 2.0 Reference Tool.
    </div>
  </div>
</div>

<div class="panel" style="margin-bottom:14px;">
  <div class="panel-pad text-md text-secondary">
    <strong>Catalog integrity.</strong> NIST outcome text and Implementation Examples remain authoritative reference material. Consultant guidance, capability anchors, Profile priorities, and Tier conclusions are governed separately in each engagement.
  </div>
</div>

<% tree.forEach(fn => { %>
  <details class="panel" style="margin-bottom:10px;" open>
    <summary class="panel-pad" style="cursor:pointer;display:flex;align-items:center;gap:10px;">
      <span class="mono text-lg" style="font-weight: 500;color:var(--accent);"><%= fn.code %></span>
      <span class="text-xl" style="font-weight: 500;"><%= fn.name %></span>
      <span class="meta text-base">(<%= fn.categories.length %> categories, <%= fn.categories.reduce((s, c) => s + c.subcategories.length, 0) %> subcategories)</span>
    </summary>
    <div class="panel-pad text-md text-secondary" style="padding-top:0;"><%= fn.description %></div>

    <% fn.categories.forEach(cat => { %>
      <details style="border-top:1px solid var(--border);">
        <summary class="panel-pad" style="cursor:pointer;display:flex;align-items:center;gap:10px;background:var(--bg-subtle);">
          <span class="mono text-md" style="font-weight:500;"><%= cat.code %></span>
          <span class="text-lg" style="font-weight:500;"><%= cat.name %></span>
          <span class="meta text-sm">(<%= cat.subcategories.length %> subcategories)</span>
        </summary>
        <div class="panel-pad text-base text-secondary" style="padding-top:6px;"><%= cat.description %></div>

        <table class="t">
          <thead>
            <tr>
              <th style="width:110px">Code</th>
              <th>Outcome</th>
              <th style="width:220px">ISO 27001:2022 refs</th>
            </tr>
          </thead>
          <tbody>
            <% cat.subcategories.forEach(sub => { %>
              <tr>
                <td class="mono text-sm" style="vertical-align:top;padding-top:10px;"><%= sub.code %></td>
                <td class="text-md" style="line-height:1.5;">
                  <%= sub.description %>
                  <% if (sub.implementation_examples) { %>
                    <details style="margin-top:6px;">
                      <summary class="text-sm" style="cursor:pointer;color:var(--accent);">Implementation examples</summary>
                      <div class="text-base text-secondary" style="margin-top:6px;line-height:1.55;white-space:pre-wrap;"><%= sub.implementation_examples %></div>
                    </details>
                  <% } %>
                </td>
                <td class="text-sm" style="line-height:1.5;vertical-align:top;padding-top:10px;">
                  <% if (sub.iso_refs.length === 0) { %>
                    <span class="meta">-</span>
                  <% } else { %>
                    <% const clauses = sub.iso_refs.filter(r => r.ref_type === 'mandatory_clause'); %>
                    <% const annexa  = sub.iso_refs.filter(r => r.ref_type === 'annex_a'); %>
                    <% if (clauses.length) { %>
                      <div class="meta text-eyebrow" style="text-transform:uppercase;letter-spacing:0.04em;margin-bottom:2px;">Clauses</div>
                      <div class="mono text-xs" style="margin-bottom:6px;"><%= clauses.map(c => c.ref_value).join(', ') %></div>
                    <% } %>
                    <% if (annexa.length) { %>
                      <div class="meta text-eyebrow" style="text-transform:uppercase;letter-spacing:0.04em;margin-bottom:2px;">Annex A</div>
                      <div class="mono text-xs">
                        <% annexa.forEach((a, i) => { %><a href="/workspaces/<%= ws.id %>/controls/annex-a.<%= a.ref_value %>" style="color:var(--accent);text-decoration:none;"><%= a.ref_value %></a><%= i < annexa.length - 1 ? ', ' : '' %><% }) %>
                      </div>
                    <% } %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </details>
    <% }) %>
  </details>
<% }) %>

<%- include('partials/footer') %>
