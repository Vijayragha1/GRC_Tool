<%- include('partials/header', { title: 'Compliance calendar', user, ws, active: 'calendar' }) %>

<div class="page-head">
  <div><h1 class="page-title">Compliance calendar</h1>
    <div class="page-subtitle">Every upcoming deadline across the ISMS — policy reviews, supplier reviews, NC due dates, training expiries, attestation expiries, audits, MRMs, risk-acceptance expiries.</div></div>
  <div style="display:flex;gap:6px;">
    <% [30, 60, 90, 180, 365].forEach(d => { %>
      <a href="?days=<%= d %>" class="btn <%= horizon == d ? 'btn-primary' : 'btn-secondary' %> btn-xs"><%= d %>d</a>
    <% }) %>
  </div>
</div>

<%
  const today = new Date().toISOString().slice(0,10);
  const labels = { doc_review:'Policy review', supplier_review:'Supplier review', nc_due:'NC due', task_due:'Task due', attestation_expiry:'Supplier doc expiry', audit_planned:'Audit · scheduled', audit_in_progress:'Audit · in progress', audit_complete:'Audit · complete', mrm:'Management review', risk_acceptance_expiry:'Risk acceptance expiry' };
  const colors = { doc_review:'#4f46e5', supplier_review:'#0ea5e9', nc_due:'#dc2626', task_due:'#71717a', attestation_expiry:'#a855f7', audit_planned:'#0ea5e9', audit_in_progress:'#ea580c', audit_complete:'#16a34a', mrm:'#0891b2', risk_acceptance_expiry:'#b91c1c' };
  const groups = {};
  events.forEach(e => { (groups[e.d] = groups[e.d] || []).push(e); });
  const dates = Object.keys(groups).sort();
%>

<div class="panel">
  <% if (!dates.length) { %><div class="empty-state"><div class="empty-sub">Nothing in the next <%= horizon %> days.</div></div><% } %>
  <% dates.forEach(d => {
       const isPast = d < today; const isToday = d === today;
  %>
    <div style="display:grid;grid-template-columns:140px 1fr;gap:14px;padding:12px 16px;border-bottom:1px solid var(--border);<%= isToday ? 'background:rgba(79,70,229,0.04);' : isPast ? 'opacity:0.6;' : '' %>">
      <div>
        <div style="font-weight:600;font-size:13.5px;<%= isPast ? 'color:#b91c1c;' : '' %>"><%= d %><% if (isToday) { %> <span class="tag tag-info">today</span><% } %><% if (isPast) { %> <span class="tag tag-danger">overdue</span><% } %></div>
        <div class="meta"><%= groups[d].length %> item<%= groups[d].length === 1 ? '' : 's' %></div>
      </div>
      <div>
        <% groups[d].forEach(e => { %>
          <a href="<%= e.link %>" style="display:flex;align-items:center;gap:8px;padding:6px 0;text-decoration:none;color:var(--text);">
            <span style="width:6px;height:6px;border-radius:50%;background:<%= colors[e.k] %>;flex-shrink:0;"></span>
            <span class="meta" style="width:160px;flex-shrink:0;"><%= labels[e.k] %></span>
            <span style="font-size:13px;"><%= e.title %></span>
          </a>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
