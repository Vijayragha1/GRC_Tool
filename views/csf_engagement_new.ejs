<%- include('partials/header', { title: 'New CSF engagement', user, ws, active: 'csf' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">New CSF engagement</h1>
    <div class="page-subtitle">Creates a CSF 2.0 maturity assessment pinned to catalog version 2.0. Default equal-weighting profile is seeded automatically across all 106 Subcategories.</div>
  </div>
</div>

<form method="POST" action="/workspaces/<%= ws.id %>/csf" class="panel">
  <div class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
    <div class="col-full">
      <label class="label">Engagement name</label>
      <input class="input" name="name" required placeholder="e.g., 2026 baseline CSF assessment">
    </div>

    <div>
      <label class="label">Period start</label>
      <input class="input" type="date" name="period_start">
    </div>
    <div>
      <label class="label">Period end</label>
      <input class="input" type="date" name="period_end">
    </div>

    <div>
      <label class="label">Target completion</label>
      <input class="input" type="date" name="target_completion_date">
    </div>
    <div>
      <label class="label">Engagement Lead</label>
      <select class="select" name="assigned_lead_id">
        <option value="">- choose later -</option>
        <% assignableUsers.forEach(u => { %>
          <option value="<%= u.id %>" <%= u.id === user.id ? 'selected' : '' %>><%= u.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="col-full">
      <label class="label">Scope mode</label>
      <div class="text-lg" style="display:flex;gap:18px;">
        <label style="display:flex;gap:6px;align-items:center;cursor:pointer;">
          <input type="radio" name="scope_mode" value="CURRENT_ONLY" checked>
          Current state only
        </label>
        <label style="display:flex;gap:6px;align-items:center;cursor:pointer;">
          <input type="radio" name="scope_mode" value="CURRENT_TARGET">
          Current + Target (Profile delta)
        </label>
      </div>
      <div class="meta text-sm" style="margin-top:4px;">Locked at engagement creation. "Current + Target" enables Profile-style gap analysis where each Subcategory has both a Current Profile score and a Target Profile score.</div>
    </div>
  </div>

  <div class="panel-pad" style="border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;background:var(--bg-subtle);">
    <a href="/workspaces/<%= ws.id %>/csf" class="btn btn-secondary btn-xs">Cancel</a>
    <button class="btn btn-primary btn-xs">Create engagement</button>
  </div>
</form>

<%- include('partials/footer') %>
