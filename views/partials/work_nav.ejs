<nav class="work-nav" aria-label="Delivery navigation">
 <% [['overview','Overview'],['queue',user.user_type==='client'?'My actions':workScope==='mine'?'My work':'Work queue'],['calendar','Calendar'],...(user.user_type==='firm'?[['workload','Team workload']]:[]),['reports','Reports']].forEach(([key,label])=>{ %>
