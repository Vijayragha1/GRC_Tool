<%- include('partials/header', { title: 'NIST CSF information review', user, ws, active: 'client-portal' }) %>
<div class="page-head"><div><a class="meta" href="/workspaces/<%= ws.id %>/client-portal">← Back to your engagement</a><div class="eyebrow" style="margin-top:10px;">NIST CSF assessment</div><h1 class="page-title"><%= engagement.name %></h1><div class="page-subtitle">Review the information below and confirm whether it accurately reflects your organisation.</div></div></div>

<% if(validationRows.length){ %><section class="panel"><div class="panel-head"><h2>Information waiting for confirmation</h2><span class="tag"><%= validationRows.length %></span></div><div class="divide-row"><% validationRows.forEach(r=>{ %><article class="csf2-client-validation"><div><code><%= r.code %></code><h3><%= r.description %></h3><p><strong>Current position:</strong> <%= r.current_profile_statement||'Not stated' %></p><p><strong>Business impact:</strong> <%= r.business_impact||'Not stated' %></p><div class="csf2-pair"><span>Policy <b><%= r.policy_score==null?'—':r.policy_score %></b></span><span>Practice <b><%= r.practice_score==null?'—':r.practice_score %></b></span><span>Evidence strength <b><%= r.evidence_confidence||'Not yet confirmed' %></b></span></div></div><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/portal/validate/<%= r.subcategory_id %>"><textarea class="textarea" name="note" rows="3" placeholder="Add a note when requesting changes"></textarea><button class="btn btn-primary" name="decision" value="validated">Confirm information</button><button class="btn" name="decision" value="changes_requested">Request changes</button></form></article><% }) %></div></section><% } %>

<section class="panel" style="margin-top:14px;"><div class="panel-head"><div><h2>Reports</h2><p>Download reports released by your engagement team.</p></div></div><div class="divide-row"><% versions.forEach(v=>{ %><div class="csf2-version-row"><div><strong>Version <%= v.version_number %></strong><small>Published <%= v.published_at %></small></div><div><a class="btn btn-primary btn-xs" href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/exports/report.pdf?version=<%= v.id %>">Download PDF</a></div></div><% }) %><% if(!versions.length){ %><div class="empty-state"><div class="empty-title">No report is available yet</div><div class="empty-sub"><%= validationRows.length?'Complete the information checks above.':'Your engagement team will publish the report here when it is ready.' %></div></div><% } %></div></section>
<%- include('partials/footer') %>
