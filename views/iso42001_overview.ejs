<%- include('partials/header', { title, user, ws, active }) %>
<%- include('partials/iso42001_audit_head') %>
<%
  const csrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
  const prog = model.programme;
  const eo = engagementOverview;
  const projection = eo.projection;
  const summary = projection?.summary;
  const phase = projection?.currentPhase;
  const plural = (n, one, many) => `${n} ${n === 1 ? one : (many || one + 's')}`;
  const inScope = systems.filter(s => s.in_scope);
  const approvedIa = inScope.filter(s => s.ia_approved_at).length;
  const assessmentPct = eo.assessment.total ? Math.round(100 * eo.assessment.assessed / eo.assessment.total) : 0;
  const gatePct = summary?.phaseGatesTotal ? Math.round(100 * summary.phaseGatesPassed / summary.phaseGatesTotal) : 0;
  const gateLabel = summary ? `${summary.phaseGatesPassed} of ${summary.phaseGatesTotal} phase gates passed` : 'Engagement plan not started';
  const lifecycle = [
    { name: 'Mobilise', keys: ['mobilisation'] },
    { name: 'Assess', keys: ['gap_assessment', 'context', 'assessment'] },
    { name: 'Implement', keys: ['treatment', 'implementation'] },
    { name: 'Assure', keys: ['operating_evidence', 'internal_assurance'] },
    { name: 'Readiness', keys: ['cert_readiness'] },
    { name: 'Certification', keys: ['stage_1', 'stage_2'] },
  ].map(group => {
    const phases = (projection?.phases || []).filter(p => group.keys.includes(p.phase_key));
    return { ...group, total: phases.length, passed: phases.filter(p => ['complete', 'waived'].includes(p.effective_status)).length, current: group.keys.includes(phase?.phase_key) };
  });
  const nextCriteria = (phase?.criteria || []).filter(c => !c.pass);
  const priorities = [];
  if (model.queues.followUp.length) priorities.push({ label: 'Auditor follow-up', title: `The auditor has come back on ${plural(model.queues.followUp.length, 'request')}`, note: 'Review the auditor’s question and prepare the additional evidence requested.', href: `${base}/requests?status=follow_up`, action: 'Review auditor follow-up', tone: 'attention' });
  if (eo.requests.toReview) priorities.push({ label: 'Assessor review', title: `${plural(eo.requests.toReview, 'client response')} ready for review`, note: 'Check the response and its evidence, then accept it or request changes.', href: eo.requests.href, action: 'Review responses', tone: 'review' });
  if (eo.findings.open) priorities.push({ label: 'Corrective action', title: `${plural(eo.findings.open, 'open finding')} to resolve`, note: eo.findings.rows[0]?.title || 'Record the correction, supporting evidence and closure review.', href: eo.findings.href, action: 'Review findings', tone: 'attention' });
  if (!eo.assessment.complete) priorities.push({ label: 'Assessment', title: eo.assessment.assessed < eo.assessment.total ? `${plural(eo.assessment.total - eo.assessment.assessed, 'requirement')} still need a conclusion` : 'Assessment needs independent review', note: eo.assessment.reviewed ? 'The reviewed baseline no longer matches the current assessment. Review the changes.' : 'Record conclusions and evidence, then complete independent review.', href: eo.assessment.href, action: 'Continue assessment', tone: 'review' });
  if (eo.requests.withClient) priorities.push({ label: 'With client', title: `${plural(eo.requests.withClient, 'request')} awaiting the client`, note: 'Follow up with the assigned owners. A response still needs assessor review.', href: eo.requests.href, action: 'View client requests', tone: 'client' });
  if (!priorities.length && nextCriteria.length) priorities.push({ label: 'Current phase', title: nextCriteria[0].label, note: 'Complete the supporting work and obtain the required approval to pass this phase.', href: eo.planHref, action: 'Open engagement plan', tone: 'review' });
  if (!priorities.length && !eo.plan) priorities.push({ label: 'Get started', title: 'Set up the engagement plan', note: 'Confirm the scope, owners and delivery dates for this engagement.', href: eo.planHref, action: 'Open engagement plan', tone: 'review' });
  const pendingDocs = [...docs.missingMandatory.map(t => ({ t, state: 'Not started' })), ...docs.awaitingApproval.map(t => ({ t, state: 'Awaiting approval' }))];
  const sources = { 'ai-systems': 'AI system register', 'ai-vendors': 'AI system suppliers', 'ai-changes': 'Change register', 'ai-incidents': 'Incident register' };
%>
<div class="a42 a42-overview">
  <header class="a42ov-heading">
    <div>
      <div class="a42ov-eyebrow">ISO/IEC 42001:2023 <span aria-hidden="true">/</span> AI management system</div>
      <h1 class="page-title">Engagement overview</h1>
      <p class="page-subtitle"><%= ws.client_name %> · Scope, delivery and assurance in one place.</p>
    </div>
    <a class="btn btn-secondary" href="<%= base %>/exec-brief">Executive brief <span aria-hidden="true">↗</span></a>
  </header>

  <%
    const TONE_OF = { attention: 'gap', review: 'gap', client: 'wip' };
    const leadState = summary?.completionReady ? ['done', 'Ready for completion review'] : eo.plan ? ['part', 'Engagement in progress'] : ['open', 'Setup required'];
    const reqHref = (stage, status) => `${base}/requests?stage=${stage}` + (status && status !== 'all' ? `&status=${status}` : '');
  %>
  <section class="panel a42-lead" aria-labelledby="a42PositionTitle">
    <div class="a42-lead-copy">
      <span class="a42-kicker"><%= eo.planScope === 'combined' ? 'Combined engagement · current phase' : 'Current phase' %></span>
      <h2 id="a42PositionTitle"><%= phase?.name || (eo.plan ? 'Phase gates complete' : 'Ready to set up your engagement') %></h2>
      <p><%= nextCriteria[0]?.label || (summary?.completionReady ? 'Completion criteria are satisfied. Review the engagement before closing.' : eo.plan ? 'Review the plan for remaining deliverables and completion criteria.' : 'Establish scope, responsibilities and the delivery plan to begin.') %></p>
      <a class="btn btn-primary" href="<%= eo.planHref %>"><%= eo.plan ? 'Open engagement plan' : 'Set up engagement plan' %> <span aria-hidden="true">→</span></a>
    </div>
    <dl class="a42-lead-facts">
      <div><dt>Engagement</dt><dd><i class="a42-dot t-<%= leadState[0] %>" aria-hidden="true"></i><%= leadState[1] %></dd></div>
      <div><dt>Phase gates passed</dt><dd><%= summary ? `${summary.phaseGatesPassed} of ${summary.phaseGatesTotal}` : 'No phase gates yet' %></dd></div>
      <div><dt>Deliverables accepted</dt><dd><%= summary ? `${summary.acceptedDeliverables} of ${summary.requiredDeliverables}` : 'Once the plan exists' %></dd></div>
    </dl>
  </section>

  <section class="a42-stats" aria-label="Engagement measures">
    <a href="<%= eo.assessment.href %>" class="a42-stat">
      <span>Requirements assessed</span><strong><%= eo.assessment.assessed %><small> / <%= eo.assessment.total %></small></strong>
      <em><%= eo.assessment.complete ? 'Independent review current' : 'Independent review outstanding' %></em>
    </a>
    <a href="<%= eo.findings.href %>" class="a42-stat<%= eo.findings.open ? ' is-attention' : '' %>">
      <span>Open findings</span><strong><%= eo.findings.open %></strong><em><%= eo.findings.open ? 'Corrective action required' : 'No open findings recorded' %></em>
    </a>
    <a href="<%= eo.requests.href %>" class="a42-stat">
      <span>Open client requests</span><strong><%= eo.requests.open %></strong><em><%= eo.requests.withClient %> with client · <%= eo.requests.toReview %> to review</em>
    </a>
    <a href="<%= base %>/ai-systems" class="a42-stat">
      <span>Impact assessments approved</span><strong><%= approvedIa %><small> / <%= inScope.length %></small></strong><em>Across AI systems in scope</em>
    </a>
  </section>

  <% if (typeof a42Masthead === 'function') { %><%- include('partials/a42_map', { mast: a42Masthead(), heading: 'The standard, requirement by requirement', intro: '27 management system clauses and 38 Annex A controls, coloured by the recorded conclusion. Select one to open its assessment.' }) %><% } %>

  <div class="a42-grid">
    <section class="panel" aria-labelledby="a42PrioritiesTitle">
      <div class="panel-head"><div><h2 id="a42PrioritiesTitle">What needs attention</h2><p class="a42-caption">The work that moves this engagement forward.</p></div><span class="meta"><%= priorities.length %></span></div>
      <% if (priorities.length) { %>
      <ul class="a42-list">
        <% priorities.forEach(item => { %>
        <li>
          <i class="a42-dot t-<%= TONE_OF[item.tone] || 'open' %>" aria-hidden="true"></i>
          <div><a class="a42-list-title" href="<%= item.href %>"><%= item.title %></a><p><%= item.label %> · <%= item.note %></p></div>
          <a class="a42-list-action" href="<%= item.href %>"><%= item.action %> <span aria-hidden="true">→</span></a>
        </li>
        <% }) %>
      </ul>
      <% } else { %>
      <p class="a42-empty">No open findings or client requests need attention. <a href="<%= eo.planHref %>">Review the engagement plan</a> for completion decisions.</p>
      <% } %>
    </section>

    <div class="a42-stack">
      <section class="panel" aria-labelledby="a42AssuranceTitle">
        <div class="panel-head"><div><h2 id="a42AssuranceTitle">Assurance checkpoints</h2><p class="a42-caption">Conclusions, approvals and published reports are tracked separately.</p></div></div>
        <ul class="a42-list">
          <li><i class="a42-dot t-<%= eo.assessment.assessed === eo.assessment.total ? 'done' : eo.assessment.assessed ? 'part' : 'open' %>" aria-hidden="true"></i><div><a class="a42-list-title" href="<%= eo.assessment.href %>">Assessment coverage</a><p><%= eo.assessment.assessed %> of <%= eo.assessment.total %> conclusions recorded</p></div></li>
          <li><i class="a42-dot t-<%= eo.assessment.complete ? 'done' : 'open' %>" aria-hidden="true"></i><div><a class="a42-list-title" href="<%= eo.assessment.href %>">Independent review</a><p><%= eo.assessment.complete ? 'Reviewed baseline is current' : eo.assessment.reviewed ? 'Assessment changed since review' : 'Review not completed' %></p></div></li>
          <li><i class="a42-dot t-<%= eo.report.published ? 'done' : 'open' %>" aria-hidden="true"></i><div><a class="a42-list-title" href="<%= eo.report.href %>">Controlled report</a><p><%= eo.report.label %></p></div></li>
          <li><i class="a42-dot t-<%= summary?.completionReady ? 'done' : 'open' %>" aria-hidden="true"></i><div><a class="a42-list-title" href="<%= eo.planHref %>">Engagement completion</a><p><%= summary?.completionReady ? 'Criteria satisfied; ready for review' : 'Completion criteria outstanding' %></p></div></li>
        </ul>
      </section>
      <section class="panel" aria-labelledby="a42ActivityTitle">
        <div class="panel-head"><div><h2 id="a42ActivityTitle">Recent activity</h2><p class="a42-caption"><%= plural(eo.evidence.total, 'current evidence file') %></p></div><a class="a42-list-action" href="<%= eo.evidence.href %>">Evidence <span aria-hidden="true">→</span></a></div>
        <% if (eo.recentActivity.length) { %>
        <ul class="a42-list">
          <% eo.recentActivity.forEach(item => { %>
          <li><i class="a42-dot t-quiet" aria-hidden="true"></i><div><a class="a42-list-title" href="<%= item.href %>"><%= item.title %></a><p><%= item.detail %></p></div><time class="a42-list-aside" datetime="<%= item.at %>"><%= fmtDate(item.at) %></time></li>
          <% }) %>
        </ul>
        <% } else { %><p class="a42-empty">Client conversations and evidence activity will appear here as work begins.</p><% } %>
      </section>
    </div>
  </div>

  <div class="a42-grid a42-grid-even">
    <section class="panel" aria-labelledby="a42SystemsTitle">
      <div class="panel-head"><div><h2 id="a42SystemsTitle">AI systems &amp; impact</h2><p class="a42-caption"><%= plural(inScope.length, 'system') %> in scope · <%= approvedIa %> impact assessments approved</p></div><a class="a42-list-action" href="<%= base %>/ai-systems">Register <span aria-hidden="true">→</span></a></div>
      <% if (inScope.length) { %>
      <ul class="a42-list">
        <% inScope.slice(0, 4).forEach(s => { %>
        <li><i class="a42-dot t-<%= s.ia_approved_at ? 'done' : s.ia_status === 'draft' ? 'wip' : 'gap' %>" aria-hidden="true"></i><div><a class="a42-list-title" href="<%= base %>/ai-systems/<%= s.id %>"><%= s.name %></a><p><%= s.purpose ? s.purpose.slice(0, 100) + (s.purpose.length > 100 ? '…' : '') : 'Purpose not recorded' %></p></div><span class="a42-list-aside"><%= s.ia_approved_at ? 'Impact approved' : s.ia_status === 'draft' ? 'Impact in draft' : 'Impact pending' %></span></li>
        <% }) %>
      </ul>
      <% if (inScope.length > 4) { %><p class="a42-more-link"><a href="<%= base %>/ai-systems">All <%= plural(inScope.length, 'system') %> →</a></p><% } %>
      <% } else { %><p class="a42-empty">No AI systems are in scope yet. <% if (perms.manage) { %><a href="<%= base %>/ai-systems/new">Add an AI system</a> to record its purpose, ownership and impacts.<% } %></p><% } %>
    </section>
    <% if (canUseTemplates && docs.mandatory.total) { %>
    <section class="panel" aria-labelledby="a42DocsTitle">
      <div class="panel-head"><div><h2 id="a42DocsTitle">AIMS documents</h2><p class="a42-caption"><strong><%= docs.mandatory.drafted %> of <%= docs.mandatory.total %></strong> documents the standard requires are drafted. <%= docs.mandatory.approved %> approved.</p></div><a class="a42-list-action" href="/workspaces/<%= ws.id %>/templates?framework=iso42001">Templates <span aria-hidden="true">→</span></a></div>
      <% if (pendingDocs.length) { %>
      <ul class="a42-list">
        <% pendingDocs.slice(0, 4).forEach(({ t, state }) => { %>
        <li><i class="a42-dot t-<%= t.doc ? 'wip' : 'open' %>" aria-hidden="true"></i><div><a class="a42-list-title" href="<%= t.doc ? `/workspaces/${ws.id}/documents/${t.doc.doc_id}` : `/workspaces/${ws.id}/templates/${t.id}` %>"><%= t.name %></a></div><span class="a42-list-aside"><%= state %></span></li>
        <% }) %>
      </ul>
      <% if (pendingDocs.length > 4) { %><p class="a42-more-link"><a href="/workspaces/<%= ws.id %>/templates?framework=iso42001"><%= pendingDocs.length - 4 %> more required documents →</a></p><% } %>
      <% } %>
    </section>
    <% } %>
  </div>

  <section class="panel rq-flow" aria-labelledby="a42ChecklistTitle">
    <div class="panel-head"><div><h2 id="a42ChecklistTitle">Certification requests</h2><p class="a42-caption">Evidence preparation for the auditor. Request status does not establish audit completion.</p></div><a class="a42-list-action" href="<%= base %>/requests">Request list <span aria-hidden="true">→</span></a></div>
    <% if (model.total) { %>
      <%- include('partials/a42_pipeline', {
        stages: [model.stage1, model.stage2, model.fieldwork].map(s => ({ key: s.stage, label: STAGE_LABELS[s.stage], total: s.total, overdue: s.overdue,
          byStatus: Object.fromEntries(Object.entries(s.counts).filter(([k]) => k !== 'withdrawn')),
          note: `${STAGE_HINTS[s.stage]} · ${s.date ? fmtDate(s.date) : 'date not set'}` })),
        href: reqHref, STATUS_LABELS, active: null, keys: true }) %>
    <% } else { %>
      <div class="a42-empty">Start the certification checklist when you are ready to prepare the auditor's evidence requests.<% if (perms.manage) { %><form method="POST" action="<%= base %>/checklist"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-secondary" type="submit">Start the checklist</button></form><% } %></div>
    <% } %>
    <% if (perms.manage && checklist.updateAvailable) { %><form class="a42-more-link" method="POST" action="<%= base %>/checklist"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-secondary btn-xs" type="submit">Update checklist to <%= checklist.latest %></button></form><% } %>
  </section>

  <div class="a42ov-details">
    <% if (model.total && model.uncited.length) { %>
    <details class="panel"><summary><span><strong>Requirements outside the request list</strong><small>Still in assessment scope, even without a direct document request.</small></span><span class="a42ov-detail-count"><%= model.uncited.length %> <span aria-hidden="true">+</span></span></summary><ul class="a42-reqs"><% model.uncited.forEach(i => { %><li><span class="a42-ref"><%= i.code %></span><a href="<%= base %>/gap/<%= i.id %>"><%= String(i.title).replace(/^(A\.)?[\d.]+\s+/, '') %></a></li><% }) %></ul></details>
    <% } %>
    <% if (model.populationRows.length) { %>
    <details class="panel"><summary><span><strong>Auditor sampling populations</strong><small>Records in the review period, linked to each request.</small></span><span aria-hidden="true">+</span></summary><div class="a42ov-table-wrap"><table class="t a42-stack"><thead><tr><th>Request</th><th>Source</th><th>Rows</th><th>Status</th></tr></thead><tbody><% model.populationRows.forEach(r => { const key = populationFor(r); %><tr><td><a href="<%= base %>/requests/<%= r.id %>"><%= r.ref %> · <%= r.title %></a></td><td data-label="Source"><%= key ? sources[key] : 'Client records' %></td><td data-label="Rows"><%= key ? populationCounts[key] : '-' %></td><td><span class="status <%= r.status_class %>"><%= r.status_label %></span></td></tr><% }) %></tbody></table></div></details>
    <% } %>
    <details class="panel" id="a42Dates"><summary><span><strong>Audit dates &amp; review period</strong><small><%= prog.stage1_date || prog.stage2_date ? `Stage 1: ${fmtDate(prog.stage1_date) || 'not set'} · Stage 2: ${fmtDate(prog.stage2_date) || 'not set'}` : 'Add audit dates (optional)' %><%= prog.certification_body ? ` · ${prog.certification_body}` : '' %></small></span><span aria-hidden="true">+</span></summary>
      <% if (perms.manage) { %>
      <form method="POST" action="<%= base %>/programme" class="a42-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="a42ov-date-fields"><div><label class="label" for="a42Body">Certification body</label><input id="a42Body" class="input" name="certification_body" maxlength="120" value="<%= prog.certification_body || '' %>"></div><div><label class="label" for="a42S1">Stage 1</label><input id="a42S1" class="input" type="date" name="stage1_date" value="<%= prog.stage1_date || '' %>"></div><div><label class="label" for="a42S2">Stage 2</label><input id="a42S2" class="input" type="date" name="stage2_date" value="<%= prog.stage2_date || '' %>"></div><div><label class="label" for="a42P1">Review period starts</label><input id="a42P1" class="input" type="date" name="review_period_start" value="<%= prog.review_period_start || '' %>"></div><div><label class="label" for="a42P2">Review period ends</label><input id="a42P2" class="input" type="date" name="review_period_end" value="<%= prog.review_period_end || '' %>"></div></div><p class="a42ov-caption">The review period limits which records appear in exported sampling populations.</p><div class="a42-form-actions"><button class="btn btn-primary" type="submit">Save dates</button></div></form>
      <% } else { %><div class="a42ov-empty">Review period: <%= fmtDate(prog.review_period_start) || 'Not set' %> to <%= fmtDate(prog.review_period_end) || 'Not set' %>.</div><% } %>
    </details>
  </div>
  <nav class="a42ov-resources" aria-label="Programme resources"><span>Programme resources</span><a href="<%= base %>/intake">Management intake</a><a href="<%= base %>">Requirements catalogue</a><a href="<%= base %>/roadmap">Improvement roadmap</a><a href="<%= base %>/readiness">Readiness detail</a></nav>
</div>
<%- include('partials/footer') %>
