<%
  const sv = (typeof system !== 'undefined' && system) || {};
  const roles = sv.roles || [];
%>
<div class="stack-grid" style="--cols:minmax(0,2fr) minmax(0,1fr) minmax(0,1fr);">
  <div><label class="label" for="aiName">Name</label><input id="aiName" class="input" name="name" maxlength="160" required value="<%= sv.name || '' %>" placeholder="e.g. Claims triage model"></div>
  <div><label class="label" for="aiStage">Lifecycle stage</label>
    <select id="aiStage" class="select" name="lifecycle_stage">
      <% Object.entries(registry.LIFECYCLE).forEach(([k, label]) => { %><option value="<%= k %>" <%= (sv.lifecycle_stage || 'in_use') === k ? 'selected' : '' %>><%= label %></option><% }) %>
    </select></div>
  <div><label class="label" for="aiLive">Went live</label><input id="aiLive" class="input" type="date" name="go_live_date" value="<%= sv.go_live_date || '' %>"><span class="hint">The auditor samples systems implemented in the review period.</span></div>
</div>
<div><label class="label" for="aiPurpose">Purpose and context</label><textarea id="aiPurpose" class="textarea" name="purpose" rows="3" maxlength="4000" placeholder="What it does, for whom, and the decision or output it produces"><%= sv.purpose || '' %></textarea><span class="hint">The auditor asks for the general purpose and context of each AI system before fieldwork.</span></div>
<div class="stack-grid" style="--cols:minmax(0,1fr) minmax(0,1fr);">
  <div><label class="label" for="aiUsers">Who uses it</label><input id="aiUsers" class="input" name="intended_users" maxlength="2000" value="<%= sv.intended_users || '' %>" placeholder="e.g. Claims handlers; customers via the app"></div>
  <div><label class="label" for="aiOwner">System owner</label><input id="aiOwner" class="input" name="system_owner" maxlength="160" value="<%= sv.system_owner || '' %>" placeholder="Name and role"></div>
</div>
<div>
  <span class="label">What the organisation does with this system</span>
  <span class="hint">Clause 4.1. The answers decide the organisation's role for it<%= roles.length ? `, now ${roles.map(r => registry.ROLE_INFO[r].name).join(', ')}` : '' %>, and the role decides which controls weigh most. Leave a question you cannot answer yet.</span>
  <%- include('a42_role_questions', { questions: registry.ROLE_QUESTIONS, answers: sv.answers || {}, prefix: 'aiRole' }) %>
</div>
<div class="stack-grid" style="--cols:minmax(0,1fr) minmax(0,2fr);">
  <div><label class="label" for="aiAuto">How much it decides on its own</label>
    <select id="aiAuto" class="select" name="automation_level">
      <option value="">Not recorded</option>
      <% Object.entries(registry.AUTOMATION).forEach(([k, label]) => { %><option value="<%= k %>" <%= sv.automation_level === k ? 'selected' : '' %>><%= label %></option><% }) %>
    </select></div>
  <div><label class="label" for="aiOversight">Human oversight</label><input id="aiOversight" class="input" name="human_oversight" maxlength="4000" value="<%= sv.human_oversight || '' %>" placeholder="Who reviews outputs and when they can override"></div>
</div>
<div class="stack-grid" style="--cols:auto minmax(0,1fr);align-items:start;">
  <div><span class="label">In the AIMS scope</span>
    <div class="a42-checks">
      <label><input type="radio" name="in_scope" value="1" <%= sv.in_scope === 0 ? '' : 'checked' %>> <span>In scope</span></label>
      <label><input type="radio" name="in_scope" value="0" <%= sv.in_scope === 0 ? 'checked' : '' %>> <span>Excluded</span></label>
    </div></div>
  <div><label class="label" for="aiScopeNote">Scope note</label><input id="aiScopeNote" class="input" name="scope_note" maxlength="2000" value="<%= sv.scope_note || '' %>" placeholder="Required when excluded: why it sits outside the scope"></div>
</div>
<p class="a42-section-title">Resources (Annex A.4)</p>
<div class="stack-grid" style="--cols:minmax(0,1fr) minmax(0,1fr);">
  <div><label class="label" for="aiData">Data</label><textarea id="aiData" class="textarea" name="data_resources" rows="3" maxlength="8000" placeholder="The data it is trained, tested or run on: sources, provenance, categories"><%= sv.data_resources || '' %></textarea></div>
  <div><label class="label" for="aiPeople">People</label><textarea id="aiPeople" class="textarea" name="human_resources" rows="3" maxlength="8000" placeholder="Roles and expertise needed to run and oversee it"><%= sv.human_resources || '' %></textarea></div>
</div>
<%
  // What the register holds because of what the organisation does with the
  // system (lib/ai-roles.js SECTIONS). A section shows when one of its
  // questions above is answered yes, or when it already holds data.
  const roleSections = registry.sectionsFor(sv);
%>
<% roleSections.forEach(sec => { %>
  <fieldset class="a42-role-section" data-role-section="<%= sec.key %>" data-when="<%= sec.when.join(' ') %>" data-filled="<%= sec.filled ? 1 : 0 %>" data-applies="<%= sec.applies ? 1 : 0 %>">
    <legend class="a42-section-title"><%= sec.title %> <span class="meta">(<%= sec.ref %>)</span></legend>
    <span class="hint"><%= sec.intro %></span>
    <div class="stack-grid" style="--cols:minmax(0,1fr) minmax(0,1fr);">
      <% sec.fields.forEach(f => { const fid = `ai-${f.name}`; %>
        <div><label class="label" for="<%= fid %>"><%= f.label %></label><% if (f.type === 'date') { %><input id="<%= fid %>" class="input" type="date" name="<%= f.name %>" value="<%= sv[f.name] || '' %>"><% } else if (f.long) { %><textarea id="<%= fid %>" class="textarea" name="<%= f.name %>" rows="3" maxlength="<%= ['tooling_resources', 'compute_resources'].includes(f.name) ? 8000 : 4000 %>" placeholder="<%= f.placeholder || '' %>"><%= sv[f.name] || '' %></textarea><% } else { %><input id="<%= fid %>" class="input" name="<%= f.name %>" maxlength="500" value="<%= sv[f.name] || '' %>" placeholder="<%= f.placeholder || '' %>"><% } %></div>
      <% }) %>
    </div>
  </fieldset>
<% }) %>
<p class="hint a42-role-empty" data-role-sections-empty hidden>Answer the questions about what the organisation does with this system; the parts of the register that apply to it appear here.</p>
<script>
(function () {
  // Show the role sections that apply as the questions are answered. Hidden
  // fields still submit, so nothing typed is lost; a section holding data
  // stays on show.
  const form = document.currentScript.closest('form');
  if (!form) return;
  const sections = form.querySelectorAll('[data-role-section]');
  const empty = form.querySelector('[data-role-sections-empty]');
  const answer = (key) => { const c = form.querySelector('input[name="role_' + key + '"]:checked'); return c ? c.value : null; };
  function update() {
    let shown = 0;
    sections.forEach((sec) => {
      const answers = sec.dataset.when.split(' ').map(answer);
      const show = sec.dataset.filled === '1' || answers.includes('yes') || (answers.every((a) => a === null) && sec.dataset.applies === '1');
      sec.hidden = !show;
      if (show) shown += 1;
    });
    if (empty) empty.hidden = shown > 0;
  }
  form.addEventListener('change', (e) => { if (e.target.name && e.target.name.indexOf('role_') === 0) update(); });
  update();
})();
</script>
