<%- include('partials/header', { title: 'Risk library', user, ws, active: 'risks' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Risks</h1>
    <div class="page-subtitle">Common ISO 27001 risks pre-written by domain. Pick the ones that apply, hit Add - they go into the register at default likelihood/impact 3 with suggested control links.</div>
  </div>
  <a href="/workspaces/<%= ws.id %>/risks" class="btn btn-secondary btn-xs">Back to register</a>
</div>

<%- include('partials/risk_tabs', { ws, active: 'register' }) %>

<form method="POST" action="/workspaces/<%= ws.id %>/risks/library">
  <div style="position:sticky;top:0;background:var(--bg-deep);padding:8px 0;margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--border);z-index:5;">
    <div class="meta"><span id="pickCount">0</span> selected · <%= Object.keys(byDomain).length %> domains · <%= Object.values(byDomain).reduce((n, a) => n + a.length, 0) %> risks total</div>
    <div style="display:flex;gap:6px;">
      <button type="button" onclick="pickAll(true)" class="btn btn-secondary btn-xs">Select all visible</button>
      <button type="button" onclick="pickAll(false)" class="btn btn-secondary btn-xs">Clear</button>
      <button type="submit" class="btn btn-primary btn-xs">Add selected to register</button>
    </div>
  </div>

  <% Object.keys(byDomain).forEach(domain => { %>
    <div class="panel" style="margin-bottom:14px;">
      <div class="panel-head"><h2><%= domain %></h2><span class="meta"><%= byDomain[domain].length %> risk<%= byDomain[domain].length === 1 ? '' : 's' %></span></div>
      <% byDomain[domain].forEach(r => { %>
        <label style="display:grid;grid-template-columns:24px 1fr;gap:10px;padding:10px 16px;border-top:1px solid var(--border);cursor:pointer;align-items:start;" onclick="setTimeout(updateCount, 0)">
          <input type="checkbox" name="pick" value="<%= r.idx %>" style="margin-top:3px;">
          <div>
            <div style="font-size:13.5px;font-weight:500;line-height:1.4;"><%= r.title %></div>
            <div class="text-md text-secondary" style="margin-top:3px;line-height:1.5;"><%= r.description %></div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">
              <% if (r.threat) { %><span class="meta text-sm"><strong>Threat:</strong> <%= r.threat %></span><% } %>
              <% if (r.vulnerability) { %><span class="meta text-sm"><strong>Vulnerability:</strong> <%= r.vulnerability %></span><% } %>
            </div>
            <% if (r.suggested_controls && r.suggested_controls.length) { %>
              <div style="margin-top:6px;">
                <% r.suggested_controls.forEach(c => { %><span class="tag tag-info text-eyebrow" style="margin-right:3px;"><%= c.replace('annex-','').toUpperCase() %></span><% }) %>
              </div>
            <% } %>
          </div>
        </label>
      <% }) %>
    </div>
  <% }) %>
</form>

<script>
function updateCount() {
  document.getElementById('pickCount').textContent = document.querySelectorAll('input[name="pick"]:checked').length;
}
function pickAll(state) {
  document.querySelectorAll('input[name="pick"]').forEach(c => c.checked = state);
  updateCount();
}
</script>

<%- include('partials/footer') %>
