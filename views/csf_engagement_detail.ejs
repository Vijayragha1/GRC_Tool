<%- include('partials/header', { title: engagement.name, user, ws, active: 'csf' }) %>

<div class="page-head">
  <div>
    <div style="display:flex;align-items:center;gap:10px;">
      <a href="/workspaces/<%= ws.id %>/csf" class="meta" style="font-size:12px;text-decoration:none;">&larr; CSF engagements</a>
    </div>
    <h1 class="page-title" style="margin-top:6px;"><%= engagement.name %></h1>
    <div class="page-subtitle">
      CSF <%= engagement.catalog_version %>
      <% if (engagement.current_version) { %> &middot; v<%= engagement.current_version %><% } %>
      &middot; <%= engagement.scope_mode === 'CURRENT_TARGET' ? 'Current + Target' : 'Current only' %>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
    <% const statusColor = { 'Draft':'var(--text-tertiary)', 'In Progress':'#1d4ed8', 'Under Review':'#a16207', 'Approved':'#15803d', 'Published':'#15803d', 'Closed':'var(--text-tertiary)' }[engagement.status] || 'var(--text)' ; %>
    <span class="tag" style="background:rgba(0,0,0,0.04);color:<%= statusColor %>;font-size:12px;"><%= engagement.status %></span>
    <% if (nextEngState && canTransitionEng) { %>
      <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/transition" style="display:inline;" onsubmit="return appConfirmForm(event, 'Move engagement to <%= nextEngState %>?')">
        <input type="hidden" name="to_state" value="<%= nextEngState %>">
        <button class="btn btn-secondary btn-xs">Mark as <%= nextEngState %> &rarr;</button>
      </form>
    <% } %>
    <% if (canPublishNow) { %>
      <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/publish" style="display:inline;" onsubmit="return appConfirmForm(event, 'Publish this engagement as v1.0? Scores, findings, and recommendations will be frozen into an immutable snapshot.')">
        <input type="hidden" name="change_summary" value="Initial publish">
        <button class="btn btn-primary btn-xs">Publish v1.0</button>
      </form>
    <% } %>
    <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/scores" class="btn btn-secondary btn-xs">Scores</a>
    <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/findings" class="btn btn-secondary btn-xs">Findings</a>
    <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/versions" class="btn btn-secondary btn-xs">Versions<% if (engagement.current_version) { %> v<%= engagement.current_version %><% } %></a>
    <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess" class="btn btn-primary btn-xs">Open assessment &rarr;</a>
  </div>
</div>

<div class="panel" style="margin-bottom:14px;border-left:3px solid #a16207;background:rgba(161,98,7,0.04);">
  <div class="panel-pad" style="font-size:12.5px;color:var(--text-secondary);">
    <strong style="color:#a16207;">PROTOTYPE - NOT FOR CLIENT DATA.</strong>
    Stage 2 of the CSF module. Engagement overview + assignments. Assessment workspace, scoring, findings, and reporting come in subsequent stages.
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
  <!-- Engagement metadata -->
  <div class="panel">
    <div class="panel-head"><h2>Engagement</h2></div>
    <div class="panel-pad" style="font-size:13px;line-height:1.7;">
      <div><span class="meta" style="font-size:11.5px;">Lead:</span> <%= lead ? lead.name : '-' %></div>
      <div><span class="meta" style="font-size:11.5px;">Period:</span> <%= engagement.period_start || '-' %> &rarr; <%= engagement.period_end || '-' %></div>
      <div><span class="meta" style="font-size:11.5px;">Target completion:</span> <%= engagement.target_completion_date || '-' %></div>
      <div><span class="meta" style="font-size:11.5px;">Created:</span> <%= engagement.created_at %></div>
    </div>
  </div>

  <!-- Assignments -->
  <div class="panel">
    <div class="panel-head">
      <h2>Team</h2>
      <span class="meta" style="font-size:11.5px;"><%= assignments.length %> assignments</span>
    </div>
    <% if (assignments.length === 0) { %>
      <div class="panel-pad meta" style="font-size:12.5px;">No assignments yet.</div>
    <% } else { %>
      <table class="t">
        <thead><tr><th>Person</th><th style="width:170px;">Role</th><th style="width:50px;"></th></tr></thead>
        <tbody>
          <% assignments.forEach(a => { %>
            <tr>
              <td style="font-size:12.5px;"><%= a.user_name %><% if (a.email) { %><div class="meta" style="font-size:11px;"><%= a.email %></div><% } %></td>
              <td>
                <span class="mono" style="font-size:11px;background:var(--bg-subtle);padding:2px 6px;border-radius:4px;border:1px solid var(--border);"><%= a.role_on_engagement %></span>
              </td>
              <td style="text-align:right;">
                <% if (canAssign) { %>
                  <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/unassign/<%= a.id %>" style="display:inline;" onsubmit="return appConfirmForm(event, 'Remove this assignment?')">
                    <button class="btn btn-ghost btn-xs" style="color:#b91c1c;font-size:11px;">&times;</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <% if (canAssign) { %>
      <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assign" class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);display:grid;grid-template-columns:1fr 170px auto;gap:8px;">
        <select class="select" name="user_id" required style="font-size:12px;">
          <option value="">- pick a person -</option>
          <% assignableUsers.forEach(u => { %>
            <option value="<%= u.id %>"><%= u.name %></option>
          <% }) %>
        </select>
        <select class="select" name="role_on_engagement" required style="font-size:12px;">
          <% engagementRoles.forEach(r => { %>
            <option value="<%= r %>" <%= r === 'CONSULTANT' ? 'selected' : '' %>><%= r %></option>
          <% }) %>
        </select>
        <button class="btn btn-primary btn-xs">Assign</button>
      </form>
      <div class="panel-pad meta" style="font-size:11px;color:var(--text-tertiary);border-top:1px solid var(--border);">
        Role meanings: <strong>ENGAGEMENT_LEAD</strong> approves and publishes. <strong>CONSULTANT</strong> scores Subcategories. <strong>REVIEWER</strong> comments on scores. <strong>ANALYST</strong> collects evidence and drafts narratives but cannot score.
      </div>
    <% } %>
  </div>
</div>

<!-- Stage 6: consultant dashboard -->
<% const sevColor = { 'CRITICAL':'#b91c1c', 'HIGH':'#dc2626', 'MEDIUM':'#a16207', 'LOW':'var(--text-tertiary)' }; %>

<!-- Progress KPI strip -->
<div class="panel" style="margin-bottom:14px;">
  <div class="panel-pad" style="display:grid;grid-template-columns:repeat(5,1fr);gap:18px;">
    <div>
      <div class="kpi-num"><%= scoredPct %><span style="font-size:14px;font-weight:400;color:var(--text-tertiary);">%</span></div>
      <div class="kpi-label">Scored</div>
      <div class="meta" style="font-size:11.5px;margin-top:4px;"><%= scoredSubs %> of <%= inscopeSubs %> in-scope</div>
    </div>
    <div>
      <div class="kpi-num num"><%= statusCounts['Not Started'] || 0 %></div>
      <div class="kpi-label">Not started</div>
    </div>
    <div>
      <div class="kpi-num num" style="color:#1d4ed8;"><%= (statusCounts['In Progress'] || 0) + (statusCounts['Evidence Collected'] || 0) + (statusCounts['Draft Complete'] || 0) %></div>
      <div class="kpi-label">In flight</div>
      <div class="meta" style="font-size:11px;margin-top:2px;">In progress + Evidence + Draft</div>
    </div>
    <div>
      <div class="kpi-num num" style="color:#15803d;"><%= (statusCounts['Reviewed'] || 0) + (statusCounts['Approved'] || 0) %></div>
      <div class="kpi-label">Reviewed/Approved</div>
    </div>
    <div>
      <% if (daysRemaining !== null) { %>
        <div class="kpi-num num" style="color:<%= daysOverdue ? '#b91c1c' : daysRemaining < 14 ? '#a16207' : 'var(--text)' %>;"><%= Math.abs(daysRemaining) %></div>
        <div class="kpi-label"><%= daysOverdue ? 'Days overdue' : 'Days to target' %></div>
        <div class="meta" style="font-size:11px;margin-top:2px;"><%= engagement.target_completion_date %></div>
      <% } else { %>
        <div class="kpi-num num" style="color:var(--text-tertiary);">-</div>
        <div class="kpi-label">No target date</div>
      <% } %>
    </div>
  </div>
</div>

<!-- Score distribution -->
<div class="panel" style="margin-bottom:14px;">
  <div class="panel-head"><h2>Score distribution (current)</h2><span class="meta" style="font-size:11.5px;"><%= scoredSubs %> scored</span></div>
  <div class="panel-pad" style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;">
    <% const maxC = Math.max(1, ...distribution.map(d => d.count)); %>
    <% distribution.forEach(d => { %>
      <div style="text-align:center;">
        <div style="height:80px;display:flex;align-items:flex-end;justify-content:center;">
          <div style="width:36px;background:<%= d.score >= 4 ? '#15803d' : d.score >= 3 ? '#1d4ed8' : d.score >= 2 ? '#a16207' : '#b91c1c' %>;height:<%= Math.round((d.count / maxC) * 76) + 4 %>px;border-radius:4px 4px 0 0;"></div>
        </div>
        <div style="font-size:18px;font-weight:600;margin-top:6px;"><%= d.count %></div>
        <div class="kpi-meta">CMMI <%= d.score %></div>
      </div>
    <% }) %>
  </div>
</div>

<!-- Outstanding items + activity feed side by side -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
  <div class="panel">
    <div class="panel-head"><h2>Outstanding items</h2></div>

    <% if (subsWithScoreNoEvidence.length) { %>
      <div class="panel-pad" style="border-top:1px solid var(--border);">
        <div class="meta" style="font-size:11px;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;color:#b91c1c;">Scored without evidence (<%= subsWithScoreNoEvidence.length %>)</div>
        <div style="font-size:12.5px;line-height:1.6;display:flex;flex-wrap:wrap;gap:6px;">
          <% subsWithScoreNoEvidence.slice(0, 12).forEach(s => { %>
            <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= s.subcategory_id %>" class="mono" style="color:var(--accent);background:rgba(185,28,28,0.08);padding:2px 6px;border-radius:4px;font-size:11px;text-decoration:none;"><%= s.sub_code %></a>
          <% }) %>
          <% if (subsWithScoreNoEvidence.length > 12) { %><span class="meta" style="font-size:11px;align-self:center;">+<%= subsWithScoreNoEvidence.length - 12 %> more</span><% } %>
        </div>
      </div>
    <% } %>

    <% if (unresolvedComments.length) { %>
      <div class="panel-pad" style="border-top:1px solid var(--border);">
        <div class="meta" style="font-size:11px;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;color:#a16207;">Unresolved reviewer comments (<%= unresolvedComments.length %>)</div>
        <% unresolvedComments.slice(0, 5).forEach(c => { %>
          <div style="font-size:12px;padding:4px 0;line-height:1.5;">
            <% if (c.requires_revision) { %><span class="tag tag-warn" style="font-size:10px;">needs revision</span><% } %>
            <strong style="font-size:12px;"><%= c.commenter_name %>:</strong>
            <%= c.text.length > 100 ? c.text.slice(0, 100) + '...' : c.text %>
            <% if (c.sub_code) { %><a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= c.subcategory_id %>" class="mono" style="color:var(--accent);text-decoration:none;font-size:11px;">&rarr; <%= c.sub_code %></a><% } %>
            <% if (c.finding_title) { %><span class="meta" style="font-size:11px;">on finding: <%= c.finding_title.slice(0, 40) %></span><% } %>
          </div>
        <% }) %>
        <% if (unresolvedComments.length > 5) { %><div class="meta" style="font-size:11px;">+<%= unresolvedComments.length - 5 %> more</div><% } %>
      </div>
    <% } %>

    <% if (findingsNoRecs.length) { %>
      <div class="panel-pad" style="border-top:1px solid var(--border);">
        <div class="meta" style="font-size:11px;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;color:#a16207;">Findings without recommendations (<%= findingsNoRecs.length %>)</div>
        <% findingsNoRecs.slice(0, 8).forEach(f => { %>
          <div style="font-size:12px;padding:3px 0;line-height:1.5;display:flex;gap:6px;align-items:center;">
            <span class="tag" style="background:<%= sevColor[f.severity] || 'var(--bg-subtle)' %>;color:#fff;font-size:9.5px;font-weight:600;"><%= f.severity %></span>
            <span style="flex:1;"><%= f.title %></span>
            <% if (f.sub_code) { %><a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= f.subcategory_id %>" class="mono" style="color:var(--accent);text-decoration:none;font-size:11px;"><%= f.sub_code %></a><% } %>
          </div>
        <% }) %>
        <% if (findingsNoRecs.length > 8) { %><div class="meta" style="font-size:11px;">+<%= findingsNoRecs.length - 8 %> more</div><% } %>
      </div>
    <% } %>

    <% if (!subsWithScoreNoEvidence.length && !unresolvedComments.length && !findingsNoRecs.length) { %>
      <div class="panel-pad meta" style="font-size:12.5px;">Nothing outstanding. Either nothing's been worked on yet, or every flagged item has been resolved.</div>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Activity</h2><span class="meta" style="font-size:11.5px;">last <%= activity.length %></span></div>
    <% if (activity.length === 0) { %>
      <div class="panel-pad meta" style="font-size:12px;">No activity yet on this workspace's CSF module.</div>
    <% } else { %>
      <div class="divide-row" style="max-height:380px;overflow-y:auto;">
        <% activity.forEach(a => { %>
          <div style="padding:6px 14px;font-size:12px;line-height:1.5;">
            <div style="display:flex;gap:6px;align-items:baseline;">
              <span class="meta" style="font-size:10.5px;flex-shrink:0;width:90px;"><%= a.created_at %></span>
              <span style="flex:1;"><strong><%= a.actor || '-' %></strong> <span class="meta" style="font-size:11.5px;"><%= a.action.replace(/^csf_/, '').replace(/_/g, ' ') %></span></span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
