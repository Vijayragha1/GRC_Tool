<%- include('partials/header', { title: kri.name, user, ws, active: 'risks' }) %>

<a href="/workspaces/<%= ws.id %>/kris" class="link-muted" style="font-size:12px;">← All KRIs</a>

<div class="page-head" style="margin-top:8px">
  <div>
    <h1 class="page-title"><%= kri.name %></h1>
    <div class="page-subtitle"><%= kri.description || '—' %></div>
  </div>
  <form method="POST" action="/workspaces/<%= ws.id %>/kris/<%= kri.id %>/delete" onsubmit="return confirm('Delete this KRI and all readings?')"><button class="btn btn-danger btn-xs">Delete</button></form>
</div>

<div class="panel" style="margin-bottom:16px">
  <div class="panel-pad" style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;">
    <div><div class="meta">Owner</div><div style="font-weight:600;"><%= kri.owner_name || '—' %></div></div>
    <div><div class="meta">Unit</div><div style="font-weight:600;"><%= kri.unit || '—' %></div></div>
    <div><div class="meta">Green ≤</div><div style="font-weight:600;"><%= kri.green_max != null ? kri.green_max : '—' %></div></div>
    <div><div class="meta">Amber ≤</div><div style="font-weight:600;"><%= kri.amber_max != null ? kri.amber_max : '—' %></div></div>
  </div>
</div>

<div class="panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>Add reading</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/kris/<%= kri.id %>/readings" class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr 2fr auto;gap:10px;align-items:end;">
    <div><label class="label">Value</label><input class="input num" name="value" type="number" step="0.01" required></div>
    <div><label class="label">Date</label><input class="input" name="measured_at" type="date" value="<%= new Date().toISOString().slice(0,10) %>"></div>
    <div><label class="label">Notes</label><input class="input" name="notes"></div>
    <div><button class="btn btn-primary btn-xs">Record</button></div>
  </form>
</div>

<div class="panel">
  <div class="panel-head"><h2>Readings (<%= readings.length %>)</h2></div>
  <table class="t">
    <thead><tr><th>Date</th><th class="num">Value</th><th>Status</th><th>Notes</th></tr></thead>
    <tbody>
      <% readings.forEach(r => {
           let band = '—', col = '#71717a';
           if (kri.green_max != null) {
             if (r.value <= kri.green_max) { band = 'green'; col = '#16a34a'; }
             else if (kri.amber_max != null && r.value <= kri.amber_max) { band = 'amber'; col = '#ca8a04'; }
             else { band = 'red'; col = '#b91c1c'; }
           }
      %>
        <tr><td class="num meta"><%= r.measured_at %></td><td class="num"><%= r.value %></td><td><span class="tag" style="background:<%= col %>1a;color:<%= col %>;border-color:<%= col %>40;font-size:10.5px;text-transform:uppercase;"><%= band %></span></td><td class="meta"><%= r.notes || '' %></td></tr>
      <% }) %>
      <% if (!readings.length) { %><tr><td colspan="4" class="t-empty">No readings yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
