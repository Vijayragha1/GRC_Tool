<%- include('partials/header', { title, user, ws, active }) %>
<%
  const csrf = typeof csrfToken !== 'undefined' ? csrfToken : '';
  const canSignoff = typeof userPerms !== 'undefined' && userPerms.has('assessment.signoff');
  const canEdit = typeof userPerms !== 'undefined' && userPerms.has('control.update');
  const fmt = value => value ? new Intl.DateTimeFormat(ws.locale || 'en-GB', { day:'numeric', month:'short', year:'numeric' }).format(new Date(`${String(value).slice(0,10)}T12:00:00`)) : '—';
  const phaseLabels = { mobilisation:'Mobilisation', fieldwork:'Fieldwork', validation:'Validation', report:'Report', post_report:'Post-report' };
  const statusLabel = value => String(value || '').replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase());
%>

<div class="page-head gfw-head">
  <div><div class="eyebrow">ISO 27001 gap assessment</div><h1 class="page-title">Fieldwork management</h1><div class="page-subtitle">Govern interviews, constraints, declared defaults, weekly snapshots and phase sign-off from one controlled workspace.</div></div>
  <a class="btn btn-secondary btn-sm" href="/workspaces/<%= ws.id %>/gap-assessment">← Gap assessment</a>
</div>

<% if (!context.pass) { %>
  <div class="panel panel-pad"><div class="empty-title">Start an assessment pass first</div><div class="empty-sub">Fieldwork records must be attached to a traceable assessment pass.</div><a class="btn btn-primary btn-sm" style="margin-top:12px" href="/workspaces/<%= ws.id %>/gap-assessment">Start assessment pass</a></div>
<% } else { %>
<section class="panel gfw-position">
  <div><span>Assessment pass</span><strong>Pass <%= context.pass.pass_number %> · <%= context.pass.label || 'Gap assessment' %></strong><small><%= statusLabel(context.pass.status) %></small></div>
  <div><span>Current governed phase</span><strong><%= phaseLabels[context.currentPhase] %></strong><small>Based on signed decisions and released outputs</small></div>
  <div><span>Requirements concluded</span><strong><%= context.live.requirementsCovered %>/<%= context.live.requirementsTotal %></strong><small><%= context.live.requirementsTotal ? Math.round(context.live.requirementsCovered/context.live.requirementsTotal*100) : 0 %>% coverage</small></div>
  <div><span>Open constraints</span><strong><%= context.live.activeBlockers %></strong><small>Manual and RFI-derived blockers</small></div>
</section>

<section class="gfw-section">
  <div class="gfw-section-head"><div><span>Governance</span><h2>Phase gates</h2><p>Stages advance only after their prerequisites are satisfied and a sign-off holder records a rationale.</p></div></div>
  <div class="gfw-gates">
    <% ['mobilisation','fieldwork','validation','report','post_report'].forEach(phase => { const gate=context.gates[phase]; const decision=context.decisionMap[phase]; const complete=context.completed[phase]; %>
      <article class="panel gfw-gate <%= complete ? 'is-complete' : context.currentPhase===phase ? 'is-current' : '' %>">
        <header><div><span><%= phaseLabels[phase] %></span><strong><%= complete ? (decision?.decision === 'not_required' ? 'Not required' : 'Complete') : context.currentPhase===phase ? 'Current' : 'Pending' %></strong></div><b><%= complete ? '✓' : '—' %></b></header>
        <div class="gfw-checks"><% gate.checks.forEach(check => { %><div class="<%= check.pass ? 'pass' : 'fail' %>"><span><%= check.pass ? '✓' : '○' %></span><%= check.label %></div><% }) %></div>
        <% if (decision) { %><p class="gfw-decision"><strong><%= decision.decided_by_name %></strong> · <%= decision.rationale %></p><% } %>
        <% if (phase !== 'report' && canSignoff) { %>
          <details class="gfw-decision-form"><summary><%= decision && complete ? 'Reopen or revise' : 'Record decision' %></summary><form method="POST" action="/workspaces/<%= ws.id %>/gap-assessment/fieldwork/phases/<%= phase %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= decision?.row_version || 0 %>"><select class="select" name="decision"><option value="complete">Complete</option><% if (phase==='validation') { %><option value="not_required">Not required</option><% } %><option value="reopened">Reopen</option></select><textarea class="textarea" name="rationale" rows="2" required placeholder="Decision rationale and basis"></textarea><button class="btn btn-primary btn-xs">Record decision</button></form></details>
        <% } %>
        <% if (phase === 'validation' && context.engagement) { %><a class="gfw-workflow-link" href="/workspaces/<%= ws.id %>/delivery?view=findings&engagement=<%= context.engagement.id %>">Manage confirmed findings →</a><% } %>
        <% if (phase === 'report' && context.engagement) { %><a class="gfw-workflow-link" href="/workspaces/<%= ws.id %>/delivery?view=reports&engagement=<%= context.engagement.id %>">Review and publish reports →</a><% } %>
      </article>
    <% }) %>
  </div>
</section>

<section class="gfw-section">
  <div class="gfw-section-head"><div><span>Weekly governance</span><h2>Fieldwork snapshots</h2><p>Freeze a point-in-time progress record for client reporting and engagement review.</p></div><% if (canSignoff) { %><form class="gfw-inline-form" method="POST" action="/workspaces/<%= ws.id %>/gap-assessment/fieldwork/snapshots"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Week ending<input class="input" type="date" name="week_ending" required></label><button class="btn btn-primary btn-sm">Freeze snapshot</button></form><% } %></div>
  <div class="panel gfw-live-metrics"><div><span>Coverage</span><strong><%= context.live.requirementsCovered %>/<%= context.live.requirementsTotal %></strong></div><div><span>Interviews</span><strong><%= context.live.interviewsCompleted %>/<%= context.live.interviewsPlanned %></strong></div><div><span>RFIs received</span><strong><%= context.live.requestsReceived %>/<%= context.live.requestsTotal %></strong></div><div><span>Blockers</span><strong><%= context.live.activeBlockers %></strong></div><div><span>Defaults</span><strong><%= context.live.declaredDefaults %></strong></div></div>
  <% if (context.snapshots.length) { %><div class="panel gfw-snapshot-list"><div class="gfw-table-head"><span>Week ending</span><span>Coverage</span><span>Interviews</span><span>RFIs</span><span>Blockers</span><span>Digest</span></div><% context.snapshots.forEach(s => { %><div><strong><%= fmt(s.week_ending) %></strong><span><%= s.requirements_covered %>/<%= s.requirements_total %></span><span><%= s.interviews_completed %>/<%= s.interviews_planned %></span><span><%= s.requests_received %>/<%= s.requests_total %></span><span><%= s.active_blockers %></span><code><%= s.snapshot_hash.slice(0,12) %>…</code></div><% }) %></div><% } %>
</section>

<section class="gfw-section" id="interviews">
  <div class="gfw-section-head"><div><span>Schedule</span><h2>Interviews</h2><p>Structured interview records replace task-title inference. Client-facing summaries must not include raw notes or named attribution.</p></div></div>
  <% if (canEdit) { %><details class="panel gfw-create"><summary>+ Schedule interview</summary><form method="POST" action="/workspaces/<%= ws.id %>/gap-assessment/fieldwork/interviews"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="gfw-form-grid"><label>Interview title<input class="input" name="title" required maxlength="220"></label><label>Participant role<input class="input" name="participant_role" required maxlength="180" placeholder="e.g. Head of IT Operations"></label><label>Scheduled date and time<input class="input" type="datetime-local" name="scheduled_at" required></label><label>Duration (minutes)<input class="input" type="number" name="duration_minutes" min="5" max="480"></label><label>Owner<select class="select" name="owner_id"><option value="">Unassigned</option><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></label><label class="gfw-wide">Objective<textarea class="textarea" name="objective" rows="2"></textarea></label></div><label class="gfw-check"><input type="checkbox" name="client_visible" value="1" checked> Show schedule and completion status to the client</label><button class="btn btn-primary btn-sm">Schedule interview</button></form></details><% } %>
  <div class="panel gfw-register"><% if (!context.interviews.length) { %><div class="panel-pad meta">No governed interviews have been scheduled.</div><% } else { context.interviews.forEach(row => { %><article><div><span><%= row.participant_role %></span><strong><%= row.title %></strong><small><%= row.scheduled_at.replace('T',' ') %> · <%= row.duration_minutes ? `${row.duration_minutes} minutes` : 'Duration not set' %></small></div><span class="status status-<%= row.status==='completed'?'good':row.status==='cancelled'?'neutral':'warn' %>"><%= statusLabel(row.status) %></span><details><summary>Update</summary><form method="POST" action="/workspaces/<%= ws.id %>/gap-assessment/fieldwork/interviews/<%= row.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= row.row_version %>"><select class="select" name="status"><% ['scheduled','completed','rescheduled','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= row.status===s?'selected':'' %>><%= statusLabel(s) %></option><% }) %></select><textarea class="textarea" name="completion_summary" rows="2" placeholder="Client-safe completion summary; required when completed"><%= row.completion_summary || '' %></textarea><button class="btn btn-secondary btn-xs">Save status</button></form></details></article><% }) } %></div>
</section>

<section class="gfw-section" id="blockers">
  <div class="gfw-section-head"><div><span>Constraints</span><h2>Blockers</h2><p>Urgent and overdue RFIs are detected automatically; material constraints can also be recorded explicitly.</p></div></div>
  <% if (context.requestBlockers.length) { %><div class="panel gfw-derived"><div class="panel-head"><div><h3>RFI-derived blockers</h3><div class="meta">Live from overdue or urgent client requests.</div></div><span class="tag tag-warning"><%= context.requestBlockers.length %></span></div><% context.requestBlockers.forEach(r=>{ %><div><strong><%= r.title %></strong><span><%= r.due_date ? `Due ${fmt(r.due_date)}` : 'Marked urgent' %></span></div><% }) %></div><% } %>
  <details class="panel gfw-create"><summary>+ Record material blocker</summary><form method="POST" action="/workspaces/<%= ws.id %>/gap-assessment/fieldwork/blockers"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="gfw-form-grid"><label>Title<input class="input" name="title" required maxlength="220"></label><label>Priority<select class="select" name="priority"><option>normal</option><option selected>high</option><option>critical</option></select></label><label>Owner<select class="select" name="owner_id"><option value="">Unassigned</option><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></label><label>Target date<input class="input" type="date" name="due_date"></label><label class="gfw-wide">Client-safe impact statement<textarea class="textarea" name="description" rows="2" required></textarea></label></div><label class="gfw-check"><input type="checkbox" name="client_visible" value="1" checked> Show this blocker to the client</label><button class="btn btn-primary btn-sm">Record blocker</button></form></details>
  <div class="panel gfw-register"><% if (!context.manualBlockers.length) { %><div class="panel-pad meta">No explicit blockers have been recorded.</div><% } else { context.manualBlockers.forEach(row=>{ %><article><div><span><%= row.priority %> priority</span><strong><%= row.title %></strong><small><%= row.description %><%= row.due_date ? ` · Due ${fmt(row.due_date)}` : '' %></small></div><span class="status status-<%= row.status==='resolved'?'good':row.status==='open'?'bad':'neutral' %>"><%= statusLabel(row.status) %></span><details><summary>Decide</summary><form method="POST" action="/workspaces/<%= ws.id %>/gap-assessment/fieldwork/blockers/<%= row.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= row.row_version %>"><select class="select" name="status"><% ['open','resolved','accepted_risk'].forEach(s=>{ %><option value="<%= s %>" <%= row.status===s?'selected':'' %>><%= statusLabel(s) %></option><% }) %></select><textarea class="textarea" name="resolution_note" rows="2" placeholder="Required for resolution or risk acceptance"><%= row.resolution_note || '' %></textarea><button class="btn btn-secondary btn-xs">Save decision</button></form></details></article><% }) } %></div>
</section>

<section class="gfw-section" id="defaults">
  <div class="gfw-section-head"><div><span>Declared Defaults Register</span><h2>Assessment defaults and exclusions</h2><p>Defaults require a requirement reference, declaration, rationale and independent confirmation before client disclosure.</p></div></div>
  <details class="panel gfw-create"><summary>+ Propose declared default</summary><form method="POST" action="/workspaces/<%= ws.id %>/gap-assessment/fieldwork/defaults"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="gfw-form-grid"><label class="gfw-wide">Requirement<select class="select" name="requirement_id" required><option value="">Choose requirement…</option><% requirements.forEach(r=>{ %><option value="<%= r.id %>"><%= r.ref.replace('annex-a.','A.').replace('clause-','') %> · <%= r.title %></option><% }) %></select></label><label class="gfw-wide">Declaration<textarea class="textarea" name="declaration" rows="2" required></textarea></label><label class="gfw-wide">Rationale<textarea class="textarea" name="rationale" rows="2" required></textarea></label></div><label class="gfw-check"><input type="checkbox" name="client_visible" value="1" checked> Disclose after confirmation</label><button class="btn btn-primary btn-sm">Propose default</button></form></details>
  <div class="panel gfw-register"><% if (!context.defaults.length) { %><div class="panel-pad meta">No declared defaults have been recorded.</div><% } else { context.defaults.forEach(row=>{ %><article><div><span><%= row.ref.replace('annex-a.','A.').replace('clause-','') %></span><strong><%= row.declaration %></strong><small><%= row.rationale %></small></div><span class="status status-<%= row.status==='confirmed'?'good':row.status==='withdrawn'?'neutral':'warn' %>"><%= statusLabel(row.status) %></span><% if (row.status==='proposed'&&canSignoff) { %><div class="gfw-row-actions"><form method="POST" action="/workspaces/<%= ws.id %>/gap-assessment/fieldwork/defaults/<%= row.id %>/confirm"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= row.row_version %>"><button class="btn btn-primary btn-xs">Confirm</button></form><form method="POST" action="/workspaces/<%= ws.id %>/gap-assessment/fieldwork/defaults/<%= row.id %>/withdraw"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= row.row_version %>"><button class="btn btn-secondary btn-xs">Withdraw</button></form></div><% } %></article><% }) } %></div>
</section>
<% } %>

<%- include('partials/footer') %>
