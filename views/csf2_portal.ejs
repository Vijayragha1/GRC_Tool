<%- include('partials/header', { title: 'CSF assessment validation', user, ws, active: 'client-portal' }) %>
<div class="page-head"><div><a class="meta" href="/workspaces/<%= ws.id %>/client-portal">← Client action centre</a><div class="eyebrow" style="margin-top:10px;">Shared assessment</div><h1 class="page-title"><%= engagement.name %></h1><div class="page-subtitle">Validate factual accuracy. Maturity conclusions and independent approval remain the consultant's responsibility.</div></div></div>

<% if(validationRows.length){ %><section class="panel"><div class="panel-head"><h2>Conclusions awaiting validation</h2><span class="tag"><%= validationRows.length %></span></div><div class="divide-row"><% validationRows.forEach(r=>{ %><article class="csf2-client-validation"><div><code><%= r.code %></code><h3><%= r.description %></h3><p><strong>Current Profile:</strong> <%= r.current_profile_statement||'Not stated' %></p><p><strong>Business impact:</strong> <%= r.business_impact||'Not stated' %></p><div class="csf2-pair"><span>Policy <b><%= r.policy_score==null?'—':r.policy_score %></b></span><span>Practice <b><%= r.practice_score==null?'—':r.practice_score %></b></span><span>Confidence <b><%= r.evidence_confidence||'unset' %></b></span></div></div><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/portal/validate/<%= r.subcategory_id %>"><textarea class="textarea" name="note" rows="3" placeholder="Note required when requesting changes"></textarea><button class="btn btn-primary" name="decision" value="validated">Confirm factual accuracy</button><button class="btn" name="decision" value="changes_requested">Request changes</button></form></article><% }) %></div></section><% } %>

<section class="panel" style="margin-top:14px;"><div class="panel-head"><div><h2>Published reports</h2><p>Only independently approved, immutable deliverables are available here.</p></div></div><div class="divide-row"><% versions.forEach(v=>{ %><div class="csf2-version-row"><div><strong>Version <%= v.version_number %></strong><small>Published <%= v.published_at %></small></div><div><a class="btn btn-primary btn-xs" href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/exports/report.pdf?version=<%= v.id %>">Download PDF</a></div></div><% }) %><% if(!versions.length){ %><div class="empty-state"><div class="empty-title">No report published yet</div><div class="empty-sub"><%= validationRows.length?'Complete the validation requests above.':'Your consulting team will publish the controlled deliverable after review and approval.' %></div></div><% } %></div></section>
<%- include('partials/footer') %>
