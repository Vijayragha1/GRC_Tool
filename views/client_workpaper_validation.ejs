<%- include('partials/header',{ title:'Confirm shared information',user,ws,active:'client-portal' }) %>
<style>
 .cwv{max-width:820px;margin:0 auto}.cwv-hero{background:var(--ink);color:#fff;border-radius:12px;padding:25px 27px;margin-bottom:14px}.cwv-hero span{font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:rgba(255,255,255,.58)}.cwv-hero h1{font-family:var(--font-display);font-size:29px;margin:8px 0;color:#fff}.cwv-hero p{font-size:11px;line-height:1.55;color:rgba(255,255,255,.68);margin:0}.cwv-panel{border:1px solid var(--border);border-radius:8px;background:var(--surface);margin-bottom:13px;overflow:hidden}.cwv-head{padding:13px 15px;border-bottom:1px solid var(--border)}.cwv-head h2{font-size:13px;margin:0}.cwv-row{display:grid;grid-template-columns:160px minmax(0,1fr);border-bottom:1px solid var(--border);font-size:10.5px}.cwv-row:last-child{border-bottom:0}.cwv-row b{padding:11px 14px;background:var(--bg-subtle);font-size:8px;text-transform:uppercase;letter-spacing:.06em}.cwv-row div{padding:11px 14px;line-height:1.55}.cwv-body{padding:15px}.cwv textarea{width:100%;min-height:90px;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);padding:9px;font:inherit;font-size:10.5px;margin:8px 0}.cwv-actions{display:flex;gap:7px}@media(max-width:620px){.cwv-row{grid-template-columns:1fr}.cwv-row b{padding-bottom:5px}.cwv-row div{padding-top:6px}}
</style>
<div class="cwv"><header class="cwv-hero"><span>Information review · <%= workpaper.framework_code.toUpperCase() %> <%= workpaper.requirement_ref %></span><h1><%= workpaper.title %></h1><p>Please confirm that the information below accurately reflects your organisation’s process and the information your team supplied.</p></header>
 <section class="cwv-panel"><div class="cwv-head"><h2>Information to review</h2></div><div class="cwv-row"><b>Related requirement</b><div><%= workpaper.requirement_title %></div></div><div class="cwv-row"><b>How the process is described</b><div><%= workpaper.management_claim.replaceAll('_',' ') %></div></div><div class="cwv-row"><b>How it currently operates</b><div><%= workpaper.implementation_conclusion.replaceAll('_',' ') %></div></div><div class="cwv-row"><b>Summary</b><div><%= workpaper.client_visible_summary||'No summary has been provided. Please request changes.' %></div></div></section>
 <section class="cwv-panel"><div class="cwv-head"><h2>Confirm or request changes</h2></div><div class="cwv-body"><form method="POST" action="/workspaces/<%= ws.id %>/client-portal/workpapers/<%= workpaper.id %>/validate"><input type="hidden" name="_csrf" value="<%= typeof csrfToken!=='undefined'?csrfToken:'' %>"><label class="text-xs">Your note</label><textarea name="note" placeholder="Confirm the information or explain what needs to change"></textarea><div class="cwv-actions"><button name="decision" value="validate" class="btn btn-primary btn-sm">Confirm information</button><button name="decision" value="changes" class="btn btn-secondary btn-sm">Request changes</button><a href="/workspaces/<%= ws.id %>/client-portal" class="btn btn-secondary btn-sm">Back to your engagement</a></div></form></div></section>
</div>
<%- include('partials/footer') %>
