<%- include('partials/header', { title: 'Dashboard widgets', user, ws, active: 'overview' }) %>

<a href="/workspaces/<%= ws.id %>" class="link-muted" style="font-size:12px;">← Overview</a>

<div class="page-head" style="margin-top:8px">
  <div><h1 class="page-title">Customize my dashboard</h1>
    <div class="page-subtitle">Pick which widgets show up on your overview page. Order matters — first checked appears first.</div></div>
</div>

<%
  const labels = {
    readiness: 'Readiness scorecard',
    top_risks: 'Top risks by score',
    open_ncs: 'Open nonconformities',
    upcoming: 'Upcoming compliance calendar',
    ccm: 'CCM check status',
    sparkline: 'Activity sparkline (30d)'
  };
%>

<form method="POST" action="/workspaces/<%= ws.id %>/widgets" class="panel">
  <div class="panel-pad" style="display:grid;gap:10px;">
    <% allWidgets.forEach(k => { %>
      <label style="display:flex;gap:10px;align-items:center;padding:10px 14px;border:1px solid var(--border);border-radius:6px;cursor:pointer;<%= enabled.has(k) ? 'background:var(--accent-soft);border-color:var(--accent);' : '' %>">
        <input type="checkbox" name="widgets" value="<%= k %>" <%= enabled.has(k) ? 'checked' : '' %>>
        <strong style="font-size:13.5px;"><%= labels[k] || k %></strong>
      </label>
    <% }) %>
    <div><button class="btn btn-primary">Save preferences</button></div>
  </div>
</form>

<%- include('partials/footer') %>
