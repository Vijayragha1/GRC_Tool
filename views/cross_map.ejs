<%- include('partials/header', { title: 'Cross-mapping', user, ws, active: 'cross-map' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Framework cross-mapping</h1>
    <div class="page-subtitle">Reuse ISO 27001 evidence across other frameworks. Mapping is indicative — verify per your auditor's interpretation.</div>
  </div>
  <select onchange="window.location='?f='+this.value" class="select" style="width:200px">
    <option value="soc2" <%= framework==='soc2'?'selected':'' %>>SOC 2 (TSC)</option>
    <option value="nist_csf" <%= framework==='nist_csf'?'selected':'' %>>NIST CSF 2.0</option>
    <option value="gdpr" <%= framework==='gdpr'?'selected':'' %>>GDPR</option>
  </select>
</div>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr>
      <th style="width:60px">ISO</th><th>Annex A control</th>
      <th style="width:170px">Status</th><th>External reference</th>
    </tr></thead>
    <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <td class="mono meta"><%= r.id.replace('annex-', '').toUpperCase() %></td>
          <td><a href="/workspaces/<%= ws.id %>/controls/<%= r.id %>" class="link-muted" style="color:var(--text);"><%= r.title.replace(/^A\.[0-9.]+ /, '') %></a></td>
          <td><span class="status s-<%= r.status.toLowerCase().replace(/ /g,'-') %>"><%= r.status %></span></td>
          <td style="font-size:12px;font-family:ui-monospace,monospace;color:var(--text-secondary);"><% if (r.refs) { %><%= r.refs %><% } else { %><span class="meta">no mapping</span><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
