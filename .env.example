# GRC Tool — environment variables
# Copy to .env and fill in values:  cp .env.example .env

NODE_ENV=production
PORT=3000
DB_PATH=/app/data/iso27001.db
ISMS_UPLOADS_DIR=/app/uploads
ISMS_BACKUP_DIR=/app/data/backups
ISMS_BACKUP_RETAIN=14
ISMS_BACKUP_LOCK_STALE_MIN=360
# Daily schedule allows one missed hour beyond a 24-hour RPO.
ISMS_BACKUP_MAX_AGE_HOURS=26
# Optional: mount separate encrypted/off-host storage at this path first.
# BACKUP_MIRROR_DIR=/app/backup-mirror

# Runtime drain and scheduled housekeeping.
SHUTDOWN_TIMEOUT_MS=15000
ISMS_JOB_INTERVAL_MIN=60

# Required: generate with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
ISMS_MASTER_KEY=

# Evidence upload malware scanning. Production defaults to required and uses
# clamscan; set CLAMAV_BIN to clamdscan when a daemon is available.
UPLOAD_AV_MODE=required
# CLAMAV_BIN=/usr/bin/clamscan
# CLAMAV_TIMEOUT_MS=30000

# Initial admin account (used on first boot only)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_PASSWORD=

# Required only when running a demo seed in production. Use a unique password
# and rotate or disable the demo accounts before exposing the deployment.
DEMO_SEED_PASSWORD=

# Optional: AI assistant (powers the guided risk assessment). Without a key the
# app still works - AI suggestions are disabled and risks are entered manually.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# Transactional email is required for production readiness. Configure Resend,
# Brevo, or Gmail; the application selects the available provider.
# RESEND_API_KEY=
# BREVO_API_KEY=
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# EMAIL_FROM_DEFAULT="ISMS <noreply@yourdomain.com>"

# Required in production: the externally reachable HTTPS URL used in links.
# APP_BASE_URL=https://yourdomain.com

# Optional: signed Third-party risk monitoring webhook verification. Configure
# a connector with the reference env://TPRM_MONITORING_WEBHOOK_SECRET, then
# inject the secret at runtime. Secret values are never entered in the UI or
# stored in the database. Use a unique random value of at least 32 bytes.
# TPRM_MONITORING_WEBHOOK_SECRET=

# Optional: public evaluation and responsible-disclosure contacts. Configure
# these before exposing the site to prospective clients. The evaluation URL
# must use HTTPS; when omitted, the public page explains how to contact the
# organization that supplied the address.
# EVALUATION_REQUEST_URL=https://yourdomain.com/request-evaluation
# EVALUATION_CONTACT_EMAIL=evaluations@yourdomain.com
# SECURITY_CONTACT_EMAIL=security@yourdomain.com
