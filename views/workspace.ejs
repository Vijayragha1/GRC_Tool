<%- include('partials/header', { title: ws.client_name, user, ws, active: 'overview' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= ws.client_name %></h1>
    <div class="page-subtitle">
      <%= ws.industry || 'Industry not set' %>
      <% if (ws.target_cert_date) { %> · target certification <%= ws.target_cert_date %><% } %>
      · stage: <%= ws.stage.replace(/_/g, ' ') %>
    </div>
  </div>
  <div style="display:flex;gap:8px;align-items:stretch;">
    <a href="/workspaces/<%= ws.id %>/audit-pack" class="btn-headline" style="display:inline-flex;align-items:center;gap:10px;padding:10px 18px;background:linear-gradient(135deg,var(--accent) 0%,var(--accent-deep) 100%);color:#fff;border:none;border-radius:8px;text-decoration:none;font-weight:600;font-size:13.5px;box-shadow:0 1px 0 rgba(255,255,255,0.15) inset, 0 4px 12px rgba(79,70,229,0.30);transition:transform 0.12s, box-shadow 0.12s;" onmouseover="this.style.transform='translateY(-1px)';this.style.boxShadow='0 1px 0 rgba(255,255,255,0.15) inset, 0 6px 16px rgba(79,70,229,0.40)';" onmouseout="this.style.transform='';this.style.boxShadow='0 1px 0 rgba(255,255,255,0.15) inset, 0 4px 12px rgba(79,70,229,0.30)';">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      <span>Audit pack</span>
      <span style="font-size:10.5px;font-weight:500;opacity:0.78;background:rgba(255,255,255,0.14);padding:2px 7px;border-radius:999px;letter-spacing:0.02em;">.zip</span>
    </a>
    <details style="position:relative;">
      <summary class="btn btn-secondary" style="display:inline-flex;align-items:center;gap:6px;padding:10px 14px;font-size:13px;cursor:pointer;height:100%;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        More exports
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div style="position:absolute;right:0;top:calc(100% + 4px);background:var(--bg);border:1px solid var(--border);border-radius:8px;box-shadow:var(--shadow-lg);min-width:180px;z-index:50;overflow:hidden;">
        <a href="/workspaces/<%= ws.id %>/export/soa.csv" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;font-size:13px;text-decoration:none;color:var(--text);border-bottom:1px solid var(--border);" onmouseover="this.style.background='var(--bg-subtle)'" onmouseout="this.style.background=''">SoA <span class="meta" style="font-size:10.5px;">.csv</span></a>
        <a href="/workspaces/<%= ws.id %>/export/risks.csv" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;font-size:13px;text-decoration:none;color:var(--text);border-bottom:1px solid var(--border);" onmouseover="this.style.background='var(--bg-subtle)'" onmouseout="this.style.background=''">Risks <span class="meta" style="font-size:10.5px;">.csv</span></a>
        <a href="/workspaces/<%= ws.id %>/export/assets.csv" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;font-size:13px;text-decoration:none;color:var(--text);" onmouseover="this.style.background='var(--bg-subtle)'" onmouseout="this.style.background=''">Assets <span class="meta" style="font-size:10.5px;">.csv</span></a>
      </div>
    </details>
  </div>
</div>

<!-- Next-best-action banner. Reads engagement state and points at the single
     highest-leverage next step. Replaces the "where do I go from here?" gap
     a new consultant lands on the workspace overview with. -->
<% if (typeof nextStep !== 'undefined' && nextStep) { %>
  <div class="panel" style="margin-bottom:18px;border-left:4px solid var(--accent);background:linear-gradient(135deg,var(--accent-soft) 0%,var(--bg) 60%);display:grid;grid-template-columns:42px 1fr auto;gap:14px;align-items:center;padding:18px 22px;">
    <div style="width:42px;height:42px;border-radius:10px;background:var(--accent);display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"/></svg>
    </div>
    <div style="min-width:0;">
      <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent-deep);margin-bottom:2px;">Next step</div>
      <div style="font-size:15px;font-weight:600;letter-spacing:-0.01em;color:var(--ink);margin-bottom:4px;"><%= nextStep.title %></div>
      <div class="meta" style="font-size:12.5px;line-height:1.5;color:var(--text);"><%= nextStep.why %></div>
    </div>
    <a href="<%= nextStep.href %>" class="btn btn-primary" style="white-space:nowrap;"><%= nextStep.cta %> →</a>
  </div>
<% } %>

<!-- Headline KPIs -->
<%
  const s1Cls = readiness.stage1 >= 80 ? 'kpi-good' : readiness.stage1 >= 50 ? 'kpi-warn' : 'kpi-bad';
  const s2Cls = readiness.stage2 >= 80 ? 'kpi-good' : readiness.stage2 >= 50 ? 'kpi-warn' : 'kpi-bad';
  const recRatio = readiness.records.total ? readiness.records.found / readiness.records.total : 0;
  const recCls = recRatio >= 0.8 ? 'kpi-good' : recRatio >= 0.5 ? 'kpi-warn' : 'kpi-bad';
  let daysCls = 'kpi-accent';
  if (readiness.daysToTarget !== null) {
    daysCls = readiness.daysToTarget < 30 ? 'kpi-bad' : readiness.daysToTarget < 90 ? 'kpi-warn' : 'kpi-good';
  }
%>
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px;">
  <a href="/workspaces/<%= ws.id %>/readiness" class="panel kpi <%= s1Cls %>" style="text-decoration:none;color:var(--text);">
    <div class="kpi-head">
      <svg class="kpi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <div class="kpi-label">Stage 1 readiness</div>
    </div>
    <div class="kpi-num num"><%= readiness.stage1 %><span style="font-size:15px;color:var(--text-tertiary);font-weight:400;margin-left:1px;">%</span></div>
    <div class="kpi-meta"><%= readiness.flags.filter(f => f.severity==='high').length %> high-severity gap<%= readiness.flags.filter(f => f.severity==='high').length === 1 ? '' : 's' %></div>
  </a>
  <a href="/workspaces/<%= ws.id %>/readiness" class="panel kpi <%= s2Cls %>" style="text-decoration:none;color:var(--text);">
    <div class="kpi-head">
      <svg class="kpi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
      <div class="kpi-label">Stage 2 readiness</div>
    </div>
    <div class="kpi-num num"><%= readiness.stage2 %><span style="font-size:14px;color:var(--text-tertiary);font-weight:400;">%</span></div>
    <div class="kpi-meta">operational evidence</div>
  </a>
  <a href="/workspaces/<%= ws.id %>/readiness" class="panel kpi <%= recCls %>" style="text-decoration:none;color:var(--text);">
    <div class="kpi-head">
      <svg class="kpi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <div class="kpi-label">Mandatory docs</div>
    </div>
    <div class="kpi-num num"><%= readiness.records.found %><span style="color:var(--text-tertiary);font-weight:400;">/<%= readiness.records.total %></span></div>
    <div class="kpi-meta">required by ISO 27001:2022</div>
  </a>
  <div class="panel kpi <%= daysCls %>">
    <div class="kpi-head">
      <svg class="kpi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <div class="kpi-label">Days to target</div>
    </div>
    <div class="kpi-num num"><%= readiness.daysToTarget !== null ? readiness.daysToTarget : '—' %></div>
    <div class="kpi-meta"><%= ws.target_cert_date || 'no target set' %></div>
  </div>
</div>

<!-- Secondary metrics -->
<div style="display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:24px;">
  <div class="panel kpi" style="padding:12px 14px"><div style="font-size:18px;font-weight:600;letter-spacing:-0.01em" class="num"><%= progress.percent %>%</div><div class="kpi-meta">Assessed (<%= progress.assessed %>/<%= progress.total %>)</div></div>
  <div class="panel kpi" style="padding:12px 14px"><div style="font-size:18px;font-weight:600;letter-spacing:-0.01em" class="num"><%= assetCount %></div><div class="kpi-meta">Assets</div></div>
  <div class="panel kpi" style="padding:12px 14px"><div style="font-size:18px;font-weight:600;letter-spacing:-0.01em" class="num"><%= riskCount %></div><div class="kpi-meta">Risks</div></div>
  <div class="panel kpi" style="padding:12px 14px"><div style="font-size:18px;font-weight:600;letter-spacing:-0.01em" class="num"><%= docCount %></div><div class="kpi-meta">Documents</div></div>
  <div class="panel kpi" style="padding:12px 14px"><div style="font-size:18px;font-weight:600;letter-spacing:-0.01em" class="num"><%= auditCount %></div><div class="kpi-meta">Audits</div></div>
  <div class="panel kpi" style="padding:12px 14px"><div style="font-size:18px;font-weight:600;letter-spacing:-0.01em;color:<%= ncOpen > 0 ? '#b91c1c' : 'var(--text)' %>" class="num"><%= ncOpen %></div><div class="kpi-meta">Open NCs</div></div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
  <div class="panel">
    <div class="panel-head"><h2>Top open risks</h2><a href="/workspaces/<%= ws.id %>/risks" class="link-muted" style="font-size:12px">View all →</a></div>
    <% if (openRisks.length === 0) { %>
      <div class="t-empty">No open risks yet.</div>
    <% } else { %>
      <div class="divide-row">
        <% openRisks.forEach(r => { %>
          <a href="/workspaces/<%= ws.id %>/risks/<%= r.id %>" class="link-muted" style="display:flex;align-items:center;justify-content:space-between;padding:10px 16px;">
            <span style="font-size:13px"><%= r.title %></span>
            <span class="tag <%= (r.likelihood * r.impact) >= 15 ? 'tag-danger' : (r.likelihood * r.impact) >= 8 ? 'tag-warn' : 'tag-success' %> num">L<%= r.likelihood %>·I<%= r.impact %> = <%= r.likelihood*r.impact %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Open tasks</h2><a href="/workspaces/<%= ws.id %>/tasks" class="link-muted" style="font-size:12px">View all →</a></div>
    <% if (openTasks.length === 0) { %>
      <div class="t-empty">No open tasks.</div>
    <% } else { %>
      <div class="divide-row">
        <% openTasks.forEach(t => { %>
          <div style="padding:10px 16px;display:flex;align-items:center;justify-content:space-between;">
            <div style="min-width:0">
              <div style="font-size:13px;font-weight:500"><%= t.title %></div>
              <div class="meta"><%= t.assignee_name || 'unassigned' %><% if (t.due_date) { %> · due <%= t.due_date %><% } %></div>
            </div>
            <span class="status s-<%= t.status %>"><%= t.status.replace('_',' ') %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<div class="panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>30-day trends</h2><span class="meta">Daily counts</span></div>
  <div class="panel-pad" style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px;">
    <div>
      <div class="meta" style="margin-bottom:6px">Risks created</div>
      <div id="tr-risks" style="height:48px;"></div>
      <div style="font-size:11px;color:var(--text-tertiary);margin-top:4px;" id="tr-risks-tot"></div>
    </div>
    <div>
      <div class="meta" style="margin-bottom:6px">Controls implemented</div>
      <div id="tr-controls" style="height:48px;"></div>
      <div style="font-size:11px;color:var(--text-tertiary);margin-top:4px;" id="tr-controls-tot"></div>
    </div>
    <div>
      <div class="meta" style="margin-bottom:6px">NCs opened</div>
      <div id="tr-ncs-open" style="height:48px;"></div>
      <div style="font-size:11px;color:var(--text-tertiary);margin-top:4px;" id="tr-ncs-open-tot"></div>
    </div>
    <div>
      <div class="meta" style="margin-bottom:6px">NCs closed</div>
      <div id="tr-ncs-closed" style="height:48px;"></div>
      <div style="font-size:11px;color:var(--text-tertiary);margin-top:4px;" id="tr-ncs-closed-tot"></div>
    </div>
  </div>
</div>

<script>
fetch('/api/workspaces/<%= ws.id %>/trends').then(r => r.json()).then(data => {
  const drawSpark = (id, series, color) => {
    const el = document.getElementById(id);
    if (!el) return;
    const w = el.clientWidth || 200, h = 48;
    const max = Math.max(1, ...series.map(d => d.c));
    const step = w / (series.length - 1);
    const path = series.map((d, i) => `${i===0?'M':'L'}${(i*step).toFixed(1)},${(h - (d.c/max)*(h-6)).toFixed(1)}`).join(' ');
    el.innerHTML = `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" style="overflow:visible">
      <path d="${path}" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="${path} L${w},${h} L0,${h} Z" fill="${color}" opacity="0.08"/>
    </svg>`;
    document.getElementById(id + '-tot').textContent = series.reduce((s,d) => s+d.c, 0) + ' total';
  };
  drawSpark('tr-risks', data.risks, '#dc2626');
  drawSpark('tr-controls', data.controls, '#16a34a');
  drawSpark('tr-ncs-open', data.ncs_open, '#dc2626');
  drawSpark('tr-ncs-closed', data.ncs_closed, '#16a34a');
});
</script>

<div class="panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>Action items</h2><span class="meta">Not / Partially Implemented</span></div>
  <% if (actionItems.length === 0) { %>
    <div class="t-empty">Nothing flagged.</div>
  <% } else { %>
    <div class="divide-row">
      <% actionItems.forEach(a => { %>
        <a href="/workspaces/<%= ws.id %>/controls/<%= a.id %>" class="link-muted" style="display:flex;align-items:center;justify-content:space-between;padding:8px 16px;font-size:13px;">
          <span><%= a.title %></span>
          <span class="status s-<%= a.status.toLowerCase().replace(/ /g,'-') %>"><%= a.status %></span>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<div class="panel">
  <div class="panel-head">
    <div style="display:flex;align-items:center;gap:14px;">
      <h2>Recent activity</h2>
      <% const maxC = Math.max(1, ...sparkline.map(d => d.c)); const w = 180; const h = 28; const step = w / (sparkline.length - 1); %>
      <svg class="spark" width="<%= w %>" height="<%= h %>" viewBox="0 0 <%= w %> <%= h %>" preserveAspectRatio="none" style="overflow:visible">
        <path d="<%= sparkline.map((d, i) => `${i===0?'M':'L'}${(i*step).toFixed(1)},${(h - (d.c/maxC)*(h-4)).toFixed(1)}`).join(' ') %>" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="<%= sparkline.map((d, i) => `${i===0?'M':'L'}${(i*step).toFixed(1)},${(h - (d.c/maxC)*(h-4)).toFixed(1)}`).join(' ') %> L<%= w %>,<%= h %> L0,<%= h %> Z" fill="var(--accent)" opacity="0.08"/>
      </svg>
      <span class="meta">30-day events</span>
    </div>
    <a href="/workspaces/<%= ws.id %>/activity" class="link-muted" style="font-size:12px">Full audit log →</a>
  </div>
  <% if (recentActivity.length === 0) { %>
    <div class="t-empty">No activity yet.</div>
  <% } else { %>
    <div class="divide-row">
      <% recentActivity.forEach(a => { %>
        <div style="padding:8px 16px;display:flex;align-items:center;justify-content:space-between;font-size:13px;">
          <span><span style="font-weight:500"><%= a.user_name %></span> <span style="color:var(--text-secondary);"><%= a.action.replace(/_/g, ' ') %></span> <span class="meta"><%= a.entity_type || '' %></span></span>
          <span class="meta num"><%= a.created_at %></span>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<details id="workspace-settings" style="margin-top:24px">
  <summary class="link-muted" style="font-size:13px;">Workspace settings</summary>
  <div class="panel panel-pad" style="margin-top:8px">
    <form method="POST" action="/workspaces/<%= ws.id %>/update" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div><label class="label">Client name</label><input class="input" name="client_name" value="<%= ws.client_name %>" required></div>
      <div><label class="label">Industry</label><input class="input" name="industry" value="<%= ws.industry || '' %>"></div>
      <div style="grid-column:1/-1"><label class="label">Scope</label><input class="input" id="scope-input" name="scope" value="<%= ws.scope || '' %>"></div>
      <div><label class="label">Target cert date</label><input class="input" name="target_cert_date" type="date" value="<%= ws.target_cert_date || '' %>"></div>
      <div><label class="label">Stage</label>
        <select class="select" name="stage">
          <% ['gap_assessment','risk_assessment','implementation','internal_audit','stage_1','stage_2','certified','surveillance'].forEach(s => { %>
            <option value="<%= s %>" <%= ws.stage === s ? 'selected' : '' %>><%= s.replace(/_/g, ' ') %></option>
          <% }) %>
        </select>
      </div>

      <div style="grid-column:1/-1;margin-top:6px;padding-top:14px;border-top:1px solid var(--border);">
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-tertiary);margin-bottom:6px;">Branding & sector</div>
        <div class="meta" style="font-size:11.5px;margin-bottom:10px;">Customise per-client without a code change. Used in the sidebar workspace block, the dashboard chip, and DOCX cover pages (when set).</div>
      </div>
      <div><label class="label">Display name (overrides client_name on cover pages)</label><input class="input" name="brand_display_name" value="<%= ws.brand_display_name || '' %>" placeholder="e.g., Acme Health Tech Inc."></div>
      <div><label class="label">Sector</label>
        <select class="select" name="sector">
          <% const sectors = ['','SaaS','Fintech','Healthcare','Manufacturing','Public sector','MSP','Retail','Education','Other']; sectors.forEach(s => { %>
            <option value="<%= s %>" <%= (ws.sector || '') === s ? 'selected' : '' %>><%= s || '— none —' %></option>
          <% }) %>
        </select>
      </div>
      <div><label class="label">Primary color (#RRGGBB)</label>
        <div style="display:flex;gap:8px;align-items:center;">
          <input class="input" name="brand_primary_color" value="<%= ws.brand_primary_color || '' %>" placeholder="#0ea5e9" pattern="^#[0-9a-fA-F]{6}$" style="flex:1;font-family:monospace;">
          <% if (ws.brand_primary_color) { %>
            <span style="display:inline-block;width:32px;height:32px;border-radius:6px;background:<%= ws.brand_primary_color %>;border:1px solid var(--border);"></span>
          <% } %>
        </div>
      </div>
      <div><label class="label">Logo URL (path or full URL)</label><input class="input" name="brand_logo_path" value="<%= ws.brand_logo_path || '' %>" placeholder="https://…/logo.png"></div>

      <div style="grid-column:1/-1"><button class="btn btn-primary">Save</button></div>
    </form>
    <div style="margin-top:18px;padding-top:14px;border-top:1px solid var(--border);">
      <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--danger,#b91c1c);margin-bottom:8px;">Danger zone</div>
      <details>
        <summary style="cursor:pointer;font-size:13px;color:var(--danger,#b91c1c);">Delete this client engagement</summary>
        <div style="margin-top:10px;padding:12px;border:1px solid var(--danger,#b91c1c);border-radius:6px;background:rgba(185,28,28,0.04);">
          <div class="meta" style="font-size:12px;line-height:1.5;margin-bottom:10px;">
            Permanently removes this workspace and everything inside it: controls, gap-assessment passes, risks, evidence files (on disk and in DB), audits, MRMs, NCs, incidents, suppliers, documents, registers. Cannot be undone.
          </div>
          <form method="POST" action="/workspaces/<%= ws.id %>/delete" onsubmit="return appConfirmForm(event, 'Final check: delete &quot;<%= ws.client_name %>&quot; and everything under it?');">
            <label class="label" style="font-size:12px;">Type <strong><%= ws.client_name %></strong> to confirm</label>
            <input class="input" name="confirm_name" required autocomplete="off" style="max-width:320px;margin-bottom:10px;">
            <div><button class="btn btn-xs" style="background:var(--danger,#b91c1c);color:#fff;border-color:var(--danger,#b91c1c);">Delete client engagement</button></div>
          </form>
        </div>
      </details>
    </div>
  </div>
</details>

<script>
  // Open the Workspace-settings <details> AND focus the scope input when
  // arriving via #workspace-settings. Lands the user on the field they came
  // to edit, not on the summary line above an unopened collapsible.
  (function () {
    const focusScope = () => {
      if (window.location.hash !== '#workspace-settings') return;
      const det = document.getElementById('workspace-settings');
      const inp = document.getElementById('scope-input');
      if (det) det.open = true;
      // Two animation frames so the details has finished rendering its expanded
      // size before we scroll, otherwise the browser scrolls to a wrong offset
      // computed against the collapsed height.
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (inp) {
          inp.scrollIntoView({ behavior: 'smooth', block: 'center' });
          inp.focus({ preventScroll: true });
          inp.select();
        }
      }));
    };
    focusScope();
    window.addEventListener('hashchange', focusScope);
  })();
</script>

<%- include('partials/footer') %>
