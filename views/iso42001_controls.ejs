<%- include('partials/header', { title: 'ISO 42001 controls', user, ws, active: 'iso42001-controls' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">ISO 42001 controls & clauses</h1>
    <div class="page-subtitle">27 clauses (4-10) and 38 Annex A controls. Bulk-edit with checkboxes or click into a control to assess.</div>
  </div>
  <form method="GET" style="display:flex;gap:6px;align-items:center;">
    <a href="/workspaces/<%= ws.id %>/iso42001/gap" class="btn btn-primary btn-xs" title="Walk clauses + Annex A one item at a time with prompts">▶ Start gap assessment</a>
    <input class="input" name="q" placeholder="Search…" value="<%= search %>" style="width:200px">
    <select name="filter" class="select" style="width:240px" onchange="this.form.submit()">
      <option value="all" <%= filter==='all'?'selected':'' %>>All items</option>
      <option value="clauses" <%= filter==='clauses'?'selected':'' %>>Clauses (4-10)</option>
      <option value="annex" <%= filter==='annex'?'selected':'' %>>Annex A only</option>
      <option value="a-policies" <%= filter==='a-policies'?'selected':'' %>>A.2 Policies related to AI</option>
      <option value="b-internal-organization" <%= filter==='b-internal-organization'?'selected':'' %>>A.3 Internal organization</option>
      <option value="c-resources" <%= filter==='c-resources'?'selected':'' %>>A.4 Resources</option>
      <option value="d-impact-assessment" <%= filter==='d-impact-assessment'?'selected':'' %>>A.5 Impact assessment</option>
      <option value="e-lifecycle" <%= filter==='e-lifecycle'?'selected':'' %>>A.6 Life cycle</option>
      <option value="f-data" <%= filter==='f-data'?'selected':'' %>>A.7 Data</option>
      <option value="g-information" <%= filter==='g-information'?'selected':'' %>>A.8 Interested parties</option>
      <option value="h-use" <%= filter==='h-use'?'selected':'' %>>A.9 Use</option>
      <option value="i-third-party" <%= filter==='i-third-party'?'selected':'' %>>A.10 Third-party</option>
      <option value="open" <%= filter==='open'?'selected':'' %>>Needs attention</option>
    </select>
    <button class="btn btn-secondary">Apply</button>
  </form>
</div>

<form method="POST" action="/workspaces/<%= ws.id %>/iso42001/bulk-controls" id="bulkForm">
  <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
  <div id="bulkBar" class="hidden panel" style="padding:8px 12px;margin-bottom:12px;display:flex;align-items:center;gap:8px;font-size:13px;background:var(--bg-subtle);position:sticky;top:0;z-index:10;">
    <span><span id="bulkCount">0</span> selected</span>
    <span class="text-tertiary">·</span>
    <select name="status" class="select" style="width:200px;font-size:12px;padding:4px 8px;">
      <option value="">Set status…</option>
      <% ['Not Assessed','Implemented','Partially Implemented','Work In Progress','Not Implemented','Not Applicable'].forEach(s => { %>
        <option value="<%= s %>"><%= s %></option>
      <% }) %>
    </select>
    <select name="applicability" class="select" style="width:170px;font-size:12px;padding:4px 8px;">
      <option value="">Applicability…</option>
      <option value="undecided">Undecided</option>
      <option value="included">Included</option>
      <option value="excluded">Excluded</option>
    </select>
    <button class="btn btn-primary btn-xs">Apply</button>
    <button type="button" onclick="clearSel()" class="btn btn-ghost btn-xs">Clear</button>
  </div>

  <div class="panel" style="overflow:hidden">
    <table class="t">
      <thead><tr>
        <th style="width:36px;padding-right:0"><input type="checkbox" onclick="toggleAll(this)"></th>
        <th style="width:80px;">ID</th>
        <th>Title</th>
        <th style="width:170px;">Status</th>
        <th style="width:90px;">Maturity</th>
        <th style="width:140px;">Owner</th>
        <th style="width:110px;">Due</th>
      </tr></thead>
      <tbody>
        <% rows.forEach(r => { %>
          <tr>
            <td style="padding-right:0"><input type="checkbox" name="ids" value="<%= r.id %>" class="bulkChk" onclick="updBulk()"></td>
            <td><span class="mono" style="font-size:11px;color:var(--text-tertiary);">
              <%= r.type === 'clause' ? '§' + r.id.replace('ai-clause-', '') : r.id.replace('ai-annex-', '').toUpperCase().replace(/-/g, '.') %>
            </span></td>
            <td><a href="/workspaces/<%= ws.id %>/iso42001/controls/<%= r.id %>" class="link-muted"><%= r.title.replace(/^(A\.[0-9.]+|[0-9.]+) /, '') %></a></td>
            <td><span class="status s-<%= r.status.toLowerCase().replace(/ /g,'-') %>"><%= r.status %></span></td>
            <td class="num text-secondary"><%= r.maturity || 0 %>/5</td>
            <td style="color:var(--text-secondary);font-size:12px;"><%= r.owner_name || '-' %></td>
            <td class="num meta"><%= r.due_date || '-' %></td>
          </tr>
        <% }) %>
        <% if (rows.length === 0) { %>
          <tr><td colspan="7" class="t-empty">No items match this filter.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</form>

<script>
function updBulk(){
  const n = document.querySelectorAll('.bulkChk:checked').length;
  document.getElementById('bulkCount').textContent = n;
  document.getElementById('bulkBar').classList.toggle('hidden', n === 0);
}
function toggleAll(el){
  document.querySelectorAll('.bulkChk').forEach(c => c.checked = el.checked);
  updBulk();
}
function clearSel(){
  document.querySelectorAll('.bulkChk').forEach(c => c.checked = false);
  updBulk();
}
</script>

<%- include('partials/footer') %>
