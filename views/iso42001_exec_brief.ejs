<%- include('partials/header', { title: 'ISO 42001 exec brief', user, ws, active: 'iso42001-exec-brief' }) %>

<style>
  .exec-num { font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  @media print {
    .sidebar, .topbar, .no-print { display: none !important; }
    .main-inner { padding: 12mm !important; max-width: none !important; }
    .panel { box-shadow: none !important; border: 1px solid #ccc !important; page-break-inside: avoid; margin-bottom: 8mm !important; }
    body { font-size: 10.5px; }
    .exec-num { font-size: 22px !important; }
  }

  /* Microtype floor for phones. This block is scoped to the view because a
     view style tag loads after app.css and would otherwise win. Only the
     selectors declared below 11px above are listed. */
  @media (max-width: 760px) {
    body
    { font-size: 11px; }
    .iso42-exec-kpis { grid-template-columns:repeat(2,minmax(0,1fr)) !important; }
    .iso42-exec-pair { grid-template-columns:minmax(0,1fr) !important; }
    .iso42-exec-pair .panel { min-width:0; }
  }
  @media (max-width:430px) {
    .iso42-exec-kpis { grid-template-columns:minmax(0,1fr) !important; }
  }
</style>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= ws.client_name %> - ISO 42001 Executive brief</h1>
    <div class="page-subtitle">One-page health summary for the sponsor / board. Prints to one A4. Generated <%= new Date().toISOString().slice(0, 10) %>.</div>
  </div>
  <button onclick="window.print()" class="btn btn-secondary btn-xs no-print">Print</button>
</div>

<!-- Top KPI band -->
<div class="iso42-exec-kpis" style="display:grid;grid-template-columns:repeat(4, 1fr);gap:10px;margin-bottom:14px;">
  <%
    const s1Color = readiness.stage1 >= 80 ? '#15803d' : readiness.stage1 >= 50 ? '#a16207' : '#b91c1c';
    const s2Color = readiness.stage2 >= 80 ? '#15803d' : readiness.stage2 >= 50 ? '#a16207' : '#b91c1c';
    let velColor = '#a16207';
    if (velocityNow > velocityPrior) velColor = '#15803d';
    else if (velocityNow < velocityPrior && velocityNow < 3) velColor = '#b91c1c';
    const aleColor = residualAle > 1000000 ? '#b91c1c' : residualAle > 250000 ? '#a16207' : '#15803d';
  %>
  <div class="panel kpi" style="padding:12px 14px;">
    <div class="kpi-label text-eyebrow">Stage 1 readiness</div>
    <div class="kpi-num exec-num" style="color:<%= s1Color %>"><%= readiness.stage1 %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-meta">target ≥ 80% before Stage 1 audit</div>
  </div>
  <div class="panel kpi" style="padding:12px 14px;">
    <div class="kpi-label text-eyebrow">Stage 2 readiness</div>
    <div class="kpi-num exec-num" style="color:<%= s2Color %>"><%= readiness.stage2 %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-meta">3 months operational evidence required</div>
  </div>
  <div class="panel kpi" style="padding:12px 14px;">
    <div class="kpi-label text-eyebrow">Velocity (last 30d)</div>
    <div class="kpi-num exec-num" style="color:<%= velColor %>"><%= velocityNow %><span class="text-lg text-tertiary" style="font-weight:400;"> moved to Implemented</span></div>
    <div class="kpi-meta">prev 30d: <%= velocityPrior %> &middot; <%= velocityDelta >= 0 ? '+' : '' %><%= velocityDelta %> change</div>
  </div>
  <div class="panel kpi" style="padding:12px 14px;">
    <div class="kpi-label text-eyebrow">Residual annual loss</div>
    <div class="kpi-num exec-num" style="color:<%= aleColor %>">$<%= residualAle.toLocaleString() %></div>
    <div class="kpi-meta">ALE = Σ (likelihood/5 × impact × $50k) over <%= openRiskCount %> open risks</div>
  </div>
</div>

<!-- Plan + days-to-target band -->
<div class="iso42-exec-pair" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;">
  <div class="panel" style="padding:12px 14px;">
    <div class="text-xs text-tertiary" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">Client plan</div>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:14px;">
      <div>
        <div class="exec-num" style="font-size:22px;font-weight: 500;"><%= planDone %><span class="text-xl text-tertiary" style="font-weight:400;">/<%= planTotal %></span></div>
        <div class="kpi-meta">phases complete &middot; <%= planPct %>%</div>
      </div>
      <div style="flex:1;height:6px;background:var(--bg-subtle);border-radius:3px;overflow:hidden;">
        <div style="height:100%;background:var(--accent);width:<%= planPct %>%;"></div>
      </div>
    </div>
  </div>
  <div class="panel" style="padding:12px 14px;">
    <div class="text-xs text-tertiary" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">Cert target</div>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:14px;">
      <div>
        <div class="exec-num" style="font-size:22px;font-weight: 500;color:<%= readiness.daysToTarget !== null && readiness.daysToTarget < 30 ? '#b91c1c' : 'var(--text)' %>"><%= readiness.daysToTarget !== null ? readiness.daysToTarget : '-' %><span class="text-xl text-tertiary" style="font-weight:400;"> days</span></div>
        <div class="kpi-meta"><%= ws.target_cert_date || 'no target set' %></div>
      </div>
      <div class="text-xs text-secondary" style="text-align:right;line-height:1.5;">
        Open NCs: <strong><%= ncTotals.major %></strong> major / <strong><%= ncTotals.minor %></strong> minor<br>
        Overdue: <strong style="color:<%= ncTotals.overdue ? '#b91c1c' : 'var(--text)' %>;"><%= ncTotals.overdue %></strong>
      </div>
    </div>
  </div>
</div>

<!-- Top risks + top NCs -->
<div class="iso42-exec-pair" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px;">
  <div class="panel">
    <div class="panel-head" style="padding:10px 14px;"><h2 class="text-lg" style="margin:0;">Top 5 open AI risks</h2></div>
    <% if (topRisks.length === 0) { %>
      <div class="t-empty text-base" style="padding:20px;">No open risks linked to ISO 42001.</div>
    <% } else { %>
      <table class="t text-sm">
        <thead><tr><th style="padding:6px 14px;">Risk</th><th style="width:70px;text-align:right;padding:6px 14px;">L×I</th><th style="width:90px;padding:6px 14px;">Owner</th></tr></thead>
        <tbody>
          <% topRisks.forEach(r => { %>
            <tr>
              <td style="padding:6px 14px;"><%= r.title %></td>
              <td class="num" style="text-align:right;padding:6px 14px;font-weight: 500;color:<%= r.score >= 15 ? '#b91c1c' : r.score >= 8 ? '#a16207' : 'var(--text)' %>;"><%= r.likelihood %>×<%= r.impact %>=<%= r.score %></td>
              <td class="meta text-eyebrow" style="padding:6px 14px;"><%= r.owner_name || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
  <div class="panel">
    <div class="panel-head" style="padding:10px 14px;"><h2 class="text-lg" style="margin:0;">Top open nonconformities</h2></div>
    <% if (topNCs.length === 0) { %>
      <div class="t-empty text-base" style="padding:20px;">No open NCs - clean bill of health.</div>
    <% } else { %>
      <table class="t text-sm">
        <thead><tr><th style="padding:6px 14px;">Finding</th><th style="width:60px;padding:6px 14px;">Sev</th><th style="width:85px;text-align:right;padding:6px 14px;">Due</th></tr></thead>
        <tbody>
          <% topNCs.forEach(n => { %>
            <tr>
              <td style="padding:6px 14px;"><%= n.title %></td>
              <td style="padding:6px 14px;"><span class="status s-<%= n.severity || 'other' %> text-xxs"><%= n.severity || '-' %></span></td>
              <td class="num meta" style="text-align:right;padding:6px 14px;font-size:10.5px;color:<%= n.due_date && n.due_date < new Date().toISOString().slice(0,10) ? '#b91c1c' : 'var(--text-tertiary)' %>;"><%= n.due_date || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<!-- Footer note -->
<div class="panel text-xs text-secondary" style="padding:10px 14px;background:var(--bg-subtle);line-height:1.5;">
  <strong>Reading the numbers:</strong>
  Stage 1 readiness blends clauses 4-10 and policy/governance Annex A controls (A.2, A.3, A.5) at Implemented. Stage 2 adds operational Annex A controls (A.4, A.6, A.7, A.8, A.9, A.10) that are Included. Velocity is the count of items moved to "Implemented" in the last 30 days, from the assessment history. Residual ALE is a heuristic - actuals depend on impact tiers your insurer assigns. Generated automatically; refresh by re-loading.
</div>

<%- include('partials/footer') %>
