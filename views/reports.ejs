<%- include('partials/header', { title: 'Reports', user, ws, active: 'reports' }) %>

<div class="page-head">
  <div><h1 class="page-title">Reports</h1>
    <div class="page-subtitle">Client deliverables (DOCX/ZIP) and reusable markdown templates with <code>{{placeholders}}</code>.</div></div>
</div>

<!-- Client deliverables - the four artefacts the consultant produces and hands off. -->
<div class="panel" style="margin-bottom:14px;">
  <div class="panel-head">
    <h2>Client deliverables <span class="meta text-lg" style="font-weight:400;">- client-facing handoff artefacts</span></h2>
  </div>
  <div class="panel-pad" style="display:grid;grid-template-columns:repeat(2, 1fr);gap:10px;">
    <a href="/workspaces/<%= ws.id %>/export/gap-report.docx" class="panel" style="padding:14px;text-decoration:none;">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <strong class="text-xl">Gap Assessment Report</strong>
        <span class="tag tag-info text-xxs" style="margin-left:auto;">.docx</span>
      </div>
      <div class="meta text-sm" style="margin-top:6px;line-height:1.45;">Per-pass deliverable: executive summary, gaps identified, full assessment results. The end-of-pass artefact for the client.</div>
    </a>
    <a href="/workspaces/<%= ws.id %>/export/recommendations.docx" class="panel" style="padding:14px;text-decoration:none;">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <strong class="text-xl">Recommendations memo</strong>
        <span class="tag tag-info text-xxs" style="margin-left:auto;">.docx</span>
      </div>
      <div class="meta text-sm" style="margin-top:6px;line-height:1.45;">Ranked remediation list with consultant notes for each item - the worklist you hand to the client.</div>
    </a>
    <a href="/workspaces/<%= ws.id %>/export/rtp.docx" class="panel" style="padding:14px;text-decoration:none;">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <strong class="text-xl">Risk Treatment Plan</strong>
        <span class="tag tag-info text-xxs" style="margin-left:auto;">.docx</span>
      </div>
      <div class="meta text-sm" style="margin-top:6px;line-height:1.45;">Clause 6.1.3.e RTP - every risk with treatment, owner, controls, actions. Audit-grade.</div>
    </a>
    <a href="/workspaces/<%= ws.id %>/export/readiness-pack.zip?stage=1" class="panel" style="padding:14px;text-decoration:none;background:var(--accent-soft);">
      <div style="display:flex;align-items:center;gap:10px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent-deep)" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        <strong class="text-xl" style="color:var(--accent-deep);">Stage 1 / 2 readiness pack</strong>
        <span class="tag tag-accent text-xxs" style="margin-left:auto;">.zip</span>
      </div>
      <div class="meta text-sm" style="margin-top:6px;line-height:1.45;color:var(--accent-deep);">Single ZIP with SoA · RTP · audits · MRMs · interested parties · objectives · evidence manifest + every active evidence file. The auditor's package.</div>
    </a>
  </div>
  <div class="panel-pad text-sm text-secondary" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
    Tip: the <strong>readiness pack</strong> is the single artefact to hand the certification body. The other three deliverables are for the client during delivery.
  </div>
</div>

<div class="text-xs text-tertiary" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;margin:24px 0 8px;">Markdown report templates</div>

<div class="panel" style="margin-bottom:14px">
  <div class="panel-head"><h2>Add custom report template</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/reports" class="panel-pad" style="display:grid;gap:10px;">
    <div style="display:grid;grid-template-columns:1fr 2fr;gap:10px;">
      <div><label class="label">Name</label><input class="input" name="name" required></div>
      <div><label class="label">Description</label><input class="input" name="description"></div>
    </div>
    <div><label class="label">Body (markdown, supports {{placeholders}})</label><textarea class="textarea mono" name="body" rows="6" required></textarea></div>
    <div><button class="btn btn-primary btn-xs">Save template</button></div>
  </form>
</div>

<div class="panel"><table class="t">
  <thead><tr><th>Name</th><th>Source</th><th>Description</th><th></th></tr></thead>
  <tbody>
    <% list.forEach(r => { %>
      <tr>
        <td><a href="/workspaces/<%= ws.id %>/reports/<%= r.id %>" class="link-muted" style="font-weight:500;"><%= r.name %></a></td>
        <td><% if (r.is_system) { %><span class="tag tag-info">system</span><% } else { %><span class="tag tag-neutral">custom</span><% } %></td>
        <td class="meta" style="max-width:480px;"><%= r.description %></td>
        <td><a href="/workspaces/<%= ws.id %>/reports/<%= r.id %>/docx" class="btn btn-accent btn-xs">.docx</a></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>

<%- include('partials/footer') %>
