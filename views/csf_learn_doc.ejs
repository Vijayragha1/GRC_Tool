<%- include('partials/header', { title: doc.title, user, ws, active: 'csf-learn' }) %>

<div class="page-head">
  <div>
    <div style="display:flex;align-items:center;gap:10px;">
      <a href="/workspaces/<%= ws.id %>/csf/learn" class="meta text-base" style="text-decoration:none;">&larr; Learn</a>
    </div>
    <h1 class="page-title" style="margin-top:6px;"><%= doc.title %></h1>
    <% if (doc.summary) { %><div class="page-subtitle"><%= doc.summary %></div><% } %>
  </div>
</div>

<div style="display:grid;grid-template-columns:3fr 1fr;gap:14px;">
  <div class="panel">
    <div class="panel-pad markdown-body" style="font-size:13.5px;line-height:1.65;">
      <%- html %>
    </div>
  </div>

  <% if (otherDocs.length) { %>
    <div>
      <div class="panel">
        <div class="panel-head"><h2>Other docs</h2></div>
        <div class="divide-row">
          <% otherDocs.forEach(o => { %>
            <a class="text-lg" href="/workspaces/<%= ws.id %>/csf/learn/<%= o.slug %>" style="display:block;padding:8px 14px;text-decoration:none;line-height:1.4;">
              <%= o.title %>
            </a>
          <% }) %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<style>
  .markdown-body h1 { font-size: 20px; margin: 24px 0 12px; font-weight: 500; }
  .markdown-body h1:first-child { margin-top: 0; }
  .markdown-body h2 { font-size: 16px; margin: 20px 0 8px; font-weight: 500; }
  .markdown-body h3 { font-size: 14px; margin: 16px 0 6px; font-weight: 500; }
  .markdown-body p { margin: 8px 0; }
  .markdown-body ul, .markdown-body ol { margin: 8px 0; padding-left: 22px; }
  .markdown-body li { margin: 4px 0; }
  .markdown-body code { background: var(--bg-subtle); padding: 1px 4px; border-radius: 3px; font-size: 12.5px; }
  .markdown-body blockquote { margin: 10px 0; padding: 6px 12px; border-left: 3px solid var(--border-strong); color: var(--text-secondary); }
</style>

<%- include('partials/footer') %>
