<%- include('partials/header', { title: `${detail.code} assessment`, user, ws, active: 'csf' }) %>
<div class="page-head"><div><a class="meta" href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assessment">← All 106 outcomes</a><div class="eyebrow" style="margin-top:10px;"><%= detail.function_name %> · <%= detail.category_name %></div><h1 class="page-title"><code><%= detail.code %></code> <%= detail.description %></h1><div class="page-subtitle">Outcome-focused assessment · <%= detail.methodology_version %></div></div><span class="status-pill"><%= detail.status %></span></div>
<%- include('partials/csf2_nav', { section: 'assessment', ws, engagement }) %>

<% if (defects.length) { %><div class="csf2-callout warning"><strong>Not conclusion-ready</strong><ul><% defects.forEach(d=>{ %><li><%= d %></li><% }) %></ul></div><% } %>

<section class="panel csf2-guidance"><div class="panel-head"><div><h2>Decision guidance</h2><p>Use NIST's outcome as the result to be achieved; use the indicators below to form an evidence-backed conclusion.</p></div><span class="tag">Content hash <%= method.content_hash.slice(0,10) %>…</span></div>
  <div class="panel-pad csf2-guidance-grid"><div><h3>NIST Implementation Examples</h3><ul><% methodData.implementation_examples.forEach(x=>{ %><li><%= x %></li><% }) %></ul></div><div><h3>Failure indicators</h3><ul><% method.failure_indicators.forEach(x=>{ %><li><%= x %></li><% }) %></ul></div><div><h3>Interview roles</h3><div class="chip-wrap"><% method.interview_roles.forEach(x=>{ %><span class="tag"><%= x %></span><% }) %></div></div><div><h3>Useful measures</h3><ul><% method.measures.forEach(x=>{ %><li><%= x %></li><% }) %></ul></div></div>
</section>

<form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assessment/<%= detail.subcategory_id %>" class="csf2-score-form">
  <input type="hidden" name="row_version" value="<%= detail.row_version %>">
  <section class="panel"><div class="panel-head"><div><h2>Profile and applicability</h2><p>Record why this outcome matters and the target state selected for this scope.</p></div></div><div class="panel-pad csf2-form-grid">
    <label class="field"><span>Applicability</span><select class="select" name="applicability_status"><option value="in_scope" <%= detail.applicability_status==='in_scope'?'selected':'' %>>In scope</option><option value="not_applicable" <%= detail.applicability_status==='not_applicable'?'selected':'' %>>Not applicable</option></select></label>
    <label class="field"><span>Profile priority</span><select class="select" name="profile_priority"><% priorities.forEach(v=>{ %><option value="<%= v %>" <%= detail.profile_priority===v?'selected':'' %>><%= v %></option><% }) %></select></label>
    <label class="field span-2"><span>Current Profile statement</span><textarea class="textarea" name="current_profile_statement" rows="3"><%= detail.current_profile_statement||'' %></textarea></label>
    <label class="field span-2"><span>Target Profile statement</span><textarea class="textarea" name="target_profile_statement" rows="3"><%= detail.target_profile_statement||'' %></textarea></label>
    <label class="field span-2"><span>Business impact and risk relevance</span><textarea class="textarea" name="business_impact" rows="3"><%= detail.business_impact||'' %></textarea></label>
    <label class="field span-2"><span>Not-applicable rationale</span><textarea class="textarea" name="exclusion_rationale" rows="3"><%= detail.exclusion_rationale||'' %></textarea></label>
  </div></section>

  <div class="csf2-axis-grid">
    <% [['policy','Policy maturity','Governance, requirements, ownership, institutionalization'],['practice','Practice maturity','Implementation, consistency, testing, and effectiveness']].forEach(([axis,label,sub])=>{ const anchors=axis==='policy'?method.policy_anchors:method.practice_anchors; %>
    <section class="panel csf2-axis <%= axis %>"><div class="panel-head"><div><div class="eyebrow"><%= axis %> axis</div><h2><%= label %></h2><p><%= sub %></p></div><span class="csf2-axis-score"><%= detail[axis+'_score']==null?'—':detail[axis+'_score'] %></span></div>
      <div class="panel-pad"><label class="field"><span>Current level</span><div class="csf2-level-options"><% levels.forEach(l=>{ %><label><input type="radio" name="<%= axis %>_score" value="<%= l.level %>" <%= Number(detail[axis+'_score'])===l.level?'checked':'' %>><b><%= l.level %></b><span><strong><%= l.name %></strong><small><%= l.short %></small></span></label><% }) %></div></label>
        <div class="csf2-selected-anchor"><strong>Required interpretation</strong><% levels.forEach(l=>{ %><p data-axis="<%= axis %>" data-level="<%= l.level %>" class="<%= Number(detail[axis+'_score'])===l.level?'':'is-hidden' %>"><%= anchors[l.level] %></p><% }) %></div>
        <label class="field"><span><%= label %> rationale</span><textarea class="textarea" name="<%= axis %>_rationale" rows="7" placeholder="State the conclusion, scope, evidence considered, exceptions, and why the selected anchor is met."><%= detail[axis+'_rationale']||'' %></textarea></label>
        <label class="field"><span><%= label %> owner</span><input class="input" name="<%= axis %>_owner" value="<%= detail[axis+'_owner']||'' %>"></label>
        <label class="field"><span>Target <%= axis %> level</span><select class="select" name="target_<%= axis %>_score"><option value="">Select target</option><% levels.forEach(l=>{ %><option value="<%= l.level %>" <%= Number(detail['target_'+axis+'_score'])===l.level?'selected':'' %>><%= l.level %> · <%= l.name %></option><% }) %></select></label>
        <div class="csf2-evidence-expectation"><strong>Expected evidence</strong><ul><% (axis==='policy'?method.policy_evidence:method.practice_evidence).forEach(x=>{ %><li><%= x %></li><% }) %></ul></div>
      </div></section>
    <% }) %>
  </div>

  <section class="panel"><div class="panel-head"><div><h2>Assurance conclusion and sampling</h2><p>Maturity, effectiveness, and evidence confidence are separate decisions.</p></div></div><div class="panel-pad csf2-form-grid">
    <label class="field"><span>Assurance outcome</span><select class="select" name="assurance_outcome"><% assuranceOutcomes.forEach(v=>{ %><option value="<%= v %>" <%= detail.assurance_outcome===v?'selected':'' %>><%= v.replaceAll('_',' ') %></option><% }) %></select></label>
    <label class="field"><span>Evidence confidence</span><select class="select" name="evidence_confidence"><option value="">Select</option><% ['low','medium','high'].forEach(v=>{ %><option value="<%= v %>" <%= detail.evidence_confidence===v?'selected':'' %>><%= v %></option><% }) %></select></label>
    <label class="field"><span>Assessment period start</span><input class="input" type="date" name="assessment_period_start" value="<%= detail.assessment_period_start||'' %>"></label><label class="field"><span>Assessment period end</span><input class="input" type="date" name="assessment_period_end" value="<%= detail.assessment_period_end||'' %>"></label>
    <label class="field span-2"><span>Population description</span><textarea class="textarea" name="population_description" rows="3"><%= detail.population_description||'' %></textarea></label>
    <label class="field"><span>Population size</span><input class="input" type="number" min="0" name="population_size" value="<%= detail.population_size==null?'':detail.population_size %>"></label><label class="field"><span>Sample size</span><input class="input" type="number" min="0" name="sample_size" value="<%= detail.sample_size==null?'':detail.sample_size %>"></label>
    <label class="field span-2"><span>Sampling rationale</span><textarea class="textarea" name="sample_rationale" rows="3"><%= detail.sample_rationale||'' %></textarea></label>
    <label class="field span-2"><span>Reviewer-facing conclusion</span><textarea class="textarea" name="review_conclusion" rows="4"><%= detail.review_conclusion||'' %></textarea></label>
  </div><div class="panel-foot"><button class="btn btn-primary" name="action" value="save">Save assessment decision</button><% if (canScore && detail.status!=='Assessor Complete' && detail.status!=='Reviewed' && detail.status!=='Client Validated' && detail.status!=='Approved') { %><button class="btn" name="action" value="complete">Submit assessor conclusion</button><% } %></div></section>
</form>

<section class="panel" style="margin-top:14px;"><div class="panel-head"><div><h2>Evidence record</h2><p>Evidence quality is explicit; a policy or interview does not prove operating effectiveness.</p></div><span class="tag"><%= evidence.length %> items</span></div>
  <div class="divide-row"><% evidence.forEach(e=>{ %><div class="csf2-evidence-row"><div><strong><%= e.description||e.file_path||e.url||'Evidence item' %></strong><small><%= e.type %> · <%= e.evidence_axis %> · <%= e.evidence_quality %> · <%= e.confidentiality %></small><% if(e.relevance_note){ %><p><%= e.relevance_note %></p><% } %></div><span class="tag"><%= e.source_reliability||'reliability unset' %></span></div><% }) %><% if(!evidence.length){ %><div class="empty-state"><div class="empty-title">No evidence retained</div></div><% } %></div>
  <% if (canAssess) { %><form method="POST" enctype="multipart/form-data" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assessment/<%= detail.subcategory_id %>/evidence" class="panel-pad csf2-form-grid csf2-subform">
    <label class="field"><span>Evidence type</span><select class="select" name="type"><option>FILE</option><option>URL</option><option>INTERVIEW</option><option>OBSERVATION</option></select></label><label class="field"><span>Axis supported</span><select class="select" name="evidence_axis"><% evidenceAxes.forEach(v=>{ %><option><%= v %></option><% }) %></select></label>
    <label class="field"><span>Evidence quality</span><select class="select" name="evidence_quality"><% evidenceQuality.forEach(v=>{ %><option><%= v %></option><% }) %></select></label><label class="field"><span>Source reliability</span><select class="select" name="source_reliability"><option value="">Select</option><option>low</option><option>medium</option><option>high</option></select></label>
    <label class="field span-2"><span>Description</span><input class="input" name="description" required></label><label class="field span-2"><span>Relevance to this outcome</span><textarea class="textarea" name="relevance_note" rows="2" required></textarea></label>
    <label class="field"><span>File</span><input class="input" type="file" name="file"></label><label class="field"><span>URL</span><input class="input" type="url" name="url"></label>
    <label class="field"><span>Evidence period start</span><input class="input" type="date" name="evidence_period_start"></label><label class="field"><span>Evidence period end</span><input class="input" type="date" name="evidence_period_end"></label>
    <label class="field"><span>Scope coverage</span><input class="input" name="scope_coverage" placeholder="Systems, populations, locations..."></label><label class="field"><span>Testing method</span><input class="input" name="testing_method" placeholder="Inspection, observation, reperformance..."></label>
    <div class="span-2"><button class="btn btn-primary">Retain evidence</button></div>
  </form><% } %>
</section>

<section class="panel" style="margin-top:14px;"><div class="panel-head"><div><h2>Assessment tests</h2><p>Direct testing creates stronger assurance than documents or interviews.</p></div></div><div class="divide-row"><% method.test_procedures.forEach((procedure,i)=>{ const code=`${detail.code}-T${i+1}`; const test=tests.find(t=>t.test_code===code)||{}; %><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assessment/<%= detail.subcategory_id %>/test" class="csf2-test-row"><input type="hidden" name="test_code" value="<%= code %>"><input type="hidden" name="procedure_text" value="<%= procedure %>"><div><strong><%= procedure %></strong><textarea class="textarea" name="conclusion" rows="2" placeholder="Test work performed, exceptions, and conclusion"><%= test.conclusion||'' %></textarea></div><div><select class="select" name="axis"><% ['both','policy','practice'].forEach(v=>{ %><option <%= test.axis===v?'selected':'' %>><%= v %></option><% }) %></select><select class="select" name="result"><% ['not_run','pass','partial','fail','no_visibility','not_applicable'].forEach(v=>{ %><option <%= test.result===v?'selected':'' %>><%= v %></option><% }) %></select><input class="input" type="number" min="0" name="sample_size" value="<%= test.sample_size==null?'':test.sample_size %>" placeholder="Sample"><button class="btn">Save test</button></div></form><% }) %></div></section>

<section class="panel" style="margin-top:14px;"><div class="panel-head"><div><h2>Exceptions and compensating controls</h2><p>Exceptions are time-bound risk decisions, not silent score adjustments.</p></div><span class="tag"><%= exceptions.length %></span></div><div class="divide-row"><% exceptions.forEach(x=>{ %><div class="csf2-exception-row"><div><strong><%= x.title %></strong><p><%= x.scope %></p><small><%= x.status %> · expires <%= x.expires_on %> · residual risk <%= x.residual_risk||'unset' %></small></div></div><% }) %></div>
  <% if(canAssess){ %><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assessment/<%= detail.subcategory_id %>/exception" class="panel-pad csf2-form-grid csf2-subform"><label class="field"><span>Exception title</span><input class="input" name="title" required></label><label class="field"><span>Scope</span><input class="input" name="scope" required></label><label class="field span-2"><span>Justification</span><textarea class="textarea" name="justification" required></textarea></label><label class="field span-2"><span>Compensating controls</span><textarea class="textarea" name="compensating_controls"></textarea></label><label class="field"><span>Residual risk</span><select class="select" name="residual_risk"><option>low</option><option>medium</option><option>high</option><option>critical</option></select></label><label class="field"><span>Expiry</span><input class="input" type="date" name="expires_on" required></label><label class="field"><span>Next review</span><input class="input" type="date" name="next_review_on" required></label><div class="span-2"><button class="btn">Record exception</button></div></form><% } %>
</section>

<section class="panel" style="margin-top:14px;"><div class="panel-head"><div><h2>Findings and improvement</h2><p>Translate material gaps into accountable risk treatment.</p></div><span class="tag"><%= findings.length %></span></div><div class="divide-row"><% findings.forEach(f=>{ %><div class="csf2-finding-row"><span class="severity severity-<%= f.severity.toLowerCase() %>"><%= f.severity %></span><div><strong><%= f.title %></strong><p><%= f.description %></p></div><span><%= f.status %></span></div><% }) %></div>
  <% if(canAssess){ %><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assessment/<%= detail.subcategory_id %>/finding" class="panel-pad csf2-form-grid csf2-subform"><label class="field"><span>Finding title</span><input class="input" name="title" required></label><label class="field"><span>Severity</span><select class="select" name="severity"><option>CRITICAL</option><option>HIGH</option><option selected>MEDIUM</option><option>LOW</option></select></label><label class="field span-2"><span>Condition, evidence, risk, and required improvement</span><textarea class="textarea" name="description" rows="4" required></textarea></label><div class="span-2"><button class="btn">Create finding</button></div></form><% } %>
</section>

<section class="panel" style="margin-top:14px;"><div class="panel-head"><h2>Decision history</h2></div><div class="divide-row"><% decisions.forEach(d=>{ %><div class="csf2-history-row"><span><%= d.axis %></span><strong><%= d.previous_value==null?'—':d.previous_value %> → <%= d.new_value==null?'—':d.new_value %></strong><small><%= d.actor_name %> · <%= d.created_at %></small></div><% }) %><% if(!decisions.length){ %><div class="empty-state"><div class="empty-title">No score decisions yet</div></div><% } %></div></section>

<script nonce="<%= typeof cspNonce !== 'undefined' ? cspNonce : '' %>">
document.querySelectorAll('.csf2-level-options input').forEach(input=>input.addEventListener('change',()=>{const axis=input.name.replace('_score','');document.querySelectorAll(`[data-axis="${axis}"]`).forEach(p=>p.classList.toggle('is-hidden',p.dataset.level!==input.value));}));
</script>
<%- include('partials/footer') %>
