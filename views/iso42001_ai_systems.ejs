<%- include('partials/header', { title, user, ws, active }) %>
<%- include('partials/iso42001_audit_head') %>
<%
  const inScope = systems.filter(s => s.in_scope);
  const excluded = systems.filter(s => !s.in_scope);
  const iaLabel = s => s.ia_approved_at ? ['Approved ' + fmtDate(s.ia_approved_at), 's-done'] : s.ia_status === 'draft' ? ['Draft', 's-in_review'] : ['None', 's-todo'];
  const scoped = !!(programme.review_period_start || programme.review_period_end);
%>

<div class="a42">
  <div class="a42-crumb"><a href="<%= base %>/overview">ISO 42001 certification</a></div>
  <div class="page-head">
    <div>
      <h1 class="page-title">AI system register</h1>
      <div class="page-subtitle">Every AI system the organisation provides, builds or uses, its role for each, and the impact assessment behind it. The auditor's populations of new systems, AI vendors, AI changes and AI incidents are drawn from here.</div>
      <div class="a42-facts">
        <span><strong><%= inScope.length %></strong> in scope</span>
        <% if (excluded.length) { %><span><strong><%= excluded.length %></strong> excluded</span><% } %>
        <span><strong><%= inScope.filter(s => s.ia_approved_at).length %></strong> with an approved impact assessment</span>
      </div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;">
      <% if (systems.length) { %><a class="btn btn-secondary" href="<%= base %>/ai-register.docx">Word</a><a class="btn btn-secondary" href="<%= base %>/ai-register.csv">CSV</a><% } %>
      <% if (perms.manage) { %><a class="btn btn-primary" href="<%= base %>/ai-systems/new">Add AI system</a><% } %>
    </div>
  </div>

  <section class="panel" aria-labelledby="aiListTitle">
    <div class="panel-head"><h2 id="aiListTitle">Systems</h2><% if (systems.length) { %><span class="meta"><%= inScope.length %> in scope<%= excluded.length ? ` · ${excluded.length} excluded` : "" %></span><% } %></div>
    <% if (!systems.length) { %>
      <div class="empty-state">
        <div class="empty-title">No AI systems recorded</div>
        <div class="empty-sub">Start with the systems in the AIMS scope. For each one the auditor wants its purpose, the organisation's role, the resources it uses and a documented impact assessment.</div>
        <% if (perms.manage) { %><a class="btn btn-primary" href="<%= base %>/ai-systems/new">Add the first system</a><% } %>
      </div>
    <% } else { %>
      <div class="ai-cards">
        <% systems.forEach(s => { const [ia, cls] = iaLabel(s); const stages = Object.keys(registry.LIFECYCLE); const at = stages.indexOf(s.lifecycle_stage); const needsIa = s.in_scope && !s.ia_approved_at && s.lifecycle_stage !== 'retired'; %>
          <article class="ai-card<%= s.in_scope ? '' : ' is-out' %><%= needsIa ? ' needs-ia' : '' %>">
            <header>
              <h3><a class="a42-title" href="<%= base %>/ai-systems/<%= s.id %>"><%= s.name %></a></h3>
              <p><%= !s.in_scope ? 'Excluded from scope' : s.purpose ? (s.purpose.length > 140 ? s.purpose.slice(0, 137) + '...' : s.purpose) : 'Purpose not recorded' %></p>
            </header>
            <ol class="ai-life" aria-label="Life cycle: <%= registry.LIFECYCLE[s.lifecycle_stage] %>">
              <% stages.forEach((k, i) => { %><li class="<%= i < at ? 'is-past' : i === at ? 'is-now' : '' %>"<%- i === at ? ' aria-current="step"' : '' %>><%= registry.LIFECYCLE[k] %></li><% }) %>
            </ol>
            <dl class="ai-facts">
              <div><dt>Organisation's role</dt><dd><%= s.roles.length ? s.roles.map(r => registry.ROLES[r].replace(/ \(.*\)$/, '')).join(', ') : 'Not recorded' %></dd></div>
              <div><dt>Human oversight</dt><dd><%= s.automation_level ? registry.AUTOMATION[s.automation_level] : 'Not recorded' %></dd></div>
              <div><dt>Went live</dt><dd><%= s.go_live_date ? fmtDate(s.go_live_date) : 'Not yet' %></dd></div>
            </dl>
            <div class="ai-ia">
              <span>Impact assessment</span>
              <strong class="status <%= cls %>"><%= ia %></strong><% if (s.ia_residual) { %><em>residual risk <%= s.ia_residual %></em><% } else if (needsIa) { %><em>The auditor samples this</em><% } %>
            </div>
            <footer>
              <a href="<%= base %>/ai-systems/<%= s.id %>#suppliers"><b><%= s.supplier_count || 0 %></b> vendor<%= s.supplier_count === 1 ? '' : 's' %></a>
              <a href="<%= base %>/ai-systems/<%= s.id %>#changes"><b><%= s.change_count || 0 %></b> change<%= s.change_count === 1 ? '' : 's' %></a>
              <a href="<%= base %>/ai-systems/<%= s.id %>#incidents"><b><%= s.incident_count || 0 %></b> incident<%= s.incident_count === 1 ? '' : 's' %></a>
            </footer>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="panel" aria-labelledby="aiPopTitle">
    <div class="panel-head">
      <h2 id="aiPopTitle">Populations for the auditor</h2>
      <span class="meta"><%= scoped ? `Review period ${fmtDate(programme.review_period_start) || 'start of records'} to ${fmtDate(programme.review_period_end) || 'today'}` : 'No review period set, so each export lists the whole register' %> · <a href="<%= base %>/overview#a42Dates">Change</a></span>
    </div>
    <div style="overflow-x:auto;">
      <table class="t a42-stack">
        <thead><tr><th scope="col">Population</th><th scope="col">Built from</th><th scope="col" class="num">Rows</th><th scope="col"><span class="sr-only">Export</span></th></tr></thead>
        <tbody>
          <% populations.forEach(p => { %>
            <tr>
              <td><%= p.title %></td>
              <td data-label="Built from"><%= { 'ai-systems': 'In-scope systems, by go-live date', 'ai-vendors': 'Suppliers recorded on each system', 'ai-changes': 'Changes linked to a system', 'ai-incidents': 'Incidents linked to a system' }[p.key] %></td>
              <td class="num" data-label="Rows"><%= p.rows.length %></td>
              <td class="num"><% if (perms.export) { %><a class="btn btn-ghost btn-xs" href="<%= base %>/populations/<%= p.key %>.csv">Download CSV</a><% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="a42-note">Employee and new-hire lists come from the client's HR records, so they are requested from the client rather than built here.</div>
  </section>
</div>

<%- include('partials/footer') %>
