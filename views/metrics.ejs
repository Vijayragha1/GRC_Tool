<%- include('partials/header', { title: 'ISMS metrics', user, ws, active: 'metrics' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">ISMS performance metrics</h1>
    <div class="page-subtitle">Clause 9.1. Auto-computed from your live data. Feed these into the next management review so MRM inputs aren't free-text guesses.</div>
  </div>
  <% if (upcomingMrms.length > 0) { %>
    <form method="POST" action="/workspaces/<%= ws.id %>/metrics/feed-to-mrm/<%= upcomingMrms[0].id %>">
      <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <button class="btn btn-primary btn-xs">Feed to MRM (<%= upcomingMrms[0].meeting_date || 'next' %>) →</button>
    </form>
  <% } %>
</div>

<!-- Primary KPI band -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;">
  <div class="panel kpi" style="border-left:3px solid <%= m.controlImplPct >= 80 ? '#15803d' : m.controlImplPct >= 50 ? '#a16207' : '#b91c1c' %>;">
    <div class="kpi-label text-eyebrow">Control implementation</div>
    <div class="kpi-num" style="color:<%= m.controlImplPct >= 80 ? '#15803d' : m.controlImplPct >= 50 ? '#a16207' : '#b91c1c' %>;"><%= m.controlImplPct %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-meta"><%= m.controlImpl %>/<%= m.controlIncluded %> included controls</div>
  </div>
  <div class="panel kpi" style="border-left:3px solid <%= m.trainPct >= 95 ? '#15803d' : m.trainPct >= 80 ? '#a16207' : '#b91c1c' %>;">
    <div class="kpi-label text-eyebrow">Training completion</div>
    <div class="kpi-num" style="color:<%= m.trainPct >= 95 ? '#15803d' : m.trainPct >= 80 ? '#a16207' : '#b91c1c' %>;"><%= m.trainPct %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-meta"><%= m.trainComplete %>/<%= m.trainAssigned %> assigned</div>
  </div>
  <div class="panel kpi" style="border-left:3px solid <%= m.docsReviewPct >= 90 ? '#15803d' : m.docsReviewPct >= 70 ? '#a16207' : '#b91c1c' %>;">
    <div class="kpi-label text-eyebrow">Doc review compliance</div>
    <div class="kpi-num" style="color:<%= m.docsReviewPct >= 90 ? '#15803d' : m.docsReviewPct >= 70 ? '#a16207' : '#b91c1c' %>;"><%= m.docsReviewPct %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-meta"><%= m.docsOverdue %> overdue of <%= m.docsApproved %> approved</div>
  </div>
  <div class="panel kpi" style="border-left:3px solid <%= m.evidenceFreshPct >= 70 ? '#15803d' : m.evidenceFreshPct >= 40 ? '#a16207' : '#b91c1c' %>;">
    <div class="kpi-label text-eyebrow">Evidence freshness</div>
    <div class="kpi-num" style="color:<%= m.evidenceFreshPct >= 70 ? '#15803d' : m.evidenceFreshPct >= 40 ? '#a16207' : '#b91c1c' %>;"><%= m.evidenceFreshPct %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-meta"><%= m.evidenceFresh %>/<%= m.evidenceTotalCtl %> with evidence &lt; 12mo</div>
  </div>
</div>

<!-- Operations metrics -->
<div class="panel" style="margin-bottom:14px;">
  <div class="panel-head"><h2>Operational metrics</h2><span class="meta">last 90 days unless noted</span></div>
  <table class="t">
    <tbody>
      <tr>
        <td style="width:40%;">
          <strong>Nonconformities - open</strong>
          <div class="meta text-xs">major / minor / observation</div>
        </td>
        <td style="width:25%;font-weight:600;">
          <span style="color:#b91c1c;"><%= m.ncBySev.major %></span>
          <span class="meta">/</span>
          <span style="color:#a16207;"><%= m.ncBySev.minor %></span>
          <span class="meta">/</span>
          <span class="meta"><%= m.ncBySev.observation %></span>
        </td>
        <td class="meta text-base"><%= m.ncOpenTotal %> total open</td>
        <td><a href="/workspaces/<%= ws.id %>/nonconformities" class="link-muted text-base">→</a></td>
      </tr>
      <tr>
        <td><strong>NC mean time to close</strong><div class="meta text-xs">avg days from open to close, last 90d</div></td>
        <td style="font-weight:600;<%= m.mttcDays != null && m.mttcDays > 30 ? 'color:#a16207;' : '' %>"><%= m.mttcDays == null ? '-' : m.mttcDays + ' days' %></td>
        <td class="meta text-base"><% if (m.mttcPrior != null) { %>prior 90d: <%= m.mttcPrior %> days<% } else { %>no prior data<% } %></td>
        <td></td>
      </tr>
      <tr>
        <td><strong>Tasks overdue</strong><div class="meta text-xs">past due_date and not closed</div></td>
        <td style="font-weight:600;color:<%= m.tasksOverduePct > 20 ? '#b91c1c' : m.tasksOverduePct > 10 ? '#a16207' : '#15803d' %>;"><%= m.tasksOverdue %> / <%= m.tasksOpen %> (<%= m.tasksOverduePct %>%)</td>
        <td></td>
        <td><a href="/workspaces/<%= ws.id %>/tasks" class="link-muted text-base">→</a></td>
      </tr>
      <tr>
        <td><strong>High-severity open risks</strong><div class="meta text-xs">L × I ≥ 15</div></td>
        <td style="font-weight:600;color:<%= m.risksHigh > 0 ? '#b91c1c' : 'var(--text)' %>;"><%= m.risksHigh %></td>
        <td class="meta text-base"><%= m.risksAccepted %> active acceptances</td>
        <td><a href="/workspaces/<%= ws.id %>/risks" class="link-muted text-base">→</a></td>
      </tr>
      <tr>
        <td><strong>Internal audits</strong><div class="meta text-xs">runs in last 12 months</div></td>
        <td style="font-weight:600;color:<%= m.auditsRun === 0 ? '#b91c1c' : 'var(--text)' %>;"><%= m.auditsRun %></td>
        <td class="meta text-base"><%= m.auditsRun === 0 ? 'clause 9.2 requires at least one' : 'on cadence' %></td>
        <td><a href="/workspaces/<%= ws.id %>/audits" class="link-muted text-base">→</a></td>
      </tr>
      <tr>
        <td><strong>Incident MTTR</strong><div class="meta text-xs">detected → resolved, last 90d</div></td>
        <td style="font-weight:600;"><%= m.incidentMTTR == null ? '-' : m.incidentMTTR + ' days' %></td>
        <td class="meta text-base"><%= m.incidentsOpen %> currently open</td>
        <td><a href="/workspaces/<%= ws.id %>/incidents" class="link-muted text-base">→</a></td>
      </tr>
    </tbody>
  </table>
</div>

<!-- Feed-to-MRM picker -->
<% if (upcomingMrms.length > 0) { %>
  <div class="panel" style="margin-bottom:14px;">
    <div class="panel-head"><h2>Feed metrics into management review</h2><span class="meta">appends to the MRM's performance_review field</span></div>
    <div class="panel-pad">
      <div class="text-base" style="margin-bottom:10px;line-height:1.5;">
        Auditors expect MRM inputs (clause 9.3.2.c "performance and effectiveness of the ISMS") to be evidence-backed numbers, not free-text. Click to append the metrics above into the chosen MRM record.
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;">
        <% upcomingMrms.forEach(mr => { %>
          <form method="POST" action="/workspaces/<%= ws.id %>/metrics/feed-to-mrm/<%= mr.id %>" style="display:inline;">
            <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
            <button class="btn btn-secondary btn-xs">MRM <%= mr.meeting_date || 'no date' %> →</button>
          </form>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>

<div class="meta text-xs" style="line-height:1.55;">
  <strong>How these are computed</strong>: control implementation = <code>control_states.status='Implemented'</code> and <code>applicability='included'</code> ÷ all included controls. Training = <code>training_records.status='completed'</code> ÷ all assigned. NC MTTR = avg of <code>julianday(closed_at) - julianday(created_at)</code> for NCs closed in the last 90 days. Doc review compliance = approved/published docs whose <code>next_review_date</code> is in the future. Evidence freshness = included controls with at least one non-superseded evidence file uploaded in the last 365 days. All numbers are live - no snapshot table yet, so the comparison with "prior period" is computed dynamically.
</div>

<%- include('partials/footer') %>
