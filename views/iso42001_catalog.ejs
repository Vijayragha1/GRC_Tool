<%- include('partials/header', { title: 'ISO 42001 catalog', user, ws, active: 'iso42001-catalog' }) %>

<style>
  @media(max-width:760px){
    .iso42-catalog-filter{display:grid;grid-template-columns:minmax(0,1fr);width:100%}
    .iso42-catalog-filter .input,.iso42-catalog-filter .select{width:100%!important}
    .iso42-catalog-actions{align-items:stretch!important;display:grid!important;gap:8px!important;grid-template-columns:1fr 1fr}
    .iso42-catalog-actions>div:last-child{grid-column:1/-1;margin-left:0!important;text-align:left}
    .iso42-catalog-actions .btn{width:100%}
  }
  @media(max-width:430px){.iso42-catalog-actions{grid-template-columns:minmax(0,1fr)}}
</style>

<div class="page-head">
  <div>
    <h1 class="page-title">ISO/IEC 42001:2023 catalog</h1>
    <div class="page-subtitle">27 clauses (4-10) and 38 Annex A reference controls for AI management systems.</div>
  </div>
  <form class="row-center iso42-catalog-filter" method="GET">
    <input class="input" name="q" placeholder="Search…" value="<%= search %>" style="width:200px">
    <select name="filter" class="select" style="width:240px" onchange="this.form.submit()">
      <option value="all" <%= filter==='all'?'selected':'' %>>All items</option>
      <option value="clauses" <%= filter==='clauses'?'selected':'' %>>Clauses (4-10)</option>
      <option value="annex" <%= filter==='annex'?'selected':'' %>>Annex A only</option>
      <option value="a-policies" <%= filter==='a-policies'?'selected':'' %>>A.2 Policies related to AI</option>
      <option value="b-internal-organization" <%= filter==='b-internal-organization'?'selected':'' %>>A.3 Internal organization</option>
      <option value="c-resources" <%= filter==='c-resources'?'selected':'' %>>A.4 Resources for AI systems</option>
      <option value="d-impact-assessment" <%= filter==='d-impact-assessment'?'selected':'' %>>A.5 Impact assessment</option>
      <option value="e-lifecycle" <%= filter==='e-lifecycle'?'selected':'' %>>A.6 AI system life cycle</option>
      <option value="f-data" <%= filter==='f-data'?'selected':'' %>>A.7 Data for AI systems</option>
      <option value="g-information" <%= filter==='g-information'?'selected':'' %>>A.8 Information for interested parties</option>
      <option value="h-use" <%= filter==='h-use'?'selected':'' %>>A.9 Use of AI systems</option>
      <option value="i-third-party" <%= filter==='i-third-party'?'selected':'' %>>A.10 Third-party and customers</option>
    </select>
    <button class="btn btn-secondary">Apply</button>
  </form>
</div>

<div class="panel" style="overflow:hidden;margin-bottom:16px;">
  <div style="padding:12px 16px;background:var(--bg-subtle);border-bottom:1px solid var(--border);">
    <div class="text-lg iso42-catalog-actions" style="display:flex;gap:24px;">
      <div><a href="/workspaces/<%= ws.id %>/iso42001/controls" class="btn btn-primary btn-xs">Assess controls</a></div>
      <div><a href="/workspaces/<%= ws.id %>/iso42001/soa" class="btn btn-secondary btn-xs">Statement of Applicability</a></div>
      <div class="text-tertiary text-base" style="margin-left:auto;">Showing <%= rows.length %> item<%= rows.length===1?'':'s' %></div>
    </div>
  </div>
  <table class="t">
    <thead><tr>
      <th style="width:90px;">ID</th>
      <th>Title</th>
      <th>Summary</th>
    </tr></thead>
    <tbody>
      <% rows.forEach(r => { %>
        <tr>
          <td><span class="mono text-xs text-tertiary">
            <%= r.type === 'clause' ? '§' + r.id.replace('ai-clause-', '') : r.id.replace('ai-annex-', '').toUpperCase().replace(/-/g, '.') %>
          </span></td>
          <td>
            <% if (r.type === 'control') { %>
              <a href="/workspaces/<%= ws.id %>/iso42001/controls/<%= r.id %>" class="link-muted">
                <%= r.title.replace(/^(A\.[0-9.]+|[0-9.]+) /, '') %>
              </a>
            <% } else { %>
              <span><%= r.title.replace(/^(A\.[0-9.]+|[0-9.]+) /, '') %></span>
            <% } %>
            <div class="text-xs text-tertiary"><%= r.type === 'clause' ? 'Clause' : 'Annex A control' %></div>
          </td>
          <td class="text-secondary text-base"><%= r.summary || '' %></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %>
        <tr><td colspan="3" class="t-empty">No items match this filter.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
