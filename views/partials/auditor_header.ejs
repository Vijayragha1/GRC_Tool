<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'Auditor view' %> · <%= workspace.client_name %></title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/fonts/inter.css">
<style>
  /*
   * Auditor portal stylesheet — deliberately distinct from the consultant
   * app. No sidebar, no edit affordances, no theme toggle. The portal is a
   * read-only audit-readiness deliverable: clean, calm, easy to navigate at
   * 14:00 on the second day of an audit when the auditor is fatigued.
   */
  :root {
    --bg: #ffffff;
    --bg-subtle: #fafafa;
    --bg-muted: #f4f4f5;
    --bg-deep: #f7f7f8;
    --border: #ececef;
    --border-strong: #d6d6db;
    --text: #18181b;
    --text-secondary: #51525c;
    --text-tertiary: #71717a;
    --accent: <%= workspace.brand_primary_color || '#4f46e5' %>;
    --accent-soft: <%= (workspace.brand_primary_color || '#4f46e5') + '14' %>;
    --accent-deep: <%= workspace.brand_primary_color || '#3730a3' %>;
    --ink: #0f0f12;
    --good: #15803d; --good-soft: rgba(22,163,74,0.10);
    --warn: #b45309; --warn-soft: rgba(202,138,4,0.10);
    --bad:  #b91c1c; --bad-soft:  rgba(220,38,38,0.10);
    --shadow-sm: 0 1px 2px rgba(15,15,18,0.04);
    --shadow-md: 0 1px 3px rgba(15,15,18,0.05), 0 1px 2px rgba(15,15,18,0.03);
    --shadow-lg: 0 4px 12px rgba(15,15,18,0.06), 0 1px 3px rgba(15,15,18,0.04);
    --radius: 8px;
    --radius-sm: 6px;
  }
  html { font-family: 'Inter', system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }
  @supports (font-variation-settings: normal) { html { font-family: 'Inter var', system-ui, sans-serif; } }
  body { background: var(--bg-deep); color: var(--text); font-size: 14px; line-height: 1.5; margin: 0; }
  *, *::before, *::after { box-sizing: border-box; }
  .mono { font-family: ui-monospace, 'SF Mono', Menlo, monospace; }
  .num { font-variant-numeric: tabular-nums; }

  /* ---- top bar ---- */
  .a-topbar {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 14px 0;
    position: sticky; top: 0; z-index: 50;
  }
  .a-container { max-width: 1280px; margin: 0 auto; padding: 0 28px; }
  .a-top-row { display: flex; align-items: center; gap: 14px; }
  .a-brand {
    display: inline-flex; align-items: center; gap: 10px;
    text-decoration: none; color: var(--ink);
  }
  .a-brand-mark {
    width: 30px; height: 30px; border-radius: 7px;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
    display: inline-flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700; font-size: 13px;
    box-shadow: 0 1px 0 rgba(255,255,255,0.15) inset, 0 1px 3px rgba(0,0,0,0.15);
  }
  .a-brand-name { font-size: 14px; font-weight: 600; color: var(--ink); letter-spacing: -0.005em; }
  .a-brand-sub  { font-size: 11px; color: var(--text-tertiary); margin-top: 1px; }
  .a-spacer { flex: 1; }
  .a-mode-badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 10px; border-radius: 999px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.04em;
    background: var(--accent-soft); color: var(--accent-deep);
    border: 1px solid var(--accent);
  }
  .a-share-meta { font-size: 11.5px; color: var(--text-tertiary); }
  .a-share-meta strong { color: var(--text); font-weight: 500; }

  /* ---- tabs ---- */
  .a-tabs {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 0; position: sticky; top: 60px; z-index: 49;
  }
  .a-tabs-row { display: flex; align-items: stretch; gap: 4px; overflow-x: auto; }
  .a-tab {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 12px 14px; text-decoration: none;
    font-size: 13px; font-weight: 500; color: var(--text-secondary);
    border-bottom: 2px solid transparent; transition: all 0.12s;
    white-space: nowrap;
  }
  .a-tab:hover { color: var(--text); background: var(--bg-subtle); }
  .a-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
  .a-tab svg { width: 14px; height: 14px; opacity: 0.7; }
  .a-tab.active svg { opacity: 1; }

  /* ---- main + content primitives ---- */
  .a-main { max-width: 1280px; margin: 0 auto; padding: 28px; }
  .a-page-head { margin-bottom: 24px; }
  .a-page-title { font-size: 24px; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); line-height: 1.15; }
  .a-page-sub { font-size: 13px; color: var(--text-secondary); margin-top: 6px; max-width: 720px; }

  .panel { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
  .panel-pad { padding: 18px 20px; }
  .panel-head { padding: 12px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .panel-head h2 { font-size: 13px; font-weight: 600; margin: 0; color: var(--ink); }

  table.t { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.t thead th { text-align: left; padding: 9px 16px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-tertiary); background: var(--bg-subtle); border-bottom: 1px solid var(--border); }
  table.t tbody td { padding: 11px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  table.t tbody tr:last-child td { border-bottom: none; }
  table.t tbody tr:hover { background: var(--bg-subtle); }
  th.num, td.num { text-align: right; }

  .chip { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; line-height: 1.5; }
  .chip-good { background: var(--good-soft); color: var(--good); }
  .chip-warn { background: var(--warn-soft); color: var(--warn); }
  .chip-bad  { background: var(--bad-soft);  color: var(--bad); }
  .chip-neutral { background: rgba(113,113,122,0.10); color: #52525b; }
  .chip-accent  { background: var(--accent-soft); color: var(--accent-deep); }

  .kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px; }
  .kpi { padding: 14px 18px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; position: relative; overflow: hidden; }
  .kpi::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--border-strong); }
  .kpi.brand::before { background: var(--accent); }
  .kpi.good::before  { background: var(--good); }
  .kpi.warn::before  { background: var(--warn); }
  .kpi.bad::before   { background: var(--bad);  }
  .kpi-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); }
  .kpi-num { font-size: 26px; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); font-variant-numeric: tabular-nums; margin-top: 4px; }
  .kpi-meta { font-size: 11.5px; color: var(--text-tertiary); margin-top: 4px; }

  .meta { color: var(--text-tertiary); font-size: 12px; }
  .text-sm  { font-size: 12px; }
  .text-md  { font-size: 13px; }
  .text-eyebrow { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }

  a.link-muted { color: var(--text-secondary); text-decoration: none; transition: color 0.12s; }
  a.link-muted:hover { color: var(--accent); }
  a.btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 13px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 500;
    text-decoration: none; transition: all 0.12s;
    border: 1px solid transparent; white-space: nowrap;
  }
  a.btn-primary { background: var(--accent); color: #fff; }
  a.btn-primary:hover { background: var(--accent-deep); }
  a.btn-secondary { background: var(--bg); color: var(--text); border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
  a.btn-secondary:hover { background: var(--bg-subtle); border-color: var(--text-tertiary); }
  a.btn-xs { padding: 4px 10px; font-size: 12px; }

  .hash { font-family: ui-monospace, monospace; font-size: 11px; color: var(--text-secondary); }
  .empty-pane { padding: 40px; text-align: center; background: var(--bg); border: 1px dashed var(--border-strong); border-radius: 8px; color: var(--text-tertiary); }
  .empty-pane-title { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
</style>
</head>
<body>

<%
  // Tab definitions. The "active" string is set by the calling view's title arg.
  const tabs = [
    { key: 'overview',  href: '',                  label: 'Overview',         icon: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>' },
    { key: 'soa',       href: '/soa',              label: 'SoA',              icon: '<polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>' },
    { key: 'risks',     href: '/risks',            label: 'Risks',            icon: '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>' },
    { key: 'evidence',  href: '/evidence',         label: 'Evidence',         icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>' },
    { key: 'documents', href: '/documents',        label: 'Policies',         icon: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>' },
    { key: 'audits',    href: '/audits',           label: 'Audits & NCs',     icon: '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>' },
    { key: 'pack',      href: '/audit-pack',       label: 'Full audit pack',  icon: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>', isPack: true }
  ];
%>

<div class="a-topbar">
  <div class="a-container">
    <div class="a-top-row">
      <a href="/auditor/<%= token %>" class="a-brand">
        <span class="a-brand-mark"><%= (workspace.client_name || 'A').slice(0,1).toUpperCase() %></span>
        <span>
          <div class="a-brand-name"><%= workspace.client_name %> · ISMS</div>
          <div class="a-brand-sub">ISO/IEC 27001:2022<% if (workspace.scope) { %> · <%= workspace.scope.slice(0, 80) %><%= workspace.scope.length > 80 ? '…' : '' %><% } %></div>
        </span>
      </a>
      <div class="a-spacer"></div>
      <% if (share && share.label) { %>
        <div class="a-share-meta"><strong><%= share.label %></strong>
        <% if (share.expires_at) { %> · expires <%= String(share.expires_at).slice(0,10) %><% } %>
        </div>
      <% } %>
      <span class="a-mode-badge">AUDITOR VIEW · READ-ONLY</span>
    </div>
  </div>
</div>

<div class="a-tabs">
  <div class="a-container">
    <div class="a-tabs-row">
      <% tabs.forEach(t => { %>
        <a href="/auditor/<%= token %><%= t.href %>" class="a-tab <%= (typeof active !== 'undefined' && active === t.key) ? 'active' : '' %>"<%= t.isPack ? ' download' : '' %>>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- t.icon %></svg>
          <%= t.label %>
        </a>
      <% }) %>
    </div>
  </div>
</div>

<div class="a-main">
