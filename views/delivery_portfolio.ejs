<%- include('partials/header',{ title:'Delivery QA',user,active:'delivery-portfolio' }) %>
<%
 const money=(minor,currency='USD')=>new Intl.NumberFormat('en-US',{style:'currency',currency}).format(Number(minor||0)/100);
 const frameworkList=value=>{ if(Array.isArray(value)) return value; try{return JSON.parse(value||'[]')}catch(_){return []} };
 const servicePath=row=>frameworkList(row.frameworks).includes('iso27001')
   ? row.engagement_outcome==='gap_assessment_only'?'Gap assessment only':'Full certification support'
   : 'Framework-specific consulting';
%>
<style>
 .dp{max-width:1280px;margin:0 auto}.dp-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-end;margin-bottom:15px}.dp-eye{font-size:9px;text-transform:uppercase;letter-spacing:.08em;font-weight:800;color:var(--text-muted);margin-bottom:7px}.dp-head h1{font-family:inherit;font-size:22px;font-weight:500;line-height:1.2;letter-spacing:-.4px;margin:0 0 6px}.dp-head p{font-size:11px;color:var(--text-muted);margin:0}.dp-metrics{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:14px}.dp-metric{border:1px solid var(--border);border-radius:7px;background:var(--surface);padding:13px}.dp-metric span{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.065em;color:var(--text-muted);margin-bottom:7px}.dp-metric b{font-family:inherit;font-size:22px;font-weight:600;letter-spacing:-.25px}.dp-panel{border:1px solid var(--border);border-radius:8px;background:var(--surface);overflow:hidden}.dp-table{width:100%;border-collapse:collapse;font-size:10px}.dp-table th{text-align:left;padding:8px 10px;background:var(--bg-subtle);border-bottom:1px solid var(--border);font-size:8px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);white-space:nowrap}.dp-table td{padding:10px;border-bottom:1px solid var(--border);vertical-align:middle}.dp-table tr:last-child td{border-bottom:0}.dp-table a{color:var(--text);font-weight:700;text-decoration:none}.dp-table a:hover{text-decoration:underline}.dp-status{border:1px solid var(--border-strong);border-radius:3px;padding:3px 5px;font-size:7.5px;text-transform:uppercase;letter-spacing:.06em;font-weight:800;white-space:nowrap}.dp-muted{font-size:9px;color:var(--text-muted);margin-top:3px}.dp-num{font-variant-numeric:tabular-nums}@media(max-width:900px){.dp-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:560px){.dp-metrics{grid-template-columns:1fr 1fr}.dp-head{align-items:flex-start;flex-direction:column}.dp-table th:nth-child(5),.dp-table td:nth-child(5),.dp-table th:nth-child(7),.dp-table td:nth-child(7){display:none}}

  /* Microtype floor for phones. This block is scoped to the view because a
     view style tag loads after app.css and would otherwise win. Only the
     selectors declared below 11px above are listed. */
  @media (max-width: 760px) {
    .dp-eye,
    .dp-metric span,
    .dp-table,
    .dp-table th,
    .dp-status,
    .dp-muted
    { font-size: 11px; }
    .dp-panel > div { overscroll-behavior-inline: contain; -webkit-overflow-scrolling: touch; }
    .dp-table { min-width: 760px; }
    .dp-head .btn { width: 100%; justify-content: center; }
  }
  @media (max-width: 430px) {
    .dp-metrics { grid-template-columns: 1fr; }
    .dp-metric { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .dp-metric span { margin-bottom: 0; }
  }
</style>
<div class="dp"><header class="dp-head"><div><div class="dp-eye">Firm quality and delivery oversight</div><h1>Delivery QA</h1><p>Review pressure, client dependencies, deadlines, utilisation and forecast margin across the consulting portfolio.</p></div><a class="btn btn-secondary btn-sm" href="/dashboard">Clients</a></header>
 <section class="dp-metrics"><div class="dp-metric"><span>Engagements</span><b><%= totals.engagements %></b></div><div class="dp-metric"><span>Contract value</span><b><%= money(totals.contract) %></b></div><div class="dp-metric"><span>Hours consumed</span><b><%= totals.hours.toFixed(1) %></b></div><div class="dp-metric"><span>Awaiting review</span><b><%= totals.review %></b></div><div class="dp-metric"><span>Overdue workpapers</span><b><%= totals.overdue %></b></div><div class="dp-metric"><span>Forecast margin</span><b><%= money(totals.margin) %></b></div></section>
 <section class="dp-panel"><div style="overflow:auto"><table class="dp-table"><thead><tr><th>Client / engagement</th><th>Service path</th><th>Lead / reviewer</th><th>Status</th><th>Target</th><th>Client waiting</th><th>QA queue</th><th>Overdue</th><th>Hours</th><th>Contract</th><th>Forecast margin</th><th></th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><a href="/workspaces/<%= r.workspace_id %>/delivery?engagement=<%= r.id %>"><%= r.client_name %></a><div class="dp-muted"><%= r.engagement_code %> · <%= r.name %></div></td><td><span class="dp-status"><%= servicePath(r) %></span><div class="dp-muted">Current engagement: <%= r.engagement_type.replaceAll('_',' ') %></div></td><td><%= r.lead_name||'Unassigned' %><div class="dp-muted">Reviewer: <%= r.reviewer_name||'Unassigned' %></div></td><td><span class="dp-status"><%= r.status.replaceAll('_',' ') %></span></td><td><%= r.target_date||'-' %></td><td class="dp-num"><%= r.client_waiting %></td><td class="dp-num"><%= r.review_count %> review · <%= r.changes_count %> changes</td><td class="dp-num"><%= r.overdue_workpapers %></td><td class="dp-num"><%= r.actual_hours %> / <%= r.planned_hours||0 %><div class="dp-muted"><%= r.utilisation_pct %>% of plan</div></td><td class="dp-num"><%= money(r.contract_value_minor,r.currency||'USD') %></td><td class="dp-num"><%= money(r.forecast_margin_minor,r.currency||'USD') %></td><td><a class="btn btn-secondary btn-xs" href="/workspaces/<%= r.workspace_id %>/delivery?view=qa&engagement=<%= r.id %>">Review</a></td></tr><% }) %><% if(!rows.length){ %><tr><td colspan="12" style="padding:28px;text-align:center;color:var(--text-muted)">Open a client delivery cockpit to create the first consulting engagement.</td></tr><% } %></tbody></table></div></section>
</div>
<%- include('partials/footer') %>
