<%- include('partials/header', { title: ws.client_name, user, ws, active: 'overview' }) %>

<div class="cm-programme-head">
  <div>
    <div class="eyebrow">Client overview · Programme setup</div>
    <h1 class="page-title"><%= ws.client_name %></h1>
    <p class="page-subtitle"><%= ws.industry || 'Industry not set' %> · No assessment programme has been assigned.</p>
  </div>
  <a class="btn" href="/workspaces/<%= ws.id %>/intake">Client setup</a>
</div>

<section class="panel" style="padding:28px;margin-bottom:18px;">
  <div style="max-width:760px;">
    <span class="cm-kicker">Programme decision pending</span>
    <h2 style="font-family:var(--font-serif);font-size:25px;font-weight:500;margin:8px 0;">Choose the assessment programmes when the engagement is ready</h2>
    <p class="page-subtitle" style="max-width:680px;line-height:1.6;">The client can remain in planning without being treated as an ISO engagement. Select any combination below; programme-specific dashboards and navigation will appear only for what you enable.</p>
  </div>
  <form id="programme-enable-form" method="POST" action="/workspaces/<%= ws.id %>/frameworks" style="margin-top:22px;">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;">
      <label class="panel-pad" style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;border:1px solid var(--border);border-radius:8px;"><input id="enable-iso27001-programme" type="checkbox" name="frameworks" value="iso27001" style="margin-top:3px;"><span><strong style="display:block;">ISO 27001:2022</strong><span class="meta">Information security management and certification readiness</span></span></label>
      <label class="panel-pad" style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;border:1px solid var(--border);border-radius:8px;"><input type="checkbox" name="frameworks" value="iso42001" style="margin-top:3px;"><span><strong style="display:block;">ISO 42001:2023</strong><span class="meta">AI management system governance and assurance</span></span></label>
      <label class="panel-pad" style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;border:1px solid var(--border);border-radius:8px;"><input type="checkbox" name="frameworks" value="csf" style="margin-top:3px;"><span><strong style="display:block;">NIST CSF 2.0</strong><span class="meta">Cybersecurity maturity and investment planning</span></span></label>
      <label class="panel-pad" style="display:flex;align-items:flex-start;gap:10px;cursor:pointer;border:1px solid var(--border);border-radius:8px;"><input type="checkbox" name="frameworks" value="dpdpa" style="margin-top:3px;"><span><strong style="display:block;">India DPDPA</strong><span class="meta">Evidence-backed data-protection gap assessment</span></span></label>
    </div>
    <fieldset id="enable-iso27001-outcome" hidden style="border:1px solid var(--border);border-radius:8px;padding:14px;margin:16px 0 0;">
      <legend class="label" style="padding:0 5px;">Contracted ISO 27001 outcome <span class="meta">required</span></legend>
      <p class="meta" style="margin:0 0 10px;line-height:1.5;">Choose the contracted endpoint before ISO 27001 is enabled. This creates the matching governed engagement and delivery plan.</p>
      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;">
        <% outcomeOptions.forEach(option => { %>
          <label class="panel-pad" style="display:flex;align-items:flex-start;gap:9px;cursor:pointer;border:1px solid var(--border);border-radius:7px;">
            <input type="radio" name="engagement_outcome" value="<%= option.value %>" style="margin-top:3px;">
            <span><strong style="display:block;margin-bottom:3px;"><%= option.label %></strong><span class="meta" style="display:block;line-height:1.45;"><%= option.description %></span></span>
          </label>
        <% }) %>
      </div>
      <div id="enable-certification-target" hidden style="margin-top:12px;max-width:300px;">
        <label class="label">Target certification date <span class="meta">optional</span></label>
        <input class="input" id="enable-target-cert-date" type="date" name="target_cert_date" disabled>
      </div>
    </fieldset>
    <div style="display:flex;align-items:center;gap:12px;margin-top:16px;">
      <button class="btn btn-primary">Enable selected programmes</button>
      <span class="meta">Leaving all unchecked keeps the client in planning.</span>
    </div>
  </form>
</section>

<section class="panel" style="padding:28px;margin-bottom:18px;">
  <div style="max-width:760px;">
    <span class="cm-kicker">Operational module</span>
    <h2 style="font-family:var(--font-serif);font-size:25px;font-weight:500;margin:8px 0;">Run third-party risk without enabling an assessment framework</h2>
    <p class="page-subtitle" style="max-width:680px;line-height:1.6;">Third-party risk is an independent service. Enable it for one-off assessments, programme setup or a fully managed provider lifecycle.</p>
  </div>
  <% if (typeof canEnableTprm !== 'undefined' && canEnableTprm) { %>
  <form method="POST" action="/workspaces/<%= ws.id %>/modules/tprm" style="margin-top:18px;">
    <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;">
      <% [['assessment_only','One-off assessment','Assess selected third parties and issue recommendations.'],['programme_setup','Programme setup','Establish inventory, methodology and governance.'],['managed_lifecycle','Managed lifecycle','Operate onboarding through monitoring and offboarding.']].forEach(option => { %>
        <label class="panel-pad" style="display:flex;align-items:flex-start;gap:9px;cursor:pointer;border:1px solid var(--border);border-radius:8px;"><input type="radio" name="service_model" value="<%= option[0] %>" required style="margin-top:3px;"><span><strong style="display:block;"><%= option[1] %></strong><span class="meta" style="display:block;line-height:1.4;"><%= option[2] %></span></span></label>
      <% }) %>
    </div>
    <div style="display:flex;align-items:center;gap:12px;margin-top:16px;"><button class="btn btn-primary">Enable third-party risk</button><span class="meta">Frameworks can still be assigned later.</span></div>
  </form>
  <% } else { %>
    <div class="callout callout-info" style="margin-top:18px;">A firm manager must choose the contracted service model and enable this module.</div>
  <% } %>
</section>

<script>
  (function () {
    const isoProgramme = document.getElementById('enable-iso27001-programme');
    const outcomeFieldset = document.getElementById('enable-iso27001-outcome');
    const targetField = document.getElementById('enable-certification-target');
    const target = document.getElementById('enable-target-cert-date');
    const choices = document.querySelectorAll('#enable-iso27001-outcome input[name="engagement_outcome"]');
    function syncIsoOutcome() {
      const enabled = !!isoProgramme.checked;
      const selected = document.querySelector('#enable-iso27001-outcome input[name="engagement_outcome"]:checked');
      const fullSupport = enabled && selected && selected.value === 'certification_support';
      outcomeFieldset.hidden = !enabled;
      choices.forEach(choice => { choice.required = enabled; });
      targetField.hidden = !fullSupport;
      target.disabled = !fullSupport;
      if (!fullSupport) target.value = '';
    }
    isoProgramme.addEventListener('change', syncIsoOutcome);
    choices.forEach(choice => choice.addEventListener('change', syncIsoOutcome));
    syncIsoOutcome();
  })();
</script>

<% if (typeof setupIncomplete !== 'undefined' && setupIncomplete) { %>
  <div class="panel panel-pad" style="display:flex;justify-content:space-between;align-items:center;gap:16px;">
    <div><strong>Client setup is in progress</strong><div class="meta"><%= intakeAnswered %> of 25 scoping questions answered.</div></div>
    <a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/intake">Continue setup →</a>
  </div>
<% } %>

<%- include('partials/footer') %>
