<%- include('partials/header', { title: 'v' + version.version_number, user, ws, active: 'csf' }) %>

<div class="page-head">
  <div>
    <div style="display:flex;align-items:center;gap:10px;">
      <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/versions" class="meta" style="font-size:12px;text-decoration:none;">&larr; Version history</a>
    </div>
    <h1 class="page-title" style="margin-top:6px;display:flex;align-items:center;gap:10px;">
      <span class="mono" style="color:var(--accent);">v<%= version.version_number %></span>
      <span style="font-size:16px;font-weight:500;color:var(--text-secondary);"><%= engagement.name %></span>
      <% if (version.is_current) { %><span class="tag" style="background:rgba(21,128,61,0.08);color:#15803d;font-size:11px;">current</span><% } %>
    </h1>
    <div class="page-subtitle">Published <%= version.published_at %> &middot; immutable snapshot</div>
  </div>
  <div style="display:flex;gap:8px;align-items:center;">
    <% if (otherVersions.length) { %>
      <form method="GET" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/versions/<%= version.id %>/diff/0" onsubmit="this.action=this.action.replace(/diff\/0$/, 'diff/' + this.against.value); return true;">
        <select name="against" class="select" style="font-size:12px;padding:4px 8px;">
          <% otherVersions.forEach(o => { %><option value="<%= o.id %>">vs v<%= o.version_number %></option><% }) %>
        </select>
        <button class="btn btn-secondary btn-xs">Diff</button>
      </form>
    <% } %>
  </div>
</div>

<% if (version.change_summary) { %>
  <div class="panel" style="margin-bottom:14px;border-left:3px solid var(--accent);">
    <div class="panel-pad" style="font-size:12.5px;line-height:1.55;">
      <div class="meta" style="font-size:10.5px;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:4px;">Change summary</div>
      <div style="white-space:pre-wrap;"><%= version.change_summary %></div>
    </div>
  </div>
<% } %>

<% function tierColor(t) { if (!t) return 'var(--text-tertiary)'; return { 1:'#b91c1c', 2:'#a16207', 3:'#1d4ed8', 4:'#15803d' }[t.tier] || 'var(--text)'; } %>

<!-- Overall headline (read-only mirror of /scores) -->
<div class="panel" style="margin-bottom:14px;">
  <div class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr <%= engagement.scope_mode === 'CURRENT_TARGET' ? '1fr 1fr' : '' %>;gap:24px;">
    <div>
      <div class="kpi-num" style="color:<%= tierColor(rollup.overall.tier) %>;">
        <%= rollup.overall.current == null ? '-' : r1(rollup.overall.current) %><span style="font-size:14px;font-weight:400;color:var(--text-tertiary);">/5</span>
      </div>
      <div class="kpi-label">Overall (at publish)</div>
      <% if (rollup.overall.tier) { %><div class="meta" style="font-size:12px;margin-top:4px;color:<%= tierColor(rollup.overall.tier) %>;font-weight:500;"><%= rollup.overall.tier.label %></div><% } %>
    </div>
    <div>
      <div class="kpi-num"><%= rollup.coverage.scoredPct %><span style="font-size:14px;color:var(--text-tertiary);font-weight:400;">%</span></div>
      <div class="kpi-label">Coverage</div>
      <div class="meta" style="font-size:11.5px;margin-top:4px;"><%= rollup.coverage.scored %> of <%= rollup.coverage.total - rollup.coverage.excluded %></div>
    </div>
    <% if (engagement.scope_mode === 'CURRENT_TARGET') { %>
      <div>
        <div class="kpi-num" style="color:<%= tierColor(rollup.overall.tier_target) %>;">
          <%= rollup.overall.target == null ? '-' : r1(rollup.overall.target) %><span style="font-size:14px;font-weight:400;color:var(--text-tertiary);">/5</span>
        </div>
        <div class="kpi-label">Target (at publish)</div>
      </div>
      <div>
        <div class="kpi-num text-warn"><%= rollup.overall.gap == null ? '-' : (rollup.overall.gap > 0 ? '+' : '') + r1(rollup.overall.gap) %></div>
        <div class="kpi-label">Gap</div>
      </div>
    <% } %>
  </div>
</div>

<!-- Function tiles -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:14px;">
  <% rollup.functions.forEach(fn => { %>
    <div class="panel" style="border-top:3px solid <%= tierColor(fn.tier) %>;">
      <div class="panel-pad">
        <div style="display:flex;align-items:baseline;gap:8px;">
          <span class="mono" style="font-weight:600;color:var(--accent);font-size:13px;"><%= fn.code %></span>
          <span style="font-weight:600;font-size:13px;"><%= fn.name %></span>
        </div>
        <div style="display:flex;align-items:baseline;gap:14px;margin-top:8px;">
          <div>
            <div class="kpi-num num" style="font-size:24px;color:<%= tierColor(fn.tier) %>;"><%= fn.current == null ? '-' : r1(fn.current) %></div>
            <div class="kpi-meta">current</div>
          </div>
          <% if (engagement.scope_mode === 'CURRENT_TARGET') { %>
            <div>
              <div class="kpi-num num" style="font-size:24px;color:<%= tierColor(fn.tier_target) %>;"><%= fn.target == null ? '-' : r1(fn.target) %></div>
              <div class="kpi-meta">target</div>
            </div>
          <% } %>
        </div>
        <% if (fn.tier) { %><div style="margin-top:6px;font-size:11.5px;color:<%= tierColor(fn.tier) %>;font-weight:500;"><%= fn.tier.label %></div><% } %>
      </div>
    </div>
  <% }) %>
</div>

<!-- Findings snapshot list -->
<div class="panel" style="margin-bottom:14px;">
  <div class="panel-head"><h2>Findings at publish</h2><span class="meta" style="font-size:11.5px;"><%= findingSnaps.length %></span></div>
  <% if (findingSnaps.length === 0) { %>
    <div class="panel-pad meta" style="font-size:12.5px;">No findings in this version.</div>
  <% } else { %>
    <% const sevColor = { 'CRITICAL':'#b91c1c', 'HIGH':'#dc2626', 'MEDIUM':'#a16207', 'LOW':'var(--text-tertiary)' }; %>
    <table class="t">
      <thead>
        <tr>
          <th style="width:90px">Severity</th>
          <th>Title</th>
          <th style="width:120px">Subcategory</th>
          <th style="width:110px">Status</th>
        </tr>
      </thead>
      <tbody>
        <% findingSnaps.forEach(f => { %>
          <tr>
            <td><span class="tag" style="background:<%= sevColor[f.severity] || 'var(--bg-subtle)' %>;color:#fff;font-size:11px;font-weight:600;"><%= f.severity %></span></td>
            <td style="font-size:12.5px;"><%= f.title %></td>
            <td class="mono" style="font-size:11.5px;"><%= f.sub_code || (f.promoted_to_engagement_theme ? '(theme)' : '-') %></td>
            <td class="meta" style="font-size:11.5px;"><%= f.status %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/footer') %>
