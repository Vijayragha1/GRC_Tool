<%- include('partials/header', { title: 'ISO 42001 readiness', user, ws, active: 'iso42001-readiness' }) %>

<style>
  @media(max-width:760px){
    .iso42-readiness-head{align-items:stretch!important;flex-direction:column;width:100%}
    .iso42-readiness-head>a{width:100%}
    .iso42-readiness-head>div{text-align:left!important}
    .iso42-readiness-kpis{grid-template-columns:repeat(2,minmax(0,1fr))!important}
    .iso42-readiness-main{grid-template-columns:minmax(0,1fr)!important}
    .iso42-readiness-status{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:14px!important}
  }
  @media(max-width:360px){.iso42-readiness-kpis{grid-template-columns:minmax(0,1fr)!important}}
</style>

<div class="page-head">
  <div>
    <h1 class="page-title">ISO 42001 certification readiness</h1>
    <div class="page-subtitle">Live assessment against ISO/IEC 42001:2023 Stage 1 (documentation) and Stage 2 (operational) audit requirements.</div>
  </div>
  <div class="iso42-readiness-head" style="display:flex;align-items:center;gap:14px;">
    <a href="/workspaces/<%= ws.id %>/iso42001/readiness/blockers" class="btn btn-primary btn-xs">Pre-cert blocker check →</a>
    <% if (r.daysToTarget !== null) { %>
      <div style="text-align:right">
        <div class="kpi-num num" style="color:<%= r.daysToTarget < 30 ? '#b91c1c' : r.daysToTarget < 90 ? '#a16207' : 'var(--text)' %>"><%= r.daysToTarget %><span class="text-lg text-tertiary" style="font-weight:400;"> days</span></div>
        <div class="meta">to target cert &middot; <%= ws.target_cert_date %></div>
      </div>
    <% } %>
  </div>
</div>

<div class="callout" style="margin-bottom:16px"><strong>Compliance Sphere ISO 42001 Readiness Method v2026.1.</strong> The readiness bands and 0 to 4 capability scale are proprietary consulting measures. They are not an ISO score and do not replace a certification body's audit decision.</div>

<div class="iso42-readiness-kpis" style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:24px;">
  <div class="panel kpi">
    <div class="kpi-num" style="color:<%= r.stage1 >= 80 ? '#15803d' : r.stage1 >= 50 ? '#a16207' : '#b91c1c' %>"><%= r.stage1 %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-label">Stage 1 readiness</div>
    <div class="kpi-meta">documentation &amp; AIMS framework</div>
  </div>
  <div class="panel kpi">
    <div class="kpi-num" style="color:<%= r.stage2 >= 80 ? '#15803d' : r.stage2 >= 50 ? '#a16207' : '#b91c1c' %>"><%= r.stage2 %><span class="text-xl text-tertiary" style="font-weight:400;">%</span></div>
    <div class="kpi-label">Stage 2 readiness</div>
    <div class="kpi-meta">operational effectiveness</div>
  </div>
  <div class="panel kpi">
    <div class="kpi-num"><%= r.records.found %><span class="text-tertiary" style="font-weight:400;">/<%= r.records.total %></span></div>
    <div class="kpi-label">Documented information</div>
    <div class="kpi-meta">mandatory + expected per ISO 42001</div>
  </div>
  <div class="panel kpi">
    <div class="kpi-num num"><%= r.metrics.avgMaturity %></div>
    <div class="kpi-label">Average maturity</div>
    <div class="kpi-meta">Compliance Sphere 0 to 4 capability scale</div>
  </div>
</div>

<div class="iso42-readiness-main" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
  <div class="panel">
    <div class="panel-head"><h2>Detected gaps</h2><span class="meta"><%= r.flags.length %> total</span></div>
    <% if (r.flags.length === 0) { %>
      <div class="t-empty text-success">No gaps detected.</div>
    <% } else { %>
      <div class="divide-row">
        <% r.flags.forEach(f => { %>
          <div style="padding:12px 16px;border-bottom:1px solid var(--border);">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;">
              <div style="flex:1;min-width:0;">
                <div class="text-lg" style="font-weight:500;line-height:1.4;"><%= f.label %></div>
                <% if (f.items.length) { %>
                  <ul class="text-base text-secondary" style="margin-top:6px;list-style:none;padding:0;">
                    <% f.items.slice(0, 5).forEach(it => { %>
                      <li style="padding:1px 0;">·
                        <% if (it.id && (String(it.id).startsWith('ai-clause') || String(it.id).startsWith('ai-annex'))) { %>
                          <a href="/workspaces/<%= ws.id %>/iso42001/gap/<%= it.id %>" class="link-muted"><%= it.title %></a>
                        <% } else if (f.kind === 'open_ncs') { %>
                          <a href="/workspaces/<%= ws.id %>/nonconformities/<%= it.id %>" class="link-muted"><%= it.title %></a>
                        <% } else { %><%= it.title %><% } %>
                      </li>
                    <% }) %>
                    <% if (f.items.length > 5) { %><li class="text-tertiary">… and <%= f.items.length - 5 %> more</li><% } %>
                  </ul>
                <% } %>
              </div>
              <span class="tag <%= f.severity === 'high' ? 'tag-danger' : 'tag-warn' %>"><%= f.severity %></span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Documented information</h2><span class="meta">Heuristic - confirm manually</span></div>
    <div class="panel-pad">
      <div class="text-xs text-tertiary" style="font-weight:500;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:8px;">Mandatory per ISO 42001:2023 (<%= r.records.mandatory.found %>/<%= r.records.mandatory.total %>)</div>
      <div class="text-lg" style="display:grid;grid-template-columns:1fr;gap:6px;margin-bottom:16px;">
        <% r.records.mandatory.checks.forEach(c => { %>
          <div style="display:flex;align-items:flex-start;gap:8px;">
            <span style="flex-shrink:0;font-weight: 500;color:<%= c.found ? '#15803d' : '#b91c1c' %>;"><%= c.found ? '✓' : '✗' %></span>
            <div style="flex:1;">
              <span style="<%= c.found ? 'color:var(--text-secondary)' : 'color:var(--text);font-weight:500' %>"><%= c.name %></span>
              <span class="mono meta" style="margin-left:6px;">Cl. <%= c.clause %></span>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="text-xs text-tertiary" style="font-weight:500;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:8px;">Expected if related Annex A control is included (<%= r.records.expected.found %>/<%= r.records.expected.total %>)</div>
      <div class="text-lg" style="display:grid;grid-template-columns:1fr;gap:6px;">
        <% r.records.expected.checks.forEach(c => { %>
          <div style="display:flex;align-items:flex-start;gap:8px;">
            <span style="flex-shrink:0;font-weight: 500;color:<%= c.found ? '#15803d' : 'var(--text-tertiary)' %>;"><%= c.found ? '✓' : '○' %></span>
            <div style="flex:1;">
              <span class="text-secondary"><%= c.name %></span>
              <span class="mono meta" style="margin-left:6px;"><%= c.clause %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<div class="panel">
  <div class="panel-head"><h2>Control implementation status</h2></div>
  <div class="panel-pad iso42-readiness-status" style="display:grid;grid-template-columns:repeat(6,1fr);gap:16px;">
    <div><div class="kpi-num num text-success"><%= r.metrics.implemented %></div><div class="kpi-meta">Implemented</div></div>
    <div><div class="kpi-num num text-warn"><%= r.metrics.partial %></div><div class="kpi-meta">Partial</div></div>
    <div><div class="kpi-num num" style="color:#1d4ed8"><%= r.metrics.wip %></div><div class="kpi-meta">In progress</div></div>
    <div><div class="kpi-num num text-danger"><%= r.metrics.notImpl %></div><div class="kpi-meta">Not implemented</div></div>
    <div><div class="kpi-num num text-tertiary"><%= r.metrics.na %></div><div class="kpi-meta">N/A</div></div>
    <div><div class="kpi-num num"><%= r.metrics.evidenceCount %></div><div class="kpi-meta">Evidence files</div></div>
  </div>
</div>

<%- include('partials/footer') %>
