<%#
  The band at the top of every ISO 42001 page. The runway is the
  engagement's stages, each a link to its page; the stage the open page
  belongs to is marked. The strip is the whole
  standard: 27 clauses then 38 Annex A controls, each coloured by its
  conclusion and linked to its assessment. The requirement a consultant just
  saved flips into its new colour when the next page opens; nothing else moves.
%>
<header class="a42-mast" aria-label="ISO/IEC 42001 engagement">
  <div class="a42-mast-top">
    <div class="a42-mast-id">
      <span class="a42-mast-std">ISO/IEC 42001 · AI management system</span>
      <span class="a42-mast-client"><%= ws.client_name %></span>
    </div>
    <ol class="a42-mast-runway" aria-label="Engagement stages">
      <% mast.stages.forEach(s => { %>
        <li class="<%= [s.done ? 'is-done' : s.current ? 'is-current' : '', s.key === here ? 'is-here' : ''].filter(Boolean).join(' ') %>"<%- s.current ? ' aria-current="step"' : '' %>><a href="<%= mast.base %>/stages/<%= s.key %>"<%- s.key === here ? ' aria-current="page"' : '' %>><%= s.name %></a></li>
      <% }) %>
    </ol>
  </div>
  <div class="a42-strip">
    <a class="a42-strip-count" href="<%= mast.base %>/gap-assessment"><strong><%= mast.assessed %></strong> of <%= mast.total %> requirements concluded<% if (!mast.hasPlan) { %><span> · no delivery plan yet</span><% } else if (mast.phaseName) { %><span> · <%= mast.phaseName %></span><% } %></a>
    <div class="a42-strip-cells" aria-hidden="true">
      <% [['Clauses 4 to 10', mast.clauses], ['Annex A', mast.controls]].forEach(([label, list]) => { %>
        <div class="a42-strip-group" style="--n:<%= list.length %>">
          <div class="a42-strip-row">
            <% list.forEach(r => { %><a class="a42-cell t-<%= r.tone %><%= r.id === currentItem ? ' is-here' : '' %>" href="<%= mast.base %>/gap/<%= r.id %>" tabindex="-1" data-id="<%= r.id %>" data-label="<%= r.ref %> · <%= r.title %> · <%= r.status %>"></a><% }) %>
          </div>
          <span class="a42-strip-label"><%= label %></span>
        </div>
      <% }) %>
    </div>
  </div>
  <% if (journey && !['iso42001-overview', 'iso42001-path'].includes(active)) {
       // The next step on the engagement's path, or where this page sits on it.
       // The overview and the path page lead with it already.
       const onPage = journey.forPage(active);
       const nx = journey.next;
  %>
    <div class="a42-path">
      <% if (!nx) { %>
        <p><strong>Every step is done.</strong> The AIMS now runs: keep answering concerns and prepare for the surveillance audits.</p>
      <% } else if (onPage && onPage.key === nx.key) { %>
        <p><span class="a42-path-step">Step <%= nx.number %> of <%= journey.total %></span> <strong><%= nx.title %></strong> is done on this page<% if (nx.detail) { %><span class="a42-path-detail"> · <%= nx.detail %></span><% } %></p>
        <a class="btn btn-secondary btn-xs" href="<%= mast.base %>/path">The whole path</a>
      <% } else if (onPage && onPage.status === 'done') { %>
        <p><span class="a42-path-step">Step <%= onPage.number %> is done.</span> <%= nx.number < onPage.number ? `Step ${nx.number} is still open:` : `Next, step ${nx.number} of ${journey.total}:` %> <strong><%= nx.title %></strong></p>
        <a class="btn btn-primary btn-xs" href="<%= nx.href %>">Go to step <%= nx.number %> <span aria-hidden="true">→</span></a>
      <% } else if (onPage && nx.number < onPage.number) { %>
        <p><span class="a42-path-step">This page is step <%= onPage.number %> of <%= journey.total %>.</span> Step <%= nx.number %> comes first: <strong><%= nx.title %></strong></p>
        <a class="btn btn-primary btn-xs" href="<%= nx.href %>">Go to step <%= nx.number %> <span aria-hidden="true">→</span></a>
      <% } else { %>
        <p><span class="a42-path-step">Next, step <%= nx.number %> of <%= journey.total %></span> <strong><%= nx.title %></strong><% if (nx.detail) { %><span class="a42-path-detail"> · <%= nx.detail %></span><% } %></p>
        <a class="btn btn-primary btn-xs" href="<%= nx.href %>">Start <span aria-hidden="true">→</span></a>
      <% } %>
    </div>
  <% } %>
</header>
<script>
(function () {
  // Flip the requirement saved on the previous page into its new colour.
  let saved = null;
  try { saved = sessionStorage.getItem('a42-saved'); sessionStorage.removeItem('a42-saved'); } catch (_) {}
  if (!saved) return;
  const flip = () => document.querySelectorAll('.a42-cell[data-id="' + CSS.escape(saved) + '"], .a42-tile[data-id="' + CSS.escape(saved) + '"]')
    .forEach(el => el.classList.add('is-fresh'));
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', flip, { once: true });
  else flip();
})();
</script>
