      <div class="avatar" style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#71717a,#52525b);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;font-size:11px;flex-shrink:0;"><%= user.name.charAt(0).toUpperCase() %></div>
      <div style="min-width:0;flex:1;">
        <div style="font-size:13px;font-weight:500;line-height:1.2;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= user.name %></div>
        <div style="font-size:10.5px;color:rgba(255,255,255,0.4);">local · no auth</div>
      </div>
      <form method="POST" action="/i18n/switch" style="margin:0;">
        <select name="locale" onchange="this.form.submit()" style="background:transparent;border:0;color:rgba(255,255,255,0.5);font-size:11px;cursor:pointer;outline:none;font-family:inherit;">
          <option value="en" <%= user.locale === 'en' ? 'selected' : '' %> style="color:#000">EN</option>
          <option value="es" <%= user.locale === 'es' ? 'selected' : '' %> style="color:#000">ES</option>
        </select>
      </form>
      <button onclick="toggleTheme()" title="Toggle theme" style="background:transparent;border:0;color:rgba(255,255,255,0.5);cursor:pointer;padding:4px;display:flex;align-items:center;border-radius:4px;transition:all 0.12s;" onmouseover="this.style.color='#fff';this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.color='rgba(255,255,255,0.5)';this.style.background='transparent'">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
  </aside>

  <main class="main">
    <div class="main-inner">
      <div class="topbar">
        <button class="icon-btn menu-toggle" onclick="toggleSidebar(true)" title="Menu" aria-label="Open menu">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <button class="icon-btn" onclick="toggleSidebarCollapse()" title="Collapse sidebar" aria-label="Collapse sidebar" style="display:none">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
        </button>
        <button class="palette-trigger" onclick="openPalette()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span>Search or jump to…</span>
          <span class="kbd" id="kbdHint">⌘K</span>
        </button>
        <% if (typeof entitySelectorWs !== 'undefined' && entitySelectorWs && typeof workspaceEntities !== 'undefined' && workspaceEntities && workspaceEntities.length) { %>
          <form method="POST" action="/workspaces/<%= entitySelectorWs.id %>/entities/select" style="margin-left:6px;">
            <input type="hidden" name="return_to" value="<%= typeof returnTo !== 'undefined' ? returnTo : '' %>">
            <select name="entity_id" class="select" style="font-size:12px;padding:5px 28px 5px 10px;width:auto;min-width:160px;height:30px;" onchange="this.form.submit()">
              <option value="">All entities (workspace-wide)</option>
              <% workspaceEntities.forEach(e => { %>
                <option value="<%= e.id %>" <%= (typeof activeEntity !== 'undefined' && activeEntity && activeEntity.id === e.id) ? 'selected' : '' %>><%= e.name %><% if (e.code) { %> · <%= e.code %><% } %></option>
              <% }) %>
            </select>
          </form>
        <% } %>
        <div class="topbar-spacer"></div>
        <% if (typeof entitySelectorWs !== 'undefined' && entitySelectorWs) { %>
          <a href="/workspaces/<%= entitySelectorWs.id %>/notifications" class="icon-btn" title="Notifications" style="position:relative;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
              <span style="position:absolute;top:-3px;right:-3px;background:#dc2626;color:white;font-size:9.5px;font-weight:600;border-radius:9px;min-width:14px;height:14px;display:flex;align-items:center;justify-content:center;padding:0 3px;"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
            <% } %>
          </a>
        <% } %>
        <button class="icon-btn" onclick="openHelp()" title="Keyboard shortcuts (?)" aria-label="Help">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </button>
      </div>
<% } else { %>
<div class="app" style="background:var(--bg-deep)">
  <main class="main">
    <div class="main-inner" style="max-width:420px;">
<% } %>
