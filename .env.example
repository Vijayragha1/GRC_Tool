# GRC Tool — environment variables
# Copy to .env and fill in values:  cp .env.example .env

NODE_ENV=production
PORT=3000

# Required: generate with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
ISMS_MASTER_KEY=

# Optional: Email integration via Resend
# RESEND_API_KEY=
# EMAIL_FROM_DEFAULT="ISMS <noreply@yourdomain.com>"

# Optional: Set to your public URL (used in email links)
# APP_BASE_URL=https://yourdomain.com
