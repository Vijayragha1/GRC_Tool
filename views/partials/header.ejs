<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<%# Cross-document View Transitions - modern browsers (Chrome/Edge/Safari) %>
<%# cross-fade between same-origin navigations so clicking a sidebar item %>
<%# stops feeling like an abrupt scroll-to-top jump. Firefox ignores this %>
<%# and falls back to the default behaviour gracefully. %>
<meta name="view-transition" content="same-origin">
<title><%= typeof title !== 'undefined' ? title : 'Dashboard' %> · Compliance Sphere</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3">
<link rel="stylesheet" href="/fonts/inter.css">
<style>
  /* Cross-document view transitions on same-origin navigations. The browser
     animates a soft cross-fade between the old and new page so clicking a
     sidebar item no longer feels like a scroll-to-top jolt. Speed kept tight
     so the transition is felt but never delayed. */
  @view-transition { navigation: auto; }
  ::view-transition-old(root),
  ::view-transition-new(root) { animation-duration: 180ms; }

  :root {
    /* Compliance Sphere palette - cream + charcoal + warm grey, matches the
       auth screens (FAFAF8 / d8d6cf / 1a1a1a). Replaces the old oxblood
       accent + neutral-greys palette. */
    --bg: #ffffff;
    --bg-subtle: #f6f5ef;
    --bg-muted: #f0eee7;
    --bg-deep: #FAFAF8;
    --border: #ecebe5;
    --border-strong: #d8d6cf;
    --text: #1a1a1a;
    --text-secondary: #6b6b66;
    --text-tertiary: #8a8a87;
    --accent: #1a1a1a;
    --accent-soft: rgba(26,26,26,0.06);
    --accent-deep: #000000;
    --ink: #1a1a1a;
    --shadow-sm: 0 1px 2px rgba(15,15,18,0.04);
    --shadow-md: 0 1px 3px rgba(15,15,18,0.05), 0 1px 2px rgba(15,15,18,0.03);
    --shadow-lg: 0 4px 12px rgba(15,15,18,0.06), 0 1px 3px rgba(15,15,18,0.04);
    --shadow-xl: 0 20px 50px rgba(15,15,18,0.18), 0 4px 12px rgba(15,15,18,0.08);
    --radius: 6px;
    --radius-sm: 6px;
  }
  [data-theme="dark"] {
    --bg: #0f0f12;
    --bg-subtle: #18181b;
    --bg-muted: #27272a;
    --bg-deep: #09090b;
    --border: #27272a;
    --border-strong: #3f3f46;
    --text: #f4f4f5;
    --text-secondary: #a1a1aa;
    --text-tertiary: #71717a;
    /* Faded oxblood for dark mode — pure #5C0A0A goes invisible on dark bg.
       D49595 reads as the same hue at sufficient contrast. */
    --accent: #D49595;
    --accent-soft: rgba(212,149,149,0.12);
    --accent-deep: #ECCCCC;
    --ink: #fafafa;
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.3);
    --shadow-md: 0 1px 3px rgba(0,0,0,0.4);
    --shadow-lg: 0 4px 12px rgba(0,0,0,0.4);
    --shadow-xl: 0 20px 50px rgba(0,0,0,0.6);
  }
  /* System sans stack - native rendering on every platform, no FOIT,
     no third-party font load. Inter falls in as a graceful upgrade only
     when the local system happens to have it installed. */
  html { font-family: -apple-system, BlinkMacSystemFont, 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  body { background: var(--bg-deep); color: var(--text); font-size: 14px; line-height: 1.5; font-feature-settings: "ss01","cv11"; transition: background 0.15s, color 0.15s; }

  /* Headings: Inter at weight 500 with tight tracking. Matches the
     Compliance Sphere auth screens (22px h1, weight 500, -0.4px tracking)
     and drops the Source Serif 4 dependency from titles. */
  .page-title, .empty-title, .a-page-title, h1.serif, h2.serif {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  *, *::before, *::after { box-sizing: border-box; }
  .mono { font-family: ui-monospace, 'SF Mono', Menlo, monospace; font-feature-settings: "ss01"; }
  .num { font-variant-numeric: tabular-nums; }

  /* The product's visual fingerprint. ISO clause + Annex A references get a
     dotted underline in the accent colour. Reads as a properly-annotated
     audit-firm document; signals "we care about the standard, not just the
     dashboard." Quiet on its own, distinctive across the product. */
  .iso-ref {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-feature-settings: "ss01";
    font-size: 0.92em;
    font-weight: 500;
    color: var(--accent);
    text-decoration: underline dotted var(--accent);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  a.iso-ref { text-decoration: underline dotted var(--accent); }
  a.iso-ref:hover { color: var(--accent-deep); text-decoration-style: solid; }

  /* Layout */
  /* Lock body scroll. Main content scrolls in its own viewport so the sidebar
     genuinely never moves and a sidebar click doesn't feel like the whole
     page jumps. The body becomes a fixed-size flex container; vertical
     scrolling lives entirely on .main. */
  html, body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  .app { display: flex; height: 100vh; height: 100dvh; }
  .sidebar {
    width: 248px; flex-shrink: 0;
    background: #F2F1EC;
    color: var(--text-secondary);
    border-right: 1px solid var(--border);
    display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh;
    transition: width 0.18s cubic-bezier(.4,0,.2,1), transform 0.18s cubic-bezier(.4,0,.2,1);
  }
  .sidebar-section { padding: 14px 14px; border-bottom: 1px solid var(--border); transition: padding 0.18s; }
  .sidebar-nav { flex: 1; padding: 10px 8px; overflow-y: auto; overflow-x: hidden; }
  .sidebar-foot { padding: 14px; border-top: 1px solid var(--border); display: flex; align-items: center; gap: 8px; }
  .sidebar-nav::-webkit-scrollbar { width: 5px; }
  .sidebar-nav::-webkit-scrollbar-thumb { background: rgba(26,26,26,0.12); border-radius: 3px; }
  .nav-group-label { font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.6px; color: var(--text-tertiary); padding: 14px 10px 6px; transition: opacity 0.12s; white-space: nowrap; }
  .nav-item {
    display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 6px;
    font-size: 13px; color: var(--text-secondary); text-decoration: none; line-height: 1.4;
    transition: all 0.12s ease; position: relative; white-space: nowrap; overflow: hidden;
  }
  .nav-item:hover { background: rgba(26,26,26,0.05); color: var(--text); }
  .nav-item.active { background: rgba(26,26,26,0.07); color: var(--text); font-weight: 500; }
  .nav-item.active::before { content: ''; position: absolute; left: -8px; top: 8px; bottom: 8px; width: 2px; background: var(--accent); border-radius: 0 2px 2px 0; }
  .nav-item .ico { width: 14px; height: 14px; flex-shrink: 0; opacity: 0.65; }
  .nav-item.active .ico { opacity: 1; }
  .nav-item-text { transition: opacity 0.12s; }

  /* Brand-mark - quiet outlined square in the new charcoal-on-cream palette. */
  .brand-mark {
    width: 24px; height: 24px; border-radius: 3px;
    background: transparent;
    border: 1px solid var(--border-strong);
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--text); font-weight: 500; font-size: 13px;
    font-family: 'Inter', system-ui, sans-serif;
    flex-shrink: 0;
  }

  /* Sidebar collapsed */
  .app.sidebar-collapsed .sidebar { width: 60px; }
  .app.sidebar-collapsed .sidebar-section > a > div,
  .app.sidebar-collapsed .nav-group-label,
  .app.sidebar-collapsed .nav-item-text,
  .app.sidebar-collapsed .ws-context > *,
  .app.sidebar-collapsed .sidebar-foot > div:not(.avatar) { display: none; }
  .app.sidebar-collapsed .sidebar-section { padding: 14px 8px; }
  .app.sidebar-collapsed .sidebar-foot { justify-content: center; padding: 14px 8px; }
  .app.sidebar-collapsed .nav-item { justify-content: center; padding: 8px; }

  /* Mobile drawer */
  .menu-toggle { display: none; }
  @media (max-width: 900px) {
    .sidebar { position: fixed; z-index: 60; transform: translateX(-100%); box-shadow: var(--shadow-xl); }
    .sidebar.open { transform: translateX(0); }
    .sidebar-backdrop { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 55; }
    .sidebar-backdrop.open { display: block; }
    .menu-toggle { display: inline-flex; }
  }

  .main { flex: 1; min-width: 0; background: var(--bg-deep); height: 100vh; height: 100dvh; overflow-y: auto; overflow-x: hidden; scroll-behavior: smooth; }
  .main-inner { max-width: 1280px; margin: 0 auto; padding: 22px 28px 72px; }
  @media (max-width: 600px) { .main-inner { padding: 16px 14px 48px; } }

  .topbar { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
  .topbar-spacer { flex: 1; }
  .palette-trigger {
    display: inline-flex; align-items: center; gap: 8px; padding: 6px 10px 6px 12px;
    background: var(--bg); border: 1px solid var(--border-strong); border-radius: 7px;
    font-size: 12.5px; color: var(--text-tertiary); cursor: pointer; transition: all 0.12s;
    box-shadow: var(--shadow-sm); font-family: inherit; min-width: 220px;
  }
  .palette-trigger:hover { border-color: var(--text-tertiary); color: var(--text-secondary); }
  .palette-trigger .kbd { margin-left: auto; padding: 1px 5px; font-size: 10.5px; background: var(--bg-muted); border: 1px solid var(--border); border-radius: 3px; color: var(--text-tertiary); font-family: ui-monospace, monospace; }
  .icon-btn { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 6px; background: var(--bg); border: 1px solid var(--border-strong); color: var(--text-secondary); cursor: pointer; transition: all 0.12s; box-shadow: var(--shadow-sm); }
  .icon-btn:hover { background: var(--bg-subtle); color: var(--text); }

  .page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 18px; }

  /* Subtab strip — shared by activity / audit / risk / soa / iso42001-soa
     tab partials. Was duplicated as inline styles in five places; now one
     class. Tabs sit on a 1px border-bottom; active tab gets the oxblood
     2px underline + ink colour. */
  .subtabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); margin-bottom: 18px; }
  .subtab {
    padding: 8px 16px; font-size: 13px; font-weight: 500;
    color: var(--text-secondary); text-decoration: none;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
    transition: color 0.12s, border-color 0.12s;
  }
  .subtab:hover { color: var(--text); }
  .subtab.is-active { color: var(--ink); font-weight: 500; border-bottom-color: var(--accent); }
  /* Page title - 22px / weight 500 / -0.4px tracking. Letter-spacing scales
     with size; positive tracking is reserved for uppercase micro-labels
     (column headers, eyebrows, REFERENCE/ADMIN sidebar labels). */
  .page-title { font-size: 22px; font-weight: 500; line-height: 1.2; color: var(--ink); letter-spacing: -0.4px; }
  .page-subtitle { font-size: 13px; color: var(--text-secondary); margin-top: 6px; max-width: 720px; }

  /* Surfaces. Density pass: panel padding 20→16, head padding 12→10. Pages
     used to feel "Vercel airy"; they now feel "Bloomberg dense" — which is
     what professional-services tools should feel like. */
  .panel { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow-sm); }
  .panel-pad { padding: 16px; }
  .panel-tight { padding: 12px 16px; }
  .panel-head { padding: 10px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .panel-head h2, .panel-head h3 { font-size: 13px; font-weight: 500; letter-spacing: -0.005em; color: var(--ink); }
  .divide-row > * + * { border-top: 1px solid var(--border); }

  /* Buttons */
  .btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 500; line-height: 1.2; transition: all 0.12s; cursor: pointer; border: 1px solid transparent; white-space: nowrap; user-select: none; font-family: inherit; text-decoration: none; }
  a.btn, a.btn:hover, a.btn:visited { text-decoration: none; }
  .btn-primary { background: var(--ink); color: var(--bg); border-color: var(--ink); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, var(--shadow-sm); }
  [data-theme="dark"] .btn-primary { background: var(--bg); color: var(--ink); border-color: var(--bg); }
  .btn-primary:hover { transform: translateY(-0.5px); box-shadow: var(--shadow-md); }
  .btn-secondary { background: var(--bg); color: var(--text); border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
  .btn-secondary:hover { background: var(--bg-subtle); border-color: var(--text-tertiary); }
  .btn-ghost { background: transparent; color: var(--text-secondary); }
  .btn-ghost:hover { background: var(--bg-muted); color: var(--text); }
  .btn-danger { background: var(--bg); color: #b91c1c; border-color: #fecaca; box-shadow: var(--shadow-sm); }
  [data-theme="dark"] .btn-danger { background: rgba(220,38,38,0.1); color: #fca5a5; border-color: rgba(220,38,38,0.3); }
  .btn-danger:hover { background: #fef2f2; }
  [data-theme="dark"] .btn-danger:hover { background: rgba(220,38,38,0.2); }
  .btn-accent { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn-accent:hover { background: var(--accent-deep); }
  .btn-xs { padding: 4px 10px; font-size: 12px; }

  .link { color: var(--text); text-decoration: none; border-bottom: 1px solid var(--border-strong); transition: border-color 0.12s; }
  .link:hover { border-bottom-color: var(--text); }
  .link-muted { color: var(--text-secondary); text-decoration: none; transition: color 0.12s; }
  .link-muted:hover { color: var(--text); }

  /* Inputs */
  .input, .select, .textarea {
    width: 100%; padding: 7px 11px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
    font-size: 13px; background: var(--bg); color: var(--text); font-family: inherit;
    transition: all 0.12s; box-shadow: var(--shadow-sm);
  }
  .input:hover, .select:hover, .textarea:hover { border-color: var(--text-tertiary); }
  .input:focus, .select:focus, .textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .input::placeholder, .textarea::placeholder { color: var(--text-tertiary); }
  .input:disabled { background: var(--bg-muted); color: var(--text-tertiary); cursor: not-allowed; }
  .label { display: block; font-size: 12px; font-weight: 500; color: var(--text-secondary); margin-bottom: 5px; letter-spacing: -0.005em; }

  select.select {
    appearance: none; -webkit-appearance: none; -moz-appearance: none;
    padding-right: 32px;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6' fill='none'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%2351525c' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat; background-position: right 11px center; background-size: 10px 6px;
    cursor: pointer;
  }
  [data-theme="dark"] select.select {
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6' fill='none'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%23a1a1aa' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
  }
  select.select::-ms-expand { display: none; }
  select.select option { padding: 4px; background: var(--bg); color: var(--text); }
  select.select optgroup { font-weight: 500; color: var(--text); }

  input[type="checkbox"] {
    appearance: none; -webkit-appearance: none;
    width: 15px; height: 15px; border: 1.5px solid var(--border-strong); border-radius: 4px;
    background: var(--bg); cursor: pointer; position: relative; vertical-align: -2px;
    transition: all 0.12s; flex-shrink: 0;
  }
  input[type="checkbox"]:hover { border-color: var(--text-secondary); }
  input[type="checkbox"]:checked { background: var(--accent); border-color: var(--accent); }
  input[type="checkbox"]:checked::after {
    content: ''; position: absolute; top: 1px; left: 4px; width: 4px; height: 8px;
    border: solid white; border-width: 0 2px 2px 0; transform: rotate(45deg);
  }
  input[type="checkbox"]:focus { outline: none; box-shadow: 0 0 0 3px var(--accent-soft); }

  input[type="file"] { font-size: 12px; color: var(--text-secondary); }
  input[type="file"]::file-selector-button { padding: 6px 12px; border: 1px solid var(--border-strong); border-radius: 6px; background: var(--bg); color: var(--text); font-size: 12px; font-weight: 500; cursor: pointer; margin-right: 10px; transition: all 0.12s; font-family: inherit; }
  input[type="file"]::file-selector-button:hover { background: var(--bg-subtle); border-color: var(--text-tertiary); }

  /* Status - QUIET TEXT, not a chip. Bold-weight semantic colour in the row,
     no pill chrome, no dot. Removes ~80% of the chip noise that LLM-generated
     SaaS reflexively scatters across every table. Where a true categorical
     badge is needed (applicability "excluded", severity "major"), use .tag. */
  .status {
    display: inline; font-size: 12px; font-weight: 500;
    white-space: nowrap; letter-spacing: 0.005em;
    text-transform: capitalize;
  }
  /* GREEN - done/good */
  .s-implemented, .s-included, .s-done, .s-closed, .s-verified { color: #15803d; }
  /* AMBER - partial/in-review */
  .s-partial, .s-partially-implemented, .s-in_review, .s-accepted, .s-minor { color: #b45309; }
  /* BLUE - in-progress/treated */
  .s-progress, .s-work-in-progress, .s-in_progress, .s-treated { color: #1d4ed8; }
  /* RED - open/blocked/major/excluded/not-implemented */
  .s-not-impl, .s-not-implemented, .s-excluded, .s-blocked, .s-open, .s-major { color: #b91c1c; }
  /* GREY - neutral/na/undecided/todo */
  .s-na, .s-not-applicable, .s-not-assessed, .s-undecided, .s-todo, .s-observation { color: #52525b; }

  /* Tag chips kept for categorical badges (applicability, severity, finding
     type) where a real visual chip is warranted. Refined to outlined style,
     not filled — quieter than the original "background fill + border" combo. */
  .tag {
    display: inline-flex; align-items: center;
    padding: 2px 8px; border-radius: 3px;
    font-size: 11px; font-weight: 500; line-height: 1.5;
    letter-spacing: 0.02em; text-transform: uppercase;
    background: transparent;
    border: 1px solid currentColor;
  }
  .tag-neutral { color: #52525b; }
  .tag-success { color: #15803d; }
  .tag-warn    { color: #b45309; }
  .tag-danger  { color: #b91c1c; }
  .tag-info    { color: var(--accent-deep); }
  .tag-accent  { background: var(--accent); color: #fff; border-color: var(--accent); }

  /* Tables. Density pass: rows from 11×16 to 8×14 — ~25% more rows per
     screen, matches the density Bloomberg / Carta / Big-4 audit dashboards
     use. The table is the primary surface of an audit tool; let it breathe
     less and earn more screen. */
  table.t { width: 100%; border-collapse: collapse; font-size: 13px; }
  table.t thead th { text-align: left; padding: 7px 14px; font-size: 10.5px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-tertiary); background: var(--bg-subtle); border-bottom: 1px solid var(--border); }
  table.t tbody td { padding: 8px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  table.t tbody tr:last-child td { border-bottom: none; }
  table.t tbody tr { transition: background 0.08s; }
  table.t tbody tr:hover { background: var(--bg-subtle); }
  .t-empty { padding: 40px 14px; text-align: center; color: var(--text-tertiary); font-size: 13px; }

  /* Empty state. Refined from "centered icon + 380px copy block" (the
     reflexive LLM/SaaS pattern) to a quieter typographic note: serif title,
     no icon backplate, slightly more space for the explanation. Reads as a
     deliberate note rather than a placeholder card. */
  .empty-state { padding: 44px 24px; text-align: center; }
  .empty-icon {
    width: 28px; height: 28px; margin: 0 auto 10px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--text-tertiary);
    /* The backplate tile is gone — the SVG sits on the page colour. */
  }
  .empty-title {
    font-size: 17px; font-weight: 500; letter-spacing: -0.01em;
    color: var(--ink); margin-bottom: 6px;
    letter-spacing: -0.005em;
  }
  .empty-sub { font-size: 13px; color: var(--text-secondary); max-width: 460px; margin: 0 auto 14px; line-height: 1.55; }

  /* KPI tile - left health-rail, icon slot, delta line */
  /* Stat tile - the four-card grid that used to feel like generic SaaS
     (30px numbers, uppercase eyebrows, coloured left strip) is now tightened:
     ~20px numbers, sentence-case labels, no accent strip. State signal moves
     onto the number itself rather than a chrome decoration. */
  .kpi { padding: 12px 14px; transition: all 0.15s; }
  a.kpi:hover { border-color: var(--text-tertiary); }
  .kpi-head { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; min-height: 16px; }
  .kpi-icon { width: 14px; height: 14px; color: var(--text-tertiary); flex-shrink: 0; }
  .kpi-label { font-size: 12px; color: var(--text-secondary); font-weight: 400; }
  .kpi-num { font-size: 20px; font-weight: 500; letter-spacing: -0.3px; line-height: 1.15; color: var(--ink); font-variant-numeric: tabular-nums; }
  .kpi-meta { font-size: 11px; color: var(--text-tertiary); margin-top: 4px; font-variant-numeric: tabular-nums; }
  /* Health-rail variants - call attention to red/amber metrics */
  /* State variants: signal moves onto the number colour. The old left-strip
     decoration ::before is dropped. Inline border-left on the .kpi element
     (set in some views) is preserved as a soft accent. */
  .kpi-good .kpi-num { color: #15803d; }
  .kpi-warn .kpi-num { color: #b45309; }
  .kpi-bad .kpi-num { color: #b91c1c; }
  .kpi-accent .kpi-num { color: var(--accent); }
  /* Delta - a tiny chip showing change since last period */
  .kpi-delta { display: inline-flex; align-items: center; gap: 3px; font-size: 10.5px; font-weight: 500; padding: 2px 6px; border-radius: 999px; margin-left: auto; }
  .kpi-delta-up { color: #15803d; background: rgba(22,163,74,0.10); }
  .kpi-delta-down { color: #b91c1c; background: rgba(220,38,38,0.10); }
  .kpi-delta-flat { color: var(--text-tertiary); background: var(--bg-muted); }

  /* Utilities (used to be Tailwind; vendored to drop the CDN) */
  .hidden { display: none !important; }
  .contents { display: contents; }

  /* Semantic text colors - replace the inline color overrides scattered
     across views. Each one matches the exact pixel value it replaces so
     the codemod-driven swap is visually a no-op. */
  .text-secondary { color: var(--text-secondary); }
  .text-tertiary  { color: var(--text-tertiary);  }
  .text-ink       { color: var(--ink);            }
  .text-danger    { color: #b91c1c; }
  .text-warn      { color: #a16207; }
  .text-success   { color: #15803d; }
  /* Weight utility — used in 25+ overdue/emphasis spots that previously
     stamped font-weight: 500 inline alongside a colour. */
  .fw-bold        { font-weight: 500; }

  /* Layout - the only spans/grids we use enough to deserve a class.
     col-full means "stretch across all grid columns of the parent". */
  .col-full       { grid-column: 1 / -1; }

  /* Layout composites - intent-named so a reader doesn't have to mentally
     unpack a list of flex properties. Each one matches an inline-style
     shape that appears 20+ times across the views. */
  .row            { display: flex; gap: 6px; }
  .row-center     { display: flex; align-items: center; gap: 6px; }
  .stack          { display: flex; flex-direction: column; gap: 6px; }
  .grid-2         { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  /* Type scale - eight named sizes covering every pixel value in actual
     use. Half-step values (10.5/11.5/12.5) get explicit names so it's
     visible they're off the standard 6-step scale; text-eyebrow is the
     uppercase section-label size found across panels. */
  .text-xxs     { font-size: 10px;   }
  .text-eyebrow { font-size: 10.5px; }
  .text-xs      { font-size: 11px;   }
  .text-sm      { font-size: 11.5px; }
  .text-base    { font-size: 12px;   }
  .text-md      { font-size: 12.5px; }
  .text-lg      { font-size: 13px;   }
  .text-xl      { font-size: 14px;   }

  /* Misc */
  details > summary { cursor: pointer; list-style: none; }
  details > summary::-webkit-details-marker { display: none; }
  hr { border: none; border-top: 1px solid var(--border); margin: 20px 0; }
  .grid-list { display: grid; gap: 8px; }
  .meta { font-size: 12px; color: var(--text-tertiary); font-variant-numeric: tabular-nums; }
  .sec-label { font-size: 10.5px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-tertiary); margin-bottom: 8px; }

  .callout { border-left: 3px solid var(--accent); background: var(--accent-soft); padding: 12px 16px; border-radius: 6px; font-size: 13px; color: var(--text); }
  .callout-title { font-weight: 500; color: var(--accent-deep); font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 4px; }

  /* Markdown */
  .markdown h1 { font-size: 22px; font-weight: 500; margin: 18px 0 10px; letter-spacing: -0.01em; color: var(--ink); }
  .markdown h2 { font-size: 17px; font-weight: 500; margin: 16px 0 8px; color: var(--ink); }
  .markdown h3 { font-size: 14px; font-weight: 500; margin: 14px 0 6px; color: var(--ink); }
  .markdown p { margin: 8px 0; color: var(--text); }
  .markdown ul { list-style: disc; padding-left: 22px; margin: 8px 0; }
  .markdown li { margin: 3px 0; }
  .markdown table { border-collapse: collapse; margin: 10px 0; font-size: 12px; }
  .markdown th, .markdown td { border: 1px solid var(--border); padding: 5px 9px; text-align: left; }
  .markdown th { background: var(--bg-subtle); font-weight: 500; }
  .markdown code { background: var(--bg-muted); padding: 1px 5px; border-radius: 3px; font-size: 12px; font-family: ui-monospace, monospace; }
  .markdown blockquote { border-left: 3px solid var(--accent); padding-left: 12px; color: var(--text-secondary); margin: 8px 0; font-style: italic; }

  /* Command palette */
  .cp-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); z-index: 100; display: flex; align-items: flex-start; justify-content: center; padding-top: 14vh; opacity: 0; pointer-events: none; transition: opacity 0.15s; }
  .cp-backdrop.open { opacity: 1; pointer-events: auto; }
  .cp-modal { width: 100%; max-width: 600px; background: var(--bg); border: 1px solid var(--border); border-radius: 12px; box-shadow: var(--shadow-xl); overflow: hidden; transform: translateY(-8px); transition: transform 0.15s; }
  .cp-backdrop.open .cp-modal { transform: translateY(0); }
  .cp-search { display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--border); }
  .cp-search-icon { color: var(--text-tertiary); flex-shrink: 0; }
  .cp-search input { flex: 1; border: 0; outline: 0; background: transparent; font-size: 15px; color: var(--text); font-family: inherit; }
  .cp-search input::placeholder { color: var(--text-tertiary); }
  .cp-search .kbd { padding: 2px 6px; font-size: 10.5px; background: var(--bg-muted); border: 1px solid var(--border); border-radius: 3px; color: var(--text-tertiary); font-family: ui-monospace, monospace; }
  .cp-results { max-height: 380px; overflow-y: auto; padding: 6px; }
  .cp-results::-webkit-scrollbar { width: 8px; }
  .cp-results::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 4px; }
  .cp-result { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 6px; cursor: pointer; transition: background 0.08s; text-decoration: none; color: var(--text); }
  .cp-result.selected, .cp-result:hover { background: var(--bg-muted); }
  .cp-type { font-size: 10.5px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-tertiary); width: 70px; flex-shrink: 0; }
  .cp-label { flex: 1; font-size: 13px; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cp-sub { font-size: 12px; color: var(--text-tertiary); margin-left: auto; flex-shrink: 0; padding-left: 12px; }
  .cp-empty { padding: 32px; text-align: center; color: var(--text-tertiary); font-size: 13px; }
  .cp-foot { display: flex; align-items: center; gap: 12px; padding: 8px 16px; border-top: 1px solid var(--border); font-size: 11px; color: var(--text-tertiary); background: var(--bg-subtle); }
  .cp-foot .kbd { padding: 1px 5px; background: var(--bg); border: 1px solid var(--border); border-radius: 3px; font-family: ui-monospace, monospace; font-size: 10.5px; }

  /* Toasts */
  .toast-stack { position: fixed; bottom: 24px; right: 24px; display: flex; flex-direction: column; gap: 8px; z-index: 200; pointer-events: none; }
  .toast { background: var(--ink); color: var(--bg); padding: 10px 16px; border-radius: 8px; font-size: 13px; box-shadow: var(--shadow-xl); display: flex; align-items: center; gap: 10px; min-width: 240px; pointer-events: auto; animation: toastIn 0.18s cubic-bezier(.4,0,.2,1); }
  [data-theme="dark"] .toast { background: var(--bg); color: var(--ink); border: 1px solid var(--border); }
  .toast.success::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #4ade80; }
  .toast.error::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: #f87171; }
  .toast.info::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  @keyframes toastIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes toastOut { to { opacity: 0; transform: translateX(20px); } }
  .toast.leaving { animation: toastOut 0.18s forwards; }

  /* Help modal (?) */
  .help-modal .cp-modal { max-width: 460px; }
  .help-shortcuts { padding: 16px 18px; }
  .help-row { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; font-size: 13px; color: var(--text); }
  .help-row .kbd { padding: 2px 7px; background: var(--bg-muted); border: 1px solid var(--border); border-radius: 4px; font-family: ui-monospace, monospace; font-size: 11.5px; color: var(--text-secondary); }

  /* Sparkline */
  .spark { display: inline-block; vertical-align: middle; }

  @keyframes fadeIn { from { opacity: 0; transform: translateY(2px); } to { opacity: 1; transform: translateY(0); } }
  .main-inner { animation: fadeIn 0.18s ease-out; }
</style>
</head>
<body>
<% if (typeof user !== 'undefined' && user) { %>
<div class="app" id="app">
  <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar(false)"></div>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-section">
      <a href="/dashboard" style="display:flex;align-items:center;gap:8px;text-decoration:none;color:#1a1a1a;line-height:1.1;">
        <svg width="20" height="20" viewBox="0 0 22 22" aria-hidden="true" style="flex-shrink:0;">
          <circle cx="11" cy="11" r="9.5" fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
          <circle cx="11" cy="11" r="6"   fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
          <circle cx="11" cy="11" r="2.5" fill="#1a1a1a"/>
        </svg>
        <span style="font-size:14.5px;font-weight:500;color:#1a1a1a;letter-spacing:-0.2px;">Compliance Sphere</span>
      </a>
      <%# Tenant switcher: shows the active firm name below the brand.
          Static text when only one firm exists (the common case); a
          dropdown when the user has access to multiple firms. Avoids
          forcing the consultant to navigate to /tenants every time. %>
      <% if (typeof activeFirm !== 'undefined' && activeFirm) { %>
        <% const otherFirms = (typeof allFirms !== 'undefined' ? allFirms : []).filter(f => f.id !== activeFirm.id); %>
        <% if (otherFirms.length === 0) { %>
          <div style="margin-top:10px;display:flex;align-items:center;gap:6px;font-size:11px;color:#6b6b66;">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:0.7;flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= activeFirm.name %></span>
          </div>
        <% } else { %>
          <details class="tenant-switcher" style="margin-top:10px;">
            <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:6px;font-size:11px;color:#3a3a3a;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:0.7;flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500;"><%= activeFirm.name %></span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div style="margin-top:6px;background:#ffffff;border:1px solid #ecebe5;border-radius:6px;max-height:260px;overflow-y:auto;">
              <% otherFirms.forEach(f => { %>
                <form method="POST" action="/tenants/<%= f.id %>/switch" style="margin:0;">
                  <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                  <button type="submit" style="display:flex;width:100%;align-items:center;gap:8px;padding:8px 12px;background:transparent;border:0;text-align:left;color:#1a1a1a;font-size:12px;cursor:pointer;border-bottom:1px solid #ecebe5;font-family:inherit;">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:0.5;flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= f.name %></span>
                    <span style="font-size:10px;color:#8a8a87;flex-shrink:0;"><%= f.workspace_count %> client<%= f.workspace_count === 1 ? '' : 's' %></span>
                  </button>
                </form>
              <% }) %>
              <a href="/tenants" style="display:block;padding:8px 12px;font-size:11px;color:#6b6b66;text-decoration:none;border-top:1px solid #ecebe5;background:rgba(26,26,26,0.04);">Manage firms →</a>
            </div>
          </details>
        <% } %>
      <% } %>
    </div>

    <% if (typeof ws !== 'undefined' && ws) { %>
    <%
      // Per-client brand color powers the left-rail accent on the sidebar
      // client context block. Falls back to the global accent.
      const brandColor = (ws.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(ws.brand_primary_color)) ? ws.brand_primary_color : null;
      const otherWorkspaces = (typeof firmWorkspaces !== 'undefined' ? firmWorkspaces : []).filter(w => w.id !== ws.id);
    %>
    <div class="sidebar-section ws-context" style="<%= brandColor ? 'padding-left:11px;' : '' %>">
      <a class="text-xs" href="/dashboard" style="color:#6b6b66;text-decoration:none;">← All clients</a>
      <%# Client name is now the trigger for the switcher dropdown.
          On click expands a list of every other workspace in this firm so
          a consultant can jump between engagements without bouncing back
          to /dashboard first. Native <details>/<summary> = works with JS off. %>
      <%# Client switcher (label says "client" not "workspace" - workspace
          is the internal table name, never user-facing). The user is the
          firm; what they switch between is the client they're
          working on right now. %>
      <details class="ws-switcher" style="margin-top:10px;">
        <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:6px;color:#1a1a1a;">
          <span class="text-lg" style="font-weight: 500;letter-spacing:-0.005em;line-height:1.3;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= ws.brand_display_name || ws.client_name %></span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="ws-switcher-menu" style="margin-top:8px;background:#ffffff;border:1px solid #ecebe5;border-radius:6px;max-height:280px;overflow-y:auto;">
          <% if (otherWorkspaces.length === 0) { %>
            <div style="padding:10px 12px;font-size:12px;color:#8a8a87;">No other clients yet.</div>
          <% } else { %>
            <% otherWorkspaces.forEach(w => {
                 const dot = (w.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(w.brand_primary_color)) ? w.brand_primary_color : 'rgba(26,26,26,0.2)';
            %>
              <a href="/workspaces/<%= w.id %>" style="display:flex;align-items:center;gap:8px;padding:8px 12px;text-decoration:none;color:#1a1a1a;font-size:13px;border-bottom:1px solid #ecebe5;">
                <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:<%= dot %>;flex-shrink:0;"></span>
                <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= w.brand_display_name || w.client_name %></span>
                <% if (w.sector) { %><span style="font-size:10px;color:#8a8a87;flex-shrink:0;"><%= w.sector %></span><% } %>
              </a>
            <% }) %>
          <% } %>
          <a href="/dashboard" style="display:block;padding:8px 12px;font-size:12px;color:#6b6b66;text-decoration:none;border-top:1px solid #ecebe5;background:rgba(26,26,26,0.04);">All clients →</a>
        </div>
      </details>
      <div class="text-xs" style="margin-top:3px;color:#8a8a87;display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
        <% if (ws.sector) { %><span class="text-xxs" style="background:rgba(26,26,26,0.08);padding:1px 6px;border-radius:999px;font-weight:500;"><%= ws.sector %></span><% } %>
        <span><%= ws.industry || ws.stage.replace(/_/g,' ') %></span>
      </div>
    </div>
    <% } %>

    <nav class="sidebar-nav">
      <% if (typeof ws !== 'undefined' && ws) { %>
        <%# First group has no label - Overview is the obvious landing point; no need for an "Engagement" header above it %>
        <a href="/workspaces/<%= ws.id %>" data-shortcut="g o" class="nav-item <%= (typeof active !== 'undefined' && active === 'overview') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          <span class="nav-item-text">Overview</span>
        </a>
        <a href="/workspaces/<%= ws.id %>/readiness" data-shortcut="g e" class="nav-item <%= (typeof active !== 'undefined' && active === 'readiness') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12A10 10 0 1 1 12 2"/><polyline points="22 4 12 14 9 11"/></svg>
          <span class="nav-item-text">Readiness</span>
        </a>
        <a href="/workspaces/<%= ws.id %>/inbox" class="nav-item <%= (typeof active !== 'undefined' && active === 'inbox') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
          <span class="nav-item-text">Inbox</span>
        </a>
        <%# Personal work hub: the outputs you assemble (audit pack,
            deliverables) and your own schedule / to-dos (calendar, tasks)
            sit under Inbox rather than padding out the Operations group. %>
        <a href="/workspaces/<%= ws.id %>/audit-pack" class="nav-item <%= (typeof active !== 'undefined' && active === 'audit-pack') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span class="nav-item-text">Audit pack</span>
        </a>
        <a href="/workspaces/<%= ws.id %>/deliverables" class="nav-item <%= (typeof active !== 'undefined' && active === 'deliverables') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          <span class="nav-item-text">Deliverables</span>
        </a>
        <a href="/workspaces/<%= ws.id %>/calendar" class="nav-item <%= (typeof active !== 'undefined' && active === 'calendar') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span class="nav-item-text">Compliance calendar</span>
        </a>
        <a href="/workspaces/<%= ws.id %>/tasks" data-shortcut="g t" class="nav-item <%= (typeof active !== 'undefined' && active === 'tasks') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <span class="nav-item-text">Tasks</span>
        </a>
        <%# Unified all-framework view - only meaningful when the engagement
            covers more than one framework. %>
        <% if (ws.frameworks && ws.frameworks.length > 1) { %>
          <a href="/workspaces/<%= ws.id %>/readiness/overview" class="nav-item <%= (typeof active !== 'undefined' && active === 'readiness-overview') ? 'active' : '' %>" style="padding-left:30px;">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            <span class="nav-item-text">All frameworks</span>
          </a>
        <% } %>

        <%# Setup group: scoping intake + gap-assessment diagnostic.
            These come first in the engagement lifecycle - the consultant
            does both before any controls / risk / SoA work - so they get
            their own group above Implementation rather than being buried
            inside it where consultants missed them. %>
        <div class="nav-group-label">Setup</div>
        <a href="/workspaces/<%= ws.id %>/intake" class="nav-item <%= (typeof active !== 'undefined' && active === 'intake') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11H3v10h6V11zM21 3h-6v18h6V3zM15 7H9v14h6V7z"/></svg>
          <span class="nav-item-text">Client setup</span>
        </a>
        <a href="/workspaces/<%= ws.id %>/team" class="nav-item <%= (typeof active !== 'undefined' && ['team','members','access'].includes(active)) ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="nav-item-text">Team &amp; access</span>
