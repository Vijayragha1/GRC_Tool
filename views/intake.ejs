<%- include('partials/header', { title: 'Engagement intake', user, ws, active: 'intake' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Engagement intake</h1>
    <div class="page-subtitle">25 questions you'd ask at a kickoff workshop. Auto-drafts the clause 4.3 scope statement and seeds the interested-parties register from your answers.</div>
  </div>
  <div style="display:flex;gap:8px;align-items:center;">
    <span class="meta text-base"><strong><%= answered %></strong> / <%= total %> answered</span>
    <form method="POST" action="/workspaces/<%= ws.id %>/intake/apply" onsubmit="return appConfirmForm(event, 'Apply scope statement to workspace settings and seed interested parties from the answers above? Existing parties are not duplicated.');">
      <button class="btn btn-accent btn-xs" <%= answered === 0 ? 'disabled' : '' %>>Apply to workspace</button>
    </form>
  </div>
</div>

<% // Onboarding cue. When the workspace is brand new (no intake answers yet),
   // the new-client form redirects here - frame it as "continue setup" and
   // point at the kickoff playbook so the consultant has a script to run. %>
<% if (answered === 0) { %>
  <div class="panel" style="margin-bottom:14px;border-left:3px solid var(--accent);background:var(--accent-soft);padding:14px 18px;display:grid;grid-template-columns:24px 1fr auto;gap:12px;align-items:center;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-deep)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
    <div>
      <div style="font-size:13.5px;font-weight:600;color:var(--accent-deep);margin-bottom:3px;">Workspace created - let's finish setup</div>
      <div class="meta text-base" style="line-height:1.5;">Send this intake to the client 3 days before kickoff (just the URL works). When they're done, hit <strong>Apply to workspace</strong> above to push the scope statement into clause 4.3 and seed the interested-parties register. To run the call itself, open the <a href="/playbooks/kickoff" style="color:var(--accent);">kickoff playbook</a>.</div>
    </div>
    <a href="/workspaces/<%= ws.id %>" class="btn btn-ghost btn-xs">Skip for now →</a>
  </div>
<% } %>

<form method="POST" action="/workspaces/<%= ws.id %>/intake" id="intakeForm" style="display:flex;flex-direction:column;gap:18px;">
  <% sections.forEach(sec => { %>
    <div class="panel">
      <div class="panel-head" style="border-bottom:1px solid var(--border);">
        <div>
          <h2 style="margin:0;"><%= sec.title %></h2>
          <div class="meta text-base" style="margin-top:4px;"><%= sec.blurb %></div>
        </div>
      </div>
      <div class="panel-pad" style="display:grid;gap:16px;">
        <% sec.questions.forEach(q => { %>
          <div>
            <label class="label" for="q-<%= q.id %>" style="display:flex;align-items:center;gap:8px;">
              <span><%= q.text %><%= q.required ? ' *' : '' %></span>
              <span class="tag tag-neutral text-xxs">clause <%= q.clause %></span>
            </label>
            <% if (q.hint) { %>
              <div class="meta text-sm text-tertiary" style="margin-bottom:6px;"><%= q.hint %></div>
            <% } %>
            <% if (q.type === 'textarea') { %>
              <textarea class="textarea" id="q-<%= q.id %>" name="<%= q.id %>" rows="3" <%= q.required ? 'required' : '' %>><%= answers[q.id] || '' %></textarea>
            <% } else if (q.type === 'date') { %>
              <input class="input" type="date" id="q-<%= q.id %>" name="<%= q.id %>" value="<%= answers[q.id] || '' %>" <%= q.required ? 'required' : '' %>>
            <% } else if (q.type === 'number') { %>
              <input class="input" type="number" id="q-<%= q.id %>" name="<%= q.id %>" value="<%= answers[q.id] || '' %>" <%= q.required ? 'required' : '' %>>
            <% } else { %>
              <input class="input" type="text" id="q-<%= q.id %>" name="<%= q.id %>" value="<%= answers[q.id] || '' %>" <%= q.required ? 'required' : '' %>>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% }) %>

  <div style="display:flex;gap:10px;align-items:center;">
    <button type="submit" class="btn btn-primary">Save intake</button>
    <span class="meta text-sm">Saving doesn't apply yet - review the draft scope below, then click <strong>Apply to workspace</strong> at the top.</span>
  </div>
</form>

<div class="panel" style="margin-top:22px;">
  <div class="panel-head">
    <h2 style="margin:0;">Draft scope statement (clause 4.3)</h2>
    <span class="meta text-sm">Generated from your answers. Re-renders on save.</span>
  </div>
  <div class="panel-pad">
    <pre class="text-lg" style="white-space:pre-wrap;font-family:inherit;line-height:1.55;margin:0;"><%= draftScope %></pre>
  </div>
</div>

<%- include('partials/footer') %>
