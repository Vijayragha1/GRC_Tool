<%- include('partials/header', { title: 'CSF versions', user, ws, active: 'csf' }) %>

<div class="page-head">
  <div>
    <div style="display:flex;align-items:center;gap:10px;">
      <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>" class="meta text-base" style="text-decoration:none;">&larr; <%= engagement.name %></a>
    </div>
    <h1 class="page-title" style="margin-top:6px;">Version history</h1>
    <div class="page-subtitle">Immutable snapshots of this engagement. Once a version is published, its scores, findings, and recommendations are frozen forever - republish creates a new version, never edits an old one.</div>
  </div>
  <div style="display:flex;gap:8px;">
    <% if (engagement.status === 'Approved' && canPublish) { %>
      <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/publish" onsubmit="return appConfirmForm(event, 'Publish this engagement as v1.0? This freezes the current scores, findings, and recommendations into an immutable snapshot.')">
        <input type="hidden" name="change_summary" value="Initial publish">
        <button class="btn btn-primary btn-xs">Publish v1.0</button>
      </form>
    <% } %>
  </div>
</div>
<%- include('partials/csf_nav', { ws, engagement }) %>

<% if (engagement.status === 'Published' && canRepublish) { %>
  <details class="panel" style="margin-bottom:14px;">
    <summary class="panel-pad text-lg" style="cursor:pointer;font-weight:500;color:var(--accent);+ Republish (creates a new minor version)</summary> <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/republish" class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);" onsubmit="return appConfirmForm(event, 'Republish this engagement? A new version is added; prior versions remain visible. Required: change summary explaining what changed since the last publish.')">
      <label class="label">Change summary <span class="text-danger">*</span></label>
      <textarea class="textarea text-md" name="change_summary" required rows="3" placeholder="What changed since the last published version? This is shown on the new version's detail page and appears in the deliverable's 'what changed' appendix."></textarea>
      <div style="margin-top:8px;text-align:right;">
        <button class="btn btn-primary btn-xs">Republish</button>
      </div>
    </form>
  </details>
<% } %>

<% if (versions.length === 0) { %>
  <div class="panel">
    <div class="panel-pad">
      <div class="empty-state">
        <div class="empty-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/></svg></div>
        <div class="empty-title">No published versions yet</div>
        <div class="empty-sub">When the engagement reaches the Approved state, the Lead can publish v1.0, freezing the current scores into an immutable snapshot. Subsequent republishes increment the version number (1.0 -> 1.1 -> 1.2 -> ...).</div>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="panel" style="overflow:hidden;">
    <table class="t">
      <thead>
        <tr>
          <th style="width:90px">Version</th>
          <th>Change summary</th>
          <th style="width:170px">Published</th>
          <th style="width:120px;text-align:right;">Subs</th>
          <th style="width:120px;text-align:right;">Findings</th>
          <th style="width:160px;text-align:right;">Compare</th>
        </tr>
      </thead>
      <tbody>
        <% versions.forEach((v, i) => { %>
          <tr style="cursor:pointer" onclick="if(event.target.tagName!=='A'&&event.target.tagName!=='BUTTON'&&event.target.tagName!=='SELECT'){location='/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/versions/<%= v.id %>'}">
            <td>
              <strong class="mono"><a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/versions/<%= v.id %>" style="color:var(--accent);text-decoration:none;">v<%= v.version_number %></a></strong>
              <% if (v.is_current) { %><span class="tag text-success text-xxs" style="background:rgba(21,128,61,0.08);margin-left:6px;">current</span><% } %>
            </td>
            <td class="text-md" style="line-height:1.5;"><%= v.change_summary || '-' %></td>
            <td class="meta text-sm"><%= v.published_at %><div class="text-xs text-tertiary">by <%= v.publisher_name || '-' %></div></td>
            <td class="num text-md"><%= v.sub_count %></td>
            <td class="num text-md"><%= v.finding_count %></td>
            <td style="text-align:right;">
              <% if (versions.length > 1) { %>
                <form method="GET" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/versions/<%= v.id %>/diff/0" onsubmit="this.action=this.action.replace(/diff\/0$/, 'diff/' + this.against.value); return true;">
                  <select name="against" class="select text-xs" style="width:90px;display:inline-block;padding:3px 6px;">
                    <% versions.filter(other => other.id !== v.id).forEach(other => { %>
                      <option value="<%= other.id %>">v<%= other.version_number %></option>
                    <% }) %>
                  </select>
                  <button class="btn btn-ghost btn-xs text-xs">Diff</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>
