<%- include('partials/header', { title: detail.sub_code, user, ws, active: 'csf' }) %>

<div class="page-head">
  <div>
    <div style="display:flex;align-items:center;gap:10px;">
      <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess" class="meta text-base" style="text-decoration:none;">&larr; All subcategories</a>
    </div>
    <h1 class="page-title" style="margin-top:6px;display:flex;align-items:center;gap:10px;">
      <span class="mono" style="color:var(--accent);"><%= detail.sub_code %></span>
      <span class="text-secondary" style="font-size:18px;font-weight:500;"><%= detail.cat_code %> &middot; <%= detail.cat_name %></span>
    </h1>
    <div class="page-subtitle" style="margin-top:4px;"><%= detail.sub_description %></div>
  </div>
  <div style="display:flex;gap:8px;">
    <% if (prev) { %><a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= prev.subcategory_id %>" class="btn btn-secondary btn-xs">&larr; <%= prev.code %></a><% } %>
    <% if (next) { %><a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= next.subcategory_id %>" class="btn btn-secondary btn-xs"><%= next.code %> &rarr;</a><% } %>
  </div>
</div>

<!-- State strip -->
<div class="panel" style="margin-bottom:14px;">
  <div class="panel-pad text-sm" style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
    <% const stateOrder = ['Not Started','In Progress','Evidence Collected','Draft Complete','Reviewed','Approved']; %>
    <% const curIdx = stateOrder.indexOf(detail.status); %>
    <% stateOrder.forEach((s, i) => { %>
      <span style="
        padding:4px 9px;border-radius:999px;
        background:<%= i <= curIdx ? '#1d4ed8' : 'var(--bg-subtle)' %>;
        color:<%= i <= curIdx ? '#fff' : 'var(--text-tertiary)' %>;
        font-size:11px;font-weight:<%= i === curIdx ? '600' : '500' %>;
        border:1px solid <%= i <= curIdx ? '#1d4ed8' : 'var(--border)' %>;
      "><%= s %></span>
      <% if (i < stateOrder.length - 1) { %><span class="text-tertiary">&rarr;</span><% } %>
    <% }) %>
    <div style="margin-left:auto;display:flex;gap:6px;">
      <% allowedNextStates.forEach(ns => { %>
        <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>/transition" style="display:inline;">
          <input type="hidden" name="to_state" value="<%= ns %>">
          <button class="btn btn-primary btn-xs">Mark as <%= ns %> &rarr;</button>
        </form>
      <% }) %>
    </div>
  </div>
</div>

<% if (warnings && warnings.length) { %>
  <div class="panel" style="margin-bottom:14px;border-left:3px solid #a16207;background:rgba(161,98,7,0.04);">
    <div class="panel-pad text-md text-secondary">
      <strong class="text-warn">Soft warnings (not blocking):</strong>
      <ul style="margin:6px 0 0 0;padding-left:18px;">
        <% warnings.forEach(w => { %><li><%= w %></li><% }) %>
      </ul>
    </div>
  </div>
<% } %>

<!-- Stage 11: Analyst guidance sidebar (Layers 1-3) -->
<% if (explainer || questions.length || prompts.length) { %>
  <details class="panel" style="margin-bottom:14px;border-left:3px solid var(--accent);" <%= detail.status === 'Not Started' || detail.status === 'In Progress' ? 'open' : '' %>>
    <summary class="panel-pad text-lg" style="cursor:pointer;font-weight:500;color:var(--accent);">Analyst guide for <%= detail.sub_code %></summary>

    <% if (explainer) { %>
      <div class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
        <% if (explainer.plain_what) { %>
          <div class="text-lg" style="line-height:1.55;margin-bottom:6px;"><strong>What this is asking:</strong> <%= explainer.plain_what %></div>
        <% } %>
        <% if (explainer.plain_why) { %>
          <div class="text-lg" style="line-height:1.55;margin-bottom:8px;"><strong>Why it matters:</strong> <%= explainer.plain_why %></div>
        <% } %>
        <div class="text-base" style="display:grid;grid-template-columns:1fr 1fr;gap:10px;line-height:1.55;">
          <% if (explainer.signs_of_strength) { %>
            <div><span class="meta text-eyebrow text-success" style="text-transform:uppercase;letter-spacing:0.04em;">Signs of strength</span><div class="text-secondary" style="margin-top:4px;"><%= explainer.signs_of_strength %></div></div>
          <% } %>
          <% if (explainer.signs_of_weakness) { %>
            <div><span class="meta text-eyebrow text-danger" style="text-transform:uppercase;letter-spacing:0.04em;">Signs of weakness</span><div class="text-secondary" style="margin-top:4px;"><%= explainer.signs_of_weakness %></div></div>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (questions.length) { %>
      <div class="panel-pad" style="border-top:1px solid var(--border);">
        <div class="meta text-xs" style="text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Interview questions</div>
        <ul class="text-md" style="line-height:1.6;margin:0;padding-left:18px;">
          <% questions.forEach(q => { %><li><span class="tag" style="font-size:9.5px;background:var(--bg-subtle);text-transform:uppercase;margin-right:6px;"><%= q.question_type %></span><%= q.question %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <% if (prompts.length) { %>
      <div class="panel-pad" style="border-top:1px solid var(--border);">
        <div class="meta text-xs" style="text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">Evidence to ask for</div>
        <ul class="text-md" style="line-height:1.6;margin:0;padding-left:18px;">
          <% prompts.forEach(p => { %><li><% if (p.evidence_type) { %><span class="tag" style="font-size:9.5px;background:var(--bg-subtle);text-transform:uppercase;margin-right:6px;"><%= p.evidence_type %></span><% } %><%= p.prompt %></li><% }) %>
        </ul>
      </div>
    <% } %>

    <div class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
      <details>
        <summary class="text-md" style="cursor:pointer;color:var(--accent);">Stuck? Ask your Lead</summary>
        <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/ask-lead" style="margin-top:8px;display:grid;grid-template-columns:1fr;gap:6px;">
          <input class="input text-base" name="subject" placeholder="Subject (optional)">
          <textarea class="textarea text-base" name="body" rows="3" required placeholder="What's the question? Include what you've already tried or seen."></textarea>
          <input type="hidden" name="subcategory_id" value="<%= detail.subcategory_id %>">
          <input type="hidden" name="return_to" value="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>">
          <div style="text-align:right;"><button class="btn btn-primary btn-xs">Send to Lead</button></div>
        </form>
      </details>
    </div>
  </details>
<% } %>

<!-- Self-check prompts (Layer 6) - non-blocking, shown when at Draft Complete or beyond -->
<% if (selfCheckPrompts.length && ['Draft Complete', 'Reviewed', 'Approved'].includes(detail.status)) { %>
  <details class="panel" style="margin-bottom:14px;">
    <summary class="panel-pad text-md" style="cursor:pointer;">Self-check before review</summary>
    <div class="panel-pad text-md" style="border-top:1px solid var(--border);line-height:1.6;">
      <ul style="margin:0;padding-left:18px;">
        <% selfCheckPrompts.forEach(p => { %><li><%= p %></li><% }) %>
      </ul>
    </div>
  </details>
<% } %>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:14px;">
  <!-- LEFT: narrative + scoring + exclusion -->
  <div>
    <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>" class="panel" style="margin-bottom:14px;">
      <div class="panel-head"><h2>Narrative</h2><span class="meta text-sm">structured into 4 sections</span></div>
      <div class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
        <div>
          <label class="label">Practice observed</label>
          <textarea class="textarea text-md" name="narrative_practice_observed" rows="5" placeholder="What did the team actually do in practice? Specifics over generic. Names, dates, system IDs where useful." style="line-height:1.5;"><%= narrativeSections.practice_observed %></textarea>
        </div>
        <div>
          <label class="label">Evidence reviewed</label>
          <textarea class="textarea text-md" name="narrative_evidence_reviewed" rows="5" placeholder="Which documents, screenshots, configurations, or interview attributions support what you observed?" style="line-height:1.5;"><%= narrativeSections.evidence_reviewed %></textarea>
        </div>
        <div>
          <label class="label">Gaps or concerns</label>
          <textarea class="textarea text-md" name="narrative_gaps_or_concerns" rows="4" placeholder="What's missing, weak, or inconsistent? Don't soften - this is what becomes a finding." style="line-height:1.5;"><%= narrativeSections.gaps_or_concerns %></textarea>
        </div>
        <div>
          <label class="label">Follow-up needed</label>
          <textarea class="textarea text-md" name="narrative_follow_up_needed" rows="4" placeholder="Anything promised but not produced? Anything you couldn't verify today and want to chase before scoring?" style="line-height:1.5;"><%= narrativeSections.follow_up_needed %></textarea>
        </div>
      </div>

      <div class="panel-head" style="border-top:1px solid var(--border);"><h2>Scoring</h2><span class="meta text-sm"><%= canEnterScore ? 'Editable' : 'Locked until Evidence Collected + scoring role' %></span></div>
      <div class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;<%= canEnterScore ? '' : 'opacity:0.5;pointer-events:none;' %>">
        <div>
          <label class="label">Current CMMI score</label>
          <select class="select" name="current_score">
            <option value="">- not set -</option>
            <% [1,2,3,4,5].forEach(n => { %><option value="<%= n %>" <%= detail.current_score === n ? 'selected' : '' %>><%= n %></option><% }) %>
          </select>
          <% if (detail.is_bulk_set) { %><div class="meta text-xs text-tertiary" style="margin-top:4px;">Set via bulk action (audit-flagged)</div><% } %>
        </div>
        <% if (engagement.scope_mode === 'CURRENT_TARGET') { %>
          <div>
            <label class="label">Target CMMI score</label>
            <select class="select" name="target_score">
              <option value="">- not set -</option>
              <% [1,2,3,4,5].forEach(n => { %><option value="<%= n %>" <%= detail.target_score === n ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
          </div>
        <% } %>
      </div>

      <div class="panel-head" style="border-top:1px solid var(--border);"><h2>Scope</h2></div>
      <div class="panel-pad">
        <label class="text-lg" style="display:flex;gap:8px;align-items:center;cursor:pointer;">
          <input type="checkbox" name="excluded_from_scope" value="1" <%= detail.excluded_from_scope ? 'checked' : '' %>>
          Excluded from this engagement's scope
        </label>
        <textarea class="textarea text-md" name="exclusion_rationale" rows="2" placeholder="Rationale for exclusion (required if excluded)" style="margin-top:8px;"><%= detail.exclusion_rationale || '' %></textarea>
      </div>

      <div class="panel-pad" style="background:var(--bg-subtle);border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;">
        <button class="btn btn-primary btn-xs">Save</button>
      </div>
    </form>

    <!-- Implementation examples + ISO refs (from Stage 1 catalog) -->
    <% if (detail.implementation_examples) { %>
      <details class="panel" style="margin-bottom:14px;">
        <summary class="panel-pad text-lg" style="cursor:pointer;font-weight:500;">NIST implementation examples</summary>
        <div class="panel-pad text-md text-secondary" style="padding-top:0;line-height:1.55;white-space:pre-wrap;"><%= detail.implementation_examples %></div>
      </details>
    <% } %>
    <% if (isoRefs && isoRefs.length) { %>
      <% const clauses = isoRefs.filter(r => r.ref_type === 'mandatory_clause'); %>
      <% const annexa = isoRefs.filter(r => r.ref_type === 'annex_a'); %>
      <div class="panel" style="margin-bottom:14px;">
        <div class="panel-head"><h2>ISO 27001:2022 cross-references</h2></div>
        <div class="panel-pad text-md" style="line-height:1.7;">
          <% if (clauses.length) { %><div><span class="meta text-sm">Mandatory clauses:</span> <span class="mono"><%= clauses.map(c => c.ref_value).join(', ') %></span></div><% } %>
          <% if (annexa.length) { %>
            <div><span class="meta text-sm">Annex A controls:</span>
              <% annexa.forEach((a, i) => { %><a href="/workspaces/<%= ws.id %>/controls/annex-a.<%= a.ref_value %>" class="mono" style="color:var(--accent);text-decoration:none;"><%= a.ref_value %></a><%= i < annexa.length - 1 ? ', ' : '' %><% }) %>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- RIGHT: evidence -->
  <div>
    <div class="panel">
      <div class="panel-head"><h2>Evidence</h2><span class="meta text-sm"><%= evidence.length %> item<%= evidence.length === 1 ? '' : 's' %></span></div>
      <% if (evidence.length === 0) { %>
        <div class="panel-pad meta text-base">No evidence yet. Attach a file, paste a link, or capture an interview attribution. At least one item is expected before transitioning to <strong>Evidence Collected</strong>.</div>
      <% } else { %>
        <div class="divide-row">
          <% evidence.forEach(e => { %>
            <div style="padding:10px 14px;">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                <div style="flex:1;min-width:0;">
                  <div style="display:flex;align-items:center;gap:6px;">
                    <span class="tag text-xxs" style="background:var(--bg-subtle);"><%= e.type %></span>
                    <% if (e.visible_to_client) { %><span class="tag text-xxs text-success" style="background:rgba(21,128,61,0.08);">visible to client</span><% } %>
                  </div>
                  <% if (e.type === 'FILE') { %>
                    <div class="mono text-sm" style="margin-top:4px;"><%= e.file_path %></div>
                  <% } else if (e.type === 'LINK') { %>
                    <div class="text-base" style="margin-top:4px;"><a href="<%= e.url %>" target="_blank" rel="noopener" style="color:var(--accent);"><%= e.url %></a></div>
                  <% } else if (e.type === 'INTERVIEW') { %>
                    <div class="text-base" style="margin-top:4px;"><%= e.interview_source %></div>
                  <% } %>
                  <% if (e.description) { %><div class="meta text-sm" style="margin-top:4px;"><%= e.description %></div><% } %>
                </div>
                <% if (canCollect) { %>
                  <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>/evidence/<%= e.id %>/delete" onsubmit="return appConfirmForm(event, 'Remove this evidence item?')">
                    <button class="btn btn-ghost btn-xs text-danger text-xs">&times;</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (canCollect) { %>
        <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>/evidence" enctype="multipart/form-data" class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
          <label class="label">Add evidence</label>
          <select class="select text-base" name="type" id="csfEvType" style="margin-bottom:8px;">
            <option value="LINK">Link (URL)</option>
            <option value="FILE">File upload</option>
            <option value="INTERVIEW">Interview attribution</option>
          </select>
          <input class="input text-base" name="url" id="csfEvUrl" placeholder="https://..." style="margin-bottom:8px;">
          <input class="input text-base" type="file" name="file" id="csfEvFile" style="margin-bottom:8px;display:none;">
          <input class="input text-base" name="interview_source" id="csfEvInterview" placeholder="e.g., Jane Doe, IT Manager, 2026-05-14" style="margin-bottom:8px;display:none;">
          <textarea class="textarea text-base" name="description" rows="2" placeholder="What does this evidence show? (optional)" style="margin-bottom:8px;"></textarea>
          <label class="text-sm" style="display:flex;gap:6px;align-items:center;margin-bottom:8px;">
            <input type="checkbox" name="visible_to_client" value="1"> Visible to client portal
          </label>
          <button class="btn btn-primary btn-xs">Attach</button>
        </form>
        <script>
        (function () {
          const sel = document.getElementById('csfEvType');
          const url = document.getElementById('csfEvUrl');
          const file = document.getElementById('csfEvFile');
          const iv = document.getElementById('csfEvInterview');
          function flip() {
            url.style.display = sel.value === 'LINK' ? '' : 'none';
            file.style.display = sel.value === 'FILE' ? '' : 'none';
            iv.style.display = sel.value === 'INTERVIEW' ? '' : 'none';
            url.required = sel.value === 'LINK';
            file.required = sel.value === 'FILE';
            iv.required = sel.value === 'INTERVIEW';
          }
          sel.addEventListener('change', flip); flip();
        })();
        </script>
      <% } %>
    </div>
  </div>
</div>

<!-- Stage 4: Findings + Reviewer comments -->
<% const sevColor = { 'CRITICAL':'#b91c1c', 'HIGH':'#dc2626', 'MEDIUM':'#a16207', 'LOW':'var(--text-tertiary)' }; %>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:14px;">
  <!-- Findings + recommendations -->
  <div class="panel">
    <div class="panel-head">
      <h2>Findings</h2>
      <span class="meta text-sm"><%= findings.length %> on this subcategory</span>
    </div>

    <% if (findings.length === 0) { %>
      <div class="panel-pad meta text-base">No findings yet on <%= detail.sub_code %>. Add one below if there's a gap, weakness, or non-conformity that should be tracked.</div>
    <% } else { %>
      <div class="divide-row">
        <% findings.forEach(f => { %>
          <div style="padding:10px 14px;border-left:3px solid <%= sevColor[f.severity] || 'var(--border)' %>;">
            <div style="display:flex;align-items:center;gap:8px;">
              <span class="tag" style="background:<%= sevColor[f.severity] || 'var(--bg-subtle)' %>;color:#fff;font-size:10px;font-weight:600;"><%= f.severity %></span>
              <strong class="text-lg" style="flex:1;"><%= f.title %></strong>
              <span class="tag text-xxs" style="background:var(--bg-subtle);"><%= f.status %></span>
              <% if (canCreateFinding) { %>
                <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/findings/<%= f.id %>/delete" style="display:inline;" onsubmit="return appConfirmForm(event, 'Delete this finding (soft-delete)?')">
                  <input type="hidden" name="return_to" value="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>">
                  <button class="btn btn-ghost btn-xs text-danger text-eyebrow">&times;</button>
                </form>
              <% } %>
            </div>
            <% if (f.description) { %>
              <div class="text-base text-secondary" style="margin-top:4px;line-height:1.5;white-space:pre-wrap;"><%= f.description %></div>
            <% } %>
            <div class="meta text-xs" style="margin-top:4px;">By <%= f.creator || '-' %> &middot; <%= f.created_at %></div>

            <% const recs = recsByFinding[f.id] || []; %>
            <% if (recs.length) { %>
              <div style="margin-top:8px;padding-left:12px;border-left:2px solid var(--border);">
                <div class="meta text-eyebrow" style="text-transform:uppercase;letter-spacing:0.04em;margin-bottom:4px;">Recommendations</div>
                <% recs.forEach(r => { %>
                  <div class="text-base" style="margin-bottom:6px;line-height:1.5;">
                    <%= r.description %>
                    <div style="display:flex;gap:6px;margin-top:2px;flex-wrap:wrap;">
                      <% if (r.estimated_effort) { %><span class="tag text-xxs" style="background:var(--bg-subtle);">effort: <%= r.estimated_effort %></span><% } %>
                      <% if (r.priority) { %><span class="tag text-xxs" style="background:var(--bg-subtle);">priority: <%= r.priority %></span><% } %>
                      <% if (r.roadmap_phase) { %><span class="tag text-xxs" style="background:var(--bg-subtle);"><%= r.roadmap_phase.replace('_PLUS','+').replace('_','-') %></span><% } %>
                      <% if (r.target_completion_date) { %><span class="meta text-xxs">due <%= r.target_completion_date %></span><% } %>
                      <% if (canManageRecs) { %>
                        <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/recommendations/<%= r.id %>/delete" style="display:inline;" onsubmit="return appConfirmForm(event, 'Delete this recommendation?')">
                          <input type="hidden" name="return_to" value="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>">
                          <button class="btn btn-ghost btn-xs text-danger text-xxs">&times;</button>
                        </form>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <% if (canManageRecs) { %>
              <details style="margin-top:6px;">
                <summary class="text-xs" style="cursor:pointer;color:var(--accent);">+ Add recommendation</summary>
                <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/findings/<%= f.id %>/recommendations" style="margin-top:6px;display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:6px;">
                  <textarea class="textarea col-full text-sm" name="description" rows="2" placeholder="What should the client do?" required></textarea>
                  <select class="select text-xs" name="estimated_effort">
                    <option value="">- effort -</option>
                    <% efforts.forEach(e => { %><option value="<%= e %>"><%= e %></option><% }) %>
                  </select>
                  <select class="select text-xs" name="priority">
                    <option value="">- priority -</option>
                    <% priorities.forEach(p => { %><option value="<%= p %>"><%= p %></option><% }) %>
                  </select>
                  <select class="select text-xs" name="roadmap_phase">
                    <option value="">- phase -</option>
                    <% phases.forEach(ph => { %><option value="<%= ph %>"><%= ph.replace('_PLUS','+').replace('_','-') %></option><% }) %>
                  </select>
                  <input class="input text-xs" type="date" name="target_completion_date">
                  <input type="hidden" name="return_to" value="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>">
                  <button class="btn btn-primary btn-xs col-full text-xs">Add</button>
                </form>
              </details>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (canCreateFinding) { %>
      <details class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
        <summary class="text-md" style="cursor:pointer;color:var(--accent);">+ New finding on <%= detail.sub_code %></summary>
        <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/findings" style="margin-top:8px;display:grid;grid-template-columns:2fr 1fr;gap:8px;">
          <input class="input col-full text-base" name="title" required placeholder="Short summary">
          <textarea class="textarea col-full text-base" name="description" rows="3" placeholder="Detail"></textarea>
          <select class="select text-base" name="severity">
            <% severities.forEach(s => { %><option value="<%= s %>" <%= s === 'MEDIUM' ? 'selected' : '' %>><%= s %></option><% }) %>
          </select>
          <div style="text-align:right;align-self:end;">
            <input type="hidden" name="assessment_id" value="<%= detail.id %>">
            <button class="btn btn-primary btn-xs">Create finding</button>
          </div>
        </form>
      </details>
    <% } %>
  </div>

  <!-- Reviewer comments -->
  <div class="panel">
    <div class="panel-head"><h2>Reviewer comments</h2><span class="meta text-sm"><%= comments.length %></span></div>
    <% if (comments.length === 0) { %>
      <div class="panel-pad meta text-base">No comments yet. Reviewers can leave notes here; "Needs revision" reopens this subcategory if it's been reviewed.</div>
    <% } else { %>
      <div class="divide-row">
        <% comments.forEach(c => { %>
          <div style="padding:10px 14px;<%= c.resolved ? 'opacity:0.5;' : '' %>">
            <div style="display:flex;align-items:center;gap:6px;">
              <strong class="text-base"><%= c.commenter_name %></strong>
              <% if (c.requires_revision) { %><span class="tag tag-warn text-xxs">needs revision</span><% } %>
              <% if (c.resolved) { %><span class="tag text-success text-xxs" style="background:rgba(21,128,61,0.08);">resolved</span><% } %>
              <span class="meta text-xs" style="margin-left:auto;"><%= c.created_at %></span>
            </div>
            <div class="text-md" style="margin-top:4px;line-height:1.5;white-space:pre-wrap;"><%= c.text %></div>
            <% if (!c.resolved) { %>
              <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/comments/<%= c.id %>/resolve" style="margin-top:6px;">
                <input type="hidden" name="return_to" value="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>">
                <button class="btn btn-ghost btn-xs text-xs">Mark resolved</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (canPostComment) { %>
      <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/comments" class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
        <textarea class="textarea text-base" name="text" rows="3" placeholder="Comment, push-back, or clarification" required></textarea>
        <input type="hidden" name="assessment_id" value="<%= detail.id %>">
        <label class="text-sm" style="display:flex;gap:6px;align-items:center;margin-top:6px;">
          <input type="checkbox" name="requires_revision" value="1">
          Needs revision (reopens to Draft Complete if in Reviewed state)
        </label>
        <button class="btn btn-primary btn-xs" style="margin-top:6px;">Post comment</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
