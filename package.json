{
  "name": "iso27001-tool",
  "version": "0.1.0",
  "description": "ISO 27001:2022 implementation and audit tool for consulting firms and their clients",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "backup": "node scripts/backup.js",
    "csf-demo": "node scripts/csf-demo.js",
    "content-parity": "node scripts/content-parity.js",
    "content-staleness": "node scripts/content-staleness.js",
    "test": "node tests/smoke.test.js && node --test --test-force-exit tests/security.test.js tests/rbac.test.js",
    "test:security": "node --test --test-force-exit tests/security.test.js tests/rbac.test.js",
    "test:browser": "node tests/browser-ui.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.3.0",
    "better-sqlite3-session-store": "^0.1.0",
    "docx": "^9.0.2",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.1",
    "helmet": "^8.2.0",
    "html-to-docx": "^1.8.0",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.8",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^25.0.4",
    "sanitize-html": "^2.17.4",
    "tinymce": "^6.8.6"
  }
}
