<%- include('partials/header', { title: 'Clients', user, ws: null }) %>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= user.user_type === 'firm' ? 'Portfolio' : 'My workspaces' %></h1>
    <div class="page-subtitle"><%= user.user_type === 'firm' ? 'All client engagements your firm is managing.' : 'Engagements you have access to.' %></div>
  </div>
  <% if (user.user_type === 'firm') { %>
    <button onclick="document.getElementById('newWs').classList.toggle('hidden')" class="btn btn-primary">New client</button>
  <% } %>
</div>

<% if (workspaces.length > 0) { %>
<%
  // Health bands for the KPI rail color
  const stage1Cls = totals.avgStage1 >= 80 ? 'kpi-good' : totals.avgStage1 >= 50 ? 'kpi-warn' : 'kpi-bad';
  const nearCertCls = totals.nearCert > 0 ? 'kpi-warn' : '';
  const redFlagsCls = totals.redFlags > 0 ? 'kpi-bad' : 'kpi-good';
  const ncCls = totals.totalOpenNCs > 0 ? 'kpi-bad' : 'kpi-good';
%>
<div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:24px;">
  <div class="panel kpi kpi-accent">
    <div class="kpi-head">
      <svg class="kpi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
      <div class="kpi-label">Engagements</div>
    </div>
    <div class="kpi-num num"><%= totals.total %></div>
    <div class="kpi-meta">active across the firm</div>
  </div>
  <div class="panel kpi <%= stage1Cls %>">
    <div class="kpi-head">
      <svg class="kpi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <div class="kpi-label">Avg Stage 1</div>
    </div>
    <div class="kpi-num num"><%= totals.avgStage1 %><span style="font-size:15px;color:var(--text-tertiary);font-weight:400;margin-left:1px;">%</span></div>
    <div class="kpi-meta">readiness across portfolio</div>
  </div>
  <div class="panel kpi <%= nearCertCls %>">
    <div class="kpi-head">
      <svg class="kpi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <div class="kpi-label">Near cert</div>
    </div>
    <div class="kpi-num num"><%= totals.nearCert %></div>
    <div class="kpi-meta">&lt; 90 days to target</div>
  </div>
  <div class="panel kpi <%= redFlagsCls %>">
    <div class="kpi-head">
      <svg class="kpi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div class="kpi-label">Needs attention</div>
    </div>
    <div class="kpi-num num"><%= totals.redFlags %></div>
    <div class="kpi-meta">engagements flagged</div>
  </div>
  <div class="panel kpi <%= ncCls %>">
    <div class="kpi-head">
      <svg class="kpi-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <div class="kpi-label">Open NCs</div>
    </div>
    <div class="kpi-num num"><%= totals.totalOpenNCs %></div>
    <div class="kpi-meta">open / overdue total</div>
  </div>
</div>
<% } %>

<!-- At-risk engagements — one row per workspace flagged across multiple signals -->
<% if (typeof atRisk !== 'undefined' && atRisk.length > 0) { %>
  <div class="panel" style="margin-bottom:24px;border-left:3px solid <%= atRisk.some(r => r.severity === 'high') ? '#b91c1c' : '#a16207' %>;">
    <div class="panel-head">
      <h2>At-risk engagements <span class="meta" style="font-weight:400;font-size:13px;">— overdue NCs · stale controls · cert deadlines · missed reviews</span></h2>
      <span class="meta">
        <% const high = atRisk.filter(r => r.severity === 'high').length; const med = atRisk.filter(r => r.severity === 'medium').length; %>
        <% if (high) { %><strong style="color:#b91c1c;"><%= high %></strong> high · <% } %>
        <% if (med) { %><strong style="color:#a16207;"><%= med %></strong> medium<% } %>
      </span>
    </div>
    <table class="t">
      <thead><tr>
        <th>Client</th>
        <th style="width:130px;">Last pass</th>
        <th style="width:120px;">Stage 1</th>
        <th style="width:140px;">Cert target</th>
        <th>Why flagged</th>
        <th style="width:80px;"></th>
      </tr></thead>
      <tbody>
        <% atRisk.forEach(r => {
             const sevColor = r.severity === 'high' ? '#b91c1c' : '#a16207';
        %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:8px;">
                <span style="width:8px;height:8px;border-radius:50%;background:<%= sevColor %>;flex-shrink:0;"></span>
                <strong style="font-size:13px;"><%= r.client_name %></strong>
                <% if (r.industry) { %><span class="meta" style="font-size:11px;"><%= r.industry %></span><% } %>
              </div>
            </td>
            <td style="font-size:11.5px;">
              <% if (r.lastPass) { %>
                Pass <%= r.lastPass.pass_number %><br>
                <span class="meta" style="font-size:10.5px;">
                  <%= r.lastPass.status === 'in_progress' ? 'in progress' : ('done ' + (r.lastPass.completed_at || '').slice(0,10)) %>
                </span>
              <% } else { %>
                <span class="meta">none</span>
              <% } %>
            </td>
            <td><span class="num" style="font-weight:500;color:<%= r.readiness.stage1 >= 80 ? '#15803d' : r.readiness.stage1 >= 50 ? '#a16207' : '#b91c1c' %>;"><%= r.readiness.stage1 %>%</span></td>
            <td style="font-size:11.5px;">
              <% if (r.target_cert_date) { %>
                <%= r.target_cert_date %><br>
                <span class="meta" style="font-size:10.5px;<%= r.readiness.daysToTarget !== null && r.readiness.daysToTarget < 30 ? 'color:#b91c1c;font-weight:600;' : '' %>">
                  <% if (r.readiness.daysToTarget !== null) { %><%= r.readiness.daysToTarget %> days<% } else { %>—<% } %>
                </span>
              <% } else { %><span class="meta">no target</span><% } %>
            </td>
            <td style="font-size:11.5px;line-height:1.5;">
              <%
                // Each reason chip links to the most relevant sub-page so a
                // consultant can drill straight in instead of bouncing through
                // the workspace overview.
                function reasonLink(reason, wsId) {
                  if (/NC/i.test(reason)) return `/workspaces/${wsId}/nonconformities`;
                  if (/cert target/i.test(reason)) return `/workspaces/${wsId}/cert-cycle`;
                  if (/objective/i.test(reason)) return `/workspaces/${wsId}/objectives`;
                  if (/stale controls/i.test(reason)) return `/workspaces/${wsId}/notifications?filter=unread`;
                  if (/party review/i.test(reason)) return `/workspaces/${wsId}/interested-parties`;
                  if (/pass/i.test(reason)) return `/workspaces/${wsId}/gap-assessment`;
                  return `/workspaces/${wsId}`;
                }
              %>
              <% r.reasons.forEach(reason => { %><a href="<%= reasonLink(reason, r.id) %>" class="tag tag-neutral" style="font-size:10.5px;margin:1px 2px 1px 0;text-decoration:none;cursor:pointer;"><%= reason %></a><% }) %>
            </td>
            <td><a href="/workspaces/<%= r.id %>" class="btn btn-secondary btn-xs">Open</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (user.user_type === 'firm') { %>
<div id="newWs" class="panel hidden" style="margin-bottom:24px">
  <div class="panel-head"><h2>New client engagement</h2></div>
  <form method="POST" action="/workspaces" class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
    <div><label class="label">Client name</label><input class="input" name="client_name" required></div>
    <div><label class="label">Industry</label><input class="input" name="industry" placeholder="SaaS, Fintech, Healthcare…"></div>
    <div style="grid-column:1/-1"><label class="label">ISMS scope</label><input class="input" name="scope" placeholder="Production SaaS platform and supporting infrastructure"></div>
    <div><label class="label">Target certification date</label><input class="input" name="target_cert_date" type="date"></div>
    <div></div>
    <div style="grid-column:1/-1"><button class="btn btn-primary">Create workspace</button></div>
  </form>
</div>
<% } %>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr>
      <th>Client</th><th style="width:140px">Stage</th>
      <th style="width:90px">Stage 1</th><th style="width:90px">Days</th>
      <th style="width:80px">NCs</th><th style="width:200px">Progress</th>
      <% if (user.user_type === 'firm') { %><th style="width:40px"></th><% } %>
    </tr></thead>
    <tbody>
      <% workspaces.forEach(w => { %>
        <tr style="cursor:pointer" onclick="location='/workspaces/<%= w.id %>'">
          <td>
            <div style="display:flex;align-items:center;gap:8px;">
              <% if (w.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(w.brand_primary_color)) { %>
                <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:<%= w.brand_primary_color %>;flex-shrink:0;"></span>
              <% } %>
              <span style="font-weight:500"><%= w.brand_display_name || w.client_name %></span>
              <% if (w.sector) { %><span class="tag tag-info" style="font-size:10px;"><%= w.sector %></span><% } %>
            </div>
            <% if (w.industry) { %><div class="meta" style="margin-top:2px"><%= w.industry %></div><% } %>
          </td>
          <td><span class="status s-<%= w.stage === 'certified' ? 'done' : 'in_progress' %>"><%= w.stage.replace(/_/g,' ') %></span></td>
          <td><span class="num" style="font-weight:500;color:<%= w.readiness.stage1 >= 80 ? '#15803d' : w.readiness.stage1 >= 50 ? '#a16207' : '#b91c1c' %>"><%= w.readiness.stage1 %>%</span></td>
          <td class="num meta" style="color:<%= w.readiness.daysToTarget !== null && w.readiness.daysToTarget < 30 ? '#b91c1c' : w.readiness.daysToTarget !== null && w.readiness.daysToTarget < 90 ? '#a16207' : '' %>"><%= w.readiness.daysToTarget !== null ? w.readiness.daysToTarget + 'd' : '—' %></td>
          <td>
            <% if (w.openMajorNCs > 0 || w.overdueNCs > 0) { %>
              <span class="tag tag-danger num"><%= w.openMajorNCs + w.overdueNCs %></span>
            <% } else { %><span class="meta">—</span><% } %>
          </td>
          <td>
            <div style="display:flex;align-items:center;gap:8px">
              <div style="width:120px;height:4px;background:var(--bg-muted);border-radius:2px;overflow:hidden;"><div style="height:100%;background:var(--accent);width:<%= w.progress.percent %>%;"></div></div>
              <span class="num" style="font-size:11px;color:var(--text-tertiary);min-width:42px;"><%= w.progress.assessed %>/<%= w.progress.total %></span>
            </div>
          </td>
          <% if (user.user_type === 'firm') { %>
          <td onclick="event.stopPropagation()" style="text-align:right;cursor:default;">
            <button type="button"
                    onclick="deleteClient(<%= w.id %>, '<%= w.client_name.replace(/'/g, "\\'") %>')"
                    title="Delete this client engagement"
                    class="btn btn-ghost btn-xs"
                    style="color:var(--danger,#b91c1c);padding:4px 8px;">×</button>
          </td>
          <% } %>
        </tr>
      <% }) %>
      <% if (workspaces.length === 0) { %>
        <tr><td colspan="6" style="padding:0;">
          <div class="empty-state">
            <div class="empty-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="empty-title">No clients yet</div>
            <div class="empty-sub">Create a workspace for each client engagement. Each workspace gets its own scope, risks, controls, and audit trail.</div>
            <% if (user.user_type === 'firm') { %>
              <button onclick="document.getElementById('newWs').classList.toggle('hidden')" class="btn btn-primary">New client</button>
            <% } %>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (user.user_type === 'firm' && user.firm_role === 'owner') { %>
<div class="panel" style="margin-top:32px;overflow:hidden">
  <div class="panel-head">
    <h2>Firm team</h2>
    <button onclick="document.getElementById('newUser').classList.toggle('hidden')" class="btn btn-secondary btn-xs">Add consultant</button>
  </div>
  <div id="newUser" class="hidden panel-pad" style="border-bottom:1px solid var(--border);background:var(--bg-subtle);">
    <form method="POST" action="/firm/users" style="display:grid;grid-template-columns:1fr 1fr 1fr 140px auto;gap:8px;align-items:end;">
      <div><label class="label">Name</label><input class="input" name="name" required></div>
      <div><label class="label">Email</label><input class="input" name="email" type="email" required></div>
      <div><label class="label">Initial password</label><input class="input" name="password" type="password" minlength="8" required></div>
      <div><label class="label">Role</label><select class="select" name="firm_role"><option value="consultant">Consultant</option><option value="owner">Owner</option></select></div>
      <button class="btn btn-primary">Create</button>
    </form>
  </div>
  <table class="t">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
    <tbody>
      <% firmUsers.forEach(u => { %>
        <tr>
          <td><%= u.name %></td>
          <td style="color:var(--text-secondary);"><%= u.email %></td>
          <td><span class="tag tag-neutral"><%= u.firm_role %></span></td>
          <td style="text-align:right">
            <% if (u.id !== user.id) { %>
              <form method="POST" action="/firm/users/<%= u.id %>/deactivate" onsubmit="return appConfirmForm(event, 'Deactivate this user?')">
                <button class="btn btn-ghost btn-xs" style="color:#b91c1c">Deactivate</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<div id="deleteClientModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;width:440px;max-width:92vw;box-shadow:0 24px 48px rgba(0,0,0,0.25);overflow:hidden;">
    <div style="padding:16px 18px;border-bottom:1px solid var(--border);background:rgba(185,28,28,0.06);">
      <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--danger,#b91c1c);">Delete client engagement</div>
      <div id="dcmTitle" style="font-size:15px;font-weight:600;margin-top:4px;"></div>
    </div>
    <form id="deleteClientForm" method="POST" action="">
      <div style="padding:18px;">
        <div class="meta" style="font-size:12.5px;line-height:1.5;margin-bottom:14px;">
          Permanently removes this workspace and everything inside it: controls, gap-assessment passes, risks, evidence files (DB and disk), audits, MRMs, NCs, incidents, suppliers, documents, registers. <strong>Cannot be undone.</strong>
        </div>
        <label class="label" style="font-size:12px;">Type <strong id="dcmExpected"></strong> to confirm</label>
        <input id="dcmInput" class="input" name="confirm_name" autocomplete="off" required>
        <div id="dcmError" style="font-size:11.5px;color:var(--danger,#b91c1c);margin-top:6px;display:none;">Name did not match.</div>
      </div>
      <div style="padding:12px 18px;border-top:1px solid var(--border);background:var(--bg-subtle);display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" id="dcmCancel" class="btn btn-ghost btn-xs">Cancel</button>
        <button type="submit" id="dcmConfirm" class="btn btn-xs" style="background:var(--danger,#b91c1c);color:#fff;border-color:var(--danger,#b91c1c);">Delete client</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('deleteClientModal');
    const form = document.getElementById('deleteClientForm');
    const title = document.getElementById('dcmTitle');
    const expected = document.getElementById('dcmExpected');
    const input = document.getElementById('dcmInput');
    const error = document.getElementById('dcmError');
    let currentName = '';

    function open(wsId, clientName) {
      currentName = clientName;
      title.textContent = clientName;
      expected.textContent = clientName;
      input.value = '';
      error.style.display = 'none';
      form.action = '/workspaces/' + wsId + '/delete';
      modal.style.display = 'flex';
      setTimeout(() => input.focus(), 50);
    }
    function close() { modal.style.display = 'none'; }

    document.getElementById('dcmCancel').addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.style.display === 'flex') close(); });
    form.addEventListener('submit', (e) => {
      if (input.value.trim() !== currentName) {
        e.preventDefault();
        error.style.display = 'block';
        input.focus();
      }
    });

    window.deleteClient = open;
  })();
</script>

<%- include('partials/footer') %>
