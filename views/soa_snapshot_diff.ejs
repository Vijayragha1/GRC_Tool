<%- include('partials/header', { title: 'SoA diff', user, ws, active: 'soa' }) %>

<a href="/workspaces/<%= ws.id %>/soa/snapshots" class="link-muted" style="font-size:12px;">← Snapshots</a>

<div class="page-head" style="margin-top:8px">
  <div><h1 class="page-title">Snapshot diff</h1></div>
  <form method="GET" action="/workspaces/<%= ws.id %>/soa/snapshots/diff" style="display:flex;gap:6px;">
    <select name="a" class="select"><% all.forEach(s => { %><option value="<%= s.id %>" <%= sa && sa.id === s.id ? 'selected' : '' %>><%= s.label || s.created_at %></option><% }) %></select>
    <span class="meta" style="line-height:32px;">vs</span>
    <select name="b" class="select"><% all.forEach(s => { %><option value="<%= s.id %>" <%= sb && sb.id === s.id ? 'selected' : '' %>><%= s.label || s.created_at %></option><% }) %></select>
    <button class="btn btn-secondary btn-xs">Compare</button>
  </form>
</div>

<% if (!diff) { %><div class="panel"><div class="panel-pad meta">Pick two snapshots above.</div></div>
<% } else if (!diff.length) { %><div class="panel"><div class="panel-pad meta">No differences. Identical SoA state.</div></div>
<% } else { %>
  <div class="panel"><table class="t">
    <thead><tr><th>Control</th><th>Title</th><th>Changes</th></tr></thead>
    <tbody>
      <% diff.forEach(d => { %>
        <tr>
          <td class="mono meta"><%= d.id.replace('annex-','').toUpperCase() %></td>
          <td><%= d.title %></td>
          <td><% d.changes.forEach(c => { %><div class="meta" style="font-family:ui-monospace,monospace;font-size:11.5px;"><%= c %></div><% }) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
<% } %>

<%- include('partials/footer') %>
