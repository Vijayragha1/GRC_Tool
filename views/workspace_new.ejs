<%- include('partials/header', { title: 'New client', user, ws, active: 'dashboard' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Create client</h1>
    <div class="page-subtitle">Create the client first, then configure one or more assessment programmes when the engagement scope is agreed.</div>
  </div>
  <a href="/dashboard" class="btn btn-secondary btn-xs">Cancel</a>
</div>

<div class="panel">
  <form method="POST" action="/workspaces" class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
    <div class="col-full">
      <label class="label">Client name <span class="meta">required</span></label>
      <input class="input" name="client_name" required autofocus placeholder="e.g., Acme HealthTech">
    </div>
    <div>
      <label class="label">Industry <span class="meta">optional</span></label>
      <input class="input" name="industry" placeholder="e.g., HealthTech SaaS, Fintech, Manufacturing">
    </div>
    <div>
      <label class="label">Target certification date <span class="meta">optional</span></label>
      <input class="input" type="date" name="target_cert_date">
    </div>
    <div class="col-full">
      <label class="label">ISMS scope statement <span class="meta">can be edited later</span></label>
      <textarea class="textarea" name="scope" rows="4" placeholder="What products, locations, organizational units, technology are in scope of the ISMS? What's explicitly excluded and why?"></textarea>
    </div>
    <div class="col-full">
      <div class="label">Assessment programmes <span class="meta">optional · choose any combination</span></div>
      <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:7px;">
        <label class="panel-pad" style="display:flex;gap:8px;cursor:pointer;"><input type="checkbox" name="frameworks" value="iso27001"><span><strong>ISO 27001:2022</strong><span class="meta" style="display:block;">Information security</span></span></label>
        <label class="panel-pad" style="display:flex;gap:8px;cursor:pointer;"><input type="checkbox" name="frameworks" value="iso42001"><span><strong>ISO 42001:2023</strong><span class="meta" style="display:block;">AI management</span></span></label>
        <label class="panel-pad" style="display:flex;gap:8px;cursor:pointer;"><input type="checkbox" name="frameworks" value="csf"><span><strong>NIST CSF 2.0</strong><span class="meta" style="display:block;">Cyber maturity</span></span></label>
      </div>
    </div>
    <div class="col-full" style="display:flex;gap:8px;">
      <button class="btn btn-primary">Create client</button>
      <a href="/dashboard" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
