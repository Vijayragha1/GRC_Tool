<%- include('partials/header', { title: 'Crosswalks', user, ws, active: 'crosswalks' }) %>

<%
  const fwMeta = {
    soc2:     { label: 'SOC 2',        sub: 'Trust Services Criteria', color: '#0891b2' },
    nist_csf: { label: 'NIST CSF 2.0', sub: 'Functions · Categories',  color: '#4f46e5' },
    gdpr:     { label: 'GDPR',         sub: 'Articles',                color: '#15803d' }
  };
  const frameworks = ['soc2','nist_csf','gdpr'];
%>

<div class="page-head">
  <div>
    <h1 class="page-title">Crosswalks</h1>
    <div class="page-subtitle">
      ISO 27001 Annex A mapped to SOC 2 (TSC), NIST CSF 2.0, and GDPR. One control implemented here typically counts in the named framework too &mdash; use this view to credit evidence across engagements.
    </div>
  </div>
  <div style="display:flex;gap:6px;align-items:center;">
    <a href="/workspaces/<%= ws.id %>/soa" class="btn btn-secondary btn-xs">Open SoA</a>
  </div>
</div>

<!-- Coverage KPIs: how many *included* controls are mapped to each framework. -->
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px;">
  <% frameworks.forEach(fw => {
       const m = fwMeta[fw];
       const c = coverage[fw];
       const pct = c.total_included ? Math.round((c.included_mapped / c.total_included) * 100) : 0;
       const cls = pct >= 70 ? 'kpi-good' : pct >= 40 ? 'kpi-warn' : 'kpi-bad';
  %>
    <a href="?framework=<%= fw %>&status=included" class="panel kpi <%= cls %>" style="text-decoration:none;">
      <div class="kpi-head">
        <span style="display:inline-block;width:10px;height:10px;border-radius:3px;background:<%= m.color %>;"></span>
        <div class="kpi-label"><%= m.label %></div>
      </div>
      <div class="kpi-num num"><%= pct %><span class="text-tertiary" style="font-size:15px;font-weight:400;margin-left:1px;">%</span></div>
      <div class="kpi-meta">
        <%= c.included_mapped %> of <%= c.total_included %> included controls mapped &middot; <%= c.total_mapped %> total Annex A mappings
      </div>
    </a>
  <% }) %>
</div>

<!-- Filter bar -->
<form method="GET" class="panel panel-pad" style="margin-bottom:14px;display:grid;grid-template-columns:1fr 180px 180px auto;gap:10px;align-items:end;">
  <div>
    <label class="label">Search</label>
    <input class="input" type="text" name="q" value="<%= q %>" placeholder="A.5.15, CC6.1, Art. 32, encryption&hellip;">
  </div>
  <div>
    <label class="label">Framework</label>
    <select class="select" name="framework">
      <option value="all"     <%= frameworkFilter === 'all'     ? 'selected' : '' %>>All</option>
      <option value="soc2"    <%= frameworkFilter === 'soc2'    ? 'selected' : '' %>>SOC 2</option>
      <option value="nist_csf"<%= frameworkFilter === 'nist_csf'? 'selected' : '' %>>NIST CSF 2.0</option>
      <option value="gdpr"    <%= frameworkFilter === 'gdpr'    ? 'selected' : '' %>>GDPR</option>
    </select>
  </div>
  <div>
    <label class="label">Status</label>
    <select class="select" name="status">
      <option value="all"      <%= statusFilter === 'all'      ? 'selected' : '' %>>All controls</option>
      <option value="included" <%= statusFilter === 'included' ? 'selected' : '' %>>Included in SoA</option>
      <option value="unmapped" <%= statusFilter === 'unmapped' ? 'selected' : '' %>>Unmapped (gaps)</option>
    </select>
  </div>
  <div style="display:flex;gap:6px;">
    <button class="btn btn-primary btn-xs" type="submit">Apply</button>
    <a class="btn btn-ghost btn-xs" href="/workspaces/<%= ws.id %>/crosswalks">Reset</a>
  </div>
</form>

<div class="meta text-base" style="margin-bottom:10px;">
  Showing <strong><%= rowCount %></strong> of <%= totalControls %> Annex A controls.
  <% if (statusFilter === 'unmapped') { %>
    &middot; These controls have no recorded equivalent in the selected frameworks &mdash; either add a mapping or accept the gap.
  <% } %>
</div>

<% themes.forEach(theme => {
     const items = byTheme[theme.key];
     if (!items || items.length === 0) return;
%>
  <div class="panel" style="overflow:hidden;margin-bottom:16px;">
    <div class="panel-head">
      <h2><%= theme.label %> <span class="meta text-base" style="font-weight:400;">&middot; <%= items.length %> control<%= items.length === 1 ? '' : 's' %></span></h2>
    </div>
    <table class="t">
      <thead><tr>
        <th style="width:70px;">ID</th>
        <th>Control</th>
        <th style="width:110px;">Applicability</th>
        <th style="width:170px;">
          <span style="display:inline-flex;align-items:center;gap:6px;">
            <span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:<%= fwMeta.soc2.color %>;"></span>
            SOC 2
          </span>
        </th>
        <th style="width:170px;">
          <span style="display:inline-flex;align-items:center;gap:6px;">
            <span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:<%= fwMeta.nist_csf.color %>;"></span>
            NIST CSF 2.0
          </span>
        </th>
        <th style="width:150px;">
          <span style="display:inline-flex;align-items:center;gap:6px;">
            <span style="display:inline-block;width:8px;height:8px;border-radius:2px;background:<%= fwMeta.gdpr.color %>;"></span>
            GDPR
          </span>
        </th>
      </tr></thead>
      <tbody>
        <% items.forEach(r => {
             const code = r.id.replace('annex-','').toUpperCase();
             const title = (r.title || '').replace(/^A\.[0-9.]+ /, '');
             const isIncluded = r.applicability === 'included';
             const isExcluded = r.applicability === 'excluded';
             const renderRefs = (fw) => {
               const refs = r.mappings[fw] || [];
               if (!refs.length) return '<span class="meta">&mdash;</span>';
               return refs.map(m => {
                 const noteAttr = m.notes ? ` title="${(m.notes || '').replace(/"/g,'&quot;')}"` : '';
                 const cursor = m.notes ? 'cursor:help;' : '';
                 return `<span class="mono text-sm"${noteAttr} style="display:inline-block;padding:2px 7px;margin:1px 2px 1px 0;border:1px solid var(--border);border-radius:4px;background:var(--bg-subtle);font-weight:500;${cursor}">${m.external_ref}</span>`;
               }).join('');
             };
        %>
          <tr>
            <td class="mono meta" style="font-weight:500;"><%= code %></td>
            <td>
              <a href="/workspaces/<%= ws.id %>/controls/assess/<%= r.id %>" class="link-muted text-lg"><%= title %></a>
            </td>
            <td>
              <% if (isIncluded) { %><span class="tag tag-success text-eyebrow">Included</span>
              <% } else if (isExcluded) { %><span class="tag tag-danger text-eyebrow">Excluded</span>
              <% } else { %><span class="tag tag-neutral text-eyebrow">Undecided</span><% } %>
            </td>
            <td style="line-height:1.7;"><%- renderRefs('soc2') %></td>
            <td style="line-height:1.7;"><%- renderRefs('nist_csf') %></td>
            <td style="line-height:1.7;"><%- renderRefs('gdpr') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% }) %>

<% if (rowCount === 0) { %>
  <div class="panel">
    <div class="empty-state">
      <div class="empty-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
      <div class="empty-title">No controls match those filters</div>
      <div class="empty-sub">Try a different framework, status, or clear the search.</div>
      <a class="btn btn-secondary" href="/workspaces/<%= ws.id %>/crosswalks">Reset filters</a>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
