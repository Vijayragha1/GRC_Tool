<%- include('partials/header', { title: 'Custom fields', user, ws, active: 'workspace' }) %>

<div class="page-head">
  <div><h1 class="page-title">Custom fields</h1>
    <div class="page-subtitle">Define additional fields per artefact type. Fields appear on the relevant detail page below the standard form.</div></div>
</div>

<div class="panel" style="margin-bottom:14px">
  <div class="panel-head"><h2>Add a custom field</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/custom-fields" class="panel-pad" style="display:grid;grid-template-columns:repeat(5,1fr);gap:10px;align-items:end;">
    <div><label class="label">Applies to</label>
      <select class="select" name="entity_type" required>
        <% ['risk','asset','supplier','document','incident','nc','task','dpia'].forEach(t => { %><option><%= t %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Field key</label><input class="input mono" name="field_key" pattern="[a-z_]+" required placeholder="business_owner"></div>
    <div><label class="label">Label</label><input class="input" name="label" required></div>
    <div><label class="label">Type</label>
      <select class="select" name="field_type" required>
        <option>text</option><option>textarea</option><option>number</option><option>date</option><option>select</option><option>checkbox</option>
      </select>
    </div>
    <div><label class="label">Options (select only)</label><input class="input" name="options" placeholder="opt1,opt2,opt3"></div>
    <div style="grid-column:1/-1"><label style="font-size:12px;display:flex;gap:6px;align-items:center;"><input type="checkbox" name="required"> Required</label></div>
    <div style="grid-column:1/-1"><button class="btn btn-primary btn-xs">Create field</button></div>
  </form>
</div>

<div class="panel"><table class="t">
  <thead><tr><th>Applies to</th><th>Key</th><th>Label</th><th>Type</th><th>Options</th><th>Required</th><th></th></tr></thead>
  <tbody>
    <% if (!fields.length) { %><tr><td colspan="7" class="t-empty">No custom fields yet.</td></tr><% } %>
    <% fields.forEach(f => { %>
      <tr>
        <td class="meta"><%= f.entity_type %></td>
        <td class="mono meta"><%= f.field_key %></td>
        <td><strong><%= f.label %></strong></td>
        <td class="meta"><%= f.field_type %></td>
        <td class="meta"><%= f.options || '—' %></td>
        <td><span class="tag <%= f.required ? 'tag-warn' : 'tag-neutral' %>"><%= f.required ? 'required' : 'optional' %></span></td>
        <td><form method="POST" action="/workspaces/<%= ws.id %>/custom-fields/<%= f.id %>/delete" onsubmit="return confirm('Delete and lose all stored values?')"><button class="btn btn-danger btn-xs">Delete</button></form></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>

<%- include('partials/footer') %>
