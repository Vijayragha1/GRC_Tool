<%- include('partials/header', { title: 'Ask my Lead', user, ws, active: 'csf' }) %>

<div class="page-head">
  <div>
    <div style="display:flex;align-items:center;gap:10px;">
      <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>" class="meta" style="font-size:12px;text-decoration:none;">&larr; <%= engagement.name %></a>
    </div>
    <h1 class="page-title" style="margin-top:6px;">Ask my Lead</h1>
    <div class="page-subtitle">Async questions sent to the engagement Lead. Use this when you're stuck on a subcategory and need a hand before scoring or escalating.</div>
  </div>
</div>

<% if (messages.length === 0) { %>
  <div class="panel">
    <div class="panel-pad">
      <div class="empty-state">
        <div class="empty-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <div class="empty-title">No messages yet</div>
        <div class="empty-sub">When an analyst clicks "Stuck? Ask your Lead" on a subcategory, the question lands here. Replies are threaded.</div>
      </div>
    </div>
  </div>
<% } %>

<% messages.forEach(m => { %>
  <div class="panel" style="margin-bottom:10px;<%= m.read_at ? '' : 'border-left:3px solid var(--accent);' %>">
    <div class="panel-pad">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:12px;">
        <strong><%= m.sender_name %></strong>
        <span class="meta">&rarr;</span>
        <span><%= m.recipient_name || '(unassigned)' %></span>
        <% if (m.in_reply_to) { %><span class="tag" style="font-size:10px;background:var(--bg-subtle);">reply</span><% } %>
        <% if (!m.read_at) { %><span class="tag" style="background:var(--accent-soft);color:var(--accent);font-size:10px;">unread</span><% } %>
        <% if (m.sub_code) { %><a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= m.subcategory_id %>" class="mono" style="font-size:11px;color:var(--accent);text-decoration:none;margin-left:auto;"><%= m.sub_code %></a><% } %>
        <span class="meta" style="font-size:11px;<%= m.sub_code ? '' : 'margin-left:auto;' %>"><%= m.created_at %></span>
      </div>
      <% if (m.subject) { %><div style="font-weight:500;font-size:13px;margin-top:6px;"><%= m.subject %></div><% } %>
      <div style="font-size:12.5px;margin-top:4px;line-height:1.55;white-space:pre-wrap;color:var(--text-secondary);"><%= m.body %></div>

      <% if (m.recipient_id === user.id && !m.replied_at) { %>
        <details style="margin-top:8px;">
          <summary style="cursor:pointer;font-size:12px;color:var(--accent);">+ Reply</summary>
          <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/ask-lead/<%= m.id %>/reply" style="margin-top:6px;">
            <textarea class="textarea" name="body" rows="3" required placeholder="Reply..." style="font-size:12px;width:100%;"></textarea>
            <button class="btn btn-primary btn-xs" style="margin-top:4px;">Send reply</button>
          </form>
        </details>
      <% } %>
      <% if (m.replied_at) { %><div class="meta" style="font-size:11px;margin-top:6px;">replied <%= m.replied_at %></div><% } %>
    </div>
  </div>
<% }) %>

<%- include('partials/footer') %>
