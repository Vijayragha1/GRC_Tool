<%- include('partials/header', { title: 'Findings & improvement plan', user, ws, active: 'csf' }) %>
<div class="page-head"><div><div class="eyebrow">Risk treatment</div><h1 class="page-title"><%= engagement.name %></h1><div class="page-subtitle">Material maturity gaps translated into findings, recommendations, central risks, and accountable work.</div></div></div>
<%- include('partials/csf2_nav', { section: 'findings', ws, engagement }) %>

<div class="csf2-kpis"><% ['CRITICAL','HIGH','MEDIUM','LOW'].forEach(s=>{ %><div><span><%= s %></span><strong><%= severityCounts[s]||0 %></strong><small>open or governed findings</small></div><% }) %><div><span>Recommendations</span><strong><%= recommendationCount %></strong></div></div>

<% if(!findings.length){ %><div class="panel"><div class="empty-state"><div class="empty-title">No findings recorded</div><div class="empty-sub">Create findings from the relevant outcome assessment so evidence and score lineage remain intact.</div></div></div><% } %>
<div class="csf2-findings-list"><% findings.forEach(f=>{ %><article class="panel csf2-finding-card"><div class="panel-head"><div><span class="severity severity-<%= f.severity.toLowerCase() %>"><%= f.severity %></span><h2><%= f.title %></h2><p><%= f.code||'Engagement theme' %> · <%= f.status %></p></div></div><div class="panel-pad"><p><%= f.description %></p><% if(f.recommendations.length){ %><div class="csf2-recommendations"><% f.recommendations.forEach(r=>{ %><div><strong><%= r.title %></strong><span><%= r.priority %> · <%= roadmapLabels[r.roadmap_phase]||r.roadmap_phase %></span><% if(!r.task_id && canManage){ %><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/recommendations/<%= r.id %>/task"><button class="btn btn-xs">Create central task</button></form><% } else if(r.task_id){ %><a class="btn btn-xs" href="/workspaces/<%= ws.id %>/tasks">Task #<%= r.task_id %></a><% } %></div><% }) %></div><% } %>
  <% if(canManage){ %><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/findings/<%= f.id %>/recommendation" class="csf2-inline-create"><input class="input" name="title" required placeholder="Recommended improvement"><select class="select" name="priority"><option>HIGH</option><option selected>MED</option><option>LOW</option></select><select class="select" name="roadmap_phase"><option value="0_3M">Now–3 months</option><option value="3_6M">3–6 months</option><option value="6_12M">6–12 months</option><option value="12M_PLUS">12+ months</option></select><button class="btn">Add recommendation</button></form><% } %></div></article><% }) %></div>
<%- include('partials/footer') %>
