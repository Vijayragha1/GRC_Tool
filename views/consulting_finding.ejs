<%- include('partials/header',{ title:finding.finding_ref,user,ws,active:'delivery' }) %>
<%
 const csrf=typeof csrfToken!=='undefined'?csrfToken:'';
 const label=value=>String(value||'').replaceAll('_',' ');
 const canReview=typeof userPerms!=='undefined'&&(userPerms.has('document.review')||rbac.isManager(user.firm_role));
 const canUpdate=typeof userPerms!=='undefined'&&(userPerms.has('control.update')||rbac.isManager(user.firm_role));
%>
<style>
 .fnd{max-width:1120px;margin:0 auto}.fnd-top{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding-bottom:15px;border-bottom:1px solid var(--border);margin-bottom:14px}.fnd-eye{font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:7px}.fnd-top h1{font-family:var(--font-display);font-size:29px;line-height:1.08;margin:0 0 6px}.fnd-top p{font-size:10.5px;color:var(--text-muted);margin:0}.fnd-actions{display:flex;gap:7px;align-items:center}.fnd-status{border:1px solid var(--border-strong);border-radius:3px;padding:4px 7px;font-size:8px;font-weight:800;letter-spacing:.065em;text-transform:uppercase;white-space:nowrap}.fnd-grid{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:14px;align-items:start}.fnd-aside{position:sticky;top:18px}.fnd-panel{border:1px solid var(--border);border-radius:8px;background:var(--surface);overflow:hidden;margin-bottom:13px}.fnd-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:13px 15px;border-bottom:1px solid var(--border)}.fnd-head h2{font-size:13px;margin:0 0 3px}.fnd-head p{font-size:9.5px;color:var(--text-muted);margin:0}.fnd-body{padding:15px}.fnd-fact{padding:0 0 14px;margin-bottom:14px;border-bottom:1px solid var(--border)}.fnd-fact:last-child{padding:0;margin:0;border:0}.fnd-fact span,.fnd-form label{display:block;font-size:8px;font-weight:800;letter-spacing:.065em;text-transform:uppercase;color:var(--text-muted);margin-bottom:6px}.fnd-fact p{font-size:11px;line-height:1.6;margin:0;white-space:pre-wrap}.fnd-kv{display:flex;justify-content:space-between;gap:14px;padding:9px 13px;border-bottom:1px solid var(--border);font-size:10px}.fnd-kv:last-child{border:0}.fnd-kv span{color:var(--text-muted)}.fnd-form{display:grid;gap:10px}.fnd-form input,.fnd-form select,.fnd-form textarea{width:100%;padding:8px 9px;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);font:inherit;font-size:10.5px}.fnd-form textarea{min-height:82px;resize:vertical}.fnd-form button{justify-content:center}.fnd-event{padding:10px 13px;border-bottom:1px solid var(--border)}.fnd-event:last-child{border:0}.fnd-event b{display:block;font-size:10px;text-transform:capitalize}.fnd-event p{font-size:9.5px;line-height:1.45;color:var(--text-muted);margin:4px 0}.fnd-event small{font-size:8px;color:var(--text-muted)}.fnd-table{width:100%;border-collapse:collapse;font-size:10px}.fnd-table th,.fnd-table td{padding:9px 11px;text-align:left;border-bottom:1px solid var(--border)}.fnd-table th{font-size:8px;text-transform:uppercase;letter-spacing:.06em;color:var(--text-muted);background:var(--bg-subtle)}.fnd-empty{padding:18px;text-align:center;color:var(--text-muted);font-size:10px}.fnd-callout{font-size:10px;line-height:1.55;color:var(--text-secondary);padding:12px 13px;background:var(--bg-subtle);border-radius:6px;margin-bottom:11px}
 @media(max-width:850px){.fnd-grid{grid-template-columns:1fr}.fnd-aside{position:static}}@media(max-width:600px){.fnd-top{align-items:flex-start;flex-direction:column}}

  /* Microtype floor for phones. This block is scoped to the view because a
     view style tag loads after app.css and would otherwise win. Only the
     selectors declared below 11px above are listed. */
  @media (max-width: 760px) {
    .fnd-eye,
    .fnd-top p,
    .fnd-status,
    .fnd-head p,
    .fnd-fact span,.fnd-form label,
    .fnd-kv,
    .fnd-form input,.fnd-form select,.fnd-form textarea,
    .fnd-event b,
    .fnd-event p,
    .fnd-event small,
    .fnd-table,
    .fnd-table th,
    .fnd-empty,
    .fnd-callout
    { font-size: 11px; }
  }
</style>
<div class="fnd">
 <header class="fnd-top"><div><div class="fnd-eye"><%= finding.finding_ref %> · <%= label(finding.finding_type) %> · <%= finding.severity %></div><h1><%= finding.title %></h1><p>Raised from <%= finding.workpaper_ref %> · <%= finding.workpaper_title %></p></div><div class="fnd-actions"><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/delivery?view=findings&engagement=<%= finding.engagement_id %>">← Findings</a><span class="fnd-status"><%= label(finding.status) %></span></div></header>
 <div class="fnd-grid"><div class="fnd-main">
  <section class="fnd-panel"><div class="fnd-head"><div><h2>Finding statement</h2><p>Condition, criteria, cause, effect and recommendation are retained as separate professional assertions.</p></div><span class="fnd-status"><%= finding.client_visible?'client visible':'internal' %></span></div><div class="fnd-body">
   <div class="fnd-fact"><span>Condition observed</span><p><%= finding.condition_text %></p></div><div class="fnd-fact"><span>Criteria</span><p><%= finding.criteria_text %></p></div><div class="fnd-fact"><span>Cause</span><p><%= finding.cause_text||'Not established' %></p></div><div class="fnd-fact"><span>Effect / risk</span><p><%= finding.effect_text %></p></div><div class="fnd-fact"><span>Recommendation</span><p><%= finding.recommendation_text %></p></div>
  </div></section>
  <% if(finding.remediation_plan||finding.resolution_summary||finding.validation_conclusion){ %><section class="fnd-panel"><div class="fnd-head"><div><h2>Remediation and closure</h2><p>Management action remains distinct from independent validation.</p></div></div><div class="fnd-body"><% if(finding.remediation_plan){ %><div class="fnd-fact"><span>Agreed remediation plan</span><p><%= finding.remediation_plan %></p></div><% } %><% if(finding.effort_estimate||finding.cost_estimate){ %><div class="fnd-fact"><span>Delivery estimate</span><p><%= finding.effort_estimate||'Effort not estimated' %> · <%= finding.cost_estimate||'Cost not estimated' %></p></div><% } %><% if(finding.retest_criteria){ %><div class="fnd-fact"><span>Re-test criteria</span><p><%= finding.retest_criteria %></p></div><% } %><% if(finding.closure_evidence_requirements){ %><div class="fnd-fact"><span>Closure evidence requirements</span><p><%= finding.closure_evidence_requirements %></p></div><% } %><% if(finding.resolution_summary){ %><div class="fnd-fact"><span>Resolution supplied</span><p><%= finding.resolution_summary %></p></div><% } %><% if(finding.validation_conclusion){ %><div class="fnd-fact"><span>Independent validation conclusion</span><p><%= finding.validation_conclusion %></p></div><% } %></div></section><% } %>
  <section class="fnd-panel"><div class="fnd-head"><div><h2>Evidence chain</h2><p>Source, remediation and validation evidence are explicitly classified.</p></div><span class="fnd-status"><%= findingEvidence.length %> linked</span></div><table class="fnd-table"><thead><tr><th>Evidence</th><th>Role</th><th>Hash</th><th>Linked by</th></tr></thead><tbody><% findingEvidence.forEach(e=>{ %><tr><td><%= e.filename %></td><td><%= e.evidence_role %></td><td style="font-family:monospace"><%= e.sha256?.slice(0,12)||'-' %></td><td><%= e.linked_by_name %></td></tr><% }) %><% if(!findingEvidence.length){ %><tr><td class="fnd-empty" colspan="4">No evidence has been linked to this finding.</td></tr><% } %></tbody></table><% if(canUpdate&&evidenceCatalog.length){ %><div class="fnd-body"><form class="fnd-form" method="POST" action="/workspaces/<%= ws.id %>/delivery/findings/<%= finding.id %>/evidence"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Link evidence</label><select name="evidence_id" required><option value="">Choose evidence…</option><% evidenceCatalog.forEach(e=>{ %><option value="<%= e.id %>"><%= e.filename %> · <%= e.uploaded_at %></option><% }) %></select><select name="evidence_role"><option value="source">Source evidence</option><option value="remediation">Remediation evidence</option><option value="validation">Independent validation evidence</option></select><button class="btn btn-secondary btn-sm">Link classified evidence</button></form></div><% } %></section>
 </div><aside class="fnd-aside">
  <section class="fnd-panel"><div class="fnd-head"><div><h2>Governed next action</h2><p>State transition controls</p></div></div><div class="fnd-body">
   <% if(finding.status==='draft'&&canReview){ %><div class="fnd-callout">Confirm only after the finding statement is factually supportable and ready for client discussion.</div><form class="fnd-form" method="POST"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= finding.row_version %>"><textarea name="note" required placeholder="Confirmation or withdrawal rationale"></textarea><button class="btn btn-primary btn-sm" formaction="/workspaces/<%= ws.id %>/delivery/findings/<%= finding.id %>/confirm">Confirm finding</button><button class="btn btn-secondary btn-sm" formaction="/workspaces/<%= ws.id %>/delivery/findings/<%= finding.id %>/withdraw">Withdraw draft</button></form><% } %>
   <% if(finding.status==='confirmed'&&canUpdate){ %><form class="fnd-form" method="POST" action="/workspaces/<%= ws.id %>/delivery/findings/<%= finding.id %>/plan"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= finding.row_version %>"><label>Accountable owner</label><select name="owner_id" required><option value="">Choose…</option><% users.forEach(u=>{ %><option value="<%= u.id %>" <%= u.id===finding.owner_id?'selected':'' %>><%= u.name %></option><% }) %></select><label>Target date</label><input type="date" name="due_date" value="<%= finding.due_date||'' %>" required><label>Agreed remediation plan</label><textarea name="remediation_plan" required><%= finding.remediation_plan||'' %></textarea><label>Effort estimate</label><input name="effort_estimate" maxlength="500" value="<%= finding.effort_estimate||'' %>" placeholder="e.g. 5–8 person days"><label>Cost estimate</label><input name="cost_estimate" maxlength="500" value="<%= finding.cost_estimate||'' %>" placeholder="e.g. £8,000–£12,000"><label>Re-test criteria</label><textarea name="retest_criteria" maxlength="10000"><%= finding.retest_criteria||'' %></textarea><label>Closure evidence requirements</label><textarea name="closure_evidence_requirements" maxlength="10000"><%= finding.closure_evidence_requirements||'' %></textarea><textarea name="note" placeholder="Planning decision note"></textarea><button class="btn btn-primary btn-sm">Accept remediation plan</button></form><% } %>
   <% if(finding.status==='remediation_planned'&&canUpdate){ %><form class="fnd-form" method="POST" action="/workspaces/<%= ws.id %>/delivery/findings/<%= finding.id %>/validate"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= finding.row_version %>"><label>Resolution supplied by management</label><textarea name="resolution_summary" required></textarea><textarea name="note" placeholder="Submission note"></textarea><button class="btn btn-primary btn-sm">Submit for validation</button></form><% } %>
   <% if(finding.status==='ready_for_validation'&&canReview){ %><div class="fnd-callout">Closure requires at least one item classified as independent validation evidence.</div><form class="fnd-form" method="POST" action="/workspaces/<%= ws.id %>/delivery/findings/<%= finding.id %>/close"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= finding.row_version %>"><label>Independent validation conclusion</label><textarea name="validation_conclusion" required></textarea><textarea name="note" placeholder="Closure rationale"></textarea><button class="btn btn-primary btn-sm">Validate and close</button></form><% } %>
   <% if(['closed','withdrawn'].includes(finding.status)){ %><div class="fnd-callout" style="margin:0">This finding is terminal. Its decision history remains append-only.</div><% } %>
  </div></section>
  <section class="fnd-panel"><div class="fnd-head"><div><h2>Accountability</h2><p>Named decision makers</p></div></div><div class="fnd-kv"><span>Owner</span><b><%= finding.owner_name||'Unassigned' %></b></div><div class="fnd-kv"><span>Due date</span><b><%= finding.due_date||'Not set' %></b></div><div class="fnd-kv"><span>Created by</span><b><%= finding.created_by_name %></b></div><div class="fnd-kv"><span>Confirmed by</span><b><%= finding.confirmed_by_name||'Pending' %></b></div><div class="fnd-kv"><span>Validated by</span><b><%= finding.validated_by_name||'Pending' %></b></div><% if(finding.internal_notes){ %><div class="fnd-body"><div class="fnd-fact"><span>Internal consultant notes</span><p><%= finding.internal_notes %></p></div></div><% } %></section>
  <section class="fnd-panel"><div class="fnd-head"><div><h2>Decision history</h2><p>Append-only lifecycle events</p></div></div><% events.slice().reverse().forEach(e=>{ %><div class="fnd-event"><b><%= e.from_status?`${label(e.from_status)} → `:'' %><%= label(e.to_status) %></b><p><%= e.note||'State transition recorded' %></p><small><%= e.actor_name %> · <%= e.created_at %></small></div><% }) %></section>
 </aside></div>
</div>
<%- include('partials/footer') %>
