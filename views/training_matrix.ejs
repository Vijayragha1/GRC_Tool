<%- include('partials/header', { title: 'Training matrix', user, ws, active: 'training' }) %>

<a href="/workspaces/<%= ws.id %>/training/catalogue" class="link-muted" style="font-size:12px;">← Catalogue</a>

<div class="page-head" style="margin-top:8px">
  <div><h1 class="page-title">Training matrix</h1>
    <div class="page-subtitle">Who has done what. Green = completed and current. Amber = expiring within 60 days. Red = overdue or missing.</div></div>
</div>

<%
  const recordsByUserCourse = {};
  records.forEach(r => { recordsByUserCourse[r.user_name + '||' + r.course_id] = r; });
%>

<div class="panel" style="overflow:auto"><table class="t">
  <thead><tr><th style="position:sticky;left:0;background:var(--bg-subtle);z-index:1;">Person</th>
    <% courses.forEach(c => { %><th class="num" style="text-align:center;font-size:10.5px;"><%= c.name %></th><% }) %>
  </tr></thead>
  <tbody>
    <% users.forEach(u => { %>
      <tr>
        <td style="position:sticky;left:0;background:var(--bg);"><strong><%= u.user_name %></strong><% if (u.user_role) { %><div class="meta"><%= u.user_role %></div><% } %></td>
        <% courses.forEach(c => {
             const r = recordsByUserCourse[u.user_name + '||' + c.id];
             let cell = '—', col = '#71717a';
             if (r) {
               if (r.status === 'completed') {
                 cell = '✓';
                 if (r.expiry_date) {
                   const days = Math.floor((new Date(r.expiry_date) - new Date()) / 86400000);
                   if (days < 0) { col = '#b91c1c'; cell = '⚠'; }
                   else if (days < 60) { col = '#ca8a04'; }
                   else { col = '#16a34a'; }
                 } else { col = '#16a34a'; }
               } else { col = '#ca8a04'; cell = '◷'; }
             } else { col = '#b91c1c'; cell = '✗'; }
        %>
          <td style="text-align:center;color:<%= col %>;font-weight:600;font-size:14px;"><%= cell %></td>
        <% }) %>
      </tr>
    <% }) %>
    <% if (!users.length) { %><tr><td colspan="<%= courses.length + 1 %>" class="t-empty">No training records yet.</td></tr><% } %>
  </tbody>
</table></div>

<%- include('partials/footer') %>
