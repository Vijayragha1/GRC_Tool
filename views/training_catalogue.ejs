<%- include('partials/header', { title: 'Training catalogue', user, ws, active: 'training' }) %>

<a href="/workspaces/<%= ws.id %>/training" class="link-muted" style="font-size:12px;">← Training records</a>

<div class="page-head" style="margin-top:8px">
  <div><h1 class="page-title">Training catalogue</h1>
    <div class="page-subtitle">Define each course once. Assign to many people. Recurring expiries get auto-tracked.</div></div>
  <a href="/workspaces/<%= ws.id %>/training/matrix" class="btn btn-secondary btn-xs">Training matrix</a>
</div>

<div class="panel" style="margin-bottom:14px">
  <div class="panel-head"><h2>New course</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/training/catalogue" class="panel-pad" style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">
    <div style="grid-column:1/-1"><label class="label">Name</label><input class="input" name="name" required></div>
    <div style="grid-column:1/-1"><label class="label">Description</label><textarea class="textarea" name="description" rows="2"></textarea></div>
    <div><label class="label">Duration (min)</label><input class="input num" name="duration_minutes" type="number"></div>
    <div><label class="label">Validity (months)</label><input class="input num" name="validity_months" type="number" value="12"></div>
    <div><label class="label">Required for roles (comma sep)</label><input class="input" name="required_for_roles" placeholder="all, engineering, ciso, finance"></div>
    <div style="grid-column:1/-1"><label class="label">Content URL / reference</label><input class="input" name="content_url"></div>
    <div><label style="display:flex;gap:6px;align-items:center;font-size:12px;"><input type="checkbox" name="has_quiz"> Has quiz</label></div>
    <div><label class="label">Passing score (%)</label><input class="input num" name="passing_score" type="number"></div>
    <div><label class="label">ISO control ref</label><input class="input" name="iso_control_ref" placeholder="annex-a.6.3"></div>
    <div style="grid-column:1/-1"><button class="btn btn-primary">Create course</button></div>
  </form>
</div>

<div class="panel"><table class="t">
  <thead><tr><th>Course</th><th>Duration</th><th>Validity</th><th>Required for</th><th class="num">Assigned</th><th class="num">Completed</th><th></th></tr></thead>
  <tbody>
    <% if (!courses.length) { %><tr><td colspan="7" class="t-empty">No courses yet.</td></tr><% } %>
    <% courses.forEach(c => { %>
      <tr>
        <td><strong><%= c.name %></strong><% if (c.description) { %><div class="meta"><%= c.description.slice(0,80) %></div><% } %></td>
        <td class="meta"><%= c.duration_minutes ? c.duration_minutes + ' min' : '—' %></td>
        <td class="meta"><%= c.validity_months ? c.validity_months + ' mo' : '—' %></td>
        <td class="meta"><%= c.required_for_roles || '—' %></td>
        <td class="num"><%= c.assigned_count %></td>
        <td class="num"><%= c.completed_count %></td>
        <td>
          <details>
            <summary class="btn btn-secondary btn-xs">Assign</summary>
            <form method="POST" action="/workspaces/<%= ws.id %>/training/catalogue/<%= c.id %>/assign" style="margin-top:6px;width:340px;">
              <textarea class="textarea" name="recipients" rows="4" placeholder="One per line: name,role&#10;Alice,Engineering&#10;Bob,CISO" required></textarea>
              <input class="input" type="date" name="due_date" style="margin-top:6px;">
              <button class="btn btn-primary btn-xs" style="margin-top:6px;">Assign</button>
            </form>
          </details>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table></div>

<%- include('partials/footer') %>
