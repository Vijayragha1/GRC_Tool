<%- include('partials/header', { title: 'New workspace', user, ws, active: 'dashboard' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Create workspace</h1>
    <div class="page-subtitle">A workspace represents one client engagement (one ISMS scope, one set of controls, one Statement of Applicability).</div>
  </div>
  <a href="/dashboard" class="btn btn-secondary btn-xs">Cancel</a>
</div>

<div class="panel">
  <form method="POST" action="/workspaces" class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
    <div class="col-full">
      <label class="label">Client / engagement name <span class="meta">required</span></label>
      <input class="input" name="client_name" required autofocus placeholder="e.g., Acme HealthTech">
    </div>
    <div>
      <label class="label">Industry <span class="meta">optional</span></label>
      <input class="input" name="industry" placeholder="e.g., HealthTech SaaS, Fintech, Manufacturing">
    </div>
    <div>
      <label class="label">Target certification date <span class="meta">optional</span></label>
      <input class="input" type="date" name="target_cert_date">
    </div>
    <div class="col-full">
      <label class="label">ISMS scope statement <span class="meta">can be edited later</span></label>
      <textarea class="textarea" name="scope" rows="4" placeholder="What products, locations, organizational units, technology are in scope of the ISMS? What's explicitly excluded and why?"></textarea>
    </div>
    <div class="col-full" style="display:flex;gap:8px;">
      <button class="btn btn-primary">Create workspace</button>
      <a href="/dashboard" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
