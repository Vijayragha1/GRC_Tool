<%- include('partials/header',{title,user,ws,active:'work'}) %>
<link rel="stylesheet" href="/work-experience.css">
<div class="work-shell">
 <header class="work-head"><div><h1><%= title %></h1><p><%= isManager?'See where delivery needs intervention, who owns the next step and what is waiting.':'Pick up your next action and keep track of the work you have handed over.' %></p></div><a class="btn btn-secondary" href="<%= user.user_type==='client'&&ws?'/workspaces/'+ws.id+'/client-portal':'/dashboard?legacy=1' %>"><%= user.user_type==='client'?'Client portal':'Clients' %></a></header>
 <%- include('partials/work_nav') %>
 <% if(result.nextAction){ const next=result.nextAction; %><section class="work-next" aria-labelledby="next-work-title"><p class="work-muted">Recommended next step</p><h2 id="next-work-title"><%= next.title %></h2><p><%= next.workspaceName %> · <%= next.programmeLabel %></p><p><strong>Responsible:</strong> <%= next.ownerName || "Needs assignment" %> · <%= next.dueDate ? "Due " + next.dueDate : "No due date set" %></p><a class="btn btn-primary" href="<%= detailHref(next.href) %>"><%= next.actionLabel %></a></section><% } %>
 <div class="work-metrics"><% [['actionRequired','Action required','action_required'],['overdue','Overdue','overdue'],['waiting','Waiting on others','waiting'],['blocked','Blocked','blocked'],['unassigned','Needs assignment','']].forEach(([key,label,status])=>{ %><a class="work-metric" href="<%= query({status,owner:key==='unassigned'?'unassigned':'',cursor:null},base) %>"><strong><%= result.counts[key] %></strong><%= label %></a><% }) %></div>
 <section class="work-panel"><div class="work-panel-head"><h2><%= isManager?'Delivery requiring attention':'Open commitments' %></h2><a href="<%= base %>" class="btn btn-secondary">View all <%= result.counts.total %></a></div><ul class="work-list"><% result.items.slice(0,6).forEach(item=>{ %><%- include('partials/work_item',{item}) %><% }) %></ul><% if(!result.items.length){ %><div class="work-empty"><strong>No open work in this scope</strong><p>Open your programme to start its next governed step, or change the work scope.</p></div><% } %></section>
 <div class="work-grid"><% result.programmeSummaries.forEach(programme=>{ %><section class="work-programme"><h3><%= programme.label %></h3><p><%= programme.actionRequired %> actions · <%= programme.waiting %> waiting · <%= programme.blocked %> blocked · <%= programme.overdue %> overdue</p><p class="work-muted"><%= programme.endpoint %></p><a href="<%= query({programme:programme.code,cursor:null},base) %>" class="btn btn-secondary">Open programme work</a></section><% }) %></div>
 <% if(programmes.length){ %><section style="margin-top:24px"><h2 style="font-size:19px;font-weight:500">Programmes</h2><div class="work-grid"><% programmes.forEach(programme=>{ %><section class="work-programme"><h3><%= programme.label %></h3><p><%= programme.endpoint %></p><a class="btn btn-secondary" href="<%= programme.href %>">Open <%= programme.label %></a></section><% }) %></div></section><% } %>
 <p class="work-caption">Work is ordered by overdue status, priority and due date. Source programmes retain their own review, approval and publication rules.</p>
</div>
<%- include('partials/footer') %>
