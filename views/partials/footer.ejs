<script>
// ----- SPA-lite content swap -----
// Multi-page apps reload on every link click, which resets scroll and feels
// like a full-page jolt. This intercepts same-origin GET nav (sidebar items,
// table-row clicks) and swaps just the main content area via fetch + DOM
// replace. The sidebar, topbar, and modals stay put. Falls back to normal
// navigation on file downloads, external URLs, modifier-key clicks, or any
// fetch failure.
(function () {
  if (!window.fetch || !window.history || !window.history.pushState) return;
  const APP_SELECTOR = '.app';

  function shouldIntercept(link, e) {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return false;
    if (link.target && link.target !== '' && link.target !== '_self') return false;
    if (link.hasAttribute('download')) return false;
    if (link.dataset.noSpa === '1') return false;
    const href = link.getAttribute('href');
    if (!href || !href.startsWith('/')) return false;
    if (href === location.pathname + location.search) return false;
    // Skip exports / file downloads / API endpoints - these need real navigation.
    if (/\.(csv|docx|zip|pdf|xlsx|png|jpg|svg|ico)(\?|#|$)/i.test(href)) return false;
    if (href.startsWith('/api/') || href.startsWith('/vendor/')) return false;
    return true;
  }

  // Update active state on sidebar nav items based on the new URL. We can
  // do this without touching the sidebar element itself, so its scroll
  // position is preserved by the browser automatically.
  function updateSidebarActive(href) {
    const path = href.split('?')[0].split('#')[0];
    document.querySelectorAll('.sidebar a.nav-item').forEach(a => {
      const aHref = (a.getAttribute('href') || '').split('?')[0].split('#')[0];
      // Active if the current URL exactly matches OR is a sub-path of the link
      // (e.g., /workspaces/X/audits matches /workspaces/X/audits/123).
      const isActive = path === aHref || (aHref !== '/' && path.startsWith(aHref + '/'));
      a.classList.toggle('active', isActive);
    });
  }

  // Detect whether the sidebar structure itself differs between old and new.
  // Workspace ↔ firm transitions render different sidebar items; everything
  // within the same context renders the same sidebar with only an active-class
  // change. Using the sidebar's first nav-item href as a fingerprint is a
  // cheap, reliable signal.
  function sidebarStructureKey(sidebar) {
    if (!sidebar) return '';
    const first = sidebar.querySelector('.nav-item');
    return first ? first.getAttribute('href') || '' : '';
  }

  function swapApp(html, targetHref) {
    const parser = new DOMParser();
    const newDoc = parser.parseFromString(html, 'text/html');
    const newApp = newDoc.querySelector(APP_SELECTOR);
    const oldApp = document.querySelector(APP_SELECTOR);
    if (!newApp || !oldApp) return false;
    // Title
    const newTitle = newDoc.querySelector('title');
    if (newTitle) document.title = newTitle.textContent;
    // CSRF token (rotation is rare but possible)
    const newCsrf = newDoc.querySelector('meta[name="csrf-token"]');
    const curCsrf = document.querySelector('meta[name="csrf-token"]');
    if (newCsrf && curCsrf) curCsrf.setAttribute('content', newCsrf.getAttribute('content'));

    // Decide whether to swap the sidebar too. If the sidebar structure is the
    // same (same context), keep the live sidebar element in place - its
    // scroll position is then preserved by the browser without any work.
    const oldSidebar = oldApp.querySelector('.sidebar');
    const newSidebar = newApp.querySelector('.sidebar');
    const sidebarChanged = sidebarStructureKey(oldSidebar) !== sidebarStructureKey(newSidebar);

    if (sidebarChanged) {
      // Workspace ↔ firm transition. Replace the whole .app since the sidebar
      // structure genuinely needs to change.
      oldApp.replaceWith(newApp);
    } else {
      // Same sidebar structure. Swap only the .main pane so the sidebar
      // element is never touched - no scroll loss possible.
      const oldMain = oldApp.querySelector('.main');
      const newMain = newApp.querySelector('.main');
      if (oldMain && newMain) {
        oldMain.replaceWith(newMain);
      } else {
        // Fallback: full app swap
        oldApp.replaceWith(newApp);
      }
    }

    // Re-run any inline scripts that arrived in the swapped subtree.
    document.querySelectorAll('.main script').forEach(old => {
      const s = document.createElement('script');
      for (const a of old.attributes) s.setAttribute(a.name, a.value);
      s.text = old.text;
      old.replaceWith(s);
    });
    // Re-stamp CSRF on every form (existing forms in sidebar, new forms in main).
    if (typeof window._csrfStamp === 'function') {
      document.querySelectorAll('form').forEach(window._csrfStamp);
    }
    // Update active state on the live sidebar (no element swap needed).
    updateSidebarActive(targetHref || location.pathname);
    // Land at the top of the new main pane.
    const liveMain = document.querySelector('.main');
    if (liveMain) liveMain.scrollTop = 0;
    return true;
  }

  // Prefetch cache. mouseover on a link kicks off a fetch; click reuses it
  // for an instant swap. Cache entries expire after 30s so stale-data risk
  // is bounded. Capped at 12 entries to keep memory honest.
  const prefetchCache = new Map();
  const PREFETCH_TTL_MS = 30000;
  const PREFETCH_MAX = 12;

  function prefetchKey(href) { return href; }
  function getPrefetched(href) {
    const k = prefetchKey(href);
    const e = prefetchCache.get(k);
    if (!e) return null;
    if (Date.now() - e.t > PREFETCH_TTL_MS) { prefetchCache.delete(k); return null; }
    return e.p;
  }
  function prefetch(href) {
    const k = prefetchKey(href);
    if (prefetchCache.has(k)) return;
    if (prefetchCache.size >= PREFETCH_MAX) {
      // Drop the oldest entry. Map preserves insertion order so first key is oldest.
      const first = prefetchCache.keys().next().value;
      if (first) prefetchCache.delete(first);
    }
    const p = fetch(href, { headers: { 'X-Spa-Nav': '1', 'X-Spa-Prefetch': '1' }, credentials: 'same-origin' })
      .then(r => (r.ok && r.headers.get('content-type')?.includes('html')) ? r.text() : null)
      .catch(() => null);
    prefetchCache.set(k, { p, t: Date.now() });
  }

  let inflight = null;
  async function navigate(href, push) {
    if (inflight) inflight.abort();
    const ctl = new AbortController();
    inflight = ctl;
    progress.start();
    try {
      // Prefer the prefetched response if we have one.
      const cached = getPrefetched(href);
      let text = cached ? await cached : null;
      if (!text) {
        const res = await fetch(href, { signal: ctl.signal, headers: { 'X-Spa-Nav': '1' }, credentials: 'same-origin' });
        if (!res.ok || !res.headers.get('content-type')?.includes('html')) {
          window.location.href = href; return;
        }
        text = await res.text();
      }
      // pushState first so location.pathname reflects the new URL inside swap.
      if (push) window.history.pushState({}, '', href);
      const ok = swapApp(text, href);
      if (!ok) { window.location.href = href; return; }
      // Drop the consumed entry so a later visit re-fetches fresh.
      prefetchCache.delete(prefetchKey(href));
    } catch (e) {
      if (e.name === 'AbortError') return;
      window.location.href = href;
    } finally {
      if (inflight === ctl) inflight = null;
      progress.done();
    }
  }

  // Top progress bar - the navigation has acknowledgement even before content
  // swaps in. Keeps the click feeling responsive on slow connections.
  const progress = (function () {
    const bar = document.createElement('div');
    bar.id = '__spa_progress';
    bar.style.cssText = 'position:fixed;top:0;left:0;height:2px;width:0;background:var(--accent);z-index:9999;transition:width 0.2s ease, opacity 0.25s ease;pointer-events:none;opacity:0;';
    if (document.body) document.body.appendChild(bar);
    else document.addEventListener('DOMContentLoaded', () => document.body.appendChild(bar));
    let timer = null;
    return {
      start() {
        bar.style.opacity = '1';
        bar.style.width = '12%';
        clearTimeout(timer);
        // Ease toward 80% while the request is in flight.
        let w = 12;
        timer = setInterval(() => { w = Math.min(80, w + (90 - w) * 0.10); bar.style.width = w + '%'; }, 220);
      },
      done() {
        clearTimeout(timer); timer = null;
        bar.style.width = '100%';
        setTimeout(() => { bar.style.opacity = '0'; bar.style.width = '0'; }, 180);
      },
    };
  })();

  // Hover prefetch - kicks off the fetch as soon as the user signals intent.
  // The 80–150ms before the click is usually enough to make the swap appear
  // instant. Skipped for links the SPA wouldn't intercept anyway.
  function attachHoverPrefetch() {
    document.querySelectorAll('a[href^="/"]').forEach(link => {
      if (link.dataset.prefetchBound) return;
      link.dataset.prefetchBound = '1';
      const onHover = () => {
        // Re-use the same shouldIntercept rules so we never prefetch URLs we'd
        // navigate to via full reload anyway.
        const fakeEvt = { button: 0, metaKey: false, ctrlKey: false, shiftKey: false, altKey: false };
        if (!shouldIntercept(link, fakeEvt)) return;
        const href = link.getAttribute('href');
        if (href === location.pathname + location.search) return;
        prefetch(href);
      };
      link.addEventListener('mouseenter', onHover, { passive: true });
      link.addEventListener('focus', onHover, { passive: true });
    });
  }
  document.addEventListener('DOMContentLoaded', attachHoverPrefetch);
  // Re-bind after every SPA swap so newly-rendered links get the same hook.
  const originalSwap = swapApp;
  // (swapApp is a closure-local name; we monkey-patch via re-assignment isn't
  //  possible across closure boundaries. Use a MutationObserver instead.)
  const linkObserver = new MutationObserver(() => attachHoverPrefetch());
  if (document.body) linkObserver.observe(document.body, { childList: true, subtree: true });
  else document.addEventListener('DOMContentLoaded', () => linkObserver.observe(document.body, { childList: true, subtree: true }));

  document.addEventListener('click', (e) => {
    const link = e.target.closest && e.target.closest('a');
    if (!link || !shouldIntercept(link, e)) return;
    e.preventDefault();
    navigate(link.getAttribute('href'), true);
  });

  window.addEventListener('popstate', () => {
    navigate(location.pathname + location.search, false);
  });
})();

// ----- Theme -----
(function() {
  const saved = localStorage.getItem('isms-theme');
  if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
})();
function toggleTheme() {
  const cur = document.documentElement.getAttribute('data-theme');
  const next = cur === 'dark' ? null : 'dark';
  if (next) document.documentElement.setAttribute('data-theme', next);
  else document.documentElement.removeAttribute('data-theme');
  localStorage.setItem('isms-theme', next || 'light');
}

// ----- Sidebar -----
(function() {
  if (localStorage.getItem('isms-sidebar') === 'collapsed') {
    document.getElementById('app')?.classList.add('sidebar-collapsed');
  }
})();
function toggleSidebar(open) {
  const sb = document.getElementById('sidebar');
  const bd = document.getElementById('sidebarBackdrop');
  if (!sb) return;
  sb.classList.toggle('open', open);
  bd.classList.toggle('open', open);
}
function toggleSidebarCollapse() {
  const app = document.getElementById('app');
  if (!app) return;
  app.classList.toggle('sidebar-collapsed');
  localStorage.setItem('isms-sidebar', app.classList.contains('sidebar-collapsed') ? 'collapsed' : 'open');
}

// ----- CSRF token injection -----
// Read the per-session CSRF token from the <meta> tag once, then ensure every
// form has a hidden `_csrf` field before it submits. We hook three places:
//   1. DOMContentLoaded - every form already in the DOM gets a hidden input.
//   2. submit event - covers forms added dynamically (the dashboard's
//      delete-client modal builds its form via JS).
//   3. appConfirmForm helper (below) - that helper bypasses the submit event
//      via HTMLFormElement.prototype.submit.call, so it must stamp the token
//      itself before re-submitting.
(function () {
  const meta = document.querySelector('meta[name="csrf-token"]');
  const token = meta ? meta.getAttribute('content') : '';
  window._csrfToken = token;

  function stampForm(form) {
    if (!form || !token) return;
    let inp = form.querySelector('input[name="_csrf"]');
    if (!inp) {
      inp = document.createElement('input');
      inp.type = 'hidden';
      inp.name = '_csrf';
      form.appendChild(inp);
    }
    inp.value = token;
    // Multipart bodies aren't parsed by the global CSRF middleware (multer
    // runs per-route, after CSRF). Append the token to the action URL so it
    // arrives via req.query instead.
    if ((form.getAttribute('enctype') || '').toLowerCase().includes('multipart')) {
      const action = form.getAttribute('action') || '';
      if (!/[?&]_csrf=/.test(action)) {
        const sep = action.includes('?') ? '&' : '?';
        form.setAttribute('action', action + sep + '_csrf=' + encodeURIComponent(token));
      }
    }
  }
  // Initial pass.
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('form').forEach(stampForm);
  });
  // Catch dynamically-created forms or forms whose token gets stripped.
  document.addEventListener('submit', e => stampForm(e.target), true);
  // Expose so appConfirmForm and the deleteClient builder can call it.
  window._csrfStamp = stampForm;
})();

// ----- Global modal API: replaces native window.confirm / window.alert -----
// appConfirm(message, opts?) -> Promise<boolean>
// appAlert(message, opts?)   -> Promise<void>
// appConfirmForm(event, message, opts?)  -> for onsubmit="return appConfirmForm(event, '…')"
// appConfirmClick(event, message, opts?) -> for onclick="return appConfirmClick(event, '…')"
(function () {
  const modal = document.getElementById('appConfirmModal');
  if (!modal) return;
  const head = document.getElementById('appConfirmHead');
  const kindEl = document.getElementById('appConfirmKind');
  const titleEl = document.getElementById('appConfirmTitle');
  const bodyEl = document.getElementById('appConfirmBody');
  const okBtn = document.getElementById('appConfirmOk');
  const cancelBtn = document.getElementById('appConfirmCancel');
  let resolver = null;
  let isAlert = false;

  function close(result) {
    modal.style.display = 'none';
    const r = resolver; resolver = null;
    if (r) r(result);
  }
  function show(message, opts) {
    opts = opts || {};
    const danger = !!opts.danger;
    isAlert = !!opts.alert;
    kindEl.textContent = (opts.kind || (isAlert ? 'Notice' : (danger ? 'Confirm delete' : 'Confirm'))).toUpperCase();
    kindEl.style.color = danger ? 'var(--danger,#b91c1c)' : 'var(--text-tertiary)';
    head.style.background = danger ? 'rgba(185,28,28,0.06)' : '';
    if (opts.title) { titleEl.textContent = opts.title; titleEl.style.display = ''; }
    else { titleEl.style.display = 'none'; }
    bodyEl.textContent = message || '';
    okBtn.textContent = opts.okLabel || (isAlert ? 'OK' : (danger ? 'Delete' : 'Confirm'));
    okBtn.className = 'btn btn-xs ' + (danger ? '' : 'btn-primary');
    if (danger) {
      okBtn.style.background = 'var(--danger,#b91c1c)';
      okBtn.style.color = '#fff';
      okBtn.style.borderColor = 'var(--danger,#b91c1c)';
    } else {
      okBtn.style.background = ''; okBtn.style.color = ''; okBtn.style.borderColor = '';
    }
    cancelBtn.style.display = isAlert ? 'none' : '';
    modal.style.display = 'flex';
    setTimeout(() => okBtn.focus(), 30);
    return new Promise(res => { resolver = res; });
  }

  okBtn.addEventListener('click', () => close(true));
  cancelBtn.addEventListener('click', () => close(false));
  modal.addEventListener('click', e => { if (e.target === modal) close(false); });
  document.addEventListener('keydown', e => {
    if (modal.style.display !== 'flex') return;
    if (e.key === 'Escape') { e.preventDefault(); close(false); }
    else if (e.key === 'Enter') { e.preventDefault(); close(true); }
  });

  window.appConfirm = (message, opts) => show(message, opts || {});
  window.appAlert = (message, opts) => show(message, Object.assign({ alert: true }, opts || {}));

  // Helper: drop-in replacement for `onsubmit="return appConfirmForm(event, '…')"`. Cancels the
  // form submit, opens our modal; if the user confirms, re-submits the form
  // with a flag so we don't loop.
  window.appConfirmForm = function (event, message, opts) {
    const form = event.currentTarget || event.target;
    if (form && form._appConfirmed) return true;
    if (event.preventDefault) event.preventDefault();
    show(message, Object.assign({ danger: true }, opts || {})).then(ok => {
      if (ok && form) {
        form._appConfirmed = true;
        // HTMLFormElement.prototype.submit bypasses the submit event, so the
        // global CSRF stamper never runs. Stamp manually before submitting.
        if (typeof window._csrfStamp === 'function') window._csrfStamp(form);
        HTMLFormElement.prototype.submit.call(form);
      }
    });
    return false;
  };

  // Helper: drop-in replacement for `onclick="return appConfirmClick(event, '…')"` on a submit
  // button inside a form. Same pattern as appConfirmForm but click-driven.
  window.appConfirmClick = function (event, message, opts) {
    const btn = event.currentTarget || event.target;
    if (btn && btn._appConfirmed) return true;
    if (event.preventDefault) event.preventDefault();
    show(message, Object.assign({ danger: true }, opts || {})).then(ok => {
      if (ok && btn) {
        btn._appConfirmed = true;
        btn.click();
      }
    });
    return false;
  };
})();

// ----- Toasts -----
function toast(msg, kind) {
  const stack = document.getElementById('toastStack');
  if (!stack) return;
  const t = document.createElement('div');
  t.className = 'toast ' + (kind || 'success');
  t.textContent = msg;
  stack.appendChild(t);
  setTimeout(() => { t.classList.add('leaving'); setTimeout(() => t.remove(), 200); }, 2800);
}
// Read flash from query params on page load
(function() {
  const p = new URLSearchParams(location.search);
  if (p.has('toast')) {
    const msg = decodeURIComponent(p.get('toast'));
    const kind = p.get('toastKind') || 'success';
    setTimeout(() => toast(msg, kind), 50);
    p.delete('toast'); p.delete('toastKind');
    const newUrl = location.pathname + (p.toString() ? '?' + p.toString() : '');
    history.replaceState({}, '', newUrl);
  }
})();

// ----- Command palette -----
const wsIdMatch = location.pathname.match(/\/workspaces\/(\d+)/);
const wsIdParam = wsIdMatch ? wsIdMatch[1] : '';
let cpResults = [];
let cpSelected = 0;
let cpDebounce;

function openPalette() {
  document.getElementById('cpBackdrop').classList.add('open');
  setTimeout(() => document.getElementById('cpInput').focus(), 50);
  cpSearch('');
}
function closePalette() {
  document.getElementById('cpBackdrop').classList.remove('open');
  document.getElementById('cpInput').value = '';
}
async function cpSearch(q) {
  const box = document.getElementById('cpResults');
  if (!q || !q.trim()) {
    box.innerHTML = '<div class="cp-empty">Type to search controls, risks, documents…</div>';
    cpResults = []; return;
  }
  try {
    const url = '/api/search?q=' + encodeURIComponent(q) + (wsIdParam ? '&wsId=' + wsIdParam : '');
    const r = await fetch(url);
    const data = await r.json();
    cpResults = data;
    cpSelected = 0;
    renderCp();
  } catch (e) {
    box.innerHTML = '<div class="cp-empty">Search failed.</div>';
  }
}
function renderCp() {
  const box = document.getElementById('cpResults');
  if (!cpResults.length) { box.innerHTML = '<div class="cp-empty">No matches</div>'; return; }
  box.innerHTML = cpResults.map((r, i) => `
    <a href="${r.href}" class="cp-result${i === cpSelected ? ' selected' : ''}" data-idx="${i}">
      <span class="cp-type">${r.type}</span>
      <span class="cp-label">${escapeHtml(r.label)}</span>
      ${r.sublabel ? '<span class="cp-sub">' + escapeHtml(r.sublabel) + '</span>' : ''}
    </a>
  `).join('');
  box.querySelectorAll('.cp-result').forEach(el => {
    el.addEventListener('mouseenter', () => { cpSelected = parseInt(el.dataset.idx, 10); renderCp(); });
  });
}
function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

document.getElementById('cpInput')?.addEventListener('input', e => {
  clearTimeout(cpDebounce);
  cpDebounce = setTimeout(() => cpSearch(e.target.value), 120);
});
document.getElementById('cpInput')?.addEventListener('keydown', e => {
  if (e.key === 'ArrowDown') { e.preventDefault(); cpSelected = Math.min(cpSelected+1, cpResults.length-1); renderCp(); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); cpSelected = Math.max(cpSelected-1, 0); renderCp(); }
  else if (e.key === 'Enter') { e.preventDefault(); if (cpResults[cpSelected]) location.href = cpResults[cpSelected].href; }
  else if (e.key === 'Escape') { closePalette(); }
});

// ----- Help modal -----
function openHelp() { document.getElementById('helpBackdrop').classList.add('open'); }
function closeHelp() { document.getElementById('helpBackdrop').classList.remove('open'); }

// ----- Keyboard shortcuts -----
const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
if (!isMac) {
  document.getElementById('kbdHint') && (document.getElementById('kbdHint').textContent = 'Ctrl K');
  document.getElementById('hk1') && (document.getElementById('hk1').textContent = 'Ctrl K');
  document.getElementById('hk2') && (document.getElementById('hk2').textContent = 'Ctrl ⇧L');
}

let gPressed = false; let gTimer;
function inEditable(el) {
  if (!el) return false;
  const tag = el.tagName;
  return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || el.isContentEditable;
}
document.addEventListener('keydown', e => {
  // ⌘K / Ctrl+K → palette
  if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openPalette(); return; }
  // ⌘⇧L → toggle theme
  if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.key.toLowerCase() === 'l') { e.preventDefault(); toggleTheme(); return; }
  if (e.key === 'Escape') {
    if (document.getElementById('cpBackdrop').classList.contains('open')) closePalette();
    else if (document.getElementById('helpBackdrop').classList.contains('open')) closeHelp();
    return;
  }
  if (inEditable(e.target)) return;
  // / → open palette
  if (e.key === '/') { e.preventDefault(); openPalette(); return; }
  // ? → help
  if (e.key === '?') { e.preventDefault(); openHelp(); return; }
  // g _ → navigate
  if (e.key === 'g') {
    gPressed = true;
    clearTimeout(gTimer);
    gTimer = setTimeout(() => { gPressed = false; }, 1000);
    return;
  }
  if (gPressed) {
    gPressed = false;
    const target = document.querySelector(`[data-shortcut="g ${e.key}"]`);
    if (target) { e.preventDefault(); location.href = target.getAttribute('href'); }
  }
});
</script>
<% } %>
</body>
</html>
