<script>
fetch('/api/workspaces/<%= ws.id %>/trends').then(r => r.json()).then(data => {
  const drawSpark = (id, series, color) => {
    const el = document.getElementById(id);
    if (!el) return;
    const w = el.clientWidth || 200, h = 48;
    const max = Math.max(1, ...series.map(d => d.c));
    const step = w / (series.length - 1);
    const path = series.map((d, i) => `${i===0?'M':'L'}${(i*step).toFixed(1)},${(h - (d.c/max)*(h-6)).toFixed(1)}`).join(' ');
    el.innerHTML = `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" style="overflow:visible">
      <path d="${path}" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="${path} L${w},${h} L0,${h} Z" fill="${color}" opacity="0.08"/>
    </svg>`;
    document.getElementById(id + '-tot').textContent = series.reduce((s,d) => s+d.c, 0) + ' total';
  };
  drawSpark('tr-risks', data.risks, '#dc2626');
  drawSpark('tr-controls', data.controls, '#16a34a');
  drawSpark('tr-ncs-open', data.ncs_open, '#dc2626');
  drawSpark('tr-ncs-closed', data.ncs_closed, '#16a34a');
});
</script>

