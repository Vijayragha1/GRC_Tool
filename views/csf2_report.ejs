<%- include('partials/header', { title: 'Assessment report', user, ws, active: 'csf' }) %>
<style>
  @media(max-width:760px){
    .csf2-report-create{display:grid;grid-template-columns:minmax(0,1fr);width:100%}
    .csf2-report-create .btn{width:100%}
    .csf2-version-row{align-items:stretch;flex-direction:column}
    .csf2-version-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%}
    .csf2-version-actions .btn,.csf2-version-actions form{width:100%}
  }
  @media(max-width:430px){.csf2-version-actions{grid-template-columns:minmax(0,1fr)}}
</style>
<div class="page-head"><div><div class="eyebrow">Decision-grade deliverable</div><h1 class="page-title"><%= engagement.name %></h1><div class="page-subtitle">Immutable Policy and Practice conclusions with evidence, limitations, findings, and target attainment.</div></div></div>
<%- include('partials/csf2_nav', { section: 'report', ws, engagement }) %>

<% if(publicationDefects.length){ %><div class="csf2-callout warning"><strong>Publication gates remain open</strong><p>Exports created before these gates close are watermarked internal progress reports. They do not state a maturity opinion and cannot be shared through the client portal.</p><ul><% publicationDefects.forEach(d=>{ %><li><%= d %></li><% }) %></ul></div><% } else { %><div class="csf2-callout success"><strong>Assessment is publication-ready</strong><p>Profile, all outcome conclusions, client validations, and independent approvals are complete. Publish the approved immutable version to create the client-reliance deliverable.</p></div><% } %>

<div class="csf2-kpis"><div><span>Policy median</span><strong><%= rollup.summary.policyMedian==null?'-':rollup.summary.policyMedian %></strong></div><div><span>Practice median</span><strong><%= rollup.summary.practiceMedian==null?'-':rollup.summary.practiceMedian %></strong></div><div><span>Target attainment</span><strong><%= rollup.summary.targetPct %>%</strong></div><div><span>Low confidence</span><strong><%= rollup.summary.lowConfidence %></strong></div><div><span>No visibility</span><strong><%= rollup.summary.noVisibility %></strong></div></div>

<section class="panel"><div class="panel-head"><div><h2>Function-level decision view</h2><p>Medians and distributions are shown separately; weak outcomes are not hidden by an average.</p></div></div><div class="csf2-function-report"><% rollup.functions.forEach(f=>{ %><div><div><code><%= f.code %></code><strong><%= f.name %></strong></div><span>Policy <b><%= f.summary.policyMedian==null?'-':f.summary.policyMedian %></b></span><span>Practice <b><%= f.summary.practiceMedian==null?'-':f.summary.practiceMedian %></b></span><span>Target <b><%= f.summary.targetPct %>%</b></span><span>Assessed <b><%= f.summary.assessed %>/<%= f.summary.inScope %></b></span></div><% }) %></div></section>

<section class="panel" style="margin-top:14px;"><div class="panel-head"><div><h2>Controlled versions</h2><p>Snapshot payloads cannot be edited after creation. Only a published version is a client deliverable.</p></div><% if(canCreateVersion){ %><form class="csf2-report-create" method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/report/version"><input class="input" name="change_summary" required minlength="20" placeholder="Purpose and material changes"><button class="btn btn-primary">Create immutable draft</button></form><% } %></div>
  <div class="divide-row"><% versions.forEach(v=>{ let frozenSummary={};try{frozenSummary=JSON.parse(v.rollup_snapshot_json||'{}').summary||{};}catch(_){frozenSummary={};}const frozenComplete=Number(frozenSummary.assessed||0)>=Number(frozenSummary.inScope||0)-Number(frozenSummary.noVisibility||0);const clientVersion=v.status==='published'&&frozenComplete; %><div class="csf2-version-row"><div><strong>Version <%= v.version_number %></strong><small><%= v.status %> · <%= frozenSummary.assessed||0 %>/<%= frozenSummary.inScope||0 %> assessed · <%= v.created_at %> · <code><%= v.snapshot_hash.slice(0,12) %>…</code></small><small><%= clientVersion ? 'Published client assessment' : (frozenComplete ? 'Complete internal assessment draft' : 'Internal progress report - no maturity opinion') %></small></div><div class="csf2-version-actions"><a class="btn btn-xs" href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/exports/report.pdf?version=<%= v.id %>"><%= clientVersion?'Client':'Internal' %> PDF</a><a class="btn btn-xs" href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/exports/report.docx?version=<%= v.id %>">Word</a><a class="btn btn-xs" href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/exports/data.csv?version=<%= v.id %>">CSV</a>
    <% if(v.status==='draft'&&canReview){ %><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/report/version/<%= v.id %>"><button class="btn btn-xs" name="action" value="review">Review</button></form><% } %><% if(v.status==='reviewed'&&canApprove){ %><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/report/version/<%= v.id %>"><button class="btn btn-xs" name="action" value="approve">Approve</button></form><% } %><% if(v.status==='approved'&&canApprove&&!publicationDefects.length){ %><form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/report/version/<%= v.id %>"><button class="btn btn-primary btn-xs" name="action" value="publish">Publish to client</button></form><% } %></div></div><% }) %><% if(!versions.length){ %><div class="empty-state"><div class="empty-title">No controlled report versions</div></div><% } %></div>
</section>
<%- include('partials/footer') %>
