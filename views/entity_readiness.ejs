<%- include('partials/header', { title: entity.name + ' — readiness', user, ws, active: 'entities' }) %>

<a href="/workspaces/<%= ws.id %>/entities" class="link-muted" style="font-size:12px;">← Entities</a>

<div class="page-head" style="margin-top:8px">
  <div><h1 class="page-title"><%= entity.name %> — readiness</h1>
    <div class="page-subtitle">Effective control state for this entity (entity override → workspace state → undecided)</div></div>
</div>

<div class="panel kpi" style="margin-bottom:16px;display:grid;grid-template-columns:repeat(6,1fr);gap:0;text-align:center;">
  <div style="padding:18px;"><div class="kpi-num num" style="color:<%= score >= 80 ? '#16a34a' : score >= 60 ? '#ca8a04' : '#b91c1c' %>"><%= score %>%</div><div class="kpi-label">Effective coverage</div></div>
  <div style="padding:18px;border-left:1px solid var(--border)"><div class="kpi-num num"><%= total %></div><div class="kpi-label">Total items</div></div>
  <div style="padding:18px;border-left:1px solid var(--border)"><div class="kpi-num num" style="color:#16a34a;"><%= impl %></div><div class="kpi-label">Implemented</div></div>
  <div style="padding:18px;border-left:1px solid var(--border)"><div class="kpi-num num" style="color:#ca8a04;"><%= partial %></div><div class="kpi-label">Partial</div></div>
  <div style="padding:18px;border-left:1px solid var(--border)"><div class="kpi-num num"><%= ent_assets %></div><div class="kpi-label">Assets</div></div>
  <div style="padding:18px;border-left:1px solid var(--border)"><div class="kpi-num num"><%= ent_risks %></div><div class="kpi-label">Risks</div></div>
</div>

<div class="panel"><table class="t">
  <thead><tr><th style="width:120px">ID</th><th>Title</th><th>Type</th><th>Applicability</th><th>Status</th></tr></thead>
  <tbody>
    <% rows.forEach(r => { %>
      <tr>
        <td class="mono meta"><%= r.id %></td>
        <td><%= r.title %></td>
        <td class="meta"><%= r.type %></td>
        <td><span class="status s-<%= r.applicability %>"><%= r.applicability %></span></td>
        <td><span class="status s-<%= (r.status || '').replace(/\s+/g,'-').toLowerCase() %>"><%= r.status %></span></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>

<%- include('partials/footer') %>
