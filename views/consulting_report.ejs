<%- include('partials/header',{ title:report.title,user,ws,active:clientView?'client-portal':'delivery' }) %>
<%
 const csrf=typeof csrfToken!=='undefined'?csrfToken:'';
 const label=value=>String(value||'').replaceAll('_',' ');
 const s=report.snapshot;
 const canApprove=!clientView&&typeof userPerms!=='undefined'&&userPerms.has('report.approve');
 const canPublish=!clientView&&typeof userPerms!=='undefined'&&userPerms.has('report.publish');
%>
<style>
 .rpt{max-width:1040px;margin:0 auto}.rpt-actions{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:12px}.rpt-sheet{background:#fff;color:#20201e;border:1px solid var(--border);box-shadow:0 8px 26px rgba(0,0,0,.06)}.rpt-cover{padding:58px 62px 42px;border-bottom:1px solid #deddd6}.rpt-eye{font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#74736e;margin-bottom:36px}.rpt-cover h1{font-family:Georgia,serif;font-size:39px;line-height:1.08;margin:0 0 14px;color:#20201e}.rpt-cover p{font-size:12px;line-height:1.6;color:#66645f;margin:0}.rpt-meta{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #deddd6}.rpt-meta div{padding:15px;border-right:1px solid #deddd6}.rpt-meta div:last-child{border:0}.rpt-meta span{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.07em;color:#77756f;margin-bottom:6px}.rpt-meta b{font-size:10px}.rpt-section{padding:30px 62px;border-bottom:1px solid #deddd6}.rpt-section h2{font-family:Georgia,serif;font-size:22px;margin:0 0 15px}.rpt-section h3{font-size:12px;margin:19px 0 7px}.rpt-section p{font-size:11px;line-height:1.65;margin:0 0 10px;white-space:pre-wrap}.rpt-table{width:100%;border-collapse:collapse;font-size:9.5px}.rpt-table th{padding:8px;text-align:left;font-size:7.5px;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #aaa8a0;background:#f6f5f1}.rpt-table td{padding:9px 8px;vertical-align:top;border-bottom:1px solid #e5e3dc}.rpt-status{border:1px solid #aaa8a0;border-radius:3px;padding:4px 7px;font-size:8px;text-transform:uppercase;letter-spacing:.06em;font-weight:800}.rpt-hash{font:8px/1.5 monospace;word-break:break-all;color:#77756f}.rpt-decision{max-width:1040px;margin:12px auto;padding:14px;border:1px solid var(--border);border-radius:8px;background:var(--surface)}.rpt-decision form{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.rpt-decision textarea{flex:1;min-width:240px;border:1px solid var(--border);border-radius:5px;padding:8px;font:inherit;font-size:10px;min-height:42px}.rpt-empty{text-align:center;color:#77756f;padding:20px}
 @media(max-width:700px){.rpt-cover,.rpt-section{padding:26px 22px}.rpt-meta{grid-template-columns:1fr 1fr}.rpt-meta div:nth-child(2){border-right:0}.rpt-actions{align-items:flex-start}.rpt-cover h1{font-size:29px}}@media print{.sidebar,.topbar,.rpt-actions,.rpt-decision{display:none!important}.app-main,.main-inner{margin:0!important;padding:0!important}.rpt{max-width:none}.rpt-sheet{border:0;box-shadow:none}.rpt-section{break-inside:avoid}.rpt-cover{padding-top:100px}}
</style>
<div class="rpt">
 <div class="rpt-actions"><a class="btn btn-secondary btn-xs" href="<%= clientView?`/workspaces/${ws.id}/client-portal`:`/workspaces/${ws.id}/delivery?view=reports&engagement=${report.engagement_id}` %>">← <%= clientView?'Client portal':'Reports' %></a><div style="display:flex;gap:7px"><span class="rpt-status"><%= report.status %></span><button class="btn btn-secondary btn-xs" type="button" onclick="window.print()">Print / save PDF</button></div></div>
 <article class="rpt-sheet">
  <header class="rpt-cover"><div class="rpt-eye"><%= label(report.report_type) %> · <%= clientView ? 'assessment report' : 'controlled client deliverable' %></div><h1><%= report.title %></h1><p><%= s.engagement.name %><br><%= s.engagement.code %> · <%= (s.engagement.frameworks||[]).join(' · ').toUpperCase() %></p></header>
  <div class="rpt-meta"><div><span>Version</span><b><%= report.version_number %></b></div><div><span>Status</span><b><%= clientView && report.status === 'published' ? 'Available' : report.status %></b></div><div><span>Generated</span><b><%= report.generated_at %></b></div><div><span>Assessment period</span><b><%= (s.engagement.period||[]).filter(Boolean).join(' – ')||'Not specified' %></b></div></div>
  <section class="rpt-section"><h2>Scope and basis</h2><h3>Scope</h3><p><%= s.engagement.scope||'The engagement scope is defined in the approved engagement record.' %></p><h3>Basis of preparation</h3><p><%= s.basis %> <%= clientView ? 'Conclusions reflect the supporting records reviewed for this assessment.' : 'Conclusions reflect the evidence retained in the immutable source workpaper versions referenced below.' %></p></section>
  <section class="rpt-section"><h2>Assessment conclusions</h2><table class="rpt-table"><thead><tr><th>Requirement</th><th><%= clientView ? 'Assessment area' : 'Workpaper' %></th><th>Design</th><th>Implementation</th><th>Operation</th><th>Evidence</th></tr></thead><tbody><% s.workpapers.forEach(w=>{ %><tr><td><b><%= w.framework_code.toUpperCase() %> <%= w.requirement_ref %></b><br><%= w.requirement_title %></td><td><% if(!clientView){ %><%= w.workpaper_ref %><br><% } %><%= w.title %><% if(w.client_visible_summary){ %><br><span style="color:#77756f"><%= w.client_visible_summary %></span><% } %></td><td><%= label(w.design_conclusion) %></td><td><%= label(w.implementation_conclusion) %></td><td><%= label(w.operating_effectiveness) %></td><td><%= label(w.evidence_sufficiency) %></td></tr><% }) %></tbody></table></section>
  <section class="rpt-section"><h2>Confirmed findings</h2><% if(!s.findings.length){ %><div class="rpt-empty">No confirmed findings were included in this report.</div><% }else{ %><% s.findings.forEach(f=>{ %><div style="padding:15px 0;border-bottom:1px solid #e5e3dc"><h3 style="margin-top:0"><%= f.finding_ref %> · <%= f.title %> <span class="rpt-status" style="margin-left:6px"><%= f.severity %></span></h3><p><b>Condition:</b> <%= f.condition_text %></p><p><b>Criteria:</b> <%= f.criteria_text %></p><p><b>Effect:</b> <%= f.effect_text %></p><p><b>Recommendation:</b> <%= f.recommendation_text %></p><% if(f.due_date){ %><p><b>Target date:</b> <%= f.due_date %></p><% } %></div><% }) %><% } %></section>
  <section class="rpt-section"><h2><%= clientView ? 'Report details' : 'Document control' %></h2><p>Generated by <%= report.generated_by_name %> on <%= report.generated_at %>.<% if(report.approved_by_name){ %> Independently approved by <%= report.approved_by_name %> on <%= report.approved_at %>.<% } %><% if(report.published_by_name){ %> Published by <%= report.published_by_name %> on <%= report.published_at %>.<% } %></p><% if(!clientView){ %><p class="rpt-hash">SHA-256 snapshot: <%= report.snapshot_hash %></p><% } %></section>
 </article>
</div>
<% if(!clientView&&((report.status==='generated'&&canApprove)||(report.status==='approved'&&canPublish))){ %><div class="rpt-decision"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/reports/<%= report.id %>/<%= report.status==='generated'?'approve':'publish' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><textarea name="note" required placeholder="Mandatory decision rationale"></textarea><button class="btn btn-primary btn-sm"><%= report.status==='generated'?'Independently approve':'Publish to client portal' %></button></form></div><% } %>
<%- include('partials/footer') %>
