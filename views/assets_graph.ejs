<%- include('partials/header', { title: 'Asset graph', user, ws, active: 'assets' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Asset relationships graph</h1>
    <div class="page-subtitle">SVG view of how assets depend on each other. Hover an asset to highlight what it touches; click to open it. Useful for blast-radius reasoning.</div>
  </div>
  <a href="/workspaces/<%= ws.id %>/assets" class="btn btn-secondary btn-xs">← Back to asset list</a>
</div>

<% if (assets.length === 0) { %>
  <div class="panel panel-pad meta">No assets yet.</div>
<% } else if (rels.length === 0) { %>
  <div class="panel panel-pad meta">
    <%= assets.length %> asset<%= assets.length === 1 ? '' : 's' %> registered, but no relationships defined yet. Open an asset and use the "Relationships" panel to record what depends on what.
  </div>
<% } else {
     // Simple force-free layout: place assets on a grid, draw edges with
     // straight lines. Critical assets larger/colored. Pure SVG, no external
     // libs — keeps the page server-rendered and printable.
     const W = 1100, H = 600, R = 28;
     const cols = Math.ceil(Math.sqrt(assets.length));
     const rows = Math.ceil(assets.length / cols);
     const dx = W / (cols + 1);
     const dy = H / (rows + 1);
     const pos = {};
     assets.forEach((a, i) => {
       const r = Math.floor(i / cols), c = i % cols;
       pos[a.id] = { x: dx * (c + 1), y: dy * (r + 1) };
     });
     const sevColor = (cr) => cr === 'critical' ? '#b91c1c' : cr === 'high' ? '#ea580c' : cr === 'medium' ? '#a16207' : 'var(--text-secondary)';
%>
  <div class="panel" style="overflow:auto;">
    <svg width="<%= W %>" height="<%= H %>" viewBox="0 0 <%= W %> <%= H %>" style="display:block;background:var(--bg-subtle);">
      <defs>
        <marker id="arrowhead" markerWidth="9" markerHeight="9" refX="9" refY="4.5" orient="auto-start-reverse">
          <polygon points="0 0, 9 4.5, 0 9" fill="#94a3b8" />
        </marker>
      </defs>
      <% rels.forEach(r => {
           const p = pos[r.parent_asset_id], c = pos[r.child_asset_id];
           if (!p || !c) return;
      %>
        <line x1="<%= p.x %>" y1="<%= p.y %>" x2="<%= c.x %>" y2="<%= c.y %>"
              stroke="#94a3b8" stroke-width="1.5" opacity="0.6" marker-end="url(#arrowhead)" />
      <% }) %>
      <% assets.forEach(a => {
           const p = pos[a.id];
           const r = a.business_criticality === 'critical' ? R + 4 : R;
           const fill = sevColor(a.business_criticality);
      %>
        <a href="/workspaces/<%= ws.id %>/assets/<%= a.id %>">
          <circle cx="<%= p.x %>" cy="<%= p.y %>" r="<%= r %>" fill="<%= fill %>" opacity="0.85" stroke="white" stroke-width="2" />
          <text x="<%= p.x %>" y="<%= p.y - r - 6 %>" text-anchor="middle" font-size="11" font-weight="600" fill="var(--text)" style="pointer-events:none;"><%= a.name.length > 18 ? a.name.slice(0,16) + '…' : a.name %></text>
          <text x="<%= p.x %>" y="<%= p.y + 4 %>" text-anchor="middle" font-size="10" fill="white" style="pointer-events:none;text-transform:uppercase;letter-spacing:0.04em;font-weight:600;"><%= (a.type || '').slice(0,3) %></text>
        </a>
      <% }) %>
    </svg>
  </div>

  <div style="display:flex;gap:14px;margin-top:10px;font-size:11.5px;flex-wrap:wrap;">
    <span class="meta">Color = business criticality:</span>
    <% [['critical','#b91c1c'],['high','#ea580c'],['medium','#a16207'],['low','var(--text-secondary)']].forEach(([l,c]) => { %>
      <span style="display:inline-flex;gap:4px;align-items:center;">
        <span style="width:10px;height:10px;border-radius:50%;background:<%= c %>;"></span>
        <%= l %>
      </span>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
