<%# Fields for a concern or reported adverse impact (A.3.3, A.8.3), shared by
    the record and update forms. Takes r (null when recording), C
    (lib/ai-concerns.js), areas, systems, incidents and today. %>
<% const x = r || {}; const id = x.id ? `cr${x.id}` : 'crNew'; %>
<div><label class="label" for="<%= id %>Channel">How it came in</label><select id="<%= id %>Channel" class="select" name="channel" required><% Object.entries(C.CHANNELS).forEach(([k, l]) => { %><option value="<%= k %>" <%= x.channel === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
<div><label class="label" for="<%= id %>Received">Received</label><input id="<%= id %>Received" class="input" type="date" name="received_on" value="<%= x.received_on || today %>" max="<%= today %>" required></div>
<div><label class="label" for="<%= id %>Reporter">Raised by</label><select id="<%= id %>Reporter" class="select" name="reporter_type"><% Object.entries(C.REPORTERS).forEach(([k, l]) => { %><option value="<%= k %>" <%= (x.reporter_type || 'other') === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
<div style="grid-column:span 3;"><label class="label" for="<%= id %>Summary">What was raised</label><textarea id="<%= id %>Summary" class="textarea" name="summary" rows="2" required maxlength="4000" placeholder="What happened, to whom, and why it matters. No names."><%= x.summary || '' %></textarea></div>
<div><label class="label" for="<%= id %>System">AI system</label><select id="<%= id %>System" class="select" name="ai_system_id"><option value="">Not tied to one system</option><% systems.forEach(s => { %><option value="<%= s.id %>" <%= Number(x.ai_system_id) === s.id ? 'selected' : '' %>><%= s.name %></option><% }) %></select></div>
<div><label class="label" for="<%= id %>Area">Area of impact</label><select id="<%= id %>Area" class="select" name="impact_area"><option value="">Not classified</option><% areas.forEach(([k, l]) => { %><option value="<%= k %>" <%= x.impact_area === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
<div><label class="label" for="<%= id %>Severity">Severity</label><select id="<%= id %>Severity" class="select" name="severity"><option value="">Not rated</option><% Object.entries(C.SEVERITY).forEach(([k, l]) => { %><option value="<%= k %>" <%= x.severity === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
<div><label class="label a42-check"><input type="checkbox" name="anonymous" value="1" <%= x.anonymous ? 'checked' : '' %>> The reporter asked to stay anonymous</label></div>
<div><label class="label" for="<%= id %>Handler">Handled by</label><input id="<%= id %>Handler" class="input" name="handler" value="<%= x.handler || '' %>" maxlength="160" placeholder="Role, not the reporter"></div>
<div><label class="label" for="<%= id %>RespondBy">Respond by</label><input id="<%= id %>RespondBy" class="input" type="date" name="respond_by" value="<%= x.respond_by || '' %>"></div>
<div><label class="label" for="<%= id %>Status">Status</label><select id="<%= id %>Status" class="select" name="status"><% Object.entries(C.STATUSES).forEach(([k, l]) => { %><option value="<%= k %>" <%= (x.status || 'received') === k ? 'selected' : '' %>><%= l %></option><% }) %></select></div>
<div><label class="label" for="<%= id %>Escalated">Escalated to management on</label><input id="<%= id %>Escalated" class="input" type="date" name="escalated_on" value="<%= x.escalated_on || '' %>"></div>
<div><label class="label" for="<%= id %>Incident">Became incident</label><select id="<%= id %>Incident" class="select" name="incident_id"><option value="">None</option><% incidents.forEach(i => { %><option value="<%= i.id %>" <%= Number(x.incident_id) === i.id ? 'selected' : '' %>>INC-<%= i.id %> · <%= i.title %></option><% }) %></select></div>
<div style="grid-column:span 2;"><label class="label" for="<%= id %>Resolution">Resolution</label><input id="<%= id %>Resolution" class="input" name="resolution" value="<%= x.resolution || '' %>" maxlength="8000" placeholder="What was found and done; needed to mark it resolved"></div>
<div><label class="label" for="<%= id %>Resolved">Resolved on</label><input id="<%= id %>Resolved" class="input" type="date" name="resolved_on" value="<%= x.resolved_on || '' %>"></div>
