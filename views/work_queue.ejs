<%- include('partials/header',{title,user,ws,active:'work'}) %>
<link rel="stylesheet" href="/work-experience.css">
<div class="work-shell">
 <header class="work-head"><div><h1><%= title %></h1><p><%= view==='reports'?'Controlled reports across your authorised programmes. Each version keeps its source review and publication rules.':view==='workload'?'Open work grouped by the person or party responsible for the next step.':view==='calendar'?'Every dated item in your selected scope. Open a day to see all its entries.':'Your next steps, reviews and dependencies across programmes.' %></p></div><% if(ws&&user.user_type==='firm'){ %><a class="btn btn-secondary" href="/workspaces/<%= ws.id %>">Client workspace</a><% } %></header>
 <%- include('partials/work_nav') %>
 <form class="work-filters" method="GET">
  <label class="work-search">Search<input type="search" name="q" value="<%= filters.q %>" placeholder="Work, client or owner"></label>
  <% if(user.user_type==='firm'&&view!=='reports'){ %><label>Scope<select name="scope"><option value="mine" <%= workScope==='mine'?'selected':'' %>>My work</option><option value="team" <%= workScope!=='mine'?'selected':'' %>>Accessible team work</option></select></label><% } %>
  <label>Programme<select name="programme"><option value="">All programmes</option><% Object.entries(PROGRAMMES).forEach(([code,programme])=>{ %><option value="<%= code %>" <%= filters.programme===code?'selected':'' %>><%= programme.label %></option><% }) %></select></label>
  <% if(view!=='reports'){ %><label>Status<select name="status"><% [['','Open work'],['action_required','Action required'],['waiting','Waiting'],['blocked','Blocked'],['overdue','Overdue'],['complete','Complete'],['all','All records']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= filters.status===value?'selected':'' %>><%= label %></option><% }) %></select></label><% } %>
  <% if(view==='calendar'){ %><label>From<input type="date" name="from" value="<%= filters.from %>"></label><label>To<input type="date" name="to" value="<%= filters.to %>"></label><% } %>
  <label>Source<select name="type"><option value="">All sources</option><option value="review" <%= filters.type==='review'?'selected':'' %>>Reviews and decisions</option><% result.facets.sources.forEach(source=>{ %><option value="<%= source %>" <%= filters.type===source?'selected':'' %>><%= source.replaceAll('_',' ') %></option><% }) %></select></label>
  <label>Owner<select name="owner"><option value="">Everyone</option><option value="unassigned" <%= filters.owner==='unassigned'?'selected':'' %>>Needs assignment</option><% result.facets.owners.forEach(owner=>{ %><option value="<%= owner.id %>" <%= filters.owner===String(owner.id)?'selected':'' %>><%= owner.name %></option><% }) %></select></label>
  <% if(user.user_type==='firm'){ %><label>Reviewer<select name="reviewer"><option value="">Any reviewer</option><option value="me" <%= filters.reviewer==='me'?'selected':'' %>>I can review</option><% result.facets.reviewers.forEach(reviewer=>{ %><option value="<%= reviewer.id %>" <%= filters.reviewer===String(reviewer.id)?'selected':'' %>><%= reviewer.name %></option><% }) %></select></label><% } %>
  <label>Priority<select name="priority"><option value="">Any priority</option><% ['critical','high','major','medium','normal','minor','low'].forEach(priority=>{ %><option value="<%= priority %>" <%= filters.priority===priority?'selected':'' %>><%= priority %></option><% }) %></select></label>
  <label>Waiting on<select name="waiting"><option value="">Any party</option><% ['client','firm','provider'].forEach(party=>{ %><option value="<%= party %>" <%= filters.waiting===party?'selected':'' %>><%= party %></option><% }) %></select></label>
  <label>Deadline<select name="deadline"><% [['','Any deadline'],['today','Today'],['week','Next 7 days'],['unscheduled','No due date']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= filters.deadline===value?'selected':'' %>><%= label %></option><% }) %></select></label>
  <button class="btn btn-primary">Apply</button><a class="btn btn-secondary" href="<%= base %><%= view==='queue'?'':'/'+view %>">Clear</a>
 </form>
 <p class="work-caption" role="status"><%= result.counts.total %> matching records · <%= result.counts.overdue %> overdue · <%= result.counts.waiting %> waiting · <%= result.counts.blocked %> blocked. Updated <time datetime="<%= result.asOf %>"><%= result.asOf.replace('T',' ').slice(0,19) %> UTC</time>.</p>
 <% if(view==='workload'){ %>
  <div class="work-panel"><table class="work-workload"><thead><tr><th scope="col">Responsible party</th><th scope="col">Open items</th><th scope="col">Overdue</th><th scope="col">Recorded effort</th><th scope="col">Items without estimate</th></tr></thead><tbody><% result.workload.forEach(group=>{ %><tr><td><a href="<%= query({owner:group.waitingOn?'':group.ownerId||'unassigned',waiting:group.waitingOn||'',status:group.waitingOn?'waiting':'',cursor:null},base) %>"><%= group.name %></a></td><td><%= group.total %></td><td><%= group.overdue %></td><td><%= (group.estimatedMinutes/60).toFixed(1) %>h</td><td><%= group.unestimated %></td></tr><% }) %></tbody></table></div><p class="work-caption">Counts describe open commitments, not capacity or utilisation. Effort includes only explicitly recorded estimates; unknown effort remains visible.</p>
 <% }else if(view==='calendar'){ %>
  <% const groups={}; result.items.forEach(item=>{(groups[item.dueDate||'Unscheduled']||=[]).push(item);});Object.keys(groups).sort().forEach(date=>{ %><details class="work-panel work-agenda" open><summary><%= date %> · <%= groups[date].length %> item<%= groups[date].length===1?'':'s' %> on this page</summary><ul class="work-list"><% groups[date].forEach(item=>{ %><%- include('partials/work_item',{item}) %><% }) %></ul></details><% }) %>
 <% }else{ %>
  <div class="work-panel"><ul class="work-list"><% result.items.forEach(item=>{ %><%- include('partials/work_item',{item}) %><% }) %></ul></div>
 <% } %>
 <% if(!result.counts.total){ %><div class="work-panel work-empty"><strong>No work matches this view</strong><p>Change the filters to inspect other authorised work. New assignments will appear here when their source record is ready.</p><a href="<%= base %>" class="btn btn-secondary">Reset filters</a></div><% } %>
 <details class="work-panel" style="padding:16px"><summary>Where these counts come from</summary><p class="work-caption">Counts use every matching authorised source record, including later pages. Linked tasks and their deliverables count once. The next responsible party changes when work is handed over; completion follows the source programme.</p><ul><% Object.entries(result.counts.byType).forEach(([source,count])=>{ %><li><a href="<%= query({type:source,cursor:null},base) %>"><%= source.replaceAll('_',' ') %>: <%= count %></a></li><% }) %></ul></details>
 <% if(view!=='workload'){ %><div class="work-pager"><span class="work-muted">Showing <%= result.counts.total ? Number(result.cursor)+1 : 0 %> to <%= Number(result.cursor)+result.items.length %> of <%= result.counts.total %> matching records</span><div><% if(Number(result.cursor)>0){ %><a class="btn btn-secondary" rel="prev" href="<%= query({cursor:Math.max(0,Number(result.cursor)-50)}) %>">← Previous</a><% } %><% if(result.nextCursor){ %><a class="btn btn-primary" rel="next" href="<%= query({cursor:result.nextCursor}) %>">Next <%= Math.min(50,result.counts.total-Number(result.nextCursor)) %> records →</a><% } %></div></div><% } %>
</div>
<%- include('partials/footer') %>
