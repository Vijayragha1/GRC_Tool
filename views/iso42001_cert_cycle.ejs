<%- include('partials/header', { title: 'ISO 42001 certification cycle', user, ws, active: 'iso42001-cert-cycle' }) %>

<%
  const today = new Date().toISOString().slice(0,10);
  const daysUntil = (d) => {
    if (!d) return null;
    const ms = new Date(d).getTime() - Date.now();
    return Math.floor(ms / 86400000);
  };
  const upcoming = events.filter(e => e.status !== 'completed' && e.status !== 'cancelled' && e.planned_date && e.planned_date >= today)
                          .sort((a,b) => (a.planned_date < b.planned_date ? -1 : 1))[0];
%>

<div class="page-head">
  <div>
    <h1 class="page-title">ISO 42001 certification cycle</h1>
    <div class="page-subtitle">Stage 1 → Stage 2 → annual surveillance for two years → 3-year recertification. Plan the calendar, track actuals, never miss a surveillance window.</div>
  </div>
</div>

<% if (upcoming) {
     const days = daysUntil(upcoming.planned_date);
%>
  <div class="panel kpi" style="margin-bottom:18px;border-left:3px solid #0891b2;">
    <div class="panel-pad">
      <div class="meta" style="font-size:11.5px;text-transform:uppercase;letter-spacing:0.05em;">Next event</div>
      <div style="font-size:18px;font-weight:600;margin-top:4px;"><%= upcoming.event_type %></div>
      <div class="meta" style="font-size:13px;margin-top:2px;">
        <%= upcoming.planned_date %>
        <% if (days >= 0) { %>&middot; <strong style="color:<%= days < 30 ? '#b91c1c' : days < 90 ? '#a16207' : 'var(--text)' %>;"><%= days %> day<%= days === 1 ? '' : 's' %></strong> away<% } %>
      </div>
    </div>
  </div>
<% } %>

<% if (events.length === 0) { %>
  <div class="panel" style="margin-bottom:18px;">
    <div class="panel-head"><h2>No cycle planned yet</h2></div>
    <div class="panel-pad">
      <div style="font-size:13px;line-height:1.55;margin-bottom:14px;">
        A typical first-cert path: Stage 1 in ~60 days, Stage 2 ~30 days after Stage 1, surveillance audits at year 1 and year 2, recertification at year 3. Seed these defaults to start, then edit the dates as the cert body confirms.
      </div>
      <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/cert-cycle/seed" style="display:inline;">
        <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
        <button class="btn btn-primary">Seed default cycle (5 events)</button>
      </form>
    </div>
  </div>
<% } else { %>
  <div class="panel" style="margin-bottom:18px;">
    <div class="panel-head"><h2>Cycle (<%= events.length %>)</h2></div>
    <table class="t">
      <thead><tr>
        <th style="width:240px;">Event</th>
        <th style="width:130px;">Planned</th>
        <th style="width:130px;">Actual</th>
        <th style="width:120px;">Status</th>
        <th>Notes</th>
        <th style="width:80px;"></th>
      </tr></thead>
      <tbody>
        <% events.forEach(e => {
             const days = daysUntil(e.planned_date);
             const overdue = e.planned_date && e.planned_date < today && e.status !== 'completed' && !e.actual_date;
        %>
          <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/cert-cycle/<%= e.id %>/update" class="contents">
            <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
            <tr>
              <td>
                <div style="font-size:13px;font-weight:500;"><%= e.event_type %></div>
              </td>
              <td>
                <input type="date" name="planned_date" value="<%= e.planned_date || '' %>" class="input" style="font-size:12px;<%= overdue ? 'border-color:#b91c1c;color:#b91c1c;' : '' %>">
                <% if (days != null && e.status !== 'completed' && !e.actual_date) { %>
                  <div class="meta" style="font-size:10.5px;"><%= days < 0 ? Math.abs(days) + 'd overdue' : days + 'd away' %></div>
                <% } %>
              </td>
              <td><input type="date" name="actual_date" value="<%= e.actual_date || '' %>" class="input" style="font-size:12px;"></td>
              <td>
                <select name="status" class="select" style="font-size:12px;">
                  <% ['planned','in_progress','completed','cancelled'].forEach(s => { %>
                    <option value="<%= s %>" <%= e.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ') %></option>
                  <% }) %>
                </select>
              </td>
              <td><input type="text" name="notes" value="<%= e.notes || '' %>" class="input" style="font-size:12px;" placeholder="-"></td>
              <td>
                <button class="btn btn-ghost btn-xs" style="font-size:11px;">Save</button>
              </td>
            </tr>
          </form>
        <% }) %>
      </tbody>
    </table>
    <div style="padding:8px 14px;border-top:1px solid var(--border);background:var(--bg-subtle);">
      <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/cert-cycle/seed" onsubmit="return confirm('Append the 5 default cycle events?');" style="display:inline;">
        <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
        <button class="btn btn-ghost btn-xs">+ Add default 5-event cycle</button>
      </form>
    </div>
  </div>
<% } %>

<div class="panel">
  <div class="panel-head"><h2>Add ad-hoc event</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/cert-cycle/add" class="panel-pad" style="display:grid;grid-template-columns:240px 130px 1fr auto;gap:8px;align-items:end;">
    <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
    <div>
      <label class="label">Event type</label>
      <select name="event_type" class="select" required>
        <% eventTypes.forEach(t => { %><option value="<%= t.label %>"><%= t.label %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Planned</label><input type="date" name="planned_date" class="input"></div>
    <div><label class="label">Notes</label><input type="text" name="notes" class="input" placeholder="e.g., cert body confirmed"></div>
    <div><button class="btn btn-primary">Add</button></div>
  </form>
</div>

<%- include('partials/footer') %>
