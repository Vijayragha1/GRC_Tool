<%- include('partials/header', { title: 'Clients', user, ws: null }) %>

<div class="page-head">
  <div>
    <h1 class="page-title"><%= user.user_type === 'firm' ? 'Portfolio' : 'My clients' %></h1>
  </div>
  <% if (user.user_type === 'firm') { %>
    <button onclick="document.getElementById('newWs').showModal()" class="btn btn-primary">+ New client</button>
  <% } %>
</div>

<%# Compact portfolio strip - dropped the 5-card grid (the Avg Stage 1
    average across heterogeneous engagements was meaningless; the rest
    of the KPIs are simple counts that don't need card chrome). One
    typographic data line instead, scanning friendly. Click-through to
    the relevant cohort on the table below. %>
<% if (workspaces.length > 0) { %>
<div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;font-size:13px;color:var(--text-secondary);margin:0 0 16px;padding:10px 14px;border:1px solid var(--border);border-radius:6px;background:var(--bg);">
  <span><strong style="color:var(--text);font-weight:600;font-size:14px;"><%= totals.total %></strong> active client<%= totals.total === 1 ? '' : 's' %></span>
  <span style="color:var(--text-tertiary);">·</span>
  <span><strong style="color:<%= totals.nearCert > 0 ? '#b45309' : 'var(--text-secondary)' %>;font-weight:600;"><%= totals.nearCert %></strong> near cert <span class="text-xs" style="color:var(--text-tertiary);">(&lt; 90d)</span></span>
  <span style="color:var(--text-tertiary);">·</span>
  <span><strong style="color:<%= totals.redFlags > 0 ? '#b91c1c' : 'var(--text-secondary)' %>;font-weight:600;"><%= totals.redFlags %></strong> needing attention</span>
  <span style="color:var(--text-tertiary);">·</span>
  <span><strong style="color:<%= totals.totalOpenNCs > 0 ? '#b91c1c' : 'var(--text-secondary)' %>;font-weight:600;"><%= totals.totalOpenNCs %></strong> open NC<%= totals.totalOpenNCs === 1 ? '' : 's' %> across the firm</span>
</div>
<% } %>

<!-- Onboarding nudge - surface unfinished setup even if the user skipped the
     wizard once. Reviewer feedback: the wizard disappeared after skip with
     no way back. Now persistent until all 6 steps are done. -->
<% if (typeof onboarding !== 'undefined' && onboarding && onboarding.done < onboarding.total) { %>
  <div class="panel" style="margin-bottom:24px;border-left:4px solid var(--accent);background:linear-gradient(135deg,var(--accent-soft) 0%,var(--bg) 60%);display:grid;grid-template-columns:42px 1fr auto;gap:14px;align-items:center;padding:16px 20px;">
    <div style="width:42px;height:42px;border-radius:10px;background:var(--accent);display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
    </div>
    <div style="min-width:0;">
      <div class="text-xs" style="font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent-deep);margin-bottom:2px;">
        Setup <%= onboarding.done %> / <%= onboarding.total %><% if (onboarding.skipped) { %> · resumed after skip<% } %>
      </div>
      <div class="text-xl text-ink" style="font-weight:600;letter-spacing:-0.005em;margin-bottom:4px;">
        <% if (onboarding.nextStep) { %>Next: <%= onboarding.nextStep.title %><% } else { %>Setup almost complete<% } %>
      </div>
      <div style="height:5px;background:var(--bg-muted);border-radius:3px;overflow:hidden;max-width:380px;">
        <div style="height:100%;background:var(--accent);width:<%= onboarding.pct %>%;transition:width 0.2s;"></div>
      </div>
    </div>
    <a href="/onboarding" class="btn btn-primary">Resume setup →</a>
  </div>
<% } %>

<!-- This week across the portfolio - what to touch today, this week, what's late.
     The MSSP consultant's morning standup view: aggregates tasks, NCs, audits,
     and MRMs across every client in the active firm. -->
<% if (typeof thisWeek !== 'undefined' && thisWeek.totalActionable > 0) { %>
  <div class="panel" style="margin-bottom:24px;">
    <div class="panel-head">
      <h2>This week <span class="meta text-lg" style="font-weight:400;">- what's due across all clients</span></h2>
      <span class="meta">
        <% if (thisWeek.overdue.length) { %><strong class="text-danger"><%= thisWeek.overdue.length %></strong> overdue · <% } %>
        <% if (thisWeek.dueThisWeek.length) { %><strong class="text-warn"><%= thisWeek.dueThisWeek.length %></strong> due this week<% } %>
      </span>
    </div>

    <% if (thisWeek.overdue.length) { %>
      <div class="panel-pad" style="border-bottom:1px solid var(--border);background:rgba(220,38,38,0.03);">
        <div class="text-xs text-danger" style="font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Overdue (<%= thisWeek.overdue.length %>)</div>
        <div style="display:grid;gap:6px;">
          <% thisWeek.overdue.slice(0, 10).forEach(it => { %>
            <a href="<%= it.href %>" class="link-muted text-md" style="display:grid;grid-template-columns:80px 100px 1fr 90px;gap:10px;padding:6px 8px;border-radius:4px;align-items:center;">
              <span class="tag tag-danger text-xxs" style="justify-self:start;"><%= it.kind %></span>
              <span class="meta text-xs text-danger" style="font-weight:500;"><%= it.due_date %></span>
              <span><%= it.title %></span>
              <span class="meta text-xs" style="text-align:right;"><%= it.client %></span>
            </a>
          <% }) %>
          <% if (thisWeek.overdue.length > 10) { %>
            <div class="meta text-xs" style="padding:4px 8px;">+ <%= thisWeek.overdue.length - 10 %> more</div>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (thisWeek.dueThisWeek.length) { %>
      <div class="panel-pad">
        <div class="text-xs text-warn" style="font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Due this week (<%= thisWeek.dueThisWeek.length %>)</div>
        <div style="display:grid;gap:6px;">
          <% thisWeek.dueThisWeek.slice(0, 10).forEach(it => { %>
            <a href="<%= it.href %>" class="link-muted text-md" style="display:grid;grid-template-columns:80px 100px 1fr 90px;gap:10px;padding:6px 8px;border-radius:4px;align-items:center;">
              <span class="tag tag-warn text-xxs" style="justify-self:start;"><%= it.kind %></span>
              <span class="meta num text-xs"><%= it.due_date %></span>
              <span><%= it.title %></span>
              <span class="meta text-xs" style="text-align:right;"><%= it.client %></span>
            </a>
          <% }) %>
          <% if (thisWeek.dueThisWeek.length > 10) { %>
            <div class="meta text-xs" style="padding:4px 8px;">+ <%= thisWeek.dueThisWeek.length - 10 %> more</div>
          <% } %>
        </div>
      </div>
    <% } %>

    <%
      const byClient = Object.values(thisWeek.byClient || {}).sort((a,b) => (b.overdue - a.overdue) || (b.thisWeek - a.thisWeek));
    %>
    <% if (byClient.length > 1) { %>
      <div class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
        <div class="text-xs text-tertiary" style="font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">By client</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));gap:8px;">
          <% byClient.forEach(c => { %>
            <a href="/workspaces/<%= c.ws_id %>" class="link-muted text-base" style="display:flex;justify-content:space-between;align-items:center;padding:8px 10px;border:1px solid var(--border);border-radius:6px;background:var(--bg);">
              <span style="font-weight:500;"><%= c.name %></span>
              <span style="display:flex;gap:4px;">
                <% if (c.overdue) { %><span class="tag tag-danger text-xxs"><%= c.overdue %> late</span><% } %>
                <% if (c.thisWeek) { %><span class="tag tag-warn text-xxs"><%= c.thisWeek %> wk</span><% } %>
              </span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<!-- At-risk clients - one row per client flagged across multiple signals -->
<% if (typeof atRisk !== 'undefined' && atRisk.length > 0) { %>
  <div class="panel" style="margin-bottom:24px;border-left:3px solid <%= atRisk.some(r => r.severity === 'high') ? '#b91c1c' : '#a16207' %>;">
    <div class="panel-head">
      <h2>At-risk clients <span class="meta text-lg" style="font-weight:400;">- overdue NCs · stale controls · cert deadlines · missed reviews</span></h2>
      <span class="meta">
        <% const high = atRisk.filter(r => r.severity === 'high').length; const med = atRisk.filter(r => r.severity === 'medium').length; %>
        <% if (high) { %><strong class="text-danger"><%= high %></strong> high · <% } %>
        <% if (med) { %><strong class="text-warn"><%= med %></strong> medium<% } %>
      </span>
    </div>
    <table class="t">
      <thead><tr>
        <th>Client</th>
        <th style="width:130px;">Last pass</th>
        <th style="width:120px;">Stage 1</th>
        <th style="width:140px;">Cert target</th>
        <th>Why flagged</th>
        <th style="width:80px;"></th>
      </tr></thead>
      <tbody>
        <% atRisk.forEach(r => {
             const sevColor = r.severity === 'high' ? '#b91c1c' : '#a16207';
        %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:8px;">
                <span style="width:8px;height:8px;border-radius:50%;background:<%= sevColor %>;flex-shrink:0;"></span>
                <strong class="text-lg"><%= r.client_name %></strong>
                <% if (r.industry) { %><span class="meta text-xs"><%= r.industry %></span><% } %>
              </div>
            </td>
            <td class="text-sm">
              <% if (r.lastPass) { %>
                Pass <%= r.lastPass.pass_number %><br>
                <span class="meta text-eyebrow">
                  <%= r.lastPass.status === 'in_progress' ? 'in progress' : ('done ' + (r.lastPass.completed_at || '').slice(0,10)) %>
                </span>
              <% } else { %>
                <span class="meta">none</span>
              <% } %>
            </td>
            <td><span class="num" style="font-weight:500;color:<%= r.readiness.stage1 >= 80 ? '#15803d' : r.readiness.stage1 >= 50 ? '#a16207' : '#b91c1c' %>;"><%= r.readiness.stage1 %>%</span></td>
            <td class="text-sm">
              <% if (r.target_cert_date) { %>
                <%= r.target_cert_date %><br>
                <span class="meta text-xs <%= r.readiness.daysToTarget !== null && r.readiness.daysToTarget < 30 ? 'text-danger fw-bold' : '' %>">
                  <% if (r.readiness.daysToTarget !== null) { %><%= r.readiness.daysToTarget %> days<% } else { %>-<% } %>
                </span>
              <% } else { %><span class="meta">no target</span><% } %>
            </td>
            <td class="text-sm" style="line-height:1.5;">
              <%
                // Each reason chip links to the most relevant sub-page so a
                // consultant can drill straight in instead of bouncing through
                // the client overview.
                function reasonLink(reason, wsId) {
                  if (/NC/i.test(reason)) return `/workspaces/${wsId}/nonconformities`;
                  if (/cert target/i.test(reason)) return `/workspaces/${wsId}/cert-cycle`;
                  if (/objective/i.test(reason)) return `/workspaces/${wsId}/objectives`;
                  if (/stale controls/i.test(reason)) return `/workspaces/${wsId}/notifications?filter=unread`;
                  if (/pass/i.test(reason)) return `/workspaces/${wsId}/gap-assessment`;
                  return `/workspaces/${wsId}`;
                }
              %>
              <% r.reasons.forEach(reason => { %><a href="<%= reasonLink(reason, r.id) %>" class="tag tag-neutral text-eyebrow" style="margin:1px 2px 1px 0;text-decoration:none;cursor:pointer;"><%= reason %></a><% }) %>
            </td>
            <td><a href="/workspaces/<%= r.id %>" class="btn btn-secondary btn-xs">Open</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<% if (user.user_type === 'firm') { %>
<%# New-client form lives in a native <dialog>. The previous inline
    expanding-panel pattern was invisible to a first-time user: they'd
    click "New client," nothing visibly happened (the panel was further
    down the page below the fold), and they'd give up. A modal makes the
    open/close transition unmissable. Escape closes it; click-outside on
    the backdrop closes it via the JS handler below. %>
<dialog id="newWs" style="border:1px solid var(--border);border-radius:10px;padding:0;width:min(640px, 92vw);background:var(--bg);color:var(--text);box-shadow:var(--shadow-xl);">
  <form method="POST" action="/workspaces">
    <header style="padding:20px 24px 12px;border-bottom:1px solid var(--border);display:flex;align-items:baseline;justify-content:space-between;">
      <div>
        <h2 style="margin:0;font-family:'Source Serif 4',Georgia,serif;font-size:20px;font-weight:600;letter-spacing:-0.01em;">New client</h2>
        <div class="meta text-sm" style="margin-top:2px;">Just the basics here — scope, stakeholders, and the rest of the 25 scoping questions come on the next page.</div>
      </div>
      <button type="button" onclick="document.getElementById('newWs').close()" aria-label="Close" style="background:transparent;border:0;color:var(--text-tertiary);cursor:pointer;padding:4px;font-size:18px;line-height:1;">×</button>
    </header>
    <div class="grid-2" style="padding:18px 24px;display:grid;grid-template-columns:1fr 1fr;gap:14px;">
      <div><label class="label">Client name <span class="meta">required</span></label><input class="input" name="client_name" required autofocus placeholder="e.g. Northwind Financial Services"></div>
      <div><label class="label">Industry</label><input class="input" name="industry" placeholder="SaaS, Fintech, Healthcare…"></div>
      <div class="col-full"><label class="label">Target certification date</label><input class="input" name="target_cert_date" type="date" style="max-width:240px;"></div>
      <%# Scope intentionally NOT here - the next-step intake page auto-
          drafts the full clause 4.3 scope statement from the 25 questions
          and applies it on save. Asking for it twice meant people typed
          a placeholder once and never came back to fix it. %>
      <div class="col-full">
        <%# ISO 27001 always-on; the extras are behind a disclosure. %>
        <input type="hidden" name="frameworks" value="iso27001">
        <details>
          <summary class="meta text-sm" style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;list-style:none;color:var(--text-secondary);">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="6 9 12 15 18 9"/></svg>
            <span>ISO 27001:2022 always included. Add another framework?</span>
          </summary>
          <div class="row text-sm" style="gap:18px;flex-wrap:wrap;padding:10px 0 0 17px;">
            <label class="row-center" style="gap:8px;cursor:pointer;">
              <input type="checkbox" name="frameworks" value="iso42001">
              <span><strong>ISO 42001:2023</strong> <span class="meta">AI management system</span></span>
            </label>
            <label class="row-center" style="gap:8px;cursor:pointer;">
              <input type="checkbox" name="frameworks" value="csf">
              <span><strong>NIST CSF 2.0</strong> <span class="meta">Cybersecurity Framework</span></span>
            </label>
          </div>
        </details>
      </div>
    </div>
    <footer style="padding:14px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;background:var(--bg-subtle);">
      <button type="button" onclick="document.getElementById('newWs').close()" class="btn btn-ghost">Cancel</button>
      <button type="submit" class="btn btn-primary">Create client</button>
    </footer>
  </form>
</dialog>
<script>
// Click-outside-to-close. The native <dialog> backdrop doesn't dismiss
// by default; this adds the expected behaviour. Only triggers when the
// click target IS the dialog element (the backdrop), not its children.
(function () {
  const dlg = document.getElementById('newWs');
  if (!dlg) return;
  dlg.addEventListener('click', e => {
    const r = dlg.getBoundingClientRect();
    const outside = e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
    if (outside) dlg.close();
  });
})();
</script>
<% } %>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr>
      <th>Client</th><th style="width:140px">Stage</th>
      <th style="width:90px">Stage 1</th><th style="width:90px">Days</th>
      <th style="width:80px">NCs</th><th style="width:200px">Progress</th>
      <% if (user.user_type === 'firm') { %><th style="width:40px"></th><% } %>
    </tr></thead>
    <tbody>
      <% workspaces.forEach(w => { %>
        <tr style="cursor:pointer" onclick="location='/workspaces/<%= w.id %>'">
          <td>
            <div style="display:flex;align-items:center;gap:8px;">
              <% if (w.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(w.brand_primary_color)) { %>
                <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:<%= w.brand_primary_color %>;flex-shrink:0;"></span>
              <% } %>
              <span style="font-weight:500"><%= w.brand_display_name || w.client_name %></span>
              <% if (w.sector) { %><span class="tag tag-info text-xxs"><%= w.sector %></span><% } %>
            </div>
            <% if (w.industry) { %><div class="meta" style="margin-top:2px"><%= w.industry %></div><% } %>
          </td>
          <td><span class="status s-<%= w.derivedStage && (w.derivedStage.key === 'post_stage_2' || w.derivedStage.key === 'surveillance') ? 'done' : 'in_progress' %>"><%= w.derivedStage ? w.derivedStage.label : 'New' %></span></td>
          <td><span class="num" style="font-weight:500;color:<%= w.readiness.stage1 >= 80 ? '#15803d' : w.readiness.stage1 >= 50 ? '#a16207' : '#b91c1c' %>"><%= w.readiness.stage1 %>%</span></td>
          <td class="num meta" style="color:<%= w.readiness.daysToTarget !== null && w.readiness.daysToTarget < 30 ? '#b91c1c' : w.readiness.daysToTarget !== null && w.readiness.daysToTarget < 90 ? '#a16207' : '' %>"><%= w.readiness.daysToTarget !== null ? w.readiness.daysToTarget + 'd' : '-' %></td>
          <td>
            <% if (w.openMajorNCs > 0 || w.overdueNCs > 0) { %>
              <span class="tag tag-danger num"><%= w.openMajorNCs + w.overdueNCs %></span>
            <% } else { %><span class="meta">-</span><% } %>
          </td>
          <td>
            <div style="display:flex;align-items:center;gap:8px">
              <div style="width:120px;height:4px;background:var(--bg-muted);border-radius:2px;overflow:hidden;"><div style="height:100%;background:var(--accent);width:<%= w.progress.percent %>%;"></div></div>
              <span class="num text-xs text-tertiary" style="min-width:42px;"><%= w.progress.assessed %>/<%= w.progress.total %></span>
            </div>
          </td>
          <% if (user.user_type === 'firm') { %>
          <td onclick="event.stopPropagation()" style="text-align:right;cursor:default;">
            <button type="button"
                    onclick="deleteClient(<%= w.id %>, '<%= w.client_name.replace(/'/g, "\\'") %>')"
                    title="Delete this client"
                    class="btn btn-ghost btn-xs"
                    style="color:var(--danger,#b91c1c);padding:4px 8px;">×</button>
          </td>
          <% } %>
        </tr>
      <% }) %>
      <% if (workspaces.length === 0) { %>
        <tr><td colspan="6" style="padding:0;">
          <div class="empty-state">
            <div class="empty-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="empty-title">No clients yet</div>
            <div class="empty-sub">Create a client for each client. Each client gets its own scope, risks, controls, and audit trail.</div>
            <% if (user.user_type === 'firm') { %>
              <button onclick="document.getElementById('newWs').showModal()" class="btn btn-primary">+ New client</button>
            <% } %>
          </div>
        </td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<% if (user.user_type === 'firm' && rbac.isManager(user.firm_role)) { %>
<div class="panel" style="margin-top:32px;overflow:hidden">
  <div class="panel-head">
    <h2>Firm team</h2>
    <button onclick="document.getElementById('newUser').classList.toggle('hidden')" class="btn btn-secondary btn-xs">Add consultant</button>
  </div>
  <div id="newUser" class="hidden panel-pad" style="border-bottom:1px solid var(--border);background:var(--bg-subtle);">
    <form method="POST" action="/firm/users" style="display:grid;grid-template-columns:1fr 1fr 1fr 140px auto;gap:8px;align-items:end;">
      <div><label class="label">Name</label><input class="input" name="name" required></div>
      <div><label class="label">Email</label><input class="input" name="email" type="email" required></div>
      <div><label class="label">Initial password</label><input class="input" name="password" type="password" minlength="8" required></div>
      <div><label class="label">Role</label><select class="select" name="firm_role"><option value="consultant">Consultant</option><option value="senior_consultant">Senior consultant</option><option value="manager">Manager</option></select></div>
      <button class="btn btn-primary">Create</button>
    </form>
  </div>
  <table class="t">
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th></th></tr></thead>
    <tbody>
      <% firmUsers.forEach(u => { %>
        <tr>
          <td><%= u.name %></td>
          <td class="text-secondary"><%= u.email %></td>
          <td><span class="tag tag-neutral"><%= rbac.ROLE_LABELS[rbac.normalizeRole(u.firm_role)] || u.firm_role %></span></td>
          <td style="text-align:right">
            <% if (u.id !== user.id) { %>
              <form method="POST" action="/firm/users/<%= u.id %>/deactivate" onsubmit="return appConfirmForm(event, 'Deactivate this user?')">
                <button class="btn btn-ghost btn-xs text-danger">Deactivate</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<div id="deleteClientModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,0.55);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;width:440px;max-width:92vw;box-shadow:0 24px 48px rgba(0,0,0,0.25);overflow:hidden;">
    <div style="padding:16px 18px;border-bottom:1px solid var(--border);background:rgba(185,28,28,0.06);">
      <div class="text-xs" style="font-weight:600;text-transform:uppercase;letter-spacing:0.05em;color:var(--danger,#b91c1c);">Delete client</div>
      <div id="dcmTitle" style="font-size:15px;font-weight:600;margin-top:4px;"></div>
    </div>
    <form id="deleteClientForm" method="POST" action="">
      <div style="padding:18px;">
        <div class="meta text-md" style="line-height:1.5;margin-bottom:14px;">
          Permanently removes this client and everything inside it: controls, gap-assessment passes, risks, evidence files (DB and disk), audits, MRMs, NCs, incidents, suppliers, documents, registers. <strong>Cannot be undone.</strong>
        </div>
        <label class="label text-base">Type <strong id="dcmExpected"></strong> to confirm</label>
        <input id="dcmInput" class="input" name="confirm_name" autocomplete="off" required>
        <div class="text-sm" id="dcmError" style="color:var(--danger,#b91c1c);margin-top:6px;display:none;">Name did not match.</div>
      </div>
      <div style="padding:12px 18px;border-top:1px solid var(--border);background:var(--bg-subtle);display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" id="dcmCancel" class="btn btn-ghost btn-xs">Cancel</button>
        <button type="submit" id="dcmConfirm" class="btn btn-xs" style="background:var(--danger,#b91c1c);color:#fff;border-color:var(--danger,#b91c1c);">Delete client</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('deleteClientModal');
    const form = document.getElementById('deleteClientForm');
    const title = document.getElementById('dcmTitle');
    const expected = document.getElementById('dcmExpected');
    const input = document.getElementById('dcmInput');
    const error = document.getElementById('dcmError');
    let currentName = '';

    function open(wsId, clientName) {
      currentName = clientName;
      title.textContent = clientName;
      expected.textContent = clientName;
      input.value = '';
      error.style.display = 'none';
      form.action = '/workspaces/' + wsId + '/delete';
      modal.style.display = 'flex';
      setTimeout(() => input.focus(), 50);
    }
    function close() { modal.style.display = 'none'; }

    document.getElementById('dcmCancel').addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.style.display === 'flex') close(); });
    form.addEventListener('submit', (e) => {
      if (input.value.trim() !== currentName) {
        e.preventDefault();
        error.style.display = 'block';
        input.focus();
      }
    });

    window.deleteClient = open;
  })();
</script>

<%# Cross-client activity feed (D-10). Last 25 events across every
    client in the firm in the last 30 days. Lets a consultant skim
    "what changed while I was in a meeting" without clicking into
    each client. Filtered to actionable events; pure read events would
    drown out the signal. %>
<% if (typeof recentActivity !== 'undefined' && recentActivity.length > 0) { %>
  <div class="panel" style="margin-top:24px;padding:0;">
    <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:baseline;justify-content:space-between;">
      <h2 style="margin:0;font-size:14px;">Recent activity across clients</h2>
      <span class="meta text-xs">last 30 days · most recent <%= recentActivity.length %> events</span>
    </div>
    <% recentActivity.forEach(a => {
        // Hide read-only events that would be noise (login, dashboard views)
        if (/^(login|logout|view_|page_)/.test(a.action)) return;
        // Friendly action label
        const actionLabel = (a.action || '').replace(/_/g, ' ');
    %>
      <a href="/workspaces/<%= a.workspace_id %>" style="display:grid;grid-template-columns:140px 1fr auto;gap:14px;padding:8px 18px;border-bottom:1px solid var(--border);text-decoration:none;color:inherit;align-items:center;">
        <span class="num text-xs" style="font-family:'SF Mono',Menlo,monospace;color:var(--text-tertiary);"><%= a.created_at %></span>
        <span style="font-size:13px;color:var(--text-secondary);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
          <strong style="font-weight:600;color:var(--text);"><%= a.user_name || 'system' %></strong>
          <%= actionLabel %>
          <% if (a.entity_type) { %><span class="meta"><%= a.entity_type %><% if (a.entity_id) { %> #<%= a.entity_id %><% } %></span><% } %>
        </span>
        <span class="text-xs" style="color:var(--text-tertiary);font-weight:500;"><%= a.client_name %></span>
      </a>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
