<%- include('partials/header', { title: 'ISO 42001 pre-cert blockers', user, ws, active: 'iso42001-readiness' }) %>

<%
  const refOf = it => it.id && String(it.id).startsWith('ai-') ? it.id.replace('ai-annex-', 'A.').replace('ai-clause-', '').replace(/-/g, '.').replace(/^A\.a\./i, 'A.') : `#${it.id}`;
%>
<div class="a42">
  <div class="a42-crumb"><a href="/workspaces/<%= ws.id %>/iso42001/overview">ISO 42001 certification</a> / <a href="/workspaces/<%= ws.id %>/iso42001/readiness">ISO 42001 readiness</a></div>
  <div class="page-head">
    <div>
      <h1 class="page-title">Pre-cert blocker check</h1>
      <div class="page-subtitle">High-severity items that must be cleared before a Stage 2 audit. Each is a specific control or NC the auditor will flag if left open.</div>
    </div>
  </div>

<% if (blockers.length === 0) { %>
  <section class="panel a42-lead a42-lead-single">
    <div class="a42-lead-copy">
      <span class="a42-kicker"><i class="a42-dot t-done" aria-hidden="true"></i> Clear</span>
      <h2>No blockers detected</h2>
      <p>Every high-severity readiness check is clean. Schedule the Stage 1 audit.</p>
      <a class="btn btn-primary" href="/workspaces/<%= ws.id %>/iso42001/cert-cycle">Certification cycle <span aria-hidden="true">→</span></a>
    </div>
  </section>
<% } else { %>
  <% blockers.forEach(b => { %>
    <section class="panel">
      <div class="panel-head">
        <div><h2><i class="a42-dot t-gap" aria-hidden="true"></i> <%= b.label %></h2></div>
        <span class="meta"><%= b.items.length %> item<%= b.items.length === 1 ? '' : 's' %></span>
      </div>
      <ul class="a42-list">
        <% b.items.forEach(it => { const gap = it.id && String(it.id).startsWith('ai-'); const href = gap ? `/workspaces/${ws.id}/iso42001/gap/${it.id}` : b.kind === 'open_ncs' ? `/workspaces/${ws.id}/nonconformities/${it.id}` : null; %>
          <li>
            <i class="a42-dot t-gap" aria-hidden="true"></i>
            <div><% if (href) { %><a class="a42-list-title" href="<%= href %>"><%= it.title %></a><% } else { %><span class="a42-list-title"><%= it.title %></span><% } %><% if (!String(it.title || '').startsWith(refOf(it))) { %><p><%= refOf(it) %></p><% } %></div>
            <% if (gap) { %><a class="a42-list-action" href="<%= href %>">Open <span aria-hidden="true">→</span></a><% } %>
          </li>
        <% }) %>
      </ul>
    </section>
  <% }) %>
<% } %>
</div>

<%- include('partials/footer') %>
