<%- include('partials/header',{title:`Assessment pass ${manifest.pass_number}`,user,ws,active:'delivery'}) %>
<%
 const retained=manifest.retained;
 const label=value=>String(value||'').replaceAll('_',' ');
 const canGenerate=typeof userPerms!=='undefined'&&userPerms.has('report.generate');
%>
<style>
.pass-version{max-width:1160px;margin:auto}.pass-version-actions{display:flex;flex-wrap:wrap;gap:10px;margin:14px 0}.pass-version-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.pass-version-meta p{margin:4px 0}.pass-version table{min-width:640px;width:100%}.pass-version th,.pass-version td{text-align:left;padding:12px;vertical-align:top}.pass-version td{border-top:1px solid var(--border)}.pass-version-table{overflow:auto}.pass-version-hash{overflow-wrap:anywhere}@media(max-width:680px){.pass-version-meta{grid-template-columns:1fr}.pass-version-actions .btn{width:100%}}
</style>
<div class="pass-version">
<div class="page-head"><div><div class="eyebrow">Retained assessment version</div><h1>Pass <%= manifest.pass_number %> · completion <%= manifest.completion_generation %></h1><p class="page-subtitle"><%= retained.pass.label||manifest.label||'Assessment' %> · <%= retained.engagement.name %></p></div></div>
<div class="pass-version-actions"><a class="btn btn-secondary btn-sm" href="/workspaces/<%= ws.id %>/gap-assessment">← Pass history</a><a class="btn btn-primary btn-sm" href="/workspaces/<%= ws.id %>/delivery?view=reports&amp;engagement=<%= manifest.engagement_id %>&amp;manifestId=<%= manifest.id %>"><%= canGenerate?'Generate or view controlled reports':'View controlled reports' %></a></div>
<section class="panel"><div class="panel-pad"><p>This version preserves the assessment at independent completion. Open a requirement to inspect its exact retained workpaper and evidence references.</p><div class="pass-version-meta"><div><strong>Prepared by</strong><p><%= manifest.prepared_by_name||'Recorded consultant' %></p></div><div><strong>Independently reviewed by</strong><p><%= manifest.reviewed_by_name||'Recorded reviewer' %></p></div><div><strong>Captured at</strong><p><%= manifest.source_cutoff %></p></div></div><p style="margin-top:16px"><strong>Scope</strong><br><%= retained.engagement.scope||'Scope retained in the engagement record.' %></p><% if(manifest.supersedes_manifest_id){ %><p>This completion follows <a href="/workspaces/<%= ws.id %>/delivery/pass-manifests/<%= manifest.supersedes_manifest_id %>">the previous retained version</a>.</p><% } %></div></section>
<section class="panel" style="margin-top:16px"><div class="panel-head"><h2>Retained conclusions (<%= manifest.items.length %>)</h2></div><div class="pass-version-table"><table><thead><tr><th>Requirement</th><th>Implementation</th><th>Evidence</th><th>Source</th><th></th></tr></thead><tbody><% manifest.items.forEach(item=>{ const version=item.version,w=version.snapshot.workpaper; %><tr><td><strong><%= w.requirement_ref %></strong><br><%= w.requirement_title %></td><td><%= label(w.implementation_conclusion) %></td><td><%= (version.snapshot.evidence||[]).length %> retained references<br><%= label(w.evidence_sufficiency) %></td><td><%= item.inherited?'Inherited from an earlier pass':'Verified in this pass' %><br>Workpaper version <%= version.version_number %></td><td><a href="/workspaces/<%= ws.id %>/delivery/workpapers/<%= item.workpaper_id %>?snapshot=<%= item.snapshot_id %>">Inspect retained version →</a></td></tr><% }) %></tbody></table></div></section>
<section class="panel" style="margin-top:16px"><div class="panel-head"><h2>Reports from this completion</h2></div><div class="panel-pad"><% if(!manifest.reports.length){ %><p>No report has been generated from this completion yet.</p><% }else{ %><% manifest.reports.forEach(report=>{ %><p><a href="/workspaces/<%= ws.id %>/delivery/reports/<%= report.id %>"><%= report.title %> · version <%= report.version_number %></a> · <%= label(report.status) %></p><% }) %><% } %></div></section>
<details class="panel" style="margin-top:16px"><summary class="panel-pad">Version integrity</summary><div class="panel-pad"><p>The source list, workpaper versions and report links are retained with this assessment completion.</p><p class="pass-version-hash">SHA-256: <%= manifest.manifest_hash %></p></div></details>
</div>
<%- include('partials/footer') %>
