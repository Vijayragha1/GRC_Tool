<%- include('partials/header',{ title:workpaper.workpaper_ref,user,ws,active:'delivery' }) %>
<%
 const csrf=typeof csrfToken!=='undefined'?csrfToken:'';
 const editable=!selectedSnapshot&&['draft','changes_requested'].includes(workpaper.status);
 const canPreview=typeof userPerms!=='undefined'&&userPerms.has('evidence.download');
 const canReview=!selectedSnapshot&&Number(workpaper.owner_id)!==Number(user.id)&&Number(workpaper.prepared_by)!==Number(user.id)&&typeof userPerms!=='undefined'&&(userPerms.has('document.review')||rbac.isManager(user.firm_role));
 const canSignoff=!selectedSnapshot&&typeof userPerms!=='undefined'&&(userPerms.has('assessment.signoff')||rbac.isManager(user.firm_role));
 const firmUsers=users.filter(u=>u.user_type==='firm'&&u.can_prepare!==false),clientUsers=users.filter(u=>u.user_type==='client');
%>
<style>
 .cwp{max-width:1160px;margin:0 auto}.cwp-top{display:flex;justify-content:space-between;gap:22px;align-items:flex-end;padding-bottom:14px;border-bottom:1px solid var(--border);margin-bottom:14px}.cwp-eye{font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--text-muted);margin-bottom:7px}.cwp-top h1{font-family:var(--font-display);font-size:29px;line-height:1.08;margin:0 0 6px}.cwp-top p{font-size:11px;color:var(--text-muted);margin:0}.cwp-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.cwp-grid{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:14px;align-items:start}.cwp-panel{border:1px solid var(--border);border-radius:8px;background:var(--surface);margin-bottom:13px;overflow:hidden}.cwp-head{padding:13px 15px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:14px;align-items:flex-start}.cwp-head h2{font-size:13px;margin:0 0 3px}.cwp-head p{font-size:9.5px;color:var(--text-muted);margin:0}.cwp-body{padding:15px}.cwp-status{border:1px solid var(--border-strong);border-radius:3px;padding:4px 6px;font-size:8px;text-transform:uppercase;letter-spacing:.065em;font-weight:800;white-space:nowrap}.cwp-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.cwp-form .wide{grid-column:1/-1}.cwp-form label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.065em;color:var(--text-muted);font-weight:700;margin-bottom:5px}.cwp-form input,.cwp-form select,.cwp-form textarea{width:100%;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);padding:8px 9px;font:inherit;font-size:10.5px}.cwp-form textarea{min-height:85px;resize:vertical}.cwp-form input:disabled,.cwp-form select:disabled,.cwp-form textarea:disabled{opacity:.75;background:var(--bg-subtle)}.cwp-bar{grid-column:1/-1;display:flex;justify-content:flex-end;gap:7px}.cwp-conclusions{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--border)}.cwp-conclusion{padding:13px;border-right:1px solid var(--border)}.cwp-conclusion:last-child{border-right:0}.cwp-conclusion span{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.065em;color:var(--text-muted);margin-bottom:6px}.cwp-conclusion b{font-size:11px;text-transform:capitalize}.cwp-table{width:100%;border-collapse:collapse;font-size:10px}.cwp-table th{padding:8px 11px;text-align:left;font-size:8px;text-transform:uppercase;letter-spacing:.065em;color:var(--text-muted);background:var(--bg-subtle);border-bottom:1px solid var(--border)}.cwp-table td{padding:9px 11px;border-bottom:1px solid var(--border);vertical-align:top}.cwp-table tr:last-child td{border-bottom:0}.cwp-aside{position:sticky;top:18px}.cwp-kv{display:flex;justify-content:space-between;gap:12px;padding:9px 13px;border-bottom:1px solid var(--border);font-size:10px}.cwp-kv:last-child{border-bottom:0}.cwp-kv span{color:var(--text-muted)}.cwp-ready{padding:12px 13px;font-size:10px;line-height:1.5}.cwp-ready ul{padding-left:17px;margin:7px 0 0}.cwp-event{padding:10px 13px;border-bottom:1px solid var(--border)}.cwp-event:last-child{border-bottom:0}.cwp-event b{font-size:10px}.cwp-event p{font-size:9.5px;color:var(--text-muted);line-height:1.45;margin:4px 0}.cwp-event small{font-size:8px;color:var(--text-muted)}.cwp-note{font-size:10px;line-height:1.5;color:var(--text-secondary);margin:0}.cwp-details{border:1px solid var(--border);border-radius:7px;margin-bottom:10px}.cwp-details summary{padding:11px 13px;list-style:none;cursor:pointer;font-size:10.5px;font-weight:700}.cwp-details[open] summary{border-bottom:1px solid var(--border)}
 @media(max-width:930px){.cwp-grid{grid-template-columns:1fr}.cwp-aside{position:static}.cwp-conclusions{grid-template-columns:1fr 1fr}.cwp-conclusion:nth-child(2){border-right:0}.cwp-conclusion:nth-child(-n+2){border-bottom:1px solid var(--border)}}@media(max-width:620px){.cwp-top{align-items:flex-start;flex-direction:column}.cwp-actions{justify-content:flex-start}.cwp-form{grid-template-columns:1fr}.cwp-form .wide,.cwp-bar{grid-column:1}.cwp-conclusions{grid-template-columns:1fr}.cwp-conclusion{border-right:0;border-bottom:1px solid var(--border)}}

  /* Microtype floor for phones. This block is scoped to the view because a
     view style tag loads after app.css and would otherwise win. Only the
     selectors declared below 11px above are listed. */
  @media (max-width: 760px) {
    .cwp-eye,
    .cwp-head p,
    .cwp-status,
    .cwp-form label,
    .cwp-form input,.cwp-form select,.cwp-form textarea,
    .cwp-conclusion span,
    .cwp-table,
    .cwp-table th,
    .cwp-kv,
    .cwp-ready,
    .cwp-event b,
    .cwp-event p,
    .cwp-event small,
    .cwp-note,
    .cwp-details summary
    { font-size: 11px; }
  }
</style>
<div class="cwp">
 <header class="cwp-top"><div><div class="cwp-eye"><%= workpaper.framework_code.toUpperCase() %> <%= workpaper.requirement_ref %> · <%= workpaper.workpaper_ref %></div><h1><%= workpaper.title %></h1><p><%= workpaper.requirement_title %> · owner <%= workpaper.owner_name %> · reviewer <%= workpaper.reviewer_name||'not assigned' %></p></div><div class="cwp-actions"><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/delivery?view=workpapers&engagement=<%= workpaper.engagement_id %>">← Workpapers</a><span class="cwp-status"><%= workpaper.status.replaceAll('_',' ') %></span></div></header>
 <% if(formError){ %><section class="cwp-panel" role="alert"><div class="cwp-body"><b>Update could not be completed</b><p><%= formError %></p><p>Your entered workpaper fields are retained below. <a href="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>" target="_blank" rel="noopener">Open the latest saved record to compare</a>.</p><% if(attemptedValues){ %><details><summary>Your attempted changes</summary><pre style="white-space:pre-wrap"><%= JSON.stringify(attemptedValues,null,2) %></pre></details><% } %></div></section><% } %>
 <% if(!selectedSnapshot&&snapshots.some(s=>s.pass_number)){ const latest=snapshots.find(s=>s.pass_number); %><section class="cwp-panel"><div class="cwp-body"><b>Assessment pass <%= latest.pass_number %> has a retained version</b><p>This page shows the current working record. Open the assessment version to inspect the conclusions and evidence captured at completion.</p><a class="btn btn-secondary btn-sm" href="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>?snapshot=<%= latest.id %>">Open pass <%= latest.pass_number %> · completion <%= latest.completion_generation %></a></div></section><% } %>
 <% if(selectedSnapshot){ %><section class="cwp-panel"><div class="cwp-body"><b>Frozen version <%= selectedSnapshot.version_number %><% if(selectedSnapshot.pass_number){ %> · Assessment pass <%= selectedSnapshot.pass_number %> · completion <%= selectedSnapshot.completion_generation %><% } %></b><p>Captured <%= selectedSnapshot.frozen_at %>. This is the exact version retained for this assessment.</p><a href="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>">Return to current workpaper</a></div></section><% } %>
 <section class="cwp-panel"><div class="cwp-conclusions"><div class="cwp-conclusion"><span>Management claim</span><b><%= workpaper.management_claim.replaceAll('_',' ') %></b></div><div class="cwp-conclusion"><span>Design assessment</span><b><%= workpaper.design_conclusion.replaceAll('_',' ') %></b></div><div class="cwp-conclusion"><span>Implementation assessment</span><b><%= workpaper.implementation_conclusion.replaceAll('_',' ') %></b></div><div class="cwp-conclusion"><span>Operating effectiveness</span><b><%= workpaper.operating_effectiveness.replaceAll('_',' ') %></b></div></div></section>
 <div class="cwp-grid"><div class="cwp-main">
  <section class="cwp-panel"><div class="cwp-head"><div><h2>Consultant workpaper</h2><p>Procedures, sampling, exceptions and defensible conclusions.</p></div><span class="cwp-status"><%= editable?'editable':'controlled' %></span></div><div class="cwp-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>" class="cwp-form" <%- editable?`data-form-draft="workpaper" data-draft-record="${workpaper.id}" data-draft-version="${storedVersion}"`:"" %> <%= formError?'data-draft-recovery=true':'' %> data-draft-recorded="<%= JSON.stringify(recordedValues) %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= workpaper.row_version %>">
   <div class="wide"><label for="cwp-field-1">Title</label><input id="cwp-field-1" name="title" value="<%= workpaper.title %>" <%= editable?'':'disabled' %> required></div>
   <div><label for="cwp-field-2">Owner</label><select id="cwp-field-2" name="owner_id" <%= editable?'':'disabled' %>><% firmUsers.forEach(u=>{ %><option value="<%= u.id %>" <%= Number(u.id)===Number(workpaper.owner_id)?'selected':'' %>><%= u.name %></option><% }) %></select></div><div><label for="cwp-field-3">Quality reviewer</label><select id="cwp-field-3" name="reviewer_id" <%= editable?'':'disabled' %>><option value="">Assign reviewer</option><% (editable?reviewerCandidates:firmUsers).forEach(u=>{ %><option value="<%= u.id %>" <%= Number(u.id)===Number(workpaper.reviewer_id)?'selected':'' %>><%= u.name %></option><% }) %></select></div>
   <div><label for="cwp-field-4">Due date</label><input id="cwp-field-4" type="date" name="due_date" value="<%= workpaper.due_date||'' %>" <%= editable?'':'disabled' %>></div><div><label for="cwp-field-5">Client validator</label><select id="cwp-field-5" name="client_validator_id" <%= editable?'':'disabled' %>><option value="">Not assigned</option><% clientUsers.forEach(u=>{ %><option value="<%= u.id %>" <%= Number(u.id)===Number(workpaper.client_validator_id)?'selected':'' %>><%= u.name %></option><% }) %></select></div>
   <div class="wide"><label for="cwp-field-6">Objective</label><textarea id="cwp-field-6" name="objective" <%= editable?'':'disabled' %>><%= workpaper.objective||'' %></textarea></div><div class="wide"><label for="cwp-field-7">Procedure performed</label><textarea id="cwp-field-7" name="procedure_performed" <%= editable?'':'disabled' %>><%= workpaper.procedure_performed||'' %></textarea></div><div class="wide"><label for="cwp-field-8">Persons interviewed</label><textarea id="cwp-field-8" name="persons_interviewed" <%= editable?'':'disabled' %>><%= workpaper.persons_interviewed||'' %></textarea></div>
   <div><label for="cwp-field-9">Testing period start</label><input id="cwp-field-9" type="date" name="testing_period_start" value="<%= workpaper.testing_period_start||'' %>" <%= editable?'':'disabled' %>></div><div><label for="cwp-field-10">Testing period end</label><input id="cwp-field-10" type="date" name="testing_period_end" value="<%= workpaper.testing_period_end||'' %>" <%= editable?'':'disabled' %>></div><div class="wide"><label for="cwp-field-11">Population description</label><textarea id="cwp-field-11" name="population_description" <%= editable?'':'disabled' %>><%= workpaper.population_description||'' %></textarea></div><div><label for="cwp-field-12">Population size</label><input id="cwp-field-12" type="number" min="0" name="population_size" value="<%= workpaper.population_size??'' %>" <%= editable?'':'disabled' %>></div><div><label for="cwp-field-13">Sample size</label><input id="cwp-field-13" type="number" min="0" name="sample_size" value="<%= workpaper.sample_size??'' %>" <%= editable?'':'disabled' %>></div><div class="wide"><label for="cwp-field-14">Sampling method</label><textarea id="cwp-field-14" name="sample_method" <%= editable?'':'disabled' %>><%= workpaper.sample_method||'' %></textarea></div><div><label for="cwp-field-15">Exceptions identified</label><input id="cwp-field-15" type="number" min="0" name="exceptions_count" value="<%= workpaper.exceptions_count %>" <%= editable?'':'disabled' %>></div><div class="wide"><label for="cwp-field-16">Exception summary</label><textarea id="cwp-field-16" name="exception_summary" <%= editable?'':'disabled' %>><%= workpaper.exception_summary||'' %></textarea></div>
   <div><label for="cwp-field-17">Management claim</label><select id="cwp-field-17" name="management_claim" <%= editable?'':'disabled' %>><% ['not_provided','implemented','partially_implemented','not_implemented','not_applicable'].forEach(v=>{ %><option value="<%= v %>" <%= workpaper.management_claim===v?'selected':'' %>><%= v.replaceAll('_',' ') %></option><% }) %></select></div><div><label for="cwp-field-18">Design conclusion</label><select id="cwp-field-18" name="design_conclusion" <%= editable?'':'disabled' %>><% ['not_assessed','suitable','partially_suitable','unsuitable','not_applicable'].forEach(v=>{ %><option value="<%= v %>" <%= workpaper.design_conclusion===v?'selected':'' %>><%= v.replaceAll('_',' ') %></option><% }) %></select></div><div><label for="cwp-field-19">Implementation conclusion</label><select id="cwp-field-19" name="implementation_conclusion" <%= editable?'':'disabled' %>><% ['not_assessed','implemented','partially_implemented','not_implemented','not_applicable'].forEach(v=>{ %><option value="<%= v %>" <%= workpaper.implementation_conclusion===v?'selected':'' %>><%= v.replaceAll('_',' ') %></option><% }) %></select></div><div><label for="cwp-field-20">Operating effectiveness</label><select id="cwp-field-20" name="operating_effectiveness" <%= editable?'':'disabled' %>><% ['not_tested','effective','partially_effective','ineffective','not_applicable'].forEach(v=>{ %><option value="<%= v %>" <%= workpaper.operating_effectiveness===v?'selected':'' %>><%= v.replaceAll('_',' ') %></option><% }) %></select></div><div><label for="cwp-field-21">Evidence sufficiency</label><select id="cwp-field-21" name="evidence_sufficiency" <%= editable?'':'disabled' %>><% ['not_assessed','insufficient','partially_sufficient','sufficient'].forEach(v=>{ %><option value="<%= v %>" <%= workpaper.evidence_sufficiency===v?'selected':'' %>><%= v.replaceAll('_',' ') %></option><% }) %></select></div>
   <div class="wide"><label for="cwp-field-22">Conclusion rationale</label><textarea id="cwp-field-22" name="conclusion_rationale" <%= editable?'':'disabled' %>><%= workpaper.conclusion_rationale||'' %></textarea></div><div class="wide"><label for="cwp-field-23">Internal consultant notes</label><textarea id="cwp-field-23" name="internal_notes" <%= editable?'':'disabled' %>><%= workpaper.internal_notes||'' %></textarea></div><div class="wide"><label for="cwp-field-24">Client-visible summary</label><textarea id="cwp-field-24" name="client_visible_summary" <%= editable?'':'disabled' %>><%= workpaper.client_visible_summary||'' %></textarea></div><div><label for="cwp-field-25">Client visibility</label><select id="cwp-field-25" name="client_visible" <%= editable?'':'disabled' %>><option value="0" <%= !Number(workpaper.client_visible)?'selected':'' %>>Internal only</option><option value="1" <%= Number(workpaper.client_visible)?'selected':'' %>>Client visible</option></select></div><div><label for="cwp-field-26">Client validation</label><select id="cwp-field-26" name="requires_client_validation" <%= editable?'':'disabled' %>><option value="0" <%= !Number(workpaper.requires_client_validation)?'selected':'' %>>Not required</option><option value="1" <%= Number(workpaper.requires_client_validation)?'selected':'' %>>Required</option></select></div>
   <% if(editable){ %><div class="wide"><label for="cwp-field-27">Submission note (optional)</label><textarea id="cwp-field-27" name="note" placeholder="Context for the independent reviewer"><%= attemptedValues?.note||'' %></textarea></div><div class="cwp-bar"><button name="intent" value="save" class="btn btn-secondary btn-sm">Save workpaper</button><button name="intent" value="submit" class="btn btn-primary btn-sm">Save and submit for review</button></div><% } %>
  </form></div></section>

  <section class="cwp-panel"><div class="cwp-head"><div><h2>Evidence assessment</h2><p>Evidence is classified by purpose, relevance and covered period. Open a linked filename to inspect the evidence.</p></div><span class="cwp-status"><%= linkedEvidence.length %> linked</span></div><table class="cwp-table"><thead><tr><th>Evidence</th><th>Purpose</th><th>Relevance</th><th>Period</th></tr></thead><tbody><% linkedEvidence.forEach(e=>{ %><tr><td><% if(canPreview){ %><a href="/workspaces/<%= ws.id %>/evidence/<%= e.evidence_id||e.id %>/preview" target="_blank" rel="noopener"><b><%= e.filename %></b> ↗</a><% }else{ %><b><%= e.filename %></b><% } %><br><span class="cwp-note"><%= e.sha256?.slice(0,12)||'no hash' %></span></td><td><%= e.purpose %></td><td><%= e.relevance.replaceAll('_',' ') %></td><td><%= e.period_covered_start||'-' %> – <%= e.period_covered_end||'-' %></td></tr><% }) %><% if(!linkedEvidence.length){ %><tr><td colspan="4" class="cwp-ready">No evidence has been assessed for this workpaper.</td></tr><% } %></tbody></table><% if(editable){ %><div class="cwp-body"><details class="cwp-details"><summary>Link and assess evidence</summary><div class="cwp-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>/evidence" class="cwp-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="wide"><label for="workpaper-evidence-search">Search all available evidence</label><input type="search" id="workpaper-evidence-search" placeholder="Search filename or description" autocomplete="off"><p class="cwp-note"><%= evidenceCatalog.length %> available files. <a href="/workspaces/<%= ws.id %>/evidence" target="_blank" rel="noopener">Upload or inspect evidence ↗</a></p><label for="workpaper-evidence-choice">Evidence to link</label><select id="workpaper-evidence-choice" name="evidence_id" required><option value="">Choose…</option><% evidenceCatalog.forEach(e=>{ %><option value="<%= e.id %>" data-search="<%= e.filename %> <%= e.description||'' %>"><%= e.filename %> · <%= e.uploaded_at %></option><% }) %></select></div><div><label for="cwp-field-28">Relevance</label><select id="cwp-field-28" name="relevance"><option value="pending">Pending review</option><option value="relevant">Relevant</option><option value="partially_relevant">Partially relevant</option><option value="not_relevant">Not relevant</option></select></div><div class="wide"><label for="cwp-field-29">Purpose</label><textarea id="cwp-field-29" name="purpose" required></textarea></div><div><label for="cwp-field-30">Covered from</label><input id="cwp-field-30" type="date" name="period_covered_start"></div><div><label for="cwp-field-31">Covered to</label><input id="cwp-field-31" type="date" name="period_covered_end"></div><div class="wide"><label for="cwp-field-32">Reviewer note</label><textarea id="cwp-field-32" name="reviewer_note"></textarea></div><div class="cwp-bar"><button class="btn btn-primary btn-sm">Link evidence</button></div></form></div></details></div><% } %></section>

  <% if(!selectedSnapshot){ %><section class="cwp-panel"><div class="cwp-head"><div><h2>Findings</h2><p>Formal lifecycle from draft through independent closure validation.</p></div><span class="cwp-status"><%= findings.length %></span></div><table class="cwp-table"><thead><tr><th>Finding</th><th>Severity</th><th>Owner</th><th>Due</th><th>Status</th></tr></thead><tbody><% findings.forEach(f=>{ %><tr><td><a href="/workspaces/<%= ws.id %>/delivery/findings/<%= f.id %>"><b><%= f.finding_ref %> · <%= f.title %></b></a></td><td><%= f.severity %></td><td><%= f.owner_name||'Unassigned' %></td><td><%= f.due_date||'-' %></td><td><span class="cwp-status"><%= f.status.replaceAll('_',' ') %></span></td></tr><% }) %><% if(!findings.length){ %><tr><td colspan="5" class="cwp-ready">No findings have been raised from this workpaper.</td></tr><% } %></tbody></table><% if(!selectedSnapshot){ %><div class="cwp-body"><details class="cwp-details"><summary>Draft a formal finding</summary><div class="cwp-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>/findings" class="cwp-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="wide"><label for="cwp-field-33">Title</label><input id="cwp-field-33" name="title" required></div><div><label for="cwp-field-34">Type</label><select id="cwp-field-34" name="finding_type"><option value="nonconformity">Nonconformity</option><option value="gap">Gap</option><option value="observation">Observation</option><option value="improvement">Improvement</option></select></div><div><label for="cwp-field-35">Severity</label><select id="cwp-field-35" name="severity"><option value="critical">Critical</option><option value="high">High</option><option value="medium" selected>Medium</option><option value="low">Low</option></select></div><div class="wide"><label for="cwp-field-36">Condition observed</label><textarea id="cwp-field-36" name="condition_text" required></textarea></div><div class="wide"><label for="cwp-field-37">Criteria</label><textarea id="cwp-field-37" name="criteria_text" required></textarea></div><div class="wide"><label for="cwp-field-38">Likely cause</label><textarea id="cwp-field-38" name="cause_text"></textarea></div><div class="wide"><label for="cwp-field-39">Effect / risk</label><textarea id="cwp-field-39" name="effect_text" required></textarea></div><div class="wide"><label for="cwp-field-40">Recommendation</label><textarea id="cwp-field-40" name="recommendation_text" required></textarea></div><div><label for="cwp-field-41">Owner</label><select id="cwp-field-41" name="owner_id"><option value="">Assign later</option><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div><label for="cwp-field-42">Due date</label><input id="cwp-field-42" type="date" name="due_date"></div><div><label for="cwp-field-43">Client visibility</label><select id="cwp-field-43" name="client_visible"><option value="0">Internal draft</option><option value="1">Release after confirmation</option></select></div><div class="wide"><label for="cwp-field-44">Internal notes</label><textarea id="cwp-field-44" name="internal_notes"></textarea></div><div class="cwp-bar"><button class="btn btn-primary btn-sm">Create draft finding</button></div></form></div></details></div><% } %></section>

  <section class="cwp-panel"><div class="cwp-head"><div><h2>Client evidence requests</h2><p>Structured hand-offs reveal only the request-not internal consultant analysis.</p></div><span class="cwp-status"><%= requests.length %></span></div><table class="cwp-table"><thead><tr><th>Request</th><th>Assigned client</th><th>Due</th><th>Status</th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td><a href="/workspaces/<%= ws.id %>/client-portal/requests/<%= r.id %>"><b><%= r.title %></b></a><br><span class="cwp-note"><%= r.request_reason %></span></td><td><%= r.assignee_name||'Unassigned' %></td><td><%= r.due_date||'-' %></td><td><span class="cwp-status"><%= r.status.replaceAll('_',' ') %></span></td></tr><% }) %></tbody></table><% if(editable&&typeof userPerms!=='undefined'&&rbac.hasPermission(userPerms,'client_request.create')){ %><div class="cwp-body"><details class="cwp-details"><summary>Create structured client request</summary><div class="cwp-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>/client-request" class="cwp-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="wide"><label for="cwp-field-45">Request title</label><input id="cwp-field-45" name="title" value="Evidence request - <%= workpaper.requirement_ref %>" required></div><div><label for="cwp-field-46">Client assignee</label><select id="cwp-field-46" name="assignee_id"><option value="">Assign later</option><% clientUsers.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div><label for="cwp-field-47">Priority</label><select id="cwp-field-47" name="priority"><option value="normal">Normal</option><option value="high">High</option><option value="urgent">Urgent</option><option value="low">Low</option></select></div><div class="wide"><label for="cwp-field-48">What is required</label><textarea id="cwp-field-48" name="description" required></textarea></div><div class="wide"><label for="cwp-field-49">Why it is required</label><textarea id="cwp-field-49" name="request_reason" required></textarea></div><div class="wide"><label for="cwp-field-50">Acceptable examples</label><textarea id="cwp-field-50" name="acceptable_examples" required></textarea></div><div><label for="cwp-field-51">Evidence period start</label><input id="cwp-field-51" type="date" name="evidence_period_start"></div><div><label for="cwp-field-52">Evidence period end</label><input id="cwp-field-52" type="date" name="evidence_period_end"></div><div><label for="cwp-field-53">Due date</label><input id="cwp-field-53" type="date" name="due_date"></div><div><label for="cwp-field-54">Confidentiality</label><select id="cwp-field-54" name="confidentiality"><option value="standard">Standard</option><option value="client_confidential" selected>Client confidential</option><option value="restricted">Restricted</option></select></div><div class="cwp-bar"><button class="btn btn-primary btn-sm">Create request</button></div></form></div></details></div><% } %></section>
 <% } %></div><aside class="cwp-aside">
  <section class="cwp-panel"><div class="cwp-head"><div><h2><%= selectedSnapshot?'Retained sign-off':'Review readiness' %></h2><p><%= selectedSnapshot?'Independently approved snapshot':'Submission gate' %></p></div></div><div class="cwp-ready"><% if(selectedSnapshot){ %><p>Review decisions are retained with this frozen version. Open the current workpaper to prepare further work.</p><% }else{ %><b><%= readiness.ready?'Ready for manager review':'Not ready' %></b><% if(readiness.problems.length){ %><ul><% readiness.problems.forEach(p=>{ %><li><%= p %></li><% }) %></ul><% }else{ %><p class="cwp-note" style="margin-top:6px">Required procedures, conclusions, evidence and reviewer assignment are present.</p><% } %><% } %></div><% if(editable){ %><div class="cwp-body" style="border-top:1px solid var(--border)"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>/submit"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= workpaper.row_version %>"><textarea name="note" aria-label="Submission note" class="input" style="width:100%;margin-bottom:8px" placeholder="Submission note"></textarea><button class="btn btn-primary btn-sm" style="width:100%;justify-content:center" <%= readiness.ready?'':'disabled' %>>Submit saved workpaper</button></form></div><% } %><% if(workpaper.status==='manager_review'&&canReview){ %><div class="cwp-body" style="border-top:1px solid var(--border)"><form method="POST"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= workpaper.row_version %>"><textarea name="note" aria-label="Review rationale" class="input" style="width:100%;margin-bottom:8px" placeholder="Review rationale"></textarea><div style="display:flex;gap:6px"><button formaction="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>/approve" class="btn btn-primary btn-sm">Approve</button><button formaction="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>/changes" class="btn btn-secondary btn-sm">Request changes</button></div></form></div><% } %><% if(workpaper.status==='approved'&&canSignoff){ %><div class="cwp-body" style="border-top:1px solid var(--border)"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>/freeze"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= workpaper.row_version %>"><textarea name="note" aria-label="Freeze note" class="input" style="width:100%;margin-bottom:8px" placeholder="Freeze note"></textarea><button class="btn btn-primary btn-sm" style="width:100%;justify-content:center">Freeze workpaper</button></form></div><% } %><% if(['approved','frozen'].includes(workpaper.status)&&canSignoff){ %><div class="cwp-body" style="border-top:1px solid var(--border)"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>/reopen"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= workpaper.row_version %>"><textarea name="note" aria-label="Mandatory reopening reason" class="input" style="width:100%;margin-bottom:8px" required placeholder="Mandatory reopening reason"></textarea><button class="btn btn-secondary btn-sm" style="width:100%;justify-content:center">Reopen with history</button></form></div><% } %></section>
  <section class="cwp-panel"><div class="cwp-head"><div><h2>Accountability</h2><p>Named professional roles</p></div></div><div class="cwp-kv"><span>Owner</span><b><%= workpaper.owner_name %></b></div><div class="cwp-kv"><span>Reviewer</span><b><%= workpaper.reviewer_name||'Unassigned' %></b></div><div class="cwp-kv"><span>Client validator</span><b><%= workpaper.client_validator_name||'Not required' %></b></div><div class="cwp-kv"><span>Evidence conclusion</span><b><%= workpaper.evidence_sufficiency.replaceAll('_',' ') %></b></div><div class="cwp-kv"><span><%= selectedSnapshot?'Frozen version':'Saved revision' %></span><b><%= selectedSnapshot?selectedSnapshot.version_number:workpaper.row_version %></b></div></section>
  <section class="cwp-panel"><div class="cwp-head"><div><h2>Decision history</h2><p>Append-only review trail</p></div><span class="cwp-status"><%= reviews.length %></span></div><% reviews.slice().reverse().forEach(r=>{ %><div class="cwp-event"><b><%= r.decision.replaceAll('_',' ') %> · <%= r.actor_name %></b><p><%= r.note||`${r.from_status} → ${r.to_status}` %></p><small><%= r.created_at %></small></div><% }) %><% if(!reviews.length){ %><div class="cwp-ready">No review decisions yet.</div><% } %></section>
  <% if(snapshots.length){ %><section class="cwp-panel"><div class="cwp-head"><div><h2>Frozen versions</h2><p>Immutable SHA-256 snapshots</p></div></div><% snapshots.forEach(s=>{ %><div class="cwp-event"><a href="/workspaces/<%= ws.id %>/delivery/workpapers/<%= workpaper.id %>?snapshot=<%= s.id %>"><b>Version <%= s.version_number %><% if(s.pass_number){ %> · Pass <%= s.pass_number %> / completion <%= s.completion_generation %><% } %></b></a><p><%= s.frozen_by_name %></p><p class="cwp-ref"><%= s.snapshot_hash %></p><small><%= s.frozen_at %></small></div><% }) %></section><% } %>
 </aside></div>
</div>
<script>
(() => {
 const search=document.getElementById('workpaper-evidence-search');
 const choice=document.getElementById('workpaper-evidence-choice');
 const recovery=<%- JSON.stringify({path:recoveryPath,fields:attemptedValues}).replace(/</g,'\\u003c') %>;
 if(recovery.path&&recovery.fields){
   const form=[...document.forms].find(form=>new URL(form.action||location.href).pathname===recovery.path || [...form.querySelectorAll('[formaction]')].some(button=>new URL(button.formAction).pathname===recovery.path));
   if(form){
     const details=form.closest('details');if(details) details.open=true;
     for(const [key,value] of Object.entries(recovery.fields)){
       const field=form.elements.namedItem(key);if(field&&'value' in field)field.value=value;
     }
   }
 }
 if(search&&choice) search.addEventListener('input',()=>{
   const term=search.value.trim().toLocaleLowerCase();
   [...choice.options].forEach(option=>{ option.hidden=!!option.value&&!String(option.dataset.search||option.text).toLocaleLowerCase().includes(term); });
 });
})();
</script>
<%- include('partials/footer') %>
