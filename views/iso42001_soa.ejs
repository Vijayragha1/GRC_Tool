<%- include('partials/header', { title: 'ISO 42001 Statement of Applicability', user, ws, active: 'iso42001-soa' }) %>

<style>
  @media(max-width:760px){
    .iso42-soa-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:100%}
    .iso42-soa-actions>#soaAutosaveStatus{grid-column:1/-1;justify-self:start}
    .iso42-soa-actions form,.iso42-soa-actions .btn{width:100%}
    .iso42-soa-summary{align-items:flex-start!important;flex-wrap:wrap}
    .iso42-soa-bulk{grid-template-columns:minmax(0,1fr)!important}
    .iso42-soa-bulk .col-full{grid-column:1!important}
    .iso42-soa-bulk .btn{width:100%}
  }
  @media(max-width:430px){.iso42-soa-actions{grid-template-columns:minmax(0,1fr)}}
</style>

<div class="page-head">
  <div>
    <h1 class="page-title">ISO 42001 Statement of Applicability</h1>
    <div class="page-subtitle">Mandatory ISO 42001 artefact (clause 6.1.3). Applicability and justification for all 38 Annex A controls plus any custom controls you add.</div>
  </div>
  <div class="row-center iso42-soa-actions">
    <span class="text-xs" id="soaAutosaveStatus" style="line-height:1;align-self:center;padding:5px 10px;border-radius:999px;background:var(--bg-subtle,#f3f4f6);border:1px solid var(--border,#e5e7eb);color:var(--text-secondary,#6b7280);white-space:nowrap;" data-state="idle">All changes saved</span>
    <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/soa/auto-justify" style="display:inline" onsubmit="return confirm('For every Annex A control treated by an open risk, mark it Included and pre-fill an inclusion justification of the form &quot;Treats R-X, R-Y&quot;. Existing justifications kept. Continue?')">
      <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <button class="btn btn-secondary btn-xs" title="One-click bulk justification for every control linked to an open AI risk">Auto-justify from risks</button>
    </form>
    <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/soa/snapshot" style="display:inline">
      <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <input type="hidden" name="label" value="Manual snapshot">
      <button class="btn btn-secondary btn-xs" title="Immutable hashed snapshot - auditors compare these over time">Capture snapshot</button>
    </form>
    <a href="/workspaces/<%= ws.id %>/iso42001/export/soa.csv" class="btn btn-secondary btn-xs">Export CSV</a>
    <a href="/workspaces/<%= ws.id %>/export/rtp.docx?framework=iso42001" class="btn btn-secondary btn-xs" title="Clause 6.1.3: every AI risk, its treatment, the ISO 42001 controls applied and the residual risk">AI risk treatment plan ↓</a>
  </div>
</div>

<%- include('partials/iso42001_soa_tabs', { ws, tab: 'current' }) %>

<!-- SoA metadata and approval -->
<% const pendingIssues = soaIssues.undecided.length + soaIssues.excludedUnjustified.length + soaIssues.includedUnjustified.length; %>
<%
  // Applicability board: every Annex A control by group, coloured by the
  // applicability decision, marked when the decision has no justification.
  const blankText = v => !String(v || '').trim();
  // Undecided already shows as an outline; the dot marks a decision without a reason.
  const soaGap = r => (r.applicability === 'included' && blankText(r.inclusion_justification)) || (r.applicability === 'excluded' && blankText(r.exclusion_justification));
  const soaRef = r => r.id.replace('ai-annex-', '').toUpperCase().replace(/-/g, '.');
  const soaGroups = typeof a42Masthead === 'function'
    ? a42Masthead().controlGroups.map(g => ({ ref: g.ref, name: g.name, rows: rows.filter(r => r.category === g.key) })).filter(g => g.rows.length)
    : [{ ref: 'A', name: 'Annex A', rows }];
  const soaCount = k => rows.filter(r => r.applicability === k).length;
  const soaSettled = rows.filter(r => r.applicability !== 'undecided' && !soaGap(r)).length;
%>
<section class="panel soa-board" aria-labelledby="soaBoardTitle" data-soa-board>
  <div class="soa-board-head">
    <div>
      <h2 id="soaBoardTitle">Applicability, control by control</h2>
      <p>Each tile is an Annex A control. An outline is still undecided; a dot marks a decision with no written reason. Select a tile to go to its row.</p>
    </div>
    <dl class="soa-board-counts">
      <div><dt>Included</dt><dd data-soa-count="included"><%= soaCount('included') %></dd></div>
      <div><dt>Excluded</dt><dd data-soa-count="excluded"><%= soaCount('excluded') %></dd></div>
      <div><dt>Undecided</dt><dd data-soa-count="undecided"><%= soaCount('undecided') %></dd></div>
      <div><dt>Decided and justified</dt><dd><span data-soa-count="settled"><%= soaSettled %></span><small> / <%= rows.length %></small></dd></div>
    </dl>
  </div>
  <div class="soa-board-rows">
    <% soaGroups.forEach(g => { %>
      <div class="a42-map-row">
        <span class="a42-map-rowhead"><b><%= g.ref %></b> <%= g.name %></span>
        <div class="a42-map-tiles">
          <% g.rows.forEach(r => { %><a class="a42-tile soa-tile s-<%= r.applicability %><%= soaGap(r) ? ' is-gap' : '' %>" href="#soa-<%= r.id %>" data-soa-tile="<%= r.id %>" title="<%= soaRef(r) %> <%= r.title.replace(/^A\.[0-9.]+ /, '') %>"><%= soaRef(r).replace(/^A\./, '') %></a><% }) %>
        </div>
      </div>
    <% }) %>
  </div>
  <ul class="a42-legend">
    <li><i class="soa-key s-included" aria-hidden="true"></i>Included</li>
    <li><i class="soa-key s-excluded" aria-hidden="true"></i>Excluded</li>
    <li><i class="soa-key s-undecided" aria-hidden="true"></i>Undecided</li>
    <li><i class="soa-key is-gap" aria-hidden="true"></i>Decided without a reason</li>
  </ul>
</section>

<details class="panel" style="margin-bottom:10px;" <%= !approvedSoa ? 'open' : '' %>>
  <summary>
    <span>SoA version and approval
      <span class="meta"><% if (approvedSoa) { %><i class="a42-dot t-done" aria-hidden="true"></i> approved by <%= approvedSoa.approved_by_name %> on <%= String(approvedSoa.approved_on).slice(0, 10) %> · <a href="/workspaces/<%= ws.id %>/iso42001/soa/snapshots/<%= approvedSoa.id %>">view the approved SoA</a><% } else { %><i class="a42-dot t-gap" aria-hidden="true"></i> <span class="soa-unapproved">Not approved yet. The auditor expects an approved SoA.</span><% } %><% if (soaMeta.version) { %> · version <%= soaMeta.version %><% } %><% if (soaMeta.owner) { %> · owner <%= soaMeta.owner %><% } %></span>
    </span>
  </summary>
  <div class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
    <div class="meta text-sm" style="line-height:1.5;margin-bottom:10px;">
      <% if (pendingIssues) { %>
        Before it can be approved: <%= soaIssues.undecided.length %> control<%= soaIssues.undecided.length === 1 ? '' : 's' %> undecided,
        <%= soaIssues.excludedUnjustified.length %> excluded without a justification,
        <%= soaIssues.includedUnjustified.length %> included without a justification.
      <% } else { %>
        Every control is decided and justified. Capture a snapshot and ask a second person with sign-off rights to approve it.
      <% } %>
    </div>
    <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/soa/metadata" class="stack-grid" style="--cols:1fr 1fr auto;gap:10px;align-items:end;">
      <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <div><label class="label">Version</label><input class="input" name="version" value="<%= soaMeta.version || '' %>" placeholder="e.g., 1.2"></div>
      <div><label class="label">Owner</label><input class="input" name="owner" value="<%= soaMeta.owner || '' %>" placeholder="e.g., AI Risk Lead"></div>
      <div><button class="btn btn-primary btn-xs">Save and capture a snapshot</button></div>
    </form>
  </div>
</details>

<!-- Bulk applicability bar -->
<details class="panel" style="margin-bottom:10px;">
  <summary class="panel-pad text-lg" style="cursor:pointer;font-weight:500;"><span>Decide applicability in bulk<span class="meta">Include every control, or only the undecided ones, in one step</span></span></summary>
  <div class="panel-pad text-base text-secondary" style="border-top:1px solid var(--border);background:var(--bg-subtle);line-height:1.55;">
    <strong>Use this for the first-pass sweep.</strong> "Include all" marks every Annex A control as <em>Included</em>. "Include undecided" only flips controls still marked <em>Undecided</em>. Per-row dropdowns below let you override afterwards.
  </div>
  <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/soa/bulk" class="panel-pad iso42-soa-bulk" style="border-top:1px solid var(--border);background:var(--bg-subtle);display:grid;grid-template-columns:1fr auto auto;gap:8px;align-items:end;">
    <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
    <div class="col-full">
      <label class="label">Justification (optional, applied to every affected row)</label>
      <input class="input" name="justification" placeholder="e.g., Required by linked AI risks per risk register">
    </div>
    <button name="action" value="include_all" class="btn btn-secondary btn-xs" onclick="return confirm('Mark every Annex A control as Included? Existing Excluded decisions kept; Undecided flips to Included.')">Include all (<%= rows.length %>)</button>
    <button name="action" value="include_undecided" class="btn btn-secondary btn-xs" onclick="return confirm('Flip every Undecided control to Included? Existing Included/Excluded decisions kept.')">Include undecided</button>
  </form>
</details>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr>
      <th style="width:60px">ID</th>
      <th>Control</th>
      <th style="width:140px" title="Risks treated by this control - clause 6.1.3 / Annex C">Risks treated</th>
      <th style="width:200px">Covered by (linked documents)</th>
      <th style="width:130px">Applicability</th>
      <th style="width:170px">Status</th>
      <th>Justification</th>
    </tr></thead>
    <tbody>
      <% rows.forEach(r => {
           const linkedDocs = (docsByControl && docsByControl[r.id]) || [];
           const linkedRisks = (risksByControl && risksByControl[r.id]) || [];
      %>
        <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/soa/<%= r.id %>" class="contents">
          <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
          <tr id="soa-<%= r.id %>">
            <td class="mono meta"><%= r.id.replace('ai-annex-', '').toUpperCase().replace(/-/g, '.') %></td>
            <td><a href="/workspaces/<%= ws.id %>/iso42001/controls/<%= r.id %>" class="link-muted"><%= r.title.replace(/^A\.[0-9.]+ /, '') %></a><% if (r.last_updated) { %><div class="meta text-eyebrow">updated <%= r.last_updated.slice(0,10) %></div><% } %></td>
            <td class="text-sm" style="line-height:1.4;">
              <% if (linkedRisks.length === 0) { %>
                <% if (r.applicability === 'included') { %>
                  <span class="soa-norisk" title="An included control with no linked risk weakens 6.1.3">No linked risk</span>
                <% } else { %>
                  <span class="meta">-</span>
                <% } %>
              <% } else { %>
                <% linkedRisks.slice(0, 3).forEach((rk, idx) => { %><a href="/workspaces/<%= ws.id %>/risks/<%= rk.risk_id %>" title="<%= rk.risk_title %> · L<%= rk.likelihood %>×I<%= rk.impact %>" style="color:var(--accent);text-decoration:none;border-bottom:1px dotted var(--accent);">R-<%= rk.risk_id %></a><% if (idx < Math.min(linkedRisks.length, 3) - 1) { %><span class="meta">, </span><% } %><% }) %><% if (linkedRisks.length > 3) { %><span class="meta"> +<%= linkedRisks.length - 3 %></span><% } %>
              <% } %>
            </td>
            <td>
              <% if (linkedDocs.length === 0) { %>
                <span class="meta">-</span>
              <% } else { %>
                <% linkedDocs.forEach((d, idx) => { %><a class="text-base" href="/workspaces/<%= ws.id %>/documents/<%= d.doc_id %>" style="color:var(--accent);text-decoration:none;" title="<%= d.category || '' %> · <%= d.doc_status %>"><%= d.doc_name %><% if (d.section_ref) { %> <%= d.section_ref %><% } %></a><% if (idx < linkedDocs.length - 1) { %><span class="meta">, </span><% } %><% }) %>
              <% } %>
            </td>
            <td>
              <select name="applicability" class="select text-base" style="padding:4px 8px;">
                <option value="undecided" <%= r.applicability === 'undecided' ? 'selected' : '' %>>Undecided</option>
                <option value="included" <%= r.applicability === 'included' ? 'selected' : '' %>>Included</option>
                <option value="excluded" <%= r.applicability === 'excluded' ? 'selected' : '' %>>Excluded</option>
              </select>
            </td>
            <td>
              <select name="status" class="select text-base" style="padding:4px 8px;">
                <% ['Not Assessed','Implemented','Partially Implemented','Work In Progress','Not Implemented','Not Applicable'].forEach(s => { %>
                  <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <textarea name="justification" data-soa-justification data-incl="<%= r.inclusion_justification || '' %>" data-excl="<%= r.exclusion_justification || '' %>" rows="1" class="textarea text-base" style="padding:4px 8px;" placeholder="<%= r.applicability === 'excluded' ? 'Why excluded' : 'Why included' %>"><%= r.applicability === 'excluded' ? (r.exclusion_justification || '') : (r.inclusion_justification || '') %></textarea>
            </td>
          </tr>
        </form>
      <% }) %>
    </tbody>
  </table>
</div>

<!-- Custom controls -->
<div class="panel" style="margin-top:18px;">
  <div class="panel-head">
    <h3>Custom (non-Annex-A) controls <span class="meta text-base" style="font-weight:400;">- additional controls beyond Annex A (NIST AI RMF, internal, sector-specific)</span></h3>
    <span class="meta"><%= customControls.length %> custom</span>
  </div>
  <% if (customControls.length === 0) { %>
    <div class="panel-pad meta text-md">No custom controls. Most clients don't need any - Annex A covers the common ground. Add only if a real control exists outside Annex A (e.g., a sector-specific AI standard, NIST AI RMF mapping).</div>
  <% } else { %>
    <table class="t">
      <thead><tr>
        <th style="width:90px;">Code</th>
        <th>Title</th>
        <th style="width:130px;">Source</th>
        <th style="width:120px;">Applicability</th>
        <th style="width:140px;">Status</th>
        <th>Justification</th>
        <th style="width:60px;"></th>
      </tr></thead>
      <tbody>
        <% customControls.forEach(c => { %>
          <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/soa/custom-controls/<%= c.id %>" class="contents">
            <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
            <tr>
              <td><input class="input mono text-base" name="code" value="<%= c.code %>" style="padding:4px 6px;"></td>
              <td><input class="input text-md" name="title" value="<%= c.title %>" style="padding:4px 6px;"></td>
              <td><input class="input text-base" name="source_framework" value="<%= c.source || '' %>" placeholder="NIST AI RMF" style="padding:4px 6px;"></td>
              <td>
                <select name="applicability" class="select text-base" style="padding:4px 8px;">
                  <% ['undecided','included','excluded'].forEach(a => { %><option value="<%= a %>" <%= c.applicability === a ? 'selected' : '' %>><%= a %></option><% }) %>
                </select>
              </td>
              <td>
                <select name="status" class="select text-base" style="padding:4px 8px;">
                  <% ['Not Assessed','Implemented','Partially Implemented','Work In Progress','Not Implemented','Not Applicable'].forEach(s => { %><option value="<%= s %>" <%= c.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
                </select>
              </td>
              <td>
                <textarea name="justification" data-soa-justification data-incl="<%= c.inclusion_justification || '' %>" data-excl="<%= c.exclusion_justification || '' %>" rows="1" class="textarea text-base" style="padding:4px 8px;" placeholder="<%= c.applicability === 'excluded' ? 'Why excluded' : 'Why included' %>"><%= c.applicability === 'excluded' ? (c.exclusion_justification || '') : (c.inclusion_justification || '') %></textarea>
              </td>
              <td>
                <button formaction="/workspaces/<%= ws.id %>/iso42001/soa/custom-controls/<%= c.id %>/delete" formmethod="POST" class="btn btn-ghost btn-xs text-xs text-danger" onclick="return confirm('Delete custom control <%= c.code %>?')">×</button>
              </td>
            </tr>
          </form>
        <% }) %>
      </tbody>
    </table>
  <% } %>
  <details style="border-top:1px solid var(--border);">
    <summary class="panel-pad text-md" style="cursor:pointer;">Add a custom control</summary>
    <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/soa/custom-controls" class="panel-pad stack-grid" style="--cols:120px 1fr 160px 140px;background:var(--bg-subtle);gap:8px;">
      <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
      <input class="input mono text-md" name="code" placeholder="C-001" required>
      <input class="input text-md" name="title" placeholder="Control title" required>
      <input class="input text-md" name="source_framework" placeholder="NIST AI RMF / Internal">
      <select class="select text-md" name="applicability">
        <option value="included">Included</option>
        <option value="excluded">Excluded</option>
        <option value="undecided">Undecided</option>
      </select>
      <textarea class="textarea text-md col-full" name="description" rows="2" placeholder="What this control does (optional)"></textarea>
      <textarea class="textarea text-md col-full" name="inclusion_justification" rows="2" placeholder="Why this control is necessary - what AI risk does it treat?"></textarea>
      <button class="btn btn-primary btn-xs col-full">Add custom control</button>
    </form>
  </details>
</div>

<script>
// SoA autosave - debounced per-row, fired on input/change. Form is <form class="contents">
// wrapping <tr>; the form element is reparented by the parser so we listen on document
// and route by event.target.form.
(function () {
  const status = document.getElementById('soaAutosaveStatus');
  if (!status) return;
  const DEBOUNCE_MS = 500;
  const timers = new WeakMap();
  let inFlight = 0;
  let lastError = null;

  function setStatus() {
    status.dataset.state = lastError ? 'error' : inFlight > 0 ? 'saving' : 'idle';
    if (lastError) {
      status.textContent = "Couldn't save - retrying on next edit";
      status.style.background = 'rgba(185,28,28,0.08)';
      status.style.borderColor = 'rgba(185,28,28,0.3)';
      status.style.color = '#b91c1c';
    } else if (inFlight > 0) {
      status.textContent = inFlight === 1 ? 'Saving…' : `Saving ${inFlight}…`;
      status.style.background = 'rgba(37,99,235,0.08)';
      status.style.borderColor = 'rgba(37,99,235,0.3)';
      status.style.color = '#1d4ed8';
    } else {
      status.textContent = 'All changes saved';
      status.style.background = '';
      status.style.borderColor = '';
      status.style.color = '';
    }
  }
  async function submitRow(form) {
    // A row form wraps a <tr>, so the parser moves its hidden token out of the
    // form element; the shared stamper cannot see it and adds a second one.
    // Two tokens reach the server as an array and fail the CSRF check, so
    // send exactly one.
    const params = new URLSearchParams();
    new FormData(form).forEach((v, k) => { if (k !== '_csrf') params.append(k, v); });
    const token = (document.querySelector('meta[name="csrf-token"]') || {}).content || window._csrfToken || '';
    if (token) params.set('_csrf', token);
    const url = form.action + (form.action.includes('?') ? '&' : '?') + 'ajax=1';
    inFlight++; setStatus();
    try {
      const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params, credentials: 'same-origin', redirect: 'manual' });
      const ok = res.ok || res.status === 204 || res.status === 0 || res.type === 'opaqueredirect' || (res.status >= 300 && res.status < 400);
      lastError = ok ? null : `HTTP ${res.status}`;
    } catch (e) { lastError = String(e); }
    finally { inFlight--; setStatus(); }
  }
  function schedule(form) {
    clearTimeout(timers.get(form));
    timers.set(form, setTimeout(() => submitRow(form), DEBOUNCE_MS));
  }
  // The justification box shows the reason for the chosen applicability.
  // Switching applicability keeps what was typed for the old side and shows
  // the saved reason for the new one; the server files the box by the
  // applicability sent with it.
  function swapJustification(select) {
    const box = select.form && select.form.elements.justification;
    if (!box || !box.hasAttribute('data-soa-justification')) return;
    const was = select.getAttribute('data-was') || (box.placeholder === 'Why excluded' ? 'excluded' : 'included');
    box.setAttribute(was === 'excluded' ? 'data-excl' : 'data-incl', box.value);
    box.value = box.getAttribute(select.value === 'excluded' ? 'data-excl' : 'data-incl') || '';
    box.placeholder = select.value === 'excluded' ? 'Why excluded' : 'Why included';
    select.setAttribute('data-was', select.value);
  }
  // The board above the table follows every edit: a changed decision flips
  // its tile, and the justification dot comes and goes as the reason is typed.
  function refreshTile(form) {
    const id = (form.action.match(/\/soa\/([^/?]+)/) || [])[1];
    const tile = id && document.querySelector('[data-soa-tile="' + CSS.escape(id) + '"]');
    if (!tile) return;
    const app = form.elements.applicability && form.elements.applicability.value;
    const why = form.elements.justification && form.elements.justification.value.trim();
    const gap = app !== 'undecided' && !why;
    const was = tile.className;
    tile.classList.remove('s-included', 's-excluded', 's-undecided');
    tile.classList.add('s-' + app);
    tile.classList.toggle('is-gap', gap);
    if (tile.className !== was && !tile.classList.contains('is-flipping')) {
      tile.classList.add('is-flipping');
      tile.addEventListener('animationend', () => tile.classList.remove('is-flipping'), { once: true });
    }
    const counts = { included: 0, excluded: 0, undecided: 0, settled: 0 };
    document.querySelectorAll('[data-soa-tile]').forEach(t => {
      ['included', 'excluded', 'undecided'].forEach(k => { if (t.classList.contains('s-' + k)) counts[k]++; });
      if (!t.classList.contains('is-gap') && !t.classList.contains('s-undecided')) counts.settled++;
    });
    Object.keys(counts).forEach(k => { const el = document.querySelector('[data-soa-count="' + k + '"]'); if (el) el.textContent = counts[k]; });
  }
  function handle(e) {
    const form = e.target && e.target.form;
    if (!form) return;
    const action = form.action || '';
    if (!/\/iso42001\/soa\//.test(action)) return;
    if (e.type === 'change' && e.target.name === 'applicability') swapJustification(e.target);
    refreshTile(form);
    schedule(form);
  }
  // Going to a row from its tile briefly marks the row.
  document.querySelectorAll('[data-soa-tile]').forEach(t => t.addEventListener('click', () => {
    const row = document.getElementById(t.getAttribute('href').slice(1));
    if (!row) return;
    row.classList.remove('is-target'); void row.offsetWidth; row.classList.add('is-target');
  }));
  document.addEventListener('input', handle);
  document.addEventListener('change', handle);
})();
</script>

