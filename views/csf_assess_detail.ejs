<%- include('partials/header', { title: detail.sub_code, user, ws, active: 'csf' }) %>

<div class="page-head">
  <div>
    <div style="display:flex;align-items:center;gap:10px;">
      <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess" class="meta" style="font-size:12px;text-decoration:none;">&larr; All subcategories</a>
    </div>
    <h1 class="page-title" style="margin-top:6px;display:flex;align-items:center;gap:10px;">
      <span class="mono" style="color:var(--accent);"><%= detail.sub_code %></span>
      <span style="font-size:18px;font-weight:500;color:var(--text-secondary);"><%= detail.cat_code %> &middot; <%= detail.cat_name %></span>
    </h1>
    <div class="page-subtitle" style="margin-top:4px;"><%= detail.sub_description %></div>
  </div>
  <div style="display:flex;gap:8px;">
    <% if (prev) { %><a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= prev.subcategory_id %>" class="btn btn-secondary btn-xs">&larr; <%= prev.code %></a><% } %>
    <% if (next) { %><a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= next.subcategory_id %>" class="btn btn-secondary btn-xs"><%= next.code %> &rarr;</a><% } %>
  </div>
</div>

<!-- State strip -->
<div class="panel" style="margin-bottom:14px;">
  <div class="panel-pad" style="display:flex;gap:6px;align-items:center;font-size:11.5px;flex-wrap:wrap;">
    <% const stateOrder = ['Not Started','In Progress','Evidence Collected','Draft Complete','Reviewed','Approved']; %>
    <% const curIdx = stateOrder.indexOf(detail.status); %>
    <% stateOrder.forEach((s, i) => { %>
      <span style="
        padding:4px 9px;border-radius:999px;
        background:<%= i <= curIdx ? '#1d4ed8' : 'var(--bg-subtle)' %>;
        color:<%= i <= curIdx ? '#fff' : 'var(--text-tertiary)' %>;
        font-size:11px;font-weight:<%= i === curIdx ? '600' : '500' %>;
        border:1px solid <%= i <= curIdx ? '#1d4ed8' : 'var(--border)' %>;
      "><%= s %></span>
      <% if (i < stateOrder.length - 1) { %><span style="color:var(--text-tertiary);">&rarr;</span><% } %>
    <% }) %>
    <div style="margin-left:auto;display:flex;gap:6px;">
      <% allowedNextStates.forEach(ns => { %>
        <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>/transition" style="display:inline;">
          <input type="hidden" name="to_state" value="<%= ns %>">
          <button class="btn btn-primary btn-xs">Mark as <%= ns %> &rarr;</button>
        </form>
      <% }) %>
    </div>
  </div>
</div>

<% if (warnings && warnings.length) { %>
  <div class="panel" style="margin-bottom:14px;border-left:3px solid #a16207;background:rgba(161,98,7,0.04);">
    <div class="panel-pad" style="font-size:12.5px;color:var(--text-secondary);">
      <strong style="color:#a16207;">Soft warnings (not blocking):</strong>
      <ul style="margin:6px 0 0 0;padding-left:18px;">
        <% warnings.forEach(w => { %><li><%= w %></li><% }) %>
      </ul>
    </div>
  </div>
<% } %>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:14px;margin-bottom:14px;">
  <!-- LEFT: narrative + scoring + exclusion -->
  <div>
    <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>" class="panel" style="margin-bottom:14px;">
      <div class="panel-head"><h2>Narrative</h2></div>
      <div class="panel-pad">
        <textarea class="textarea" name="narrative" rows="10" placeholder="Practice observed / Evidence reviewed / Gaps or concerns / Follow-up needed. Specific over generic. What did interviews and document review actually show? At least 3-5 sentences for audit-grade write-ups." style="font-family:inherit;font-size:13px;line-height:1.55;"><%= detail.narrative || '' %></textarea>
      </div>

      <div class="panel-head" style="border-top:1px solid var(--border);"><h2>Scoring</h2><span class="meta" style="font-size:11.5px;"><%= canEnterScore ? 'Editable' : 'Locked until Evidence Collected + scoring role' %></span></div>
      <div class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;<%= canEnterScore ? '' : 'opacity:0.5;pointer-events:none;' %>">
        <div>
          <label class="label">Current CMMI score</label>
          <select class="select" name="current_score">
            <option value="">- not set -</option>
            <% [1,2,3,4,5].forEach(n => { %><option value="<%= n %>" <%= detail.current_score === n ? 'selected' : '' %>><%= n %></option><% }) %>
          </select>
          <% if (detail.is_bulk_set) { %><div class="meta" style="font-size:11px;margin-top:4px;color:var(--text-tertiary);">Set via bulk action (audit-flagged)</div><% } %>
        </div>
        <% if (engagement.scope_mode === 'CURRENT_TARGET') { %>
          <div>
            <label class="label">Target CMMI score</label>
            <select class="select" name="target_score">
              <option value="">- not set -</option>
              <% [1,2,3,4,5].forEach(n => { %><option value="<%= n %>" <%= detail.target_score === n ? 'selected' : '' %>><%= n %></option><% }) %>
            </select>
          </div>
        <% } %>
      </div>

      <div class="panel-head" style="border-top:1px solid var(--border);"><h2>Scope</h2></div>
      <div class="panel-pad">
        <label style="display:flex;gap:8px;align-items:center;font-size:13px;cursor:pointer;">
          <input type="checkbox" name="excluded_from_scope" value="1" <%= detail.excluded_from_scope ? 'checked' : '' %>>
          Excluded from this engagement's scope
        </label>
        <textarea class="textarea" name="exclusion_rationale" rows="2" placeholder="Rationale for exclusion (required if excluded)" style="margin-top:8px;font-size:12.5px;"><%= detail.exclusion_rationale || '' %></textarea>
      </div>

      <div class="panel-pad" style="background:var(--bg-subtle);border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;">
        <button class="btn btn-primary btn-xs">Save</button>
      </div>
    </form>

    <!-- Implementation examples + ISO refs (from Stage 1 catalog) -->
    <% if (detail.implementation_examples) { %>
      <details class="panel" style="margin-bottom:14px;">
        <summary class="panel-pad" style="cursor:pointer;font-size:13px;font-weight:500;">NIST implementation examples</summary>
        <div class="panel-pad" style="padding-top:0;font-size:12.5px;color:var(--text-secondary);line-height:1.55;white-space:pre-wrap;"><%= detail.implementation_examples %></div>
      </details>
    <% } %>
    <% if (isoRefs && isoRefs.length) { %>
      <% const clauses = isoRefs.filter(r => r.ref_type === 'mandatory_clause'); %>
      <% const annexa = isoRefs.filter(r => r.ref_type === 'annex_a'); %>
      <div class="panel" style="margin-bottom:14px;">
        <div class="panel-head"><h2>ISO 27001:2022 cross-references</h2></div>
        <div class="panel-pad" style="font-size:12.5px;line-height:1.7;">
          <% if (clauses.length) { %><div><span class="meta" style="font-size:11.5px;">Mandatory clauses:</span> <span class="mono"><%= clauses.map(c => c.ref_value).join(', ') %></span></div><% } %>
          <% if (annexa.length) { %>
            <div><span class="meta" style="font-size:11.5px;">Annex A controls:</span>
              <% annexa.forEach((a, i) => { %><a href="/workspaces/<%= ws.id %>/controls/annex-a.<%= a.ref_value %>" class="mono" style="color:var(--accent);text-decoration:none;"><%= a.ref_value %></a><%= i < annexa.length - 1 ? ', ' : '' %><% }) %>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

  <!-- RIGHT: evidence -->
  <div>
    <div class="panel">
      <div class="panel-head"><h2>Evidence</h2><span class="meta" style="font-size:11.5px;"><%= evidence.length %> item<%= evidence.length === 1 ? '' : 's' %></span></div>
      <% if (evidence.length === 0) { %>
        <div class="panel-pad meta" style="font-size:12px;">No evidence yet. Attach a file, paste a link, or capture an interview attribution. At least one item is expected before transitioning to <strong>Evidence Collected</strong>.</div>
      <% } else { %>
        <div class="divide-row">
          <% evidence.forEach(e => { %>
            <div style="padding:10px 14px;">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                <div style="flex:1;min-width:0;">
                  <div style="display:flex;align-items:center;gap:6px;">
                    <span class="tag" style="font-size:10px;background:var(--bg-subtle);"><%= e.type %></span>
                    <% if (e.visible_to_client) { %><span class="tag" style="font-size:10px;background:rgba(21,128,61,0.08);color:#15803d;">visible to client</span><% } %>
                  </div>
                  <% if (e.type === 'FILE') { %>
                    <div class="mono" style="font-size:11.5px;margin-top:4px;"><%= e.file_path %></div>
                  <% } else if (e.type === 'LINK') { %>
                    <div style="font-size:12px;margin-top:4px;"><a href="<%= e.url %>" target="_blank" rel="noopener" style="color:var(--accent);"><%= e.url %></a></div>
                  <% } else if (e.type === 'INTERVIEW') { %>
                    <div style="font-size:12px;margin-top:4px;"><%= e.interview_source %></div>
                  <% } %>
                  <% if (e.description) { %><div class="meta" style="font-size:11.5px;margin-top:4px;"><%= e.description %></div><% } %>
                </div>
                <% if (canCollect) { %>
                  <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>/evidence/<%= e.id %>/delete" onsubmit="return appConfirmForm(event, 'Remove this evidence item?')">
                    <button class="btn btn-ghost btn-xs" style="color:#b91c1c;font-size:11px;">&times;</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <% if (canCollect) { %>
        <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/assess/<%= detail.subcategory_id %>/evidence" enctype="multipart/form-data" class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
          <label class="label">Add evidence</label>
          <select class="select" name="type" id="csfEvType" style="margin-bottom:8px;font-size:12px;">
            <option value="LINK">Link (URL)</option>
            <option value="FILE">File upload</option>
            <option value="INTERVIEW">Interview attribution</option>
          </select>
          <input class="input" name="url" id="csfEvUrl" placeholder="https://..." style="margin-bottom:8px;font-size:12px;">
          <input class="input" type="file" name="file" id="csfEvFile" style="margin-bottom:8px;display:none;font-size:12px;">
          <input class="input" name="interview_source" id="csfEvInterview" placeholder="e.g., Jane Doe, IT Manager, 2026-05-14" style="margin-bottom:8px;display:none;font-size:12px;">
          <textarea class="textarea" name="description" rows="2" placeholder="What does this evidence show? (optional)" style="margin-bottom:8px;font-size:12px;"></textarea>
          <label style="display:flex;gap:6px;align-items:center;font-size:11.5px;margin-bottom:8px;">
            <input type="checkbox" name="visible_to_client" value="1"> Visible to client portal
          </label>
          <button class="btn btn-primary btn-xs">Attach</button>
        </form>
        <script>
        (function () {
          const sel = document.getElementById('csfEvType');
          const url = document.getElementById('csfEvUrl');
          const file = document.getElementById('csfEvFile');
          const iv = document.getElementById('csfEvInterview');
          function flip() {
            url.style.display = sel.value === 'LINK' ? '' : 'none';
            file.style.display = sel.value === 'FILE' ? '' : 'none';
            iv.style.display = sel.value === 'INTERVIEW' ? '' : 'none';
            url.required = sel.value === 'LINK';
            file.required = sel.value === 'FILE';
            iv.required = sel.value === 'INTERVIEW';
          }
          sel.addEventListener('change', flip); flip();
        })();
        </script>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
