<%- include('partials/header', { title: 'Supplier contract review', user, ws, active: 'vendors' }) %>
<div class="page-head"><div><a class="link-muted text-xs" href="/workspaces/<%= ws.id %>/vendors/<%= v.id %>">← <%= v.name %></a><h1 class="page-title" style="margin-top:8px">Contract and SLA review</h1><div class="page-subtitle">Internal review against the executed agreement. This register is never sent to the vendor.</div></div></div>

<% if (!bundle) { %>
  <div class="panel" style="max-width:760px"><div class="panel-head"><h2>Start contract review</h2></div><form method="POST" action="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/contract-review/start" class="panel-pad grid-2"><div><label class="label">Agreement reference</label><input class="input" name="agreement_reference" required></div><div><label class="label">Agreement date</label><input class="input" type="date" name="agreement_date"></div><div class="col-full"><button class="btn btn-primary">Start 47-clause review</button></div></form></div>
<% } else { %>
  <% const contractClosed = bundle.review.status === 'complete'; %>
  <div class="panel" style="margin-bottom:16px"><div class="panel-pad" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:0"><div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Clauses</div><div class="kpi-num"><%= bundle.progress.total %></div></div><div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Complete</div><div class="kpi-num"><%= bundle.progress.complete %></div></div><div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Gaps identified</div><div class="kpi-num"><%= bundle.progress.gaps %></div></div><div class="kpi"><div class="sec-label">Decision blockers</div><div class="kpi-num"><%= bundle.progress.open %></div></div></div></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/contract-review">
    <% const categories=[...new Set(methodology.contractClauses.map(c=>c.category))]; categories.forEach((category,index)=>{ const clauses=methodology.contractClauses.filter(c=>c.category===category); %><details class="panel" style="margin-bottom:12px" <%= index===0?'open':'' %>><summary class="panel-head" style="cursor:pointer;list-style:none"><h2><%= category %></h2><span class="meta"><%= clauses.length %> clauses</span></summary>
      <% clauses.forEach(clause=>{ const item=bundle.itemMap[clause.id]||{}; %><div style="padding:18px;border-top:1px solid var(--border)"><div style="display:flex;gap:10px;align-items:flex-start"><span class="tag tag-neutral"><%= clause.id %></span><div style="font-weight:600;line-height:1.45"><%= clause.requirement.replaceAll('{{client}}',ws.client_name) %></div></div><div class="meta" style="margin:5px 0 12px 58px"><%= clause.regulatoryBasis.replaceAll('{{client}}',ws.client_name) %> · Workbook scope: <%= clause.requiredWhen %></div><div style="display:grid;grid-template-columns:120px 1fr 1fr 280px;gap:10px"><div><label class="label">Required?</label><select class="select" name="required_<%= clause.id %>" <%= contractClosed?'disabled':'' %>><option value="1" <%= item.required!==0?'selected':'' %>>Yes</option><option value="0" <%= item.required===0?'selected':'' %>>No</option></select></div><div><label class="label">Clause status</label><select class="select" name="status_<%= clause.id %>" <%= contractClosed?'disabled':'' %>><% methodology.responses.contract.forEach(option=>{ %><option <%= (item.status||'Not Reviewed')===option?'selected':'' %>><%= option %></option><% }) %></select></div><div><label class="label">Contract reference</label><input class="input" name="reference_<%= clause.id %>" value="<%= item.contract_reference||'' %>" <%= contractClosed?'disabled':'' %>></div><div><label class="label">Linked finding <a href="/workspaces/<%= ws.id %>/vendors/<%= v.id %>?view=legacy&tab=findings" target="_blank" rel="noopener" style="float:right;font-weight:500">Open register</a></label><select class="select" name="finding_<%= clause.id %>" <%= contractClosed?'disabled':'' %>><option value="">No linked finding</option><% findings.forEach(finding=>{ %><option value="<%= finding.id %>" <%= Number(item.finding_id)===finding.id?'selected':'' %>>#<%= finding.id %> · <%= finding.severity %> · <%= finding.title %></option><% }) %></select></div></div><input class="input" name="comments_<%= clause.id %>" value="<%= item.reviewer_comments||'' %>" placeholder="Reviewer comments" style="margin-top:8px" <%= contractClosed?'disabled':'' %>></div><% }) %>
    </details><% }) %>
    <% if (!contractClosed) { %><div class="row" style="margin-bottom:24px"><button class="btn btn-secondary" name="action" value="save">Save review</button><button class="btn btn-primary" name="action" value="complete">Complete contract review</button></div><% } else { %><div class="panel" style="margin-bottom:24px"><div class="panel-pad"><strong>Contract review complete</strong><div class="meta">This conclusion is locked. Start a new periodic review only when the agreement or service scope changes.</div></div></div><% } %>
  </form>
<% } %>
<%- include('partials/footer') %>
