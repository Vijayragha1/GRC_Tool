<%- include('partials/header', { title: 'Supplier due diligence', user, ws, active: 'vendors' }) %>

<div class="page-head">
  <div><a class="link-muted text-xs" href="/workspaces/<%= ws.id %>/vendors/<%= v.id %>">← <%= v.name %></a><h1 class="page-title" style="margin-top:8px">Vendor due diligence</h1><div class="page-subtitle">Tier sets assessment depth. Conditional modules set breadth. Every conclusion remains evidence-backed.</div></div>
  <div class="row"><a class="btn btn-secondary" href="/workspaces/<%= ws.id %>/supplier-methodology">Configure methodology</a><% if (bundle) { %><span class="status s-<%= bundle.assessment.status==='complete'?'done':bundle.assessment.status==='submitted'||bundle.assessment.status==='under_review'?'in_progress':'todo' %>"><%= bundle.assessment.status.replace(/_/g,' ') %></span><% } %></div>
</div>

<% if (!inherent || inherent.status !== 'approved') { %>
  <div class="panel"><div class="panel-pad"><h2>Approve inherent risk first</h2><p class="meta">The tier and module scope must be approved before a questionnaire can be issued.</p><a class="btn btn-primary" href="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/inherent-risk">Open inherent-risk assessment</a></div></div>
<% } else if (!bundle) { %>
  <div class="panel" style="max-width:760px"><div class="panel-head"><div><h2>Create the scoped questionnaire</h2><div class="meta"><%= tierLabel(inherent.assigned_tier) %> · <%= methodology.ddqQuestions.filter(question => question.enabled !== false && question.tiers.includes(inherent.assigned_tier)).length %> enabled baseline questions · methodology version <%= methodologyRecord.version %></div></div></div>
    <form method="POST" action="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/due-diligence/start" class="panel-pad grid-2">
      <div><label class="label">Vendor contact name</label><input class="input" name="vendor_contact_name"></div><div><label class="label">Vendor contact email</label><input class="input" type="email" name="vendor_contact_email" value="<%= v.contact || '' %>" required></div><div><label class="label">Due date</label><input class="input" type="date" name="due_date" required></div><div></div>
      <div class="col-full"><div class="sec-label">Conditional modules</div><% inherentModules.forEach(module => { %><div style="display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--border)"><span><%= module.name %></span><strong><%= module.applicability %></strong></div><% }) %></div>
      <div class="col-full"><button class="btn btn-primary">Create due-diligence assessment</button></div>
    </form>
  </div>
<% } else { %>
  <% const reviewEnabled = ['submitted','under_review'].includes(bundle.assessment.status); const assessmentClosed = bundle.assessment.status === 'complete'; %>
  <div class="panel" style="margin-bottom:16px"><div class="panel-pad" style="display:grid;grid-template-columns:repeat(5,minmax(0,1fr));padding:0">
    <div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Scope</div><div style="font-size:17px;font-weight:600;margin-top:7px"><%= tierLabel(bundle.assessment.tier) %></div></div>
    <div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label">Questions</div><div class="kpi-num"><%= bundle.progress.total %></div></div>
    <div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label"><%= reviewEnabled || assessmentClosed ? 'Review complete' : 'Vendor answered' %></div><div class="kpi-num"><%= reviewEnabled || assessmentClosed ? bundle.progress.complete : bundle.vendorAnswered %></div><div class="meta"><%= bundle.progress.total ? Math.round((reviewEnabled || assessmentClosed ? bundle.progress.complete : bundle.vendorAnswered) / bundle.progress.total * 100) : 0 %>%</div></div>
    <div class="kpi" style="border-right:1px solid var(--border)"><div class="sec-label"><%= reviewEnabled || assessmentClosed ? 'Review items' : 'Unanswered' %></div><div class="kpi-num"><%= reviewEnabled || assessmentClosed ? bundle.progress.open : bundle.progress.total - bundle.vendorAnswered %></div><div class="meta"><%= assessmentClosed ? 'No review items remain' : reviewEnabled ? bundle.readyForReview + ' ready for review' : 'Waiting for vendor' %></div></div>
    <div class="kpi"><div class="sec-label">Due</div><div style="font-size:17px;font-weight:600;margin-top:7px"><%= bundle.assessment.due_date || 'Set before issue' %></div></div>
  </div></div>

  <div class="panel" style="margin-bottom:16px">
    <div class="panel-head"><div><h2><%= assessmentClosed ? 'Questionnaire record' : reviewEnabled ? 'Vendor submission' : 'Issue to vendor' %></h2><div class="meta"><%= assessmentClosed ? 'The completed response and review remain available as one governed record.' : reviewEnabled ? 'The vendor response is locked while internal review is completed.' : 'The secure link expires after 30 days and is the vendor’s credential.' %></div></div></div>
    <% if (bundle.assessment.last_delivery_at) { %><div class="panel-pad" style="border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:16px;align-items:center"><div><strong><%= bundle.assessment.delivery_status==='sent' ? 'Email delivered to provider' : bundle.assessment.delivery_status==='preview' ? 'Local preview only' : 'Email delivery failed' %></strong><div class="meta"><%= bundle.assessment.vendor_contact_email %> · <%= bundle.assessment.last_delivery_at %><%= bundle.assessment.delivery_provider ? ' · '+bundle.assessment.delivery_provider : '' %></div><% if (bundle.assessment.delivery_error) { %><div class="meta" style="color:var(--danger)"><%= bundle.assessment.delivery_error %></div><% } %></div><span class="status s-<%= bundle.assessment.delivery_status==='sent'?'done':bundle.assessment.delivery_status==='failed'?'todo':'in_progress' %>"><%= bundle.assessment.delivery_status %></span></div><% } %>
    <% if (['draft','issued','in_progress'].includes(bundle.assessment.status)) { %><form method="POST" action="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/due-diligence/share" class="panel-pad" style="display:grid;grid-template-columns:1fr 1.25fr .8fr auto;gap:10px;align-items:end"><div><label class="label">Contact name</label><input class="input" name="vendor_contact_name" value="<%= bundle.assessment.vendor_contact_name || '' %>"></div><div><label class="label">Email</label><input class="input" type="email" name="vendor_contact_email" value="<%= bundle.assessment.vendor_contact_email || v.contact || '' %>" required></div><div><label class="label">Due date</label><input class="input" type="date" name="due_date" value="<%= bundle.assessment.due_date || '' %>" required></div><button class="btn btn-primary"><%= bundle.assessment.status==='draft'?'Issue secure link':'Replace secure link' %></button></form><% } else { %><div class="panel-pad"><strong><%= assessmentClosed ? 'Assessment concluded' : 'Vendor submission received' %></strong><div class="meta"><%= assessmentClosed ? 'The issued link is closed. A new periodic or triggered assessment creates a separate governed record.' : 'The questionnaire is locked while the internal evidence review is performed.' %></div></div><% } %>
    <% if (inviteLink) { %><div class="panel-pad" style="border-top:1px solid var(--border)"><label class="label">Secure link created for testing</label><input class="input" value="<%= inviteLink %>" readonly onclick="this.select()"></div><% } %>
  </div>

  <div class="panel" style="margin-bottom:16px"><div class="panel-pad" style="display:flex;justify-content:space-between;gap:18px;align-items:center"><div><div class="sec-label">Assessment methodology</div><strong><%= methodology.title %> · version <%= methodologyRecord.version %></strong><div class="meta">This assessment is pinned to content hash <%= (methodologyRecord.content_hash || bundle.assessment.methodology_hash || '').slice(0,12) %>. Publishing a later version will not change its scope.</div></div><a class="btn btn-secondary" href="/workspaces/<%= ws.id %>/supplier-methodology">View configuration</a></div></div>

  <div class="panel" style="margin-bottom:16px"><div class="panel-head"><h2>Assessment scope</h2></div><div class="panel-pad" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px"><% bundle.modules.forEach(module => { %><div style="padding:12px;border:1px solid var(--border);border-radius:7px"><div class="sec-label"><%= module.applicability %></div><strong><%= module.name %></strong><div class="meta"><%= module.questionCount %> questions</div></div><% }) %></div></div>

  <% if (!reviewEnabled && !assessmentClosed) { %><div class="panel" style="margin-bottom:16px"><div class="panel-pad"><strong>Waiting for vendor submission</strong><div class="meta">Responses remain visible below, but reviewer conclusions stay locked until the vendor submits the complete scoped questionnaire.</div></div></div><% } %>
  <form method="POST" action="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/due-diligence/review">
    <% const domains = [...new Set(bundle.questions.map(question => question.domain))]; domains.forEach((domain, index) => { const questions = bundle.questions.filter(question => question.domain === domain); %>
      <details class="panel" style="margin-bottom:12px" <%= index===0?'open':'' %>><summary class="panel-head" style="cursor:pointer;list-style:none"><div><h2><%= domain %></h2><div class="meta"><%= questions.length %> questions</div></div><strong><%= questions.filter(q => (bundle.responseMap[q.id]||{}).status === 'Response Complete').length %>/<%= questions.length %> complete</strong></summary>
        <% questions.forEach(question => { const row = bundle.responseMap[question.id] || {}; %><div style="padding:18px;border-top:1px solid var(--border)">
          <div style="display:flex;justify-content:space-between;gap:16px"><div><span class="tag tag-neutral"><%= question.id %></span> <strong><%= question.theme %></strong></div><span class="status s-<%= row.status==='Response Complete'?'done':row.status==='Unanswered'?'todo':'in_progress' %>"><%= row.status || 'Unanswered' %></span></div>
          <div style="font-weight:600;line-height:1.45;margin-top:10px"><%= question.question %></div><div class="meta" style="margin-top:4px"><%= question.guidance %></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px"><div><div class="sec-label">Vendor response</div><div><strong><%= row.response || 'Not answered' %></strong></div><div class="meta"><%= row.detail || 'No supporting detail' %></div></div><div><div class="sec-label">Evidence expected</div><div><%= question.evidenceRequired %></div><div class="meta"><%= row.evidence_reference || 'No evidence reference' %></div><% (bundle.evidenceMap[question.id]||[]).forEach(file=>{ %><div style="margin-top:5px"><a href="/workspaces/<%= ws.id %>/vendors/<%= v.id %>/due-diligence/evidence/<%= file.id %>"><%= file.filename %></a> <span class="meta">· <%= Math.round(file.size_bytes/1024) %> KB · <%= file.source %></span></div><% }) %></div></div>
          <div style="display:grid;grid-template-columns:1fr 260px;gap:10px;margin-top:12px"><div><label class="label">Reviewer conclusion</label><select class="select" name="reviewer_<%= question.id %>" <%= reviewEnabled?'':'disabled' %>><% methodology.responses.reviewer.forEach(option=>{ %><option <%= (row.reviewer_conclusion||'Not Reviewed')===option?'selected':'' %>><%= option %></option><% }) %></select></div><div><label class="label">Linked finding <a href="/workspaces/<%= ws.id %>/vendors/<%= v.id %>?view=legacy&tab=findings" target="_blank" rel="noopener" style="float:right;font-weight:500">Open register</a></label><select class="select" name="finding_<%= question.id %>" <%= reviewEnabled?'':'disabled' %>><option value="">No linked finding</option><% findings.forEach(finding=>{ %><option value="<%= finding.id %>" <%= Number(row.finding_id)===finding.id?'selected':'' %>>#<%= finding.id %> · <%= finding.severity %> · <%= finding.title %></option><% }) %></select></div></div><input class="input" style="margin-top:8px" name="reviewer_comments_<%= question.id %>" value="<%= row.reviewer_comments || '' %>" placeholder="Reviewer conclusion and test performed" <%= reviewEnabled?'':'disabled' %>>
        </div><% }) %>
      </details>
    <% }) %>
    <% if (reviewEnabled) { %><div class="row" style="margin-bottom:24px"><button class="btn btn-secondary" name="action" value="save">Save review</button><button class="btn btn-primary" name="action" value="complete">Complete due diligence</button></div><% } else if (assessmentClosed) { %><div class="panel" style="margin-bottom:24px"><div class="panel-pad"><strong>Review complete</strong><div class="meta">This conclusion is retained as an immutable assessment record. Start a new periodic or triggered review from the supplier record when reassessment is due.</div></div></div><% } %>
  </form>
<% } %>

<%- include('partials/footer') %>
