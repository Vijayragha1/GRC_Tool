<%- include('partials/header', { title: 'Statement of Applicability', user, ws, active: 'soa' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Statement of Applicability</h1>
    <div class="page-subtitle">Mandatory ISO 27001 document. Applicability and justification for all 93 Annex A controls.</div>
  </div>
  <div style="display:flex;gap:6px;">
    <a href="/workspaces/<%= ws.id %>/soa/snapshots" class="btn btn-secondary btn-xs">Snapshots</a>
    <form method="POST" action="/workspaces/<%= ws.id %>/soa/auto-justify" style="display:inline" onsubmit="return confirm('Auto-include and justify every control linked to a risk?')"><button class="btn btn-secondary btn-xs">Auto-justify from risks</button></form>
    <form method="POST" action="/workspaces/<%= ws.id %>/soa/snapshot" style="display:inline"><input type="hidden" name="label" value="Manual snapshot"><button class="btn btn-secondary btn-xs">Capture snapshot</button></form>
    <a href="/workspaces/<%= ws.id %>/export/soa.csv" class="btn btn-secondary btn-xs">Export CSV</a>
  </div>
</div>

<!-- Bulk applicability bar — fast-path for large workspaces -->
<details class="panel" style="margin-bottom:10px;">
  <summary class="panel-pad" style="cursor:pointer;font-size:13px;font-weight:500;">+ Bulk decide applicability <span class="meta" style="font-weight:400;">— include all, include undecided, or set selection in one shot</span></summary>
  <form method="POST" action="/workspaces/<%= ws.id %>/soa/bulk" class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);display:grid;grid-template-columns:1fr auto auto auto;gap:8px;align-items:end;">
    <div style="grid-column:1/-1;">
      <label class="label">Justification (optional, applied to every affected row)</label>
      <input class="input" name="justification" placeholder="e.g., Required by linked risks per workspace risk register">
    </div>
    <button name="action" value="include_all" class="btn btn-secondary btn-xs" onclick="return confirm('Mark every Annex A control as included?')">Include all (93)</button>
    <button name="action" value="include_undecided" class="btn btn-secondary btn-xs" onclick="return confirm('Mark every undecided Annex A control as included?')">Include undecided</button>
    <span class="meta" style="font-size:11.5px;">For per-row decisions, use the dropdowns below.</span>
  </form>
</details>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr>
      <th style="width:60px">ID</th>
      <th>Control</th>
      <th style="width:200px" title="Risks treated by this control — required by 6.1.3.d.1">Risks treated</th>
      <th style="width:60px" title="Evidence files linked to this control">E</th>
      <th style="width:60px" title="Open nonconformities on this control">NC</th>
      <th style="width:240px">Covered by (linked documents)</th>
      <th style="width:140px">Applicability</th>
      <th style="width:170px">Status</th>
      <th>Justification</th>
    </tr></thead>
    <tbody>
      <% rows.forEach(r => {
           const linkedDocs = (docsByControl && docsByControl[r.id]) || [];
           const linkedRisks = (typeof risksByControl !== 'undefined' && risksByControl[r.id]) || [];
      %>
        <form method="POST" action="/workspaces/<%= ws.id %>/soa/<%= r.id %>" class="contents">
          <tr>
            <td class="mono meta"><%= r.id.replace('annex-', '').toUpperCase() %></td>
            <td><a href="/workspaces/<%= ws.id %>/controls/<%= r.id %>" class="link-muted" style="color:var(--text);"><%= r.title.replace(/^A\.[0-9.]+ /, '') %></a><% if (r.systemic_count >= 3) { %> <span class="tag tag-danger" style="font-size:10px;" title="<%= r.systemic_count %> findings in last 12 months">SYSTEMIC</span><% } %><% if (r.last_verified_at) { %><div class="meta" style="font-size:10.5px;">verified <%= r.last_verified_at.slice(0,10) %></div><% } %></td>
            <td style="font-size:11.5px;line-height:1.4;">
              <% if (linkedRisks.length === 0) { %>
                <% if (r.applicability === 'included') { %>
                  <span class="tag tag-warn" style="font-size:10px;" title="An included control with no linked risk fails 6.1.3.d.1">unjustified</span>
                <% } else { %>
                  <span class="meta">—</span>
                <% } %>
              <% } else { %>
                <% linkedRisks.slice(0, 3).forEach((rk, idx) => { %><a href="/workspaces/<%= ws.id %>/risks/<%= rk.risk_id %>" title="<%= rk.risk_title %> · L<%= rk.likelihood %>×I<%= rk.impact %>" style="color:var(--accent);text-decoration:none;border-bottom:1px dotted var(--accent);">R-<%= rk.risk_id %></a><% if (idx < Math.min(linkedRisks.length, 3) - 1) { %><span class="meta">, </span><% } %><% }) %><% if (linkedRisks.length > 3) { %><span class="meta"> +<%= linkedRisks.length - 3 %></span><% } %>
              <% } %>
            </td>
            <td><% if (r.evidence_count > 0) { %><span class="tag tag-info num"><%= r.evidence_count %></span><% } else { %><span class="meta">—</span><% } %></td>
            <td><% if (r.open_nc_count > 0) { %><span class="tag tag-danger num"><%= r.open_nc_count %></span><% } else { %><span class="meta">—</span><% } %></td>
            <td>
              <% if (linkedDocs.length === 0) { %>
                <span class="meta">—</span>
              <% } else { %>
                <% linkedDocs.forEach((d, idx) => { %><a href="/workspaces/<%= ws.id %>/documents/<%= d.doc_id %>" style="font-size:12px;color:var(--accent);text-decoration:none;" title="<%= d.category || '' %> · <%= d.doc_status %>"><%= d.doc_name %><% if (d.section_ref) { %> <%= d.section_ref %><% } %></a><% if (idx < linkedDocs.length - 1) { %><span class="meta">, </span><% } %><% }) %>
              <% } %>
            </td>
            <td>
              <select name="applicability" class="select" style="font-size:12px;padding:4px 8px;">
                <option value="undecided" <%= r.applicability === 'undecided' ? 'selected' : '' %>>Undecided</option>
                <option value="included" <%= r.applicability === 'included' ? 'selected' : '' %>>Included</option>
                <option value="excluded" <%= r.applicability === 'excluded' ? 'selected' : '' %>>Excluded</option>
              </select>
            </td>
            <td>
              <select name="status" class="select" style="font-size:12px;padding:4px 8px;">
                <% ['Not Assessed','Implemented','Partially Implemented','Work In Progress','Not Implemented','Not Applicable'].forEach(s => { %>
                  <option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </td>
            <td>
              <textarea name="<%= r.applicability === 'excluded' ? 'exclusion_justification' : 'inclusion_justification' %>" rows="1" class="textarea" style="font-size:12px;padding:4px 8px;" placeholder="<%= r.applicability === 'excluded' ? 'Why excluded' : 'Why included' %>"><%= r.applicability === 'excluded' ? (r.exclusion_justification || '') : (r.inclusion_justification || '') %></textarea>
              <button class="btn btn-ghost btn-xs" style="margin-top:4px;font-size:11px;">Save</button>
            </td>
          </tr>
        </form>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
