<%- include('partials/header',{ title:'Delivery cockpit',user,ws,active:'delivery' }) %>
<%
  const csrf=typeof csrfToken!=='undefined'?csrfToken:'';
  const today=new Date().toISOString().slice(0,10);
  const canFirmManage=user.user_type==='firm'&&rbac.isManager(user.firm_role);
  const firmUsers=users.filter(u=>u.user_type==='firm');
  const clientUsers=users.filter(u=>u.user_type==='client');
  const money=(minor,currency=commercial?.currency||'USD')=>new Intl.NumberFormat('en-US',{style:'currency',currency}).format(Number(minor||0)/100);
  let methodContent={};try{methodContent=JSON.parse(methodology?.content_json||'{}')}catch(_){methodContent={}}
  const methodLabel=value=>String(value||'').replaceAll('_',' ').replace(/\b\w/g,c=>c.toUpperCase());
  const methodPurpose=methodContent.purpose||'Provide a consistent, evidence-based approach for planning, performing, reviewing and reporting client framework assessments.';
  const methodProcedures=methodContent.required_procedures||'Define the assessment objective and scope; document the procedure performed and people consulted; identify the population and sample where applicable; record exceptions; and support every conclusion with retained evidence.';
  const methodEvidence=methodContent.evidence_standard||'Evidence must be relevant to the assessment objective, cover the stated assessment period, be sufficient for the conclusion reached, and include an explicit reviewer conclusion.';
  const methodReview=methodContent.review_standard||'The preparer submits completed work for independent manager review. Client factual validation is obtained when required. Approved workpapers are frozen as immutable versions, and preparers cannot approve their own work.';
  const methodReporting=methodContent.reporting_standard||'Client reports are generated only from frozen workpapers and confirmed client-visible findings, independently approved, versioned and published through the controlled client portal.';
  const q=(viewName)=>`?view=${viewName}&engagement=${engagement.id}`;
%>
<style>
  .dco{max-width:1240px;margin:0 auto}.dco-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;padding:25px 27px;background:var(--ink);color:#fff;border-radius:12px;margin-bottom:13px;align-items:end}.dco-eyebrow{font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.55);margin-bottom:9px}.dco-hero h1{font-family:var(--font-display);font-size:31px;line-height:1.05;margin:0 0 7px;color:#fff}.dco-hero p{font-size:12px;color:rgba(255,255,255,.68);margin:0;line-height:1.5}.dco-state{text-align:right}.dco-state strong{font-family:var(--font-display);font-size:22px;display:block}.dco-state span{font-size:10px;color:rgba(255,255,255,.58)}
  .dco-switch{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px}.dco-switch select{max-width:360px}.dco-actions{display:flex;gap:7px;flex-wrap:wrap}.dco-tabs{display:flex;gap:4px;overflow:auto;border-bottom:1px solid var(--border);margin-bottom:14px}.dco-tab{padding:9px 12px;text-decoration:none;color:var(--text-secondary);font-size:11px;white-space:nowrap;border-bottom:2px solid transparent}.dco-tab.active{color:var(--text);border-bottom-color:var(--text);font-weight:700}
  .dco-metrics{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:14px}.dco-metric{border:1px solid var(--border);background:var(--surface);border-radius:7px;padding:13px 14px}.dco-metric span{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.07em;color:var(--text-muted);margin-bottom:7px}.dco-metric strong{font-family:var(--font-display);font-size:23px;line-height:1}.dco-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:14px;align-items:start}.dco-panel{border:1px solid var(--border);border-radius:8px;background:var(--surface);margin-bottom:13px;overflow:hidden}.dco-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;padding:13px 15px;border-bottom:1px solid var(--border)}.dco-head h2{font-size:13px;margin:0 0 3px}.dco-head p{font-size:9.5px;color:var(--text-muted);margin:0;line-height:1.4}.dco-count{font-family:var(--font-display);font-size:21px}.dco-body{padding:15px}.dco-row{display:grid;grid-template-columns:90px minmax(0,1fr) auto;gap:12px;align-items:center;padding:11px 15px;border-bottom:1px solid var(--border)}.dco-row:last-child{border-bottom:0}.dco-row-label{font-size:8px;text-transform:uppercase;letter-spacing:.07em;font-weight:800}.dco-row b{display:block;font-size:11px;margin-bottom:2px}.dco-row small{display:block;color:var(--text-muted);font-size:9.5px;line-height:1.4}.dco-table-wrap{overflow:auto}.dco-table{width:100%;border-collapse:collapse;font-size:10.5px}.dco-table th{padding:8px 11px;text-align:left;text-transform:uppercase;letter-spacing:.065em;font-size:8px;color:var(--text-muted);background:var(--bg-subtle);border-bottom:1px solid var(--border);white-space:nowrap}.dco-table td{padding:9px 11px;border-bottom:1px solid var(--border);vertical-align:middle}.dco-table tr:last-child td{border-bottom:0}.dco-table a{color:var(--text);font-weight:700;text-decoration:none}.dco-table a:hover{text-decoration:underline}.dco-muted{color:var(--text-muted)}.dco-ref{font-family:'SF Mono',Menlo,monospace;font-size:9px}.dco-status{border:1px solid var(--border-strong);border-radius:3px;padding:3px 5px;font-size:7.5px;text-transform:uppercase;letter-spacing:.06em;font-weight:800;white-space:nowrap}.dco-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.dco-form .wide{grid-column:1/-1}.dco-form label{display:block;font-size:8px;text-transform:uppercase;letter-spacing:.065em;color:var(--text-muted);font-weight:700;margin-bottom:5px}.dco-form input,.dco-form select,.dco-form textarea{width:100%;border:1px solid var(--border);border-radius:5px;background:var(--surface);color:var(--text);padding:8px 9px;font:inherit;font-size:10.5px}.dco-form textarea{min-height:74px;resize:vertical}.dco-formbar{grid-column:1/-1;display:flex;justify-content:flex-end;gap:7px;padding-top:3px}.dco-details{border:1px solid var(--border);border-radius:7px;margin-bottom:10px;background:var(--surface)}.dco-details summary{padding:11px 13px;cursor:pointer;font-size:10.5px;font-weight:700;list-style:none}.dco-details summary::-webkit-details-marker{display:none}.dco-details[open] summary{border-bottom:1px solid var(--border)}.dco-details .dco-body{padding:13px}.dco-aside{position:sticky;top:18px}.dco-note{font-size:10px;line-height:1.55;color:var(--text-secondary);margin:0}.dco-empty{padding:24px 15px;text-align:center;color:var(--text-muted);font-size:10px}.dco-kv{display:flex;justify-content:space-between;gap:12px;padding:9px 13px;border-bottom:1px solid var(--border);font-size:10px}.dco-kv:last-child{border-bottom:0}.dco-kv span{color:var(--text-muted)}.dco-method{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;padding-top:15px}.dco-method-card{border:1px solid var(--border);border-radius:7px;padding:13px;background:var(--bg-subtle)}.dco-method-card.wide{grid-column:1/-1}.dco-method-card h3{font-size:10px;margin:0 0 6px}.dco-method-card p{font-size:10px;line-height:1.55;color:var(--text-secondary);margin:0;white-space:pre-wrap}.dco-method-list{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.dco-method-list span{border:1px solid var(--border-strong);border-radius:4px;padding:4px 6px;background:var(--surface);font-size:8.5px;color:var(--text-secondary)}.dco-method-flow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;margin-top:9px}.dco-method-step{border:1px solid var(--border);border-radius:5px;padding:8px;background:var(--surface);font-size:8.5px;line-height:1.35}.dco-method-step b{display:block;font-family:var(--font-display);font-size:15px;margin-bottom:3px}
  @media(max-width:1050px){.dco-grid{grid-template-columns:1fr}.dco-aside{position:static}.dco-metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:680px){.dco-hero{grid-template-columns:1fr}.dco-state{text-align:left}.dco-switch{align-items:flex-start;flex-direction:column}.dco-metrics{grid-template-columns:1fr 1fr}.dco-form{grid-template-columns:1fr}.dco-form .wide,.dco-formbar{grid-column:1}.dco-row{grid-template-columns:1fr}.dco-table th:nth-child(4),.dco-table td:nth-child(4){display:none}.dco-method{grid-template-columns:1fr}.dco-method-card.wide{grid-column:1}.dco-method-flow{grid-template-columns:1fr 1fr}}
</style>

<div class="dco">
  <header class="dco-hero"><div><div class="dco-eyebrow">Consultant delivery operating system</div><h1><%= engagement.name %></h1><p><%= engagement.engagement_code %> · <%= JSON.parse(engagement.framework_scope_json||'[]').join(' · ').toUpperCase() %> · professional work, client hand-offs and quality review in one governed record.</p></div><div class="dco-state"><strong><%= engagement.status.replaceAll('_',' ') %></strong><span><%= engagement.target_date?`Target ${engagement.target_date}`:'No target date' %> · v<%= engagement.row_version %></span></div></header>
  <div class="dco-switch"><select class="select" onchange="location='?engagement='+this.value+'&view=<%= view %>'"><% engagements.forEach(e=>{ %><option value="<%= e.id %>" <%= e.id===engagement.id?'selected':'' %>><%= e.engagement_code %> · <%= e.name %> (<%= e.status.replaceAll('_',' ') %>)</option><% }) %></select><div class="dco-actions"><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/engagement-plan">Delivery plan</a><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/client-portal">Client portal</a><details style="position:relative"><summary class="btn btn-primary btn-xs">New engagement</summary><div style="position:absolute;right:0;top:35px;width:min(620px,86vw);z-index:20" class="dco-panel"><div class="dco-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/engagements" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div><label>Engagement code</label><input name="engagement_code" placeholder="ENG-2026-002"></div><div><label>Name</label><input name="name" required></div><div><label>Type</label><select name="engagement_type"><option value="implementation">Implementation</option><option value="readiness">Readiness</option><option value="internal_audit">Internal audit</option><option value="gap_assessment">Gap assessment</option><option value="advisory">Advisory</option><option value="surveillance">Surveillance</option></select></div><div><label>Frameworks</label><select name="frameworks" multiple size="4"><% [...new Set(requirements.map(r=>r.framework_code))].forEach(code=>{ %><option value="<%= code %>" selected><%= code.toUpperCase() %></option><% }) %><option value="iso27001">ISO 27001</option><option value="iso42001">ISO 42001</option><option value="csf">NIST CSF</option></select></div><div><label>Lead consultant</label><select name="lead_consultant_id"><% firmUsers.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div><label>Quality reviewer</label><select name="quality_reviewer_id"><option value="">Assign later</option><% firmUsers.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div class="wide"><label>Scope statement</label><textarea name="scope_statement"></textarea></div><div><label>Start date</label><input type="date" name="start_date"></div><div><label>Target date</label><input type="date" name="target_date"></div><div class="dco-formbar"><button class="btn btn-primary btn-sm">Create engagement</button></div></form></div></div></details></div></div>
  <nav class="dco-tabs"><% [['overview','Overview'],['workpapers','Workpapers'],['findings','Findings'],['requests','Client requests'],['frameworks','Common controls'],['reports','Reports'],['commercial','Commercial'],['methodology','Methodology'],['qa','Quality review']].forEach(([key,label])=>{ %><a class="dco-tab <%= view===key?'active':'' %>" href="<%= q(key) %>"><%= label %></a><% }) %></nav>

  <div class="dco-metrics"><div class="dco-metric"><span>My workpapers</span><strong><%= metrics.mine %></strong></div><div class="dco-metric"><span>My reviews</span><strong><%= metrics.review %></strong></div><div class="dco-metric"><span>Waiting on client</span><strong><%= metrics.client %></strong></div><div class="dco-metric"><span>Overdue</span><strong><%= metrics.overdue %></strong></div><div class="dco-metric"><span>Frozen workpapers</span><strong><%= metrics.frozen %></strong></div><div class="dco-metric"><span>Framework coverage</span><strong><%= metrics.coverage %>%</strong></div></div>

  <% if(view==='overview'){ %><div class="dco-grid"><main>
    <section class="dco-panel"><div class="dco-head"><div><h2>Consultant work queue</h2><p>Items requiring professional judgment, client input or quality review.</p></div><span class="dco-count"><%= workpapers.filter(w=>!['frozen','superseded'].includes(w.status)).length+requests.filter(r=>!['accepted','cancelled'].includes(r.status)).length %></span></div>
      <div class="dco-row"><span class="dco-row-label">Prepare</span><div><b>Draft and changes-requested workpapers</b><small>Complete procedures, evidence assessment and four-layer conclusions.</small></div><a class="btn btn-secondary btn-xs" href="<%= q('workpapers') %>"><%= workpapers.filter(w=>['draft','changes_requested'].includes(w.status)).length %> items</a></div>
      <div class="dco-row"><span class="dco-row-label">Review</span><div><b>Manager quality review</b><small>Maker–checker decisions awaiting the assigned reviewer.</small></div><a class="btn btn-secondary btn-xs" href="<%= q('qa') %>"><%= workpapers.filter(w=>w.status==='manager_review').length %> items</a></div>
      <div class="dco-row"><span class="dco-row-label">Client</span><div><b>Evidence and validation hand-offs</b><small>Client requests that remain open, in progress or require changes.</small></div><a class="btn btn-secondary btn-xs" href="<%= q('requests') %>"><%= requests.filter(r=>!['accepted','cancelled'].includes(r.status)).length %> items</a></div>
      <div class="dco-row"><span class="dco-row-label">Close</span><div><b>Approved workpapers ready to freeze</b><small>Freeze only after all review and validation decisions are complete.</small></div><a class="btn btn-secondary btn-xs" href="<%= q('qa') %>"><%= workpapers.filter(w=>w.status==='approved').length %> items</a></div>
    </section>
    <section class="dco-panel"><div class="dco-head"><div><h2>Recent workpapers</h2><p>The engagement's current professional record.</p></div><a class="btn btn-primary btn-xs" href="<%= q('workpapers') %>">Open register</a></div><div class="dco-table-wrap"><table class="dco-table"><thead><tr><th>Ref</th><th>Requirement</th><th>Conclusion</th><th>Owner</th><th>Status</th></tr></thead><tbody><% workpapers.slice(0,10).forEach(w=>{ %><tr><td class="dco-ref"><a href="/workspaces/<%= ws.id %>/delivery/workpapers/<%= w.id %>"><%= w.workpaper_ref %></a></td><td><%= w.framework_code.toUpperCase() %> <%= w.requirement_ref %> · <%= w.requirement_title %></td><td><%= w.operating_effectiveness.replaceAll('_',' ') %></td><td><%= w.owner_name||'Unassigned' %></td><td><span class="dco-status"><%= w.status.replaceAll('_',' ') %></span></td></tr><% }) %><% if(!workpapers.length){ %><tr><td colspan="5" class="dco-empty">No workpapers yet. Start from the Workpapers tab.</td></tr><% } %></tbody></table></div></section>
    <details class="dco-details"><summary>Engagement scope and governance</summary><div class="dco-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/engagements/<%= engagement.id %>" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="row_version" value="<%= engagement.row_version %>"><div><label>Name</label><input name="name" value="<%= engagement.name %>" required></div><div><label>Status</label><select name="status"><% ['draft','active','on_hold','quality_review','complete','cancelled'].forEach(v=>{ %><option value="<%= v %>" <%= engagement.status===v?'selected':'' %>><%= v.replaceAll('_',' ') %></option><% }) %></select></div><div><label>Lead consultant</label><select name="lead_consultant_id"><% firmUsers.forEach(u=>{ %><option value="<%= u.id %>" <%= engagement.lead_consultant_id===u.id?'selected':'' %>><%= u.name %></option><% }) %></select></div><div><label>Quality reviewer</label><select name="quality_reviewer_id"><option value="">Unassigned</option><% firmUsers.forEach(u=>{ %><option value="<%= u.id %>" <%= engagement.quality_reviewer_id===u.id?'selected':'' %>><%= u.name %></option><% }) %></select></div><div><label>Client sponsor</label><select name="client_sponsor_id"><option value="">Unassigned</option><% clientUsers.forEach(u=>{ %><option value="<%= u.id %>" <%= engagement.client_sponsor_id===u.id?'selected':'' %>><%= u.name %></option><% }) %></select></div><div><label>Assessment period</label><div style="display:flex;gap:6px"><input type="date" name="assessment_period_start" value="<%= engagement.assessment_period_start||'' %>"><input type="date" name="assessment_period_end" value="<%= engagement.assessment_period_end||'' %>"></div></div><div class="wide"><label>Scope statement</label><textarea name="scope_statement"><%= engagement.scope_statement||'' %></textarea></div><div><label>Included entities</label><textarea name="included_entities"><%= engagement.included_entities||'' %></textarea></div><div><label>Included locations</label><textarea name="included_locations"><%= engagement.included_locations||'' %></textarea></div><div><label>Included systems and processes</label><textarea name="included_systems"><%= engagement.included_systems||'' %></textarea></div><div><label>Exclusions</label><textarea name="exclusions"><%= engagement.exclusions||'' %></textarea></div><div><label>Start date</label><input type="date" name="start_date" value="<%= engagement.start_date||'' %>"></div><div><label>Target date</label><input type="date" name="target_date" value="<%= engagement.target_date||'' %>"></div><div class="wide"><label>Completion note</label><textarea name="completion_note"><%= engagement.completion_note||'' %></textarea></div><div class="dco-formbar"><button class="btn btn-primary btn-sm">Save engagement governance</button></div></form></div></details>
  </main><aside class="dco-aside"><section class="dco-panel"><div class="dco-head"><div><h2>Engagement governance</h2><p>Scope and accountability</p></div></div><div class="dco-kv"><span>Lead</span><b><%= firmUsers.find(u=>u.id===engagement.lead_consultant_id)?.name||'Unassigned' %></b></div><div class="dco-kv"><span>Quality reviewer</span><b><%= firmUsers.find(u=>u.id===engagement.quality_reviewer_id)?.name||'Unassigned' %></b></div><div class="dco-kv"><span>Assessment period</span><b><%= engagement.assessment_period_start||'-' %> – <%= engagement.assessment_period_end||'-' %></b></div><div class="dco-body"><p class="dco-note"><%= engagement.scope_statement||'Scope statement not yet documented for this engagement.' %></p></div></section><section class="dco-panel"><div class="dco-head"><div><h2>Engagement team</h2><p>Role and planned effort</p></div><span class="dco-count"><%= team.length %></span></div><% team.forEach(t=>{ %><div class="dco-kv"><span><%= t.role.replaceAll('_',' ') %></span><b><%= t.name %> · <%= t.planned_hours %>h</b></div><% }) %><div class="dco-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/engagements/<%= engagement.id %>/team" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="wide"><label>Member</label><select name="user_id"><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div><label>Role</label><select name="role"><option value="consultant">Consultant</option><option value="quality_reviewer">Quality reviewer</option><option value="subject_matter_expert">Subject matter expert</option><option value="client_sponsor">Client sponsor</option><option value="client_contributor">Client contributor</option></select></div><div><label>Planned hours</label><input type="number" min="0" step="0.25" name="planned_hours" value="0"></div><div class="dco-formbar"><button class="btn btn-secondary btn-sm">Assign</button></div></form></div></section><section class="dco-panel"><div class="dco-head"><div><h2>Commercial health</h2><p>Firm-internal</p></div></div><div class="dco-kv"><span>Contract</span><b><%= money(commercial?.contract_value_minor) %></b></div><div class="dco-kv"><span>Hours</span><b><%= commercial?.actual_hours||0 %> / <%= commercial?.planned_hours||0 %></b></div><div class="dco-kv"><span>Invoiced</span><b><%= money(commercial?.invoiced_minor) %></b></div><div class="dco-body"><a class="btn btn-secondary btn-sm" style="width:100%;justify-content:center" href="<%= q('commercial') %>">Commercial detail</a></div></section></aside></div><% } %>

  <% if(view==='workpapers'){ %><div class="dco-grid"><main><section class="dco-panel"><div class="dco-head"><div><h2>Consultant workpaper register</h2><p>Management claim, design, implementation and operating effectiveness remain separate conclusions.</p></div><span class="dco-count"><%= workpapers.length %></span></div><div class="dco-table-wrap"><table class="dco-table"><thead><tr><th>Workpaper</th><th>Requirement</th><th>Design</th><th>Implementation</th><th>Effectiveness</th><th>Evidence</th><th>Status</th></tr></thead><tbody><% workpapers.forEach(w=>{ %><tr><td><a href="/workspaces/<%= ws.id %>/delivery/workpapers/<%= w.id %>"><span class="dco-ref"><%= w.workpaper_ref %></span><br><%= w.title %></a></td><td><%= w.framework_code.toUpperCase() %> <%= w.requirement_ref %></td><td><%= w.design_conclusion.replaceAll('_',' ') %></td><td><%= w.implementation_conclusion.replaceAll('_',' ') %></td><td><%= w.operating_effectiveness.replaceAll('_',' ') %></td><td><%= w.evidence_count %></td><td><span class="dco-status"><%= w.status.replaceAll('_',' ') %></span></td></tr><% }) %><% if(!workpapers.length){ %><tr><td colspan="7" class="dco-empty">Create the first scoped workpaper using the form on the right.</td></tr><% } %></tbody></table></div></section></main><aside class="dco-aside"><section class="dco-panel"><div class="dco-head"><div><h2>New workpaper</h2><p>Creates a governed draft</p></div></div><div class="dco-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/workpapers" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="engagement_id" value="<%= engagement.id %>"><div class="wide"><label>Requirement</label><select name="requirement_id" required><option value="">Choose…</option><% requirements.forEach(r=>{ %><option value="<%= r.id %>"><%= r.framework_code.toUpperCase() %> · <%= r.ref %> · <%= r.title %></option><% }) %></select></div><div class="wide"><label>Workpaper title</label><input name="title" required placeholder="Assess control design and operation"></div><div><label>Owner</label><select name="owner_id"><% firmUsers.forEach(u=>{ %><option value="<%= u.id %>" <%= u.id===user.id?'selected':'' %>><%= u.name %></option><% }) %></select></div><div><label>Reviewer</label><select name="reviewer_id"><option value="">Assign later</option><% firmUsers.filter(u=>u.id!==user.id).forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div><label>Due date</label><input type="date" name="due_date"></div><div><label>Management claim</label><select name="management_claim"><option value="not_provided">Not provided</option><option value="implemented">Implemented</option><option value="partially_implemented">Partially implemented</option><option value="not_implemented">Not implemented</option><option value="not_applicable">Not applicable</option></select></div><div class="dco-formbar"><button class="btn btn-primary btn-sm">Create draft</button></div></form></div></section></aside></div><% } %>

  <% if(view==='findings'){ %><section class="dco-panel"><div class="dco-head"><div><h2>Finding and remediation register</h2><p>Confirmed issues move through agreed ownership, remediation and independent closure validation.</p></div><span class="dco-count"><%= findings.length %></span></div><div class="dco-table-wrap"><table class="dco-table"><thead><tr><th>Finding</th><th>Source</th><th>Type</th><th>Severity</th><th>Owner</th><th>Due</th><th>Visibility</th><th>Status</th></tr></thead><tbody><% findings.forEach(f=>{ %><tr><td><a href="/workspaces/<%= ws.id %>/delivery/findings/<%= f.id %>"><span class="dco-ref"><%= f.finding_ref %></span><br><%= f.title %></a></td><td><%= f.workpaper_ref||'Engagement' %></td><td><%= f.finding_type.replaceAll('_',' ') %></td><td><b><%= f.severity %></b></td><td><%= f.owner_name||'Unassigned' %></td><td><%= f.due_date||'-' %></td><td><%= f.client_visible?'Client':'Internal' %></td><td><span class="dco-status"><%= f.status.replaceAll('_',' ') %></span></td></tr><% }) %><% if(!findings.length){ %><tr><td colspan="8" class="dco-empty">Raise findings from assessed workpapers so every issue retains its source and evidence chain.</td></tr><% } %></tbody></table></div></section><% } %>

  <% if(view==='requests'){ %><section class="dco-panel"><div class="dco-head"><div><h2>Structured client requests</h2><p>Requests created from workpapers, with purpose, acceptable examples, evidence period and confidentiality.</p></div><span class="dco-count"><%= requests.length %></span></div><div class="dco-table-wrap"><table class="dco-table"><thead><tr><th>Request</th><th>Workpaper</th><th>Client owner</th><th>Evidence period</th><th>Quality</th><th>Due</th><th>Status</th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td><a href="/workspaces/<%= ws.id %>/client-portal/requests/<%= r.id %>"><%= r.title %></a><br><span class="dco-muted"><%= r.confidentiality?.replaceAll('_',' ') %></span></td><td class="dco-ref"><%= r.workpaper_ref||'-' %></td><td><%= r.assignee_name||'Unassigned' %></td><td><%= r.evidence_period_start||'-' %> – <%= r.evidence_period_end||'-' %></td><td><%= r.evidence_quality.replaceAll('_',' ') %></td><td><%= r.due_date||'-' %></td><td><span class="dco-status"><%= r.status.replaceAll('_',' ') %></span></td></tr><% }) %><% if(!requests.length){ %><tr><td colspan="7" class="dco-empty">Create client evidence requests from individual workpapers.</td></tr><% } %></tbody></table></div></section><% } %>

  <% if(view==='frameworks'){ %><div class="dco-grid"><main><section class="dco-panel"><div class="dco-head"><div><h2>Client common-control layer</h2><p>Assess the client control once, then map it across in-scope framework requirements.</p></div><span class="dco-count"><%= controls.length %></span></div><div class="dco-table-wrap"><table class="dco-table"><thead><tr><th>Control</th><th>Owner</th><th>Frequency</th><th>Nature</th><th>Mappings</th><th>Status</th></tr></thead><tbody><% controls.forEach(c=>{ %><tr><td><span class="dco-ref"><%= c.control_code %></span><br><b><%= c.title %></b></td><td><%= users.find(u=>u.id===c.control_owner_id)?.name||c.process_owner||'Unassigned' %></td><td><%= c.frequency||'-' %></td><td><%= c.nature||'-' %></td><td><%= c.mapping_count %></td><td><span class="dco-status"><%= c.status %></span></td></tr><% }) %><% if(!controls.length){ %><tr><td colspan="6" class="dco-empty">No client common controls have been defined.</td></tr><% } %></tbody></table></div></section><% if(controls.length){ %><section class="dco-panel"><div class="dco-head"><div><h2>Map a control to a requirement</h2><p>Mappings require explicit coverage and professional rationale.</p></div></div><div class="dco-body"><form method="POST" class="dco-form" onsubmit="this.action='/workspaces/<%= ws.id %>/delivery/client-controls/'+this.client_control_id.value+'/mappings'"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="engagement_id" value="<%= engagement.id %>"><div><label>Client control</label><select name="client_control_id"><% controls.forEach(c=>{ %><option value="<%= c.id %>"><%= c.control_code %> · <%= c.title %></option><% }) %></select></div><div><label>Requirement</label><select name="requirement_id"><% requirements.forEach(r=>{ %><option value="<%= r.id %>"><%= r.framework_code.toUpperCase() %> <%= r.ref %> · <%= r.title %></option><% }) %></select></div><div><label>Coverage</label><select name="coverage"><option value="full">Full</option><option value="partial">Partial</option><option value="supporting">Supporting</option></select></div><div class="wide"><label>Mapping rationale</label><textarea name="mapping_rationale" required></textarea></div><div class="dco-formbar"><button class="btn btn-primary btn-sm">Save mapping</button></div></form></div></section><% } %></main><aside class="dco-aside"><section class="dco-panel"><div class="dco-head"><div><h2>New client control</h2><p>Client-specific operating control</p></div></div><div class="dco-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/client-controls" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="engagement_id" value="<%= engagement.id %>"><div><label>Code</label><input name="control_code" required placeholder="CC-001"></div><div><label>Title</label><input name="title" required></div><div class="wide"><label>Description</label><textarea name="description"></textarea></div><div><label>Owner</label><select name="control_owner_id"><option value="">Unassigned</option><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></div><div><label>Frequency</label><input name="frequency" placeholder="Quarterly"></div><div><label>Type</label><select name="control_type"><option value="">Choose…</option><option value="preventive">Preventive</option><option value="detective">Detective</option><option value="corrective">Corrective</option><option value="directive">Directive</option></select></div><div><label>Nature</label><select name="nature"><option value="manual">Manual</option><option value="automated">Automated</option><option value="hybrid">Hybrid</option></select></div><div class="dco-formbar"><button class="btn btn-primary btn-sm">Create control</button></div></form></div></section></aside></div><% } %>

  <% if(view==='reports'){ %><div class="dco-grid"><main><section class="dco-panel"><div class="dco-head"><div><h2>Controlled report register</h2><p>Every version is generated from frozen workpapers and client-visible confirmed findings, then independently approved before publication.</p></div><span class="dco-count"><%= reports.length %></span></div><div class="dco-table-wrap"><table class="dco-table"><thead><tr><th>Report</th><th>Type</th><th>Version</th><th>Generated by</th><th>Generated</th><th>Snapshot</th><th>Status</th></tr></thead><tbody><% reports.forEach(r=>{ %><tr><td><a href="/workspaces/<%= ws.id %>/delivery/reports/<%= r.id %>"><%= r.title %></a></td><td><%= r.report_type.replaceAll('_',' ') %></td><td><%= r.version_number %></td><td><%= r.generated_by_name %></td><td><%= r.generated_at %></td><td class="dco-ref"><%= r.snapshot_hash.slice(0,12) %>…</td><td><span class="dco-status"><%= r.status %></span></td></tr><% }) %><% if(!reports.length){ %><tr><td colspan="7" class="dco-empty">No controlled reports have been generated for this engagement.</td></tr><% } %></tbody></table></div></section></main><aside class="dco-aside"><section class="dco-panel"><div class="dco-head"><div><h2>Generate report version</h2><p>Immutable at creation</p></div></div><div class="dco-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/reports" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="engagement_id" value="<%= engagement.id %>"><div class="wide"><label>Report title</label><input name="title" placeholder="<%= engagement.name %> - readiness report"></div><div class="wide"><label>Report type</label><select name="report_type"><option value="assessment">Assessment</option><option value="readiness">Readiness</option><option value="internal_audit">Internal audit</option><option value="management">Management</option></select></div><div class="dco-formbar"><button class="btn btn-primary btn-sm" <%= metrics.frozen?'':'disabled' %>>Generate immutable version</button></div></form><% if(!metrics.frozen){ %><p class="dco-note" style="margin-top:10px">Freeze at least one independently approved workpaper first.</p><% } %></div></section></aside></div><% } %>

  <% if(view==='commercial'){ %><div class="dco-grid"><main><section class="dco-panel"><div class="dco-head"><div><h2>Engagement economics</h2><p>Contract, effort, billing and forecast margin. Firm-internal only.</p></div></div><div class="dco-body"><div class="dco-metrics" style="grid-template-columns:repeat(4,1fr)"><div class="dco-metric"><span>Contract value</span><strong><%= money(commercial.contract_value_minor) %></strong></div><div class="dco-metric"><span>Hours consumed</span><strong><%= commercial.actual_hours %></strong></div><div class="dco-metric"><span>Plan utilisation</span><strong><%= commercial.planned_hours?Math.round(commercial.actual_hours/commercial.planned_hours*100):0 %>%</strong></div><div class="dco-metric"><span>Forecast margin</span><strong><%= money(commercial.contract_value_minor-commercial.actual_hours*commercial.internal_cost_rate_minor) %></strong></div></div><% if(canFirmManage){ %><form method="POST" action="/workspaces/<%= ws.id %>/delivery/commercial" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="engagement_id" value="<%= engagement.id %>"><input type="hidden" name="row_version" value="<%= commercial.row_version %>"><div><label>Currency</label><input name="currency" value="<%= commercial.currency %>"></div><div><label>Contract value</label><input type="number" step="0.01" name="contract_value" value="<%= commercial.contract_value_minor/100 %>"></div><div><label>Planned hours</label><input type="number" step="0.25" name="planned_hours" value="<%= commercial.planned_hours %>"></div><div><label>Internal cost / hour</label><input type="number" step="0.01" name="internal_cost_rate" value="<%= commercial.internal_cost_rate_minor/100 %>"></div><div><label>Billing model</label><select name="billing_model"><% ['fixed_fee','time_and_materials','retainer','milestone'].forEach(v=>{ %><option value="<%= v %>" <%= commercial.billing_model===v?'selected':'' %>><%= v.replaceAll('_',' ') %></option><% }) %></select></div><div><label>Billing status</label><select name="billing_status"><% ['not_started','in_progress','fully_billed','on_hold'].forEach(v=>{ %><option value="<%= v %>" <%= commercial.billing_status===v?'selected':'' %>><%= v.replaceAll('_',' ') %></option><% }) %></select></div><div><label>Invoiced</label><input type="number" step="0.01" name="invoiced" value="<%= commercial.invoiced_minor/100 %>"></div><div><label>Collected</label><input type="number" step="0.01" name="collected" value="<%= commercial.collected_minor/100 %>"></div><div class="dco-formbar"><button class="btn btn-primary btn-sm">Save commercial baseline</button></div></form><% } %></div></section><section class="dco-panel"><div class="dco-head"><div><h2>Time entries</h2><p>Delivery effort by consultant and category.</p></div><span class="dco-count"><%= timeEntries.length %></span></div><div class="dco-table-wrap"><table class="dco-table"><thead><tr><th>Date</th><th>Consultant</th><th>Category</th><th>Description</th><th>Hours</th><th>Billable</th></tr></thead><tbody><% timeEntries.forEach(t=>{ %><tr><td><%= t.work_date %></td><td><%= t.user_name %></td><td><%= t.category.replaceAll('_',' ') %></td><td><%= t.description %></td><td><%= t.hours %></td><td><%= t.billable?'Yes':'No' %></td></tr><% }) %></tbody></table></div></section><section class="dco-panel"><div class="dco-head"><div><h2>Scope-change register</h2><p>Commercial and schedule impacts require explicit decisions.</p></div><span class="dco-count"><%= scopeChanges.length %></span></div><div class="dco-table-wrap"><table class="dco-table"><thead><tr><th>Change</th><th>Impact</th><th>Proposed by</th><th>Status</th><th>Decision</th></tr></thead><tbody><% scopeChanges.forEach(s=>{ %><tr><td><b><%= s.title %></b><br><span class="dco-muted"><%= s.reason %></span></td><td><%= s.schedule_impact_days %> days · <%= money(s.fee_impact_minor) %></td><td><%= s.proposed_by_name %></td><td><span class="dco-status"><%= s.status %></span></td><td><% if(s.status==='proposed'&&canFirmManage){ %><form method="POST" action="/workspaces/<%= ws.id %>/delivery/scope-changes/<%= s.id %>/decision" style="display:flex;gap:5px"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="engagement_id" value="<%= engagement.id %>"><input name="decision_note" required placeholder="Decision rationale" style="width:140px"><button name="decision" value="approved" class="btn btn-secondary btn-xs">Approve</button><button name="decision" value="rejected" class="btn btn-secondary btn-xs">Reject</button></form><% }else{ %><%= s.decision_note||'-' %><% } %></td></tr><% }) %><% if(!scopeChanges.length){ %><tr><td colspan="5" class="dco-empty">No scope changes recorded.</td></tr><% } %></tbody></table></div></section></main><aside class="dco-aside"><section class="dco-panel"><div class="dco-head"><div><h2>Record time</h2><p>Actual delivery effort</p></div></div><div class="dco-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/time" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="engagement_id" value="<%= engagement.id %>"><div><label>Date</label><input type="date" name="work_date" value="<%= today %>" required></div><div><label>Hours</label><input type="number" step="0.25" min="0.25" max="24" name="hours" required></div><div class="wide"><label>Category</label><select name="category"><% ['planning','assessment','client_meeting','workpaper','review','reporting','remediation','administration'].forEach(v=>{ %><option value="<%= v %>"><%= v.replaceAll('_',' ') %></option><% }) %></select></div><div class="wide"><label>Description</label><textarea name="description" required></textarea></div><div><label>Billable</label><select name="billable"><option value="1">Yes</option><option value="0">No</option></select></div><div class="dco-formbar"><button class="btn btn-primary btn-sm">Record time</button></div></form></div></section><section class="dco-panel"><div class="dco-head"><div><h2>Propose scope change</h2><p>Creates a governed decision</p></div></div><div class="dco-body"><form method="POST" action="/workspaces/<%= ws.id %>/delivery/scope-changes" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="engagement_id" value="<%= engagement.id %>"><div class="wide"><label>Title</label><input name="title" required></div><div class="wide"><label>Description</label><textarea name="description" required></textarea></div><div class="wide"><label>Reason</label><textarea name="reason" required></textarea></div><div><label>Schedule impact (days)</label><input type="number" name="schedule_impact_days" value="0"></div><div><label>Fee impact</label><input type="number" step="0.01" name="fee_impact" value="0"></div><div class="dco-formbar"><button class="btn btn-primary btn-sm">Propose change</button></div></form></div></section></aside></div><% } %>

  <% if(view==='methodology'){ %><div class="dco-grid"><main><section class="dco-panel"><div class="dco-head"><div><h2><%= methodology.name %></h2><p>The current approved standard applied to consultant delivery and quality review.</p></div><span class="dco-status">Version <%= methodology.current_version %></span></div><div class="dco-body"><div class="dco-kv"><span>Approved by</span><b><%= methodology.approved_by_name %></b></div><div class="dco-kv"><span>Approved at</span><b><%= methodology.approved_at %></b></div><div class="dco-kv"><span>Change summary</span><b><%= methodology.change_summary %></b></div><div class="dco-method">
    <section class="dco-method-card wide"><h3>Purpose</h3><p><%= methodPurpose %></p></section>
    <section class="dco-method-card"><h3>Required workpaper content</h3><p><%= methodProcedures %></p><% if(methodContent.workpaper_required_fields?.length){ %><div class="dco-method-list"><% methodContent.workpaper_required_fields.forEach(item=>{ %><span><%= methodLabel(item) %></span><% }) %></div><% } %></section>
    <section class="dco-method-card"><h3>Professional conclusion model</h3><p>Management assertions and consultant conclusions are recorded separately.</p><div class="dco-method-list"><% (methodContent.conclusions||['management_claim','design','implementation','operating_effectiveness']).forEach(item=>{ %><span><%= methodLabel(item) %></span><% }) %></div></section>
    <section class="dco-method-card wide"><h3>Review and approval workflow</h3><p><%= methodReview %></p><div class="dco-method-flow"><% (methodContent.review_sequence||['consultant_submission','manager_review','client_validation_if_required','approval','freeze']).forEach((item,index)=>{ %><div class="dco-method-step"><b><%= index+1 %></b><%= methodLabel(item) %></div><% }) %></div></section>
    <section class="dco-method-card"><h3>Evidence standard</h3><p><%= methodEvidence %></p><% if(methodContent.evidence_rules?.length){ %><div class="dco-method-list"><% methodContent.evidence_rules.forEach(item=>{ %><span><%= methodLabel(item) %></span><% }) %></div><% } %></section>
    <section class="dco-method-card"><h3>Independence and reporting</h3><p><%= methodReporting %></p><div class="dco-method-list"><span><%= methodContent.segregation_of_duties===false?'Segregation disabled':'Segregation of duties enforced' %></span><span>Immutable approved versions</span></div></section>
   </div></div></section></main><aside class="dco-aside"><section class="dco-panel"><div class="dco-head"><div><h2>Approve new version</h2><p>Manager-only immutable publication</p></div></div><div class="dco-body"><% if(canFirmManage){ %><form method="POST" action="/workspaces/<%= ws.id %>/delivery/methodology" class="dco-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="wide"><label>Purpose</label><textarea name="purpose" required><%= methodPurpose %></textarea></div><div class="wide"><label>Required procedures</label><textarea name="required_procedures" required><%= methodProcedures %></textarea></div><div class="wide"><label>Evidence standard</label><textarea name="evidence_standard" required><%= methodEvidence %></textarea></div><div class="wide"><label>Review standard</label><textarea name="review_standard" required><%= methodReview %></textarea></div><div class="wide"><label>Reporting standard</label><textarea name="reporting_standard"><%= methodReporting %></textarea></div><div class="wide"><label>Change summary</label><input name="change_summary" required></div><div class="dco-formbar"><button class="btn btn-primary btn-sm">Approve version <%= methodology.current_version+1 %></button></div></form><% }else{ %><p class="dco-note">Only firm managers can approve methodology versions.</p><% } %></div></section></aside></div><% } %>

  <% if(view==='qa'){ %><div class="dco-grid"><main><section class="dco-panel"><div class="dco-head"><div><h2>Quality review queue</h2><p>Maker–checker decisions, client validation and freeze readiness.</p></div><span class="dco-count"><%= workpapers.filter(w=>['manager_review','client_validation','approved','changes_requested'].includes(w.status)).length %></span></div><div class="dco-table-wrap"><table class="dco-table"><thead><tr><th>Workpaper</th><th>Prepared by</th><th>Reviewer</th><th>Evidence conclusion</th><th>Exceptions</th><th>Status</th><th>Action</th></tr></thead><tbody><% workpapers.filter(w=>['manager_review','client_validation','approved','changes_requested'].includes(w.status)).forEach(w=>{ %><tr><td><a href="/workspaces/<%= ws.id %>/delivery/workpapers/<%= w.id %>"><span class="dco-ref"><%= w.workpaper_ref %></span><br><%= w.title %></a></td><td><%= w.owner_name %></td><td><%= w.reviewer_name||'Unassigned' %></td><td><%= w.evidence_sufficiency.replaceAll('_',' ') %></td><td><%= w.exceptions_count %></td><td><span class="dco-status"><%= w.status.replaceAll('_',' ') %></span></td><td><a class="btn btn-secondary btn-xs" href="/workspaces/<%= ws.id %>/delivery/workpapers/<%= w.id %>">Review</a></td></tr><% }) %></tbody></table></div></section></main><aside class="dco-aside"><section class="dco-panel"><div class="dco-head"><div><h2>QA rules</h2><p>Applied before sign-off</p></div></div><div class="dco-kv"><span>Self-approval</span><b>Prohibited</b></div><div class="dco-kv"><span>Evidence sufficiency</span><b>Required</b></div><div class="dco-kv"><span>Client validation</span><b>When flagged</b></div><div class="dco-kv"><span>Frozen history</span><b>Immutable</b></div><div class="dco-body"><a class="btn btn-secondary btn-sm" style="width:100%;justify-content:center" href="/delivery-portfolio">Firm delivery QA</a></div></section></aside></div><% } %>
</div>
<%- include('partials/footer') %>
