<%- include('partials/header', { title: 'ISO 42001 certification cycle', user, ws, active: 'iso42001-cert-cycle' }) %>

<style>
  .iso42-cycle-event { border-top: 1px solid var(--border); }
  .iso42-cycle-event:first-child { border-top: 0; }
  .iso42-cycle-row { display: grid; grid-template-columns: minmax(0, 1.4fr) 130px 130px 130px minmax(0, 1.2fr) minmax(0, 1fr) auto; gap: 8px; align-items: end; }
  .iso42-finding-form { display: grid; grid-template-columns: 190px minmax(0, 1fr) 150px; gap: 8px; align-items: end; }
  @media (max-width: 1000px) {
    .iso42-cycle-row, .iso42-finding-form { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .iso42-cycle-row > :first-child, .iso42-finding-form .span-all { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .iso42-cycle-row, .iso42-finding-form, .iso42-cycle-add { grid-template-columns: minmax(0, 1fr) !important; }
    .iso42-cycle-add .btn, .iso42-cycle-seed .btn { width: 100%; }
  }
</style>

<%
  const today = new Date().toISOString().slice(0, 10);
  const daysUntil = (d) => (d ? Math.floor((new Date(`${d}T00:00:00Z`).getTime() - Date.now()) / 86400000) : null);
  const upcoming = events.filter(e => !['completed', 'cancelled'].includes(e.status) && e.planned_date && e.planned_date >= today)
    .sort((a, b) => (a.planned_date < b.planned_date ? -1 : 1))[0];
  const cycles = [...new Set(events.map(e => e.cycle_no))].sort((a, b) => a - b);
  const severityLabel = Object.fromEntries(severities.map(s => [s.key, s.label]));
  const severityTag = { major: 'tag-danger', minor: 'tag-warn', observation: 'tag-neutral', opportunity: 'tag-info' };
%>

<div class="page-head">
  <div>
    <h1 class="page-title">ISO 42001 certification cycle</h1>
    <div class="page-subtitle">Stage 1 and Stage 2, surveillance in years one and two, recertification in year three. Record what the certification body finds at each audit and track it to closure with the client.</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin-bottom:18px;">
  <div class="panel kpi"><div class="panel-pad">
    <div class="meta text-sm" style="text-transform:uppercase;letter-spacing:0.05em;">Next audit</div>
    <% if (upcoming) { const days = daysUntil(upcoming.planned_date); %>
      <div style="font-size:18px;font-weight:500;margin-top:4px;"><%= upcoming.label %></div>
      <div class="meta text-lg" style="margin-top:2px;"><%= upcoming.planned_date %> &middot; <strong style="color:<%= days < 30 ? '#b91c1c' : days < 90 ? '#a16207' : 'var(--text)' %>;"><%= days %> day<%= days === 1 ? '' : 's' %></strong> away</div>
    <% } else { %>
      <div class="meta text-lg" style="margin-top:4px;">Nothing planned</div>
    <% } %>
  </div></div>
  <div class="panel kpi"><div class="panel-pad">
    <div class="meta text-sm" style="text-transform:uppercase;letter-spacing:0.05em;">Open certification findings</div>
    <div style="font-size:18px;font-weight:500;margin-top:4px;"><%= openFindings.total %></div>
    <div class="meta text-lg" style="margin-top:2px;"><%= openFindings.major || 0 %> major &middot; <%= openFindings.minor || 0 %> minor &middot; <%= (openFindings.observation || 0) + (openFindings.opportunity || 0) %> other</div>
  </div></div>
</div>

<% if (events.length === 0) { %>
  <div class="panel" style="margin-bottom:18px;">
    <div class="panel-head"><h2>No cycle planned yet</h2></div>
    <div class="panel-pad">
      <div class="text-lg" style="line-height:1.55;margin-bottom:14px;">
        Plan the standard cycle from the target certification date<% if (ws.target_cert_date) { %> (<%= ws.target_cert_date %>)<% } %>: Stage 2 on that date, Stage 1 a month before, surveillance at one and two years, recertification at three. Change the dates as the certification body confirms them.
      </div>
      <form class="iso42-cycle-seed" method="POST" action="/workspaces/<%= ws.id %>/iso42001/cert-cycle/seed" style="display:inline;">
        <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
        <button class="btn btn-primary">Plan the standard cycle</button>
      </form>
    </div>
  </div>
<% } %>

<% cycles.forEach(cycleNo => { const cycleEvents = events.filter(e => e.cycle_no === cycleNo); %>
  <div class="panel" style="margin-bottom:18px;">
    <div class="panel-head">
      <h2>Certification cycle <%= cycleNo %></h2>
      <span class="meta"><%= cycleNo === currentCycle ? 'current' : 'completed cycle' %> &middot; <%= cycleEvents.length %> event<%= cycleEvents.length === 1 ? '' : 's' %></span>
    </div>
    <% cycleEvents.forEach(e => {
         const days = daysUntil(e.planned_date);
         const overdue = e.planned_date && e.planned_date < today && e.status !== 'completed' && !e.actual_date;
    %>
      <div class="iso42-cycle-event panel-pad" id="event-<%= e.id %>">
        <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/cert-cycle/<%= e.id %>/update" class="iso42-cycle-row">
          <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
          <div>
            <div class="text-lg" style="font-weight:500;"><%= e.label %></div>
            <% if (e.isAudit && (e.openMajor || e.openMinor || e.openOther)) { %>
              <div class="meta text-sm"><%= e.openMajor %> major &middot; <%= e.openMinor %> minor &middot; <%= e.openOther %> other open<% if (e.overdue) { %> &middot; <span style="color:#b91c1c;"><%= e.overdue %> past deadline</span><% } %></div>
            <% } %>
          </div>
          <div>
            <label class="label">Planned</label>
            <input type="date" name="planned_date" value="<%= e.planned_date || '' %>" class="input text-base" style="<%= overdue ? 'border-color:#b91c1c;color:#b91c1c;' : '' %>">
            <% if (days != null && e.status !== 'completed' && !e.actual_date) { %><div class="meta text-eyebrow"><%= days < 0 ? Math.abs(days) + 'd overdue' : days + 'd away' %></div><% } %>
          </div>
          <div><label class="label">Took place</label><input type="date" name="actual_date" value="<%= e.actual_date || '' %>" class="input text-base"></div>
          <div>
            <label class="label">Status</label>
            <select name="status" class="select text-base">
              <% statuses.forEach(st => { %><option value="<%= st %>" <%= e.status === st ? 'selected' : '' %>><%= st %></option><% }) %>
            </select>
          </div>
          <div><label class="label">Certification body</label><input type="text" name="certification_body" value="<%= e.certification_body || '' %>" class="input text-base" placeholder="-"></div>
          <div><label class="label">Notes</label><input type="text" name="notes" value="<%= e.notes || '' %>" class="input text-base" placeholder="-"></div>
          <div style="display:flex;gap:4px;">
            <button class="btn btn-secondary btn-xs">Save</button>
            <% if (!e.findings.length) { %>
              <button class="btn btn-ghost btn-xs text-danger" formaction="/workspaces/<%= ws.id %>/iso42001/cert-cycle/<%= e.id %>/delete" formmethod="POST" onclick="return confirm('Remove this event from the cycle?')">×</button>
            <% } %>
          </div>
        </form>

        <% if (e.isAudit) { %>
          <% if (e.findings.length) { %>
            <table class="t" style="margin-top:12px;">
              <thead><tr><th style="width:190px;">Finding</th><th>Requirement and description</th><th style="width:120px;">Closure deadline</th><th style="width:110px;">Status</th></tr></thead>
              <tbody>
                <% e.findings.forEach(f => { %>
                  <tr>
                    <td><span class="tag <%= severityTag[f.severity] || 'tag-neutral' %>"><%= severityLabel[f.severity] || f.severity %></span></td>
                    <td>
                      <a href="/workspaces/<%= ws.id %>/nonconformities/<%= f.id %>" class="link-muted" style="font-weight:500;"><%= f.title %></a>
                      <% if (f.iso_title) { %><div class="meta text-sm"><%= f.iso_title %></div><% } %>
                    </td>
                    <td class="meta" style="<%= f.due_date && f.due_date < today && !['closed','verified'].includes(f.status) ? 'color:#b91c1c;' : '' %>"><%= f.due_date || '-' %></td>
                    <td><span class="status s-<%= ['closed','verified'].includes(f.status) ? 'done' : f.status %>"><%= f.status %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          <% } %>
          <details style="margin-top:10px;">
            <summary class="meta text-sm" style="cursor:pointer;">+ Record a finding from this audit</summary>
            <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/cert-cycle/<%= e.id %>/findings" class="iso42-finding-form" style="margin-top:8px;">
              <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
              <div>
                <label class="label">Grade</label>
                <select name="severity" class="select" required>
                  <option value="">- choose -</option>
                  <% severities.forEach(sv => { %><option value="<%= sv.key %>"><%= sv.label %></option><% }) %>
                </select>
              </div>
              <div>
                <label class="label">Requirement</label>
                <%- include('partials/requirement_select', { groups: requirementGroups, name: 'iso_item_id', blank: '- not tied to one requirement -' }) %>
              </div>
              <div><label class="label">Closure deadline</label><input type="date" name="due_date" class="input"></div>
              <div class="span-all" style="grid-column:1 / -1;"><label class="label">Title <span class="meta">optional</span></label><input type="text" name="title" class="input" maxlength="200" placeholder="Short name for the finding"></div>
              <div class="span-all" style="grid-column:1 / -1;"><label class="label">What the auditor found</label><textarea name="description" class="textarea" rows="3" required placeholder="As the auditor wrote it in the report"></textarea></div>
              <div class="span-all" style="grid-column:1 / -1;"><button class="btn btn-primary btn-xs">Record finding</button></div>
            </form>
          </details>
        <% } %>
      </div>
    <% }) %>
  </div>
<% }) %>

<% if (canStartNextCycle) { %>
  <div class="panel" style="margin-bottom:18px;">
    <div class="panel-pad" style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
      <div class="text-lg">The recertification audit is complete. Plan the next three-year cycle from its date.</div>
      <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/cert-cycle/next">
        <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
        <button class="btn btn-primary btn-xs">Start cycle <%= currentCycle + 1 %></button>
      </form>
    </div>
  </div>
<% } %>

<div class="panel">
  <div class="panel-head"><h2>Add an audit or review</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/iso42001/cert-cycle/add" class="panel-pad iso42-cycle-add" style="display:grid;grid-template-columns:240px 130px minmax(0,1fr) minmax(0,1fr) auto;gap:8px;align-items:end;">
    <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
    <div>
      <label class="label">Audit or review</label>
      <select name="event_key" class="select" required>
        <% eventTypes.forEach(t => { %><option value="<%= t.key %>"><%= t.label %></option><% }) %>
      </select>
    </div>
    <div><label class="label">Planned</label><input type="date" name="planned_date" class="input"></div>
    <div><label class="label">Certification body</label><input type="text" name="certification_body" class="input" placeholder="-"></div>
    <div><label class="label">Notes</label><input type="text" name="notes" class="input" placeholder="e.g. dates confirmed by the auditor"></div>
    <div><button class="btn btn-primary">Add</button></div>
  </form>
</div>

<%- include('partials/footer') %>
