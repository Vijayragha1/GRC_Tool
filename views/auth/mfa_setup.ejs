<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Secure your account · Compliance Sphere</title>
  <link rel="stylesheet" href="/fonts/inter.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
  <style>
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:#fafaf8;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#1a1a1a;padding:36px 20px}.shell{width:100%;max-width:760px;margin:0 auto}.brand{font-size:15px;font-weight:500;margin-bottom:34px}.card{background:#fff;border:1px solid #e2e0d9;border-radius:12px;padding:28px;box-shadow:0 8px 30px rgba(30,30,25,.04)}h1{font-size:25px;font-weight:500;letter-spacing:-.5px;margin:0 0 8px}.sub{font-size:13px;line-height:1.6;color:#66665f;margin:0 0 24px}.setup{display:grid;grid-template-columns:240px 1fr;gap:28px;align-items:start}.qr{border:1px solid #eceae3;border-radius:10px;padding:9px;width:240px;height:240px}.qr img{display:block;width:220px;height:220px}.step{font-size:12px;line-height:1.55;color:#55554f;margin-bottom:17px}.step b{display:block;color:#1a1a1a;font-size:13px;margin-bottom:3px}.secret{font:500 13px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:1px;background:#f5f4ef;border:1px solid #e5e3dc;padding:11px;border-radius:7px;word-break:break-all;margin:7px 0 18px}label{display:block;font-size:12px;font-weight:500;margin-bottom:7px}input[type=text]{width:100%;height:42px;border:1px solid #d8d6cf;border-radius:7px;background:#fff;padding:0 12px;font:500 18px Inter;letter-spacing:4px;text-align:center}button,.button{display:inline-flex;align-items:center;justify-content:center;min-height:40px;border:0;border-radius:7px;background:#1a1a1a;color:#fff;font:500 13px Inter;padding:0 18px;text-decoration:none;cursor:pointer;margin-top:12px}.alert{font-size:12.5px;padding:10px 12px;background:#fbeaea;color:#7a1010;border:1px solid #ecc6c6;border-radius:7px;margin-bottom:16px}.success{padding:18px;background:#eff7f1;border:1px solid #c9e2cf;border-radius:9px;margin-bottom:20px}.success h2{font-size:17px;font-weight:500;margin:0 0 6px}.codes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:16px 0 6px}.code{font:500 13px ui-monospace,SFMono-Regular,Menlo,monospace;background:#fff;border:1px solid #d9e5dc;border-radius:6px;padding:9px;text-align:center}.notice{font-size:12px;line-height:1.55;color:#5d625e}.enabled{display:flex;gap:12px;align-items:flex-start;background:#eff7f1;border:1px solid #c9e2cf;border-radius:9px;padding:16px;margin:20px 0}.tick{width:24px;height:24px;border-radius:50%;background:#176b38;color:#fff;display:grid;place-items:center;font-size:14px;flex:0 0 auto}@media(max-width:640px){.card{padding:21px}.setup{grid-template-columns:1fr}.qr{margin:auto}.codes{grid-template-columns:1fr}}
  </style>
</head>
<body><main class="shell">
  <div class="brand">◎ Compliance Sphere</div>
  <section class="card">
    <% if (completed) { %>
      <div class="success"><h2>Multi-factor authentication is active</h2><div class="notice">Save these recovery codes now. Each code works once and they cannot be shown again.</div></div>
      <div class="codes"><% recoveryCodes.forEach(code => { %><div class="code"><%= code %></div><% }) %></div>
      <p class="notice">Store the codes in your password manager or another protected location—not beside your password.</p>
      <a class="button" href="<%= nextUrl %>">Continue securely</a>
    <% } else if (enabled) { %>
      <h1>Your account is protected</h1>
      <div class="enabled"><span class="tick">✓</span><div><strong>Multi-factor authentication is enabled</strong><div class="notice">A current authenticator or unused recovery code is required after every password sign-in.</div></div></div>
      <a class="button" href="<%= nextUrl %>">Continue</a>
    <% } else { %>
      <h1>Secure your account</h1>
      <p class="sub">Client evidence and assurance decisions are sensitive. Add Compliance Sphere to any TOTP authenticator before continuing.</p>
      <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
      <div class="setup">
        <div class="qr"><img src="<%= qrDataUrl %>" alt="Authenticator setup QR code"></div>
        <div>
          <div class="step"><b>1. Scan the QR code</b>Use Microsoft Authenticator, Google Authenticator, 1Password, Authy or another TOTP-compatible app.</div>
          <div class="step"><b>Can’t scan it?</b>Enter this setup key manually:</div>
          <div class="secret"><%= secret %></div>
          <form method="POST" action="/security/mfa/setup">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="next" value="<%= nextUrl %>">
            <label for="code">2. Enter the current six-digit code</label>
            <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required autofocus>
            <button type="submit">Enable MFA</button>
          </form>
        </div>
      </div>
    <% } %>
  </section>
</main></body></html>
