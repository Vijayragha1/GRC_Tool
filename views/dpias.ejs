<%- include('partials/header', { title: 'DPIAs', user, ws, active: 'risks' }) %>

<div class="page-head">
  <div><h1 class="page-title">Data Protection Impact Assessments</h1>
    <div class="page-subtitle">GDPR Art. 35 / ISO 27701: structured assessment of high-risk processing of personal data.</div></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/dpias" style="display:flex;gap:6px;">
    <input class="input" name="title" required placeholder="Processing name (e.g., Recruitment ATS)" style="width:280px">
    <button class="btn btn-primary btn-xs">Start DPIA</button>
  </form>
</div>

<div class="panel"><table class="t">
  <thead><tr><th>Title</th><th>Status</th><th>Outcome</th><th>Residual risk</th><th>Approver</th><th>Approved</th><th>Created</th></tr></thead>
  <tbody>
    <% if (!list.length) { %><tr><td colspan="7" class="t-empty">No DPIAs yet.</td></tr><% } %>
    <% list.forEach(d => { %>
      <tr style="cursor:pointer" onclick="location='/workspaces/<%= ws.id %>/dpias/<%= d.id %>'">
        <td><strong><%= d.title %></strong></td>
        <td><span class="tag <%= d.status === 'approved' ? 'tag-success' : d.status === 'review' ? 'tag-warn' : 'tag-neutral' %>"><%= d.status %></span></td>
        <td class="meta"><%= d.outcome || '—' %></td>
        <td class="meta"><%= d.residual_risk_level || '—' %></td>
        <td class="meta"><%= d.approver || '—' %></td>
        <td class="meta"><%= d.approved_at || '—' %></td>
        <td class="meta"><%= d.created_at %></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>

<%- include('partials/footer') %>
