<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Security verification · Compliance Sphere</title>
  <link rel="stylesheet" href="/fonts/inter.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
  <style>
    *{box-sizing:border-box}body{margin:0;min-height:100vh;background:#fafaf8;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#1a1a1a;display:grid;place-items:center;padding:32px}.shell{width:100%;max-width:390px}.brand{font-size:15px;font-weight:500;margin-bottom:36px;display:flex;gap:9px;align-items:center}.mark{width:22px;height:22px;border:1.5px solid #1a1a1a;border-radius:50%;display:grid;place-items:center}.mark:after{content:'';width:7px;height:7px;background:#1a1a1a;border-radius:50%}h1{font-size:24px;font-weight:500;letter-spacing:-.5px;margin:0 0 8px}.sub{font-size:13px;line-height:1.55;color:#6b6b66;margin:0 0 24px}.alert{font-size:12.5px;line-height:1.45;padding:10px 12px;background:#fbeaea;color:#7a1010;border:1px solid #ecc6c6;border-radius:7px;margin-bottom:16px}label{display:block;font-size:12px;font-weight:500;margin-bottom:7px}input{width:100%;height:46px;border:1px solid #d8d6cf;border-radius:7px;background:#fff;padding:0 13px;font:500 20px/1 Inter;letter-spacing:4px;text-align:center;outline:none}input:focus{border-color:#1a1a1a;box-shadow:0 0 0 3px rgba(26,26,26,.08)}button{width:100%;height:42px;border:0;border-radius:7px;background:#1a1a1a;color:#fff;font:500 13px Inter;margin-top:14px;cursor:pointer}.help{font-size:11.5px;color:#77776f;line-height:1.55;margin-top:12px;text-align:center}
  </style>
</head>
<body><main class="shell">
  <div class="brand"><span class="mark"></span>Compliance Sphere</div>
  <h1>Verify it’s you</h1>
  <p class="sub">Enter the current code for <strong><%= email %></strong>. You can also use one unused recovery code.</p>
  <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
  <form method="POST" action="/mfa/verify">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label for="code">Authenticator or recovery code</label>
    <input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="19" required autofocus aria-describedby="code-help">
    <button type="submit">Verify and continue</button>
    <p class="help" id="code-help">Authenticator codes contain six digits. Recovery codes may include hyphens.</p>
  </form>
</main></body></html>
