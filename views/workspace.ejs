<%- include('partials/header', { title: ws.client_name, user, ws, active: 'overview' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">
      <%= ws.client_name %>
      <% if (ws.scope_confirmed_at) { %>
        <span title="Scope confirmed on <%= ws.scope_confirmed_at %>" style="display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight: 500;letter-spacing:0.04em;text-transform:uppercase;color:#15803d;background:rgba(22,128,61,0.08);padding:3px 8px;border-radius:12px;vertical-align:middle;margin-left:8px;">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          Scope confirmed
        </span>
      <% } %>
    </h1>
    <div class="page-subtitle">
      <%= ws.industry || 'Industry not set' %>
      <% if (ws.target_cert_date) { %> · target certification <%= ws.target_cert_date %><% } %>
      · stage: <%= (typeof derivedStage !== 'undefined' && derivedStage) ? derivedStage.label : (ws.stage || 'new').replace(/_/g, ' ') %>
    </div>
  </div>
  <div style="display:flex;gap:8px;align-items:stretch;">
    <a href="/workspaces/<%= ws.id %>/audit-pack" class="btn btn-primary" style="display:inline-flex;align-items:center;gap:10px;padding:10px 18px;font-size:13.5px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      <span>Audit pack</span>
      <span class="text-eyebrow" style="font-weight:500;opacity:0.78;background:rgba(255,255,255,0.14);padding:2px 7px;border-radius:999px;letter-spacing:0.02em;">.zip</span>
    </a>
    <details style="position:relative;">
      <summary class="btn btn-secondary text-lg" style="display:inline-flex;align-items:center;gap:6px;padding:10px 14px;cursor:pointer;height:100%;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        More exports
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div style="position:absolute;right:0;top:calc(100% + 4px);background:var(--bg);border:1px solid var(--border);border-radius:8px;box-shadow:var(--shadow-lg);min-width:180px;z-index:50;overflow:hidden;">
        <a class="text-lg" href="/workspaces/<%= ws.id %>/export/soa.csv" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;text-decoration:none;border-bottom:1px solid var(--border);" onmouseover="this.style.background='var(--bg-subtle)'" onmouseout="this.style.background=''">SoA <span class="meta text-eyebrow">.csv</span></a>
        <a class="text-lg" href="/workspaces/<%= ws.id %>/export/risks.csv" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;text-decoration:none;border-bottom:1px solid var(--border);" onmouseover="this.style.background='var(--bg-subtle)'" onmouseout="this.style.background=''">Risks <span class="meta text-eyebrow">.csv</span></a>
        <a class="text-lg" href="/workspaces/<%= ws.id %>/export/assets.csv" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;text-decoration:none;border-bottom:1px solid var(--border);" onmouseover="this.style.background='var(--bg-subtle)'" onmouseout="this.style.background=''">Assets <span class="meta text-eyebrow">.csv</span></a>
        <a class="text-lg" href="/workspaces/<%= ws.id %>/deliverables" style="display:flex;justify-content:space-between;align-items:center;padding:10px 14px;text-decoration:none;background:var(--bg-subtle);" onmouseover="this.style.background='var(--bg-muted)'" onmouseout="this.style.background='var(--bg-subtle)'">All deliverables <span class="meta text-eyebrow">+ report templates</span></a>
      </div>
    </details>
  </div>
</div>

<%# Setup-incomplete banner. Shown when intake has been started but
    fewer than 8 questions are answered - the overview's readiness +
    summary numbers won't make sense until basic scoping facts are in.
    Drops away on its own once the setup gets enough answers. %>
<% if (typeof setupIncomplete !== 'undefined' && setupIncomplete) { %>
  <div class="panel" style="margin-bottom:18px;background:rgba(180,83,9,0.06);display:grid;grid-template-columns:42px 1fr auto;gap:14px;align-items:center;padding:14px 18px;">
    <div style="width:42px;height:42px;border-radius:10px;background:#b45309;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"/></svg>
    </div>
    <div style="min-width:0;">
      <div class="text-xs" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;color:#9a3412;margin-bottom:2px;">Client setup is incomplete</div>
      <div class="text-ink" style="font-size:14px;font-weight:500;letter-spacing:-0.005em;">Only <%= intakeAnswered %> of 25 scoping questions answered. The numbers below will be more meaningful once basic scope, headcount, and crown-jewel assets are captured.</div>
    </div>
    <a href="/workspaces/<%= ws.id %>/intake" class="btn btn-secondary" style="white-space:nowrap;">Continue setup →</a>
  </div>
<% } %>

<% if (typeof truth !== 'undefined' && (truth.counts.critical > 0 || truth.counts.high > 0)) { %>
  <div class="panel" style="margin-bottom:18px;border-left:4px solid <%= truth.counts.critical ? '#b42318' : '#b54708' %>;display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;padding:14px 18px;">
    <div>
      <div class="text-xs" style="font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:<%= truth.counts.critical ? '#b42318' : '#b54708' %>;margin-bottom:3px;">Authoritative status · <%= truth.verdict.label %></div>
      <div style="font-size:13px;color:var(--text-secondary);line-height:1.45"><strong style="color:var(--ink)"><%= truth.quality.score %>/100 decision-data quality.</strong> <%= truth.counts.critical %> critical conflict<%= truth.counts.critical===1?'':'s' %> and <%= truth.counts.high %> high-priority gap<%= truth.counts.high===1?'':'s' %> must be resolved before this workspace can support an unqualified client or auditor conclusion.</div>
    </div>
    <a class="btn btn-secondary" href="/workspaces/<%= ws.id %>/data-quality">Open data quality →</a>
  </div>
<% } %>

<!-- Next-best-action banner. Reads engagement state and points at the single
     highest-leverage next step. Replaces the "where do I go from here?" gap
     a new consultant lands on the client overview with. -->
<% if (typeof nextStep !== 'undefined' && nextStep) { %>
  <div class="panel" style="margin-bottom:18px;background:var(--bg-subtle);display:grid;grid-template-columns:42px 1fr auto;gap:14px;align-items:center;padding:18px 22px;">
    <div style="width:42px;height:42px;border-radius:10px;background:var(--accent);display:flex;align-items:center;justify-content:center;color:var(--accent-contrast);flex-shrink:0;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"/></svg>
    </div>
    <div style="min-width:0;">
      <div class="text-xs" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;color:var(--accent-deep);margin-bottom:2px;">Next step</div>
      <div class="text-ink" style="font-size:15px;font-weight: 500;letter-spacing:-0.01em;margin-bottom:4px;"><%= nextStep.title %></div>
      <div class="meta text-md" style="line-height:1.5;"><%= nextStep.why %></div>
    </div>
    <a href="<%= nextStep.href %>" class="btn btn-primary" style="white-space:nowrap;"><%= nextStep.cta %> →</a>
  </div>
<% } %>

<!-- Engagement status - "terminal" layout. Hero readout + sparkline of
     readiness trend across the top, dense 6-cell metric strip below.
     Higher information density than card grids; chart-led rather than
     number-led. Reuses the /api/workspaces/:wsId/trends endpoint that
     the 30-day-trends panel further down already calls. -->
<%
  const highSev = readiness.flags.filter(f => f.severity === 'high').length;
  const dtt = readiness.daysToTarget;
  const targetDate = ws.target_cert_date;
  // Pick the indicator colour for the hero number. Same thresholds the
  // old kpi-good/warn/bad classes used, but applied to the number
  // itself rather than as a left-border accent.
  const heroColor = readiness.stage1Ready ? '#15803d' : '#b91c1c';
  const ncColor = ncOpen > 0 ? '#b91c1c' : '#15803d';
  const recPct = readiness.records.total ? Math.round((readiness.records.found / readiness.records.total) * 100) : 0;
%>

<!-- HERO: readiness number + trend sparkline + status sidebar -->
<div style="border:1px solid var(--border);background:var(--bg);margin-bottom:10px;display:grid;grid-template-columns:240px 1fr 220px;align-items:stretch;">
  <!-- Left: big number -->
  <a href="/workspaces/<%= ws.id %>/readiness" style="padding:18px 22px;text-decoration:none;color:inherit;border-right:1px solid var(--border);">
    <div style="font-size:10px;font-weight: 500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:8px;">Stage 1 maturity</div>
    <div style="display:flex;align-items:baseline;gap:4px;line-height:0.95;font-variant-numeric:tabular-nums;">
      <span style="font-size:44px;font-weight: 500;letter-spacing:-0.02em;color:<%= heroColor %>;"><%= readiness.stage1 %></span>
      <span style="font-size:20px;font-weight:400;color:var(--text-tertiary);">%</span>
    </div>
    <div class="num" style="margin-top:8px;font-size:11px;color:<%= readiness.stage1Ready ? '#15803d' : '#b91c1c' %>;letter-spacing:0.02em;"><%= readiness.stage1Ready ? 'Hard gates passed' : `${readiness.stage1GatePassed}/${readiness.stage1GateTotal} hard gates passed` %></div>
  </a>
  <!-- Middle: gap assessment + implementation breakdown. Was a misleading
       30-day "trajectory" sparkline (cumulative count of Implemented
       controls touched in last 30d - looked like a readiness trend but
       wasn't). Replaced with the two questions the overview should
       answer: (1) where are we in the gap assessment, (2) how does the
       implementation status break down by theme. -->
  <%
    const totalItems = stateRows => 0; // placeholder, not used
    const totalControls = themes.org.total + themes.people.total + themes.physical.total + themes.tech.total;
    const totalClauses = (breakdown.clauses['Implemented'] || 0) + (breakdown.clauses['Partially Implemented'] || 0) +
                         (breakdown.clauses['Work In Progress'] || 0) + (breakdown.clauses['Not Implemented'] || 0) +
                         (breakdown.clauses['Not Applicable'] || 0) + (breakdown.clauses['Not Assessed'] || 0);
    const totalAll = totalClauses + totalControls;
    const sum = key => (breakdown.clauses[key] || 0) + (breakdown.annex[key] || 0);
    const counts = {
      impl: sum('Implemented'),
      partial: sum('Partially Implemented'),
      wip: sum('Work In Progress'),
      notImpl: sum('Not Implemented'),
      na: sum('Not Applicable'),
      notAss: sum('Not Assessed')
    };
    const assessed = totalAll - counts.notAss;
    const assessedPct = totalAll ? Math.round((assessed / totalAll) * 100) : 0;
    const passLabel = activePass
      ? (activePass.label || `Pass ${activePass.pass_number}`)
      : 'No active pass';
    // Stacked-bar segments (skip zero-width to avoid 0.5px slivers).
    const seg = [
      { v: counts.impl,    color: '#15803d', label: 'Implemented' },
      { v: counts.partial, color: '#b45309', label: 'Partially' },
      { v: counts.wip,     color: '#0891b2', label: 'In progress' },
      { v: counts.notImpl, color: '#b91c1c', label: 'Not implemented' },
      { v: counts.na,      color: '#8a8a87', label: 'Not applicable' },
      { v: counts.notAss,  color: '#e5e3dc', label: 'Not assessed' }
    ].filter(s => s.v > 0);
  %>
  <div style="padding:14px 18px;display:flex;flex-direction:column;gap:12px;">
    <%
      const implPct = totalAll ? Math.round(counts.impl / totalAll * 100) : 0;
      const implMeta = [];
      if (counts.partial > 0) implMeta.push(`<span style="color:#b45309;">${counts.partial}</span> partial`);
      if (counts.notImpl > 0) implMeta.push(`<span style="color:#b91c1c;">${counts.notImpl}</span> not impl`);
    %>

    <!-- BLOCK 1: Gap assessment - summary + bar + per-section breakdown -->
    <div>
      <a href="/workspaces/<%= ws.id %>/controls" style="text-decoration:none;color:inherit;display:block;">
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;">
          <div style="font-size:10px;font-weight:500;letter-spacing:0.6px;text-transform:uppercase;color:var(--text-tertiary);">Gap assessment</div>
          <div class="num" style="font-size:11px;color:var(--text-tertiary);"><span style="color:var(--text);font-weight:500;"><%= assessed %></span> of <%= totalAll %> assessed · <%= assessedPct %>%<% if (activePass) { %> · <%= passLabel %><% } %></div>
        </div>
        <div style="display:flex;height:8px;border-radius:2px;overflow:hidden;background:var(--bg-muted);" title="<%= assessed %> assessed · <%= counts.notAss %> not assessed">
          <% if (assessed > 0) { %><span style="background:#1a1a1a;width:<%= totalAll ? (assessed / totalAll * 100).toFixed(2) : 0 %>%;"></span><% } %>
        </div>
      </a>
      <div style="display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:6px;font-size:10px;color:var(--text-tertiary);">
        <span style="display:inline-flex;align-items:center;gap:5px;">
          <span style="width:8px;height:8px;border-radius:2px;background:#1a1a1a;display:inline-block;flex-shrink:0;"></span>
          Assessed <span class="num" style="color:var(--text);font-weight:500;"><%= assessed %></span>
        </span>
        <% if (counts.notAss > 0) { %>
          <span style="display:inline-flex;align-items:center;gap:5px;">
            <span style="width:8px;height:8px;border-radius:2px;background:#e5e3dc;border:1px solid var(--border);display:inline-block;flex-shrink:0;"></span>
            Not assessed <span class="num" style="color:var(--text);font-weight:500;"><%= counts.notAss %></span>
          </span>
        <% } %>
      </div>
      <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:6px;">
        <% Object.values(themes).forEach(t => {
             const pct = t.total ? Math.round(t.assessed / t.total * 100) : 0;
        %>
          <div>
            <div style="font-size:9.5px;color:var(--text-tertiary);margin-bottom:2px;letter-spacing:0.2px;"><%= t.label %></div>
            <div class="num" style="font-size:11.5px;color:var(--text);font-weight:500;"><%= t.assessed %><span style="color:var(--text-tertiary);font-weight:400;">/<%= t.total %></span></div>
            <div style="height:3px;background:var(--bg-muted);border-radius:1px;margin-top:3px;overflow:hidden;">
              <div style="height:100%;background:#1a1a1a;width:<%= pct %>%;"></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- BLOCK 2: Implementation - summary + stacked bar + per-section breakdown -->
    <div>
      <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;">
        <div style="font-size:10px;font-weight:500;letter-spacing:0.6px;text-transform:uppercase;color:var(--text-tertiary);">Implementation</div>
        <div class="num" style="font-size:11px;color:var(--text-tertiary);"><span style="color:var(--text);font-weight:500;"><%= counts.impl %></span> of <%= totalAll %> implemented · <%= implPct %>%<% if (implMeta.length) { %> · <%- implMeta.join(' · ') %><% } %></div>
      </div>
      <div style="display:flex;height:8px;border-radius:2px;overflow:hidden;background:var(--bg-muted);">
        <% seg.forEach(s => { %>
          <span title="<%= s.label %>: <%= s.v %>" style="background:<%= s.color %>;width:<%= totalAll ? (s.v / totalAll * 100).toFixed(2) : 0 %>%;"></span>
        <% }) %>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:4px 12px;margin-top:6px;font-size:10px;color:var(--text-tertiary);">
        <% seg.forEach(s => { %>
          <span style="display:inline-flex;align-items:center;gap:5px;">
            <span style="width:8px;height:8px;border-radius:2px;background:<%= s.color %>;display:inline-block;flex-shrink:0;"></span>
            <%= s.label %> <span class="num" style="color:var(--text);font-weight:500;"><%= s.v %></span>
          </span>
        <% }) %>
      </div>
      <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:6px;">
        <% Object.values(themes).forEach(t => {
             const pct = t.total ? Math.round(t.implemented / t.total * 100) : 0;
             const col = pct >= 80 ? '#15803d' : pct >= 50 ? '#b45309' : pct > 0 ? '#b91c1c' : 'var(--text-tertiary)';
        %>
          <div>
            <div style="font-size:9.5px;color:var(--text-tertiary);margin-bottom:2px;letter-spacing:0.2px;"><%= t.label %></div>
            <div class="num" style="font-size:11.5px;color:var(--text);font-weight:500;"><%= t.implemented %><span style="color:var(--text-tertiary);font-weight:400;">/<%= t.total %></span></div>
            <div style="height:3px;background:var(--bg-muted);border-radius:1px;margin-top:3px;overflow:hidden;">
              <div style="height:100%;background:<%= col %>;width:<%= pct %>%;"></div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
  <!-- Right: status sidebar -->
  <div style="padding:14px 18px;border-left:1px solid var(--border);display:flex;flex-direction:column;justify-content:space-between;font-family:'SF Mono','Menlo','Consolas',monospace;font-size:11px;">
    <div>
      <div style="display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dashed var(--border);">
        <span style="color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.05em;">Target</span>
        <span style="color:var(--text);font-weight: 500;"><%= targetDate || '—' %></span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dashed var(--border);">
        <span style="color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.05em;">Days left</span>
        <span style="color:<%= dtt !== null && dtt < 90 ? '#b45309' : 'var(--text)' %>;font-weight: 500;"><%= dtt !== null ? dtt : '—' %></span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px dashed var(--border);">
        <span style="color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.05em;">Stage 2</span>
        <span style="color:var(--text);font-weight: 500;"><%= readiness.stage2 %>%</span>
      </div>
      <div style="display:flex;justify-content:space-between;padding:5px 0;">
        <span style="color:var(--text-tertiary);text-transform:uppercase;letter-spacing:0.05em;">High-sev</span>
        <span style="color:<%= highSev > 0 ? '#b91c1c' : '#15803d' %>;font-weight: 500;"><%= highSev %><% if (highSev > 0) { %> ●<% } %></span>
      </div>
    </div>
  </div>
</div>

<!-- METRIC STRIP: 6 dense cells, each with label + number + mini-bar/sparkline -->
<div style="display:grid;grid-template-columns:repeat(6,1fr);border:1px solid var(--border);background:var(--bg);margin-bottom:24px;">
  <!-- Mandatory docs - progress fill (no historical sparkline available) -->
  <a href="/workspaces/<%= ws.id %>/documents" style="padding:12px 14px;border-right:1px solid var(--border);text-decoration:none;color:inherit;">
    <div style="font-size:9.5px;font-weight: 500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:6px;">Mandatory docs</div>
    <div class="num" style="font-size:22px;font-weight: 500;letter-spacing:-0.01em;color:var(--text);font-family:'SF Mono','Menlo','Consolas',monospace;"><%= readiness.records.found %><span style="color:var(--text-tertiary);font-weight:400;">/<%= readiness.records.total %></span></div>
    <div style="margin-top:8px;height:4px;background:var(--bg-muted);border-radius:0;overflow:hidden;">
      <div style="height:100%;width:<%= recPct %>%;background:<%= recPct >= 80 ? '#15803d' : recPct >= 50 ? '#b45309' : '#b91c1c' %>;"></div>
    </div>
  </a>
  <!-- Controls assessed - progress fill -->
  <a href="/workspaces/<%= ws.id %>/controls" style="padding:12px 14px;border-right:1px solid var(--border);text-decoration:none;color:inherit;">
    <div style="font-size:9.5px;font-weight: 500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:6px;">Assessed</div>
    <div class="num" style="font-size:22px;font-weight: 500;letter-spacing:-0.01em;color:var(--text);font-family:'SF Mono','Menlo','Consolas',monospace;"><%= progress.assessed %><span style="color:var(--text-tertiary);font-weight:400;">/<%= progress.total %></span></div>
    <div style="margin-top:8px;height:4px;background:var(--bg-muted);border-radius:0;overflow:hidden;">
      <div style="height:100%;width:<%= progress.percent %>%;background:<%= progress.percent >= 80 ? '#15803d' : progress.percent >= 50 ? '#b45309' : '#b91c1c' %>;"></div>
    </div>
  </a>
  <!-- Assets - count + sparkline (no historical data, blank track) -->
  <a href="/workspaces/<%= ws.id %>/assets" style="padding:12px 14px;border-right:1px solid var(--border);text-decoration:none;color:inherit;">
    <div style="font-size:9.5px;font-weight: 500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:6px;">Assets</div>
    <div class="num" style="font-size:22px;font-weight: 500;letter-spacing:-0.01em;color:var(--text);font-family:'SF Mono','Menlo','Consolas',monospace;"><%= assetCount %></div>
    <div style="margin-top:8px;font-size:10px;color:var(--text-tertiary);font-family:'SF Mono','Menlo','Consolas',monospace;">in scope</div>
  </a>
  <!-- Risks - count + 30d sparkline (created) -->
  <a href="/workspaces/<%= ws.id %>/risks" style="padding:12px 14px;border-right:1px solid var(--border);text-decoration:none;color:inherit;">
    <div style="font-size:9.5px;font-weight: 500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:6px;">Risks</div>
    <div class="num" style="font-size:22px;font-weight: 500;letter-spacing:-0.01em;color:var(--text);font-family:'SF Mono','Menlo','Consolas',monospace;"><%= riskCount %></div>
    <div id="stripSparkRisks" style="margin-top:6px;height:18px;"></div>
  </a>
  <!-- Audits - count -->
  <a href="/workspaces/<%= ws.id %>/audits" style="padding:12px 14px;border-right:1px solid var(--border);text-decoration:none;color:inherit;">
    <div style="font-size:9.5px;font-weight: 500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:6px;">Internal audits</div>
    <div class="num" style="font-size:22px;font-weight: 500;letter-spacing:-0.01em;color:var(--text);font-family:'SF Mono','Menlo','Consolas',monospace;"><%= auditCount %></div>
    <div style="margin-top:8px;font-size:10px;color:var(--text-tertiary);font-family:'SF Mono','Menlo','Consolas',monospace;">conducted</div>
  </a>
  <!-- Open NCs - count + 30d sparkline (opened) + status dot -->
  <a href="/workspaces/<%= ws.id %>/nonconformities" style="padding:12px 14px;text-decoration:none;color:inherit;">
    <div style="font-size:9.5px;font-weight: 500;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:6px;">Open NCs</div>
    <div class="num" style="font-size:22px;font-weight: 500;letter-spacing:-0.01em;color:<%= ncColor %>;font-family:'SF Mono','Menlo','Consolas',monospace;display:flex;align-items:center;gap:8px;">
      <%= ncOpen %>
      <% if (ncOpen > 0) { %><span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#b91c1c;"></span><% } %>
    </div>
    <div id="stripSparkNCs" style="margin-top:6px;height:18px;"></div>
  </a>
</div>

<script>
// Top hero sparkline + bottom strip mini-sparklines. Reuses the same
// /api/workspaces/:wsId/trends endpoint as the existing 30-day trends
// panel further down the page - one fetch, multiple consumers.
fetch('/api/workspaces/<%= ws.id %>/trends').then(r => r.json()).then(data => {
  // Cumulative "controls implemented" curve - approximates a readiness
  // trajectory without needing a dedicated server-side computation.
  // The hero shows the cumulative path; strip mini-sparks show raw
  // daily counts (intentionally noisier - that's the point of the
  // weekly cadence visualisation).
  const cumulative = (() => {
    let acc = 0;
    return data.controls.map(d => ({ d: d.d, c: (acc += d.c) }));
  })();
  const drawArea = (id, series, color, opts) => {
    const el = document.getElementById(id);
    if (!el) return;
    const w = el.clientWidth || 200;
    const h = el.clientHeight || 48;
    const max = Math.max(1, ...series.map(d => d.c));
    const min = Math.min(...series.map(d => d.c));
    const range = Math.max(1, max - min);
    const step = w / Math.max(1, series.length - 1);
    const padding = (opts && opts.padding) || 2;
    const path = series.map((d, i) =>
      `${i===0?'M':'L'}${(i*step).toFixed(1)},${(h - padding - ((d.c - min)/range)*(h - padding*2)).toFixed(1)}`
    ).join(' ');
    el.innerHTML = `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" style="overflow:visible;display:block;">
      <path d="${path} L${w},${h} L0,${h} Z" fill="${color}" opacity="0.10"/>
      <path d="${path}" fill="none" stroke="${color}" stroke-width="${(opts && opts.strokeWidth) || 1.5}" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`;
  };
  // Bar-style mini-sparkline for the strip (terminal aesthetic - bars
  // not line, since we're showing discrete daily counts at small size).
  const drawBars = (id, series, color) => {
    const el = document.getElementById(id);
    if (!el) return;
    const w = el.clientWidth || 100;
    const h = el.clientHeight || 18;
    const max = Math.max(1, ...series.map(d => d.c));
    const barW = w / series.length;
    const bars = series.map((d, i) => {
      const barH = (d.c / max) * h;
      const y = h - barH;
      return `<rect x="${(i*barW).toFixed(1)}" y="${y.toFixed(1)}" width="${Math.max(1, barW-1).toFixed(1)}" height="${barH.toFixed(1)}" fill="${color}" opacity="${d.c > 0 ? 0.85 : 0.15}"/>`;
    }).join('');
    el.innerHTML = `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" style="overflow:visible;display:block;">${bars}</svg>`;
  };

  drawArea('heroSpark', cumulative, 'var(--accent)', { strokeWidth: 2, padding: 4 });
  drawBars('stripSparkRisks', data.risks, '#71717a');
  drawBars('stripSparkNCs', data.ncs_open, '#b91c1c');

  // Hero delta - compare last 7 days vs prior 7 days of cumulative
  const tail = cumulative.slice(-7).reduce((s,d) => s + d.c, 0);
  const prev = cumulative.slice(-14, -7).reduce((s,d) => s + d.c, 0);
  const delta = tail - prev;
  const el = document.getElementById('heroDelta');
  if (el && cumulative.some(d => d.c > 0)) {
    const arrow = delta > 0 ? '▲' : delta < 0 ? '▼' : '◆';
    const color = delta > 0 ? '#15803d' : delta < 0 ? '#b91c1c' : 'var(--text-tertiary)';
    el.innerHTML = `<span style="color:${color};font-weight: 500;">${arrow}</span> ${Math.abs(delta)} controls past 7d`;
  }
});
</script>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
  <div class="panel">
    <div class="panel-head"><h2>Top open risks</h2><a href="/workspaces/<%= ws.id %>/risks" class="link-muted text-base">View all →</a></div>
    <% if (openRisks.length === 0) { %>
      <div class="t-empty">No open risks yet.</div>
    <% } else { %>
      <div class="divide-row">
        <% openRisks.forEach(r => { %>
          <a href="/workspaces/<%= ws.id %>/risks/<%= r.id %>" class="link-muted" style="display:flex;align-items:center;justify-content:space-between;padding:10px 16px;">
            <span class="text-lg"><%= r.title %></span>
            <span class="tag <%= (r.likelihood * r.impact) >= 15 ? 'tag-danger' : (r.likelihood * r.impact) >= 8 ? 'tag-warn' : 'tag-success' %> num">L<%= r.likelihood %>·I<%= r.impact %> = <%= r.likelihood*r.impact %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="panel">
    <div class="panel-head"><h2>Open tasks</h2><a href="/workspaces/<%= ws.id %>/tasks" class="link-muted text-base">View all →</a></div>
