<%- include('partials/header', { title: 'CSF portal', user, ws, active: 'csf' }) %>

<div class="page-head">
  <div>
    <div style="display:flex;align-items:center;gap:10px;">
      <% if (user.user_type === 'client') { %>
        <a href="/workspaces/<%= ws.id %>/client-portal" class="meta text-base" style="text-decoration:none;">&larr; back to your engagement</a>
      <% } else { %>
        <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>" class="meta text-base" style="text-decoration:none;">&larr; back to engagement</a>
      <% } %>
    </div>
    <h1 class="page-title" style="margin-top:6px;"><%= engagement.name %></h1>
    <% if (currentVersion) { %>
      <div class="page-subtitle">Client portal &middot; v<%= currentVersion.version_number %> &middot; published <%= currentVersion.published_at %></div>
    <% } else { %>
      <div class="page-subtitle">Client portal</div>
    <% } %>
  </div>
  <% if (currentVersion) { %>
    <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/exports/report.pdf?vid=<%= currentVersion.id %>" class="btn btn-primary btn-xs">Download v<%= currentVersion.version_number %> PDF &darr;</a>
  <% } %>
</div>

<% if (validationRows && validationRows.length) { %><div class="panel" style="margin-bottom:14px;"><div class="panel-head"><h2>Information waiting for your confirmation</h2><span class="tag"><%= validationRows.length %></span></div><div class="divide-row"><% validationRows.forEach(a => { %><div style="padding:14px;"><div class="csf-client-validation-row" style="display:flex;gap:10px;align-items:start;"><div style="flex:1;"><strong><%= a.code %></strong><div class="text-md" style="margin-top:3px;"><%= a.description %></div><% if (a.current_profile_statement) { %><p class="text-md"><strong>Current position:</strong> <%= a.current_profile_statement %></p><% } %><% if (a.business_impact) { %><p class="text-md"><strong>Business impact:</strong> <%= a.business_impact %></p><% } %></div>
      <form class="csf-client-validation-form" method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/portal/validate/<%= a.id %>" style="width:280px;display:grid;gap:7px;"><textarea class="textarea text-sm" name="note" rows="3" placeholder="Add a note when requesting changes"></textarea><button class="btn btn-primary btn-xs" name="decision" value="validated">Confirm information</button><button class="btn btn-secondary btn-xs" name="decision" value="changes_requested">Request changes</button></form></div></div><% }) %></div></div><% } %>

<% if (!currentVersion) { %>
  <div class="panel">
    <div class="panel-pad">
      <div class="empty-state">
        <div class="empty-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg></div>
        <div class="empty-title">Not published yet</div>
        <div class="empty-sub"><%= validationRows && validationRows.length ? 'Complete the information checks above. Your report will appear here when it is ready.' : 'Your engagement team will share this assessment here when it is ready.' %></div>
      </div>
    </div>
  </div>
<% } else { %>

  <% function tierColor(t) { if (!t) return 'var(--text-tertiary)'; return { 1:'#b91c1c', 2:'#a16207', 3:'#1d4ed8', 4:'#15803d' }[t.tier] || 'var(--text)'; } %>
  <% const sevColor = { 'CRITICAL':'#b91c1c', 'HIGH':'#dc2626', 'MEDIUM':'#a16207', 'LOW':'var(--text-tertiary)' }; %>

  <!-- Headline -->
  <div class="panel" style="margin-bottom:14px;">
    <div class="panel-pad" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px;">
      <div>
        <div class="kpi-num" style="color:<%= tierColor(rollup.overall.tier) %>;"><%= rollup.overall.current == null ? '-' : r1(rollup.overall.current) %><span class="text-xl text-tertiary" style="font-weight:400;">/5</span></div>
        <div class="kpi-label">Overall capability</div>
        <% if (rollup.overall.tier) { %><div class="meta" style="font-size:12px;margin-top:4px;color:<%= tierColor(rollup.overall.tier) %>;font-weight:500;"><%= rollup.overall.tier.label %></div><% } %>
      </div>
      <div>
        <div class="kpi-num"><%= rollup.coverage.scored %><span class="text-xl text-tertiary" style="font-weight:400;">/<%= rollup.coverage.total - rollup.coverage.excluded %></span></div>
        <div class="kpi-label">Subcategories assessed</div>
      </div>
      <% if (engagement.scope_mode === 'CURRENT_TARGET') { %>
        <div>
          <div class="kpi-num" style="color:<%= tierColor(rollup.overall.tier_target) %>;"><%= rollup.overall.target == null ? '-' : r1(rollup.overall.target) %><span class="text-xl text-tertiary" style="font-weight:400;">/5</span></div>
          <div class="kpi-label">Target capability</div>
          <% if (rollup.overall.tier_target) { %><div class="meta" style="font-size:12px;margin-top:4px;color:<%= tierColor(rollup.overall.tier_target) %>;font-weight:500;"><%= rollup.overall.tier_target.label %></div><% } %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Function tiles -->
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:14px;">
    <% rollup.functions.forEach(fn => { %>
      <div class="panel">
        <div class="panel-pad">
          <div style="display:flex;align-items:baseline;gap:8px;">
            <span class="mono" style="font-weight: 500;color:var(--accent);"><%= fn.code %></span>
            <span class="text-lg" style="font-weight: 500;"><%= fn.name %></span>
          </div>
          <div style="font-size:24px;font-weight: 500;margin-top:8px;"><%= fn.current == null ? '-' : r1(fn.current) %></div>
          <% if (fn.tier) { %><div style="font-size:11.5px;color:<%= tierColor(fn.tier) %>;font-weight:500;"><%= fn.tier.label %></div><% } %>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Top findings -->
  <div class="panel" style="margin-bottom:14px;">
    <div class="panel-head"><h2>Top findings</h2><span class="meta text-sm"><%= findingSnaps.length %> total</span></div>
    <% if (findingSnaps.length === 0) { %>
      <div class="panel-pad meta text-md">No findings recorded in this version.</div>
    <% } else { %>
      <div class="divide-row">
        <% findingSnaps.slice(0, 10).forEach(f => { %>
          <div style="padding:10px 14px;">
            <div style="display:flex;align-items:center;gap:8px;">
              <span class="tag" style="background:<%= sevColor[f.severity] || 'var(--bg-subtle)' %>;color:#fff;font-size:10px;font-weight: 500;"><%= f.severity %></span>
              <strong class="text-lg"><%= f.title %></strong>
              <% if (f.sub_code) { %><span class="meta mono text-xs" style="margin-left:auto;"><%= f.sub_code %></span><% } %>
            </div>
            <% if (f.description) { %><div class="text-base text-secondary" style="margin-top:4px;line-height:1.5;white-space:pre-wrap;"><%= f.description %></div><% } %>

            <% const ccs = clientComments.filter(c => c.finding_id === f.finding_id); %>
            <% if (ccs.length) { %>
              <div class="text-base" style="margin-top:8px;padding-left:12px;border-left:2px solid var(--border);line-height:1.5;">
                <% ccs.forEach(c => { %>
                  <div style="padding:3px 0;"><strong class="text-sm"><%= c.commenter_name %>:</strong> <%= c.text %> <span class="meta text-eyebrow"><%= c.created_at %></span></div>
                <% }) %>
              </div>
            <% } %>

            <details style="margin-top:6px;">
              <summary class="text-sm" style="cursor:pointer;color:var(--accent);">+ Add comment</summary>
              <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/portal/comments" style="margin-top:6px;">
                <input type="hidden" name="finding_id" value="<%= f.finding_id %>">
                <textarea class="textarea text-base" name="text" rows="2" required placeholder="Question or context to share with the consultant" style="width:100%;"></textarea>
                <button class="btn btn-primary btn-xs" style="margin-top:4px;">Post</button>
              </form>
            </details>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Roadmap + Remediation tracker -->
  <div class="panel" style="margin-bottom:14px;">
    <div class="panel-head"><h2>Roadmap &amp; remediation tracker</h2><span class="meta text-sm">live</span></div>
    <% const phases = [
         { key: '0_3M', label: '0-3 months' },
         { key: '3_6M', label: '3-6 months' },
         { key: '6_12M', label: '6-12 months' },
         { key: '12M_PLUS', label: '12+ months' },
         { key: null, label: 'Unphased' },
       ]; %>
    <% phases.forEach(ph => { %>
      <% const inPhase = recSnaps.filter(r => (r.roadmap_phase || null) === ph.key); %>
      <% if (inPhase.length) { %>
        <div class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);">
          <strong class="text-lg"><%= ph.label %></strong>
          <span class="meta text-sm" style="margin-left:8px;"><%= inPhase.length %> action<%= inPhase.length === 1 ? '' : 's' %></span>
        </div>
        <div class="divide-row">
          <% inPhase.forEach(r => { %>
            <div id="rec-<%= r.recommendation_id %>" style="padding:10px 14px;">
              <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                <% if (r.priority) { %><span class="tag text-xxs" style="background:var(--bg-subtle);">priority: <%= r.priority %></span><% } %>
                <% if (r.estimated_effort) { %><span class="tag text-xxs" style="background:var(--bg-subtle);">effort: <%= r.estimated_effort %></span><% } %>
                <strong class="text-md" style="flex:1;"><%= r.description %></strong>
                <% const remColor = { 'NOT_STARTED':'var(--text-tertiary)', 'IN_PROGRESS':'#1d4ed8', 'DONE':'#15803d', 'BLOCKED':'#b91c1c' }; %>
                <span class="tag" style="background:rgba(0,0,0,0.04);color:<%= remColor[r.rem_status || 'NOT_STARTED'] %>;font-size:11px;"><%= (r.rem_status || 'NOT_STARTED').replace('_',' ') %></span>
              </div>
              <% if (r.finding_title) { %><div class="meta text-xs" style="margin-top:2px;">From finding: <%= r.finding_title %></div><% } %>
              <% if (r.rem_note) { %><div class="text-base text-secondary" style="margin-top:4px;line-height:1.5;white-space:pre-wrap;"><%= r.rem_note %></div><% } %>

              <details style="margin-top:6px;">
                <summary class="text-sm" style="cursor:pointer;color:var(--accent);">Update status</summary>
                <form method="POST" action="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/portal/remediation/<%= r.recommendation_id %>" style="margin-top:6px;display:grid;grid-template-columns:170px 1fr;gap:6px;align-items:end;">
                  <select class="select text-sm" name="status">
                    <% REMEDIATION_STATUSES.forEach(s => { %><option value="<%= s %>" <%= s === (r.rem_status || 'NOT_STARTED') ? 'selected' : '' %>><%= s.replace('_',' ') %></option><% }) %>
                  </select>
                  <input class="input text-sm" name="client_evidence_url" placeholder="Optional URL (ticket, doc, deploy)" value="<%= '' %>">
                  <textarea class="textarea col-full text-sm" name="client_note" rows="2" placeholder="What's been done? What's blocking?"><%= r.rem_note || '' %></textarea>
                  <button class="btn btn-primary btn-xs col-full">Save</button>
                </form>
              </details>
            </div>
          <% }) %>
        </div>
      <% } %>
    <% }) %>
    <% if (recSnaps.length === 0) { %>
      <div class="panel-pad meta text-md">No recommendations in this version.</div>
    <% } %>
  </div>

  <!-- Version history downloads -->
  <% if (allVersions.length > 1) { %>
    <div class="panel" style="margin-bottom:14px;">
      <div class="panel-head"><h2>Version history</h2></div>
      <table class="t">
        <thead><tr><th style="width:120px">Version</th><th>Published</th><th style="width:200px;text-align:right;">Report</th></tr></thead>
        <tbody>
          <% allVersions.forEach(v => { %>
            <tr>
              <td><strong class="mono">v<%= v.version_number %></strong><% if (currentVersion.id === v.id) { %><span class="tag text-success text-xxs" style="background:rgba(21,128,61,0.08);margin-left:6px;">current</span><% } %></td>
              <td class="meta text-sm"><%= v.published_at %></td>
              <td style="text-align:right;">
                <a href="/workspaces/<%= ws.id %>/csf/<%= engagement.id %>/exports/report.docx?vid=<%= v.id %>" class="btn btn-ghost btn-xs">Download &darr;</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

<% } %>

<%- include('partials/footer') %>
