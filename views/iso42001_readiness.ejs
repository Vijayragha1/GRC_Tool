<%- include('partials/header', { title: 'ISO 42001 readiness', user, ws, active: 'iso42001-readiness' }) %>

<%
  const gapLink = it => (it.id && (String(it.id).startsWith('ai-clause') || String(it.id).startsWith('ai-annex'))) ? `/workspaces/${ws.id}/iso42001/gap/${it.id}` : null;
  const statusBar = [['done', 'Implemented', r.metrics.implemented], ['part', 'Partial', r.metrics.partial], ['wip', 'In progress', r.metrics.wip], ['gap', 'Not implemented', r.metrics.notImpl], ['na', 'N/A', r.metrics.na]];
%>

<div class="page-head">
  <div>
    <h1 class="page-title">ISO 42001 certification readiness</h1>
    <div class="page-subtitle">Live assessment against ISO/IEC 42001:2023 Stage 1 (documentation) and Stage 2 (operational) audit requirements.</div>
    <% if (r.daysToTarget !== null) { %><div class="a42-facts"><span><strong><%= r.daysToTarget %></strong> days to target cert &middot; <%= ws.target_cert_date %></span></div><% } %>
  </div>
  <div>
    <a href="/workspaces/<%= ws.id %>/iso42001/readiness/blockers" class="btn btn-primary">Pre-cert blocker check →</a>
  </div>
</div>

<section class="a42-stats" aria-label="Readiness measures">
  <div class="a42-stat<%= r.stage1 < 50 ? ' is-attention' : '' %>"><span>Stage 1 readiness</span><strong><%= r.stage1 %><small>%</small></strong><em>documentation &amp; AIMS framework</em></div>
  <div class="a42-stat<%= r.stage2 < 50 ? ' is-attention' : '' %>"><span>Stage 2 readiness</span><strong><%= r.stage2 %><small>%</small></strong><em>operational effectiveness</em></div>
  <div class="a42-stat"><span>Documented information</span><strong><%= r.records.found %><small> / <%= r.records.total %></small></strong><em>mandatory + expected per ISO 42001</em></div>
  <div class="a42-stat"><span>Average maturity</span><strong><%= r.metrics.avgMaturity %></strong><em>Compliance Sphere 0 to 4 capability scale</em></div>
</section>

<div class="a42-grid a42-grid-even">
  <section class="panel" aria-labelledby="rdGapsTitle">
    <div class="panel-head"><div><h2 id="rdGapsTitle">Detected gaps</h2><p class="a42-caption">What would hold up the audit, most serious first.</p></div><span class="meta"><%= r.flags.length %> total</span></div>
    <% if (r.flags.length === 0) { %>
      <p class="a42-empty">No gaps detected.</p>
    <% } else { %>
      <ul class="a42-list">
        <% r.flags.forEach(f => { %>
          <li>
            <i class="a42-dot t-<%= f.severity === 'high' ? 'gap' : 'wip' %>" aria-hidden="true"></i>
            <div>
              <span class="a42-list-title"><%= f.label %></span>
              <% if (f.items.length) { %>
                <p><% f.items.slice(0, 5).forEach((it, i) => { const href = gapLink(it) || (f.kind === 'open_ncs' ? `/workspaces/${ws.id}/nonconformities/${it.id}` : null); %><%= i ? ' · ' : '' %><% if (href) { %><a href="<%= href %>"><%= it.title %></a><% } else { %><%= it.title %><% } %><% }) %><% if (f.items.length > 5) { %> · and <%= f.items.length - 5 %> more<% } %></p>
              <% } %>
            </div>
            <span class="a42-list-aside"><%= f.severity === 'high' ? 'High' : 'Medium' %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="panel" aria-labelledby="rdDocsTitle">
    <div class="panel-head"><div><h2 id="rdDocsTitle">Documented information</h2><p class="a42-caption">Heuristic - confirm manually.</p></div></div>
    <h3 class="a42-list-group">Mandatory per ISO 42001:2023 <span><%= r.records.mandatory.found %> of <%= r.records.mandatory.total %></span></h3>
    <ul class="a42-list">
      <% r.records.mandatory.checks.forEach(c => { %>
        <li>
          <i class="a42-dot t-<%= c.found ? 'done' : 'gap' %>" aria-hidden="true"></i>
          <div>
            <span class="a42-list-title"><%= c.name %></span>
            <% if (c.basis) { %><p><%= c.basis %></p><% } %>
            <% if (c.declaredOnly) { %><p class="a42-warn">Marked implemented, but the record was not found</p><% } %>
          </div>
          <span class="a42-list-aside">Cl. <%= c.clause %></span>
        </li>
      <% }) %>
    </ul>
    <h3 class="a42-list-group">Expected if the related Annex A control is included <span><%= r.records.expected.found %> of <%= r.records.expected.total %></span></h3>
    <ul class="a42-list">
      <% r.records.expected.checks.forEach(c => { %>
        <li>
          <i class="a42-dot t-<%= c.found ? 'done' : 'open' %>" aria-hidden="true"></i>
          <div>
            <span class="a42-list-title"><%= c.name %></span>
            <% if (c.basis) { %><p><%= c.basis %></p><% } %>
            <% if (c.declaredOnly) { %><p class="a42-warn">Marked implemented, but the record was not found</p><% } %>
          </div>
          <span class="a42-list-aside"><%= c.clause %></span>
        </li>
      <% }) %>
    </ul>
  </section>
</div>

<section class="panel rq-flow" aria-labelledby="rdStatusTitle">
  <div class="panel-head"><div><h2 id="rdStatusTitle">Control implementation status</h2><p class="a42-caption"><%= r.metrics.evidenceCount %> evidence file<%= r.metrics.evidenceCount === 1 ? '' : 's' %> on record.</p></div><a class="a42-list-action" href="/workspaces/<%= ws.id %>/iso42001/gap-assessment">Gap assessment <span aria-hidden="true">→</span></a></div>
  <div class="rq-flow-rows">
    <div class="rq-flow-row">
      <span class="rq-flow-label"><b>Annex A controls</b><span>by recorded status</span></span>
      <div>
        <div class="rq-flow-bar">
          <% statusBar.filter(([, , n]) => n).forEach(([tone, label, n]) => { %><span class="rq-seg t-<%= tone %>" style="--n:<%= n %>" title="<%= label %>: <%= n %>"><span><%= n %></span></span><% }) %>
          <% if (!statusBar.some(([, , n]) => n)) { %><span class="rq-seg t-open" style="--n:1"><span>0</span></span><% } %>
        </div>
        <ul class="rq-flow-keys"><% statusBar.forEach(([tone, label, n]) => { %><li><i class="a42-dot t-<%= tone %>" aria-hidden="true"></i><%= label %><span><%= n %></span></li><% }) %></ul>
      </div>
    </div>
  </div>
</section>

<details class="panel">
  <summary><span>About the readiness method<small>Compliance Sphere ISO 42001 Readiness Method v2026.1</small></span></summary>
  <p class="a42-empty">The readiness bands and 0 to 4 capability scale are proprietary consulting measures. They are not an ISO score and do not replace a certification body's audit decision.</p>
</details>

<%- include('partials/footer') %>
