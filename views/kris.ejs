<%- include('partials/header', { title: 'KRIs', user, ws, active: 'risks' }) %>

<div class="page-head">
  <div><h1 class="page-title">Key risk indicators</h1>
    <div class="page-subtitle">Quantitative metrics with green / amber / red bands. Track monthly to detect risk emerging before it becomes incident.</div></div>
  <button onclick="document.getElementById('newK').classList.toggle('hidden')" class="btn btn-primary">New KRI</button>
</div>

<div id="newK" class="hidden panel" style="margin-bottom:16px">
  <div class="panel-head"><h2>New KRI</h2></div>
  <form method="POST" action="/workspaces/<%= ws.id %>/kris" class="panel-pad" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
    <div style="grid-column:1/-1"><label class="label">Name</label><input class="input" name="name" required placeholder="e.g., Critical-vuln remediation SLA"></div>
    <div style="grid-column:1/-1"><label class="label">Description</label><textarea class="textarea" name="description" rows="2"></textarea></div>
    <div><label class="label">Unit</label><input class="input" name="unit" placeholder="days / %  / count"></div>
    <div><label class="label">Green ≤</label><input class="input num" name="green_max" type="number" step="0.01"></div>
    <div><label class="label">Amber ≤</label><input class="input num" name="amber_max" type="number" step="0.01"></div>
    <div><label class="label">Frequency</label><select class="select" name="measurement_frequency"><option>weekly</option><option selected>monthly</option><option>quarterly</option></select></div>
    <div><label class="label">Owner</label><input class="input" name="owner_name"></div>
    <div><label class="label">Linked risk</label><select class="select" name="risk_id"><option value="">—</option><% risks.forEach(r => { %><option value="<%= r.id %>"><%= r.title %></option><% }) %></select></div>
    <div style="grid-column:1/-1"><label style="font-size:12px;display:flex;gap:6px;align-items:center;"><input type="checkbox" name="red_above_amber" checked> Higher = worse (default). Uncheck if lower = worse.</label></div>
    <div style="grid-column:1/-1"><button class="btn btn-primary">Create</button></div>
  </form>
</div>

<div class="panel" style="overflow:hidden">
  <table class="t">
    <thead><tr><th>KRI</th><th>Linked risk</th><th>Unit</th><th>Latest</th><th>Status</th><th>Trend (90d)</th><th>Frequency</th></tr></thead>
    <tbody>
      <% if (!kris.length) { %><tr><td colspan="7" class="t-empty">No KRIs yet. Add one to begin tracking quantitatively.</td></tr><% } %>
      <% kris.forEach(k => {
           let band = '—', col = '#71717a';
           if (k.latest != null && k.green_max != null) {
             if (k.latest <= k.green_max) { band = 'green'; col = '#16a34a'; }
             else if (k.amber_max != null && k.latest <= k.amber_max) { band = 'amber'; col = '#ca8a04'; }
             else { band = 'red'; col = '#b91c1c'; }
           }
      %>
        <tr style="cursor:pointer" onclick="location='/workspaces/<%= ws.id %>/kris/<%= k.id %>'">
          <td><strong><%= k.name %></strong><% if (k.owner_name) { %><div class="meta"><%= k.owner_name %></div><% } %></td>
          <td class="meta"><%= k.risk_title || '—' %></td>
          <td class="meta"><%= k.unit || '—' %></td>
          <td class="num"><%= k.latest != null ? k.latest : '—' %></td>
          <td><span class="tag" style="background:<%= col %>1a;color:<%= col %>;border-color:<%= col %>40;text-transform:uppercase;font-size:10.5px;"><%= band %></span></td>
          <td class="meta"><%= k.reading_count %> readings</td>
          <td class="meta"><%= k.measurement_frequency %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
