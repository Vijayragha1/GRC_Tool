<%- include('partials/header', { title: 'Time tracking', user, ws, active: 'tasks' }) %>

<a href="/workspaces/<%= ws.id %>/tasks" class="link-muted" style="font-size:12px;">← Tasks</a>

<div class="page-head" style="margin-top:8px">
  <div><h1 class="page-title">Time tracking</h1>
    <div class="page-subtitle">Total time logged on this engagement. Useful when billing the client.</div></div>
</div>

<div class="panel kpi" style="margin-bottom:16px;display:grid;grid-template-columns:repeat(3,1fr);gap:0;text-align:center;">
  <div style="padding:18px;"><div class="kpi-num num"><%= ((totals.m || 0) / 60).toFixed(1) %>h</div><div class="kpi-label">Total time logged</div></div>
  <div style="padding:18px;border-left:1px solid var(--border)"><div class="kpi-num num" style="color:#16a34a;"><%= ((totals.bm || 0) / 60).toFixed(1) %>h</div><div class="kpi-label">Billable hours</div></div>
  <div style="padding:18px;border-left:1px solid var(--border)"><div class="kpi-num num"><%= entries.length %></div><div class="kpi-label">Entries (last 200)</div></div>
</div>

<div class="panel"><table class="t">
  <thead><tr><th>Date</th><th>Who</th><th>Task</th><th class="num">Minutes</th><th>Billable</th><th>Notes</th></tr></thead>
  <tbody>
    <% if (!entries.length) { %><tr><td colspan="6" class="t-empty">No time entries yet. Log time from any task detail page.</td></tr><% } %>
    <% entries.forEach(e => { %>
      <tr>
        <td class="meta num"><%= e.date %></td>
        <td><%= e.user_name %></td>
        <td class="meta"><%= e.task_title || '—' %></td>
        <td class="num"><%= e.minutes %></td>
        <td><span class="tag <%= e.billable ? 'tag-success' : 'tag-neutral' %>" style="font-size:10.5px;"><%= e.billable ? 'billable' : 'non-bill' %></span></td>
        <td class="meta"><%= e.description || '' %></td>
      </tr>
    <% }) %>
  </tbody>
</table></div>

<%- include('partials/footer') %>
