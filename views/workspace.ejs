    </div>
  <% } %>
</div>

<details id="workspace-settings" style="margin-top:24px">
  <summary class="link-muted text-lg">Client settings</summary>
  <div class="panel panel-pad" style="margin-top:8px">
    <form class="grid-2" method="POST" action="/workspaces/<%= ws.id %>/update">
      <%# Optimistic-concurrency snapshot: server rejects with 409 if another
          consultant updated the workspace settings between this page load and
          form submit. Pre-CAS forms (without this field) fall through to the
          old last-writer-wins path so a long-open tab still works. %>
      <input type="hidden" name="updated_at_snapshot" value="<%= ws.updated_at || '' %>">
      <div><label class="label">Client name</label><input class="input" name="client_name" value="<%= ws.client_name %>" required></div>
      <div><label class="label">Industry</label><input class="input" name="industry" value="<%= ws.industry || '' %>"></div>
      <div class="col-full"><label class="label">Scope</label><input class="input" id="scope-input" name="scope" value="<%= ws.scope || '' %>"></div>
      <div><label class="label">Target cert date</label><input class="input" name="target_cert_date" type="date" value="<%= ws.target_cert_date || '' %>"></div>
      <%# Stage is now auto-derived from real signals (intake answers,
          controls assessed, internal audits done, Stage 1/2 audits
          completed) - no longer a manual field. Shown read-only as
          a sanity check that the derivation matches the consultant's
          intuition. %>
      <div><label class="label">Stage <span class="meta">auto-derived</span></label>
        <div style="padding:8px 10px;border:1px solid var(--border);border-radius:6px;background:var(--bg-muted);font-size:13.5px;color:var(--text-secondary);">
          <%= (typeof derivedStage !== 'undefined' && derivedStage) ? derivedStage.label : (ws.stage || 'New').replace(/_/g, ' ') %>
        </div>
      </div>

      <div class="col-full" style="margin-top:6px;padding-top:14px;border-top:1px solid var(--border);">
        <div class="text-xs text-tertiary" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">Branding & sector</div>
        <div class="meta text-sm" style="margin-bottom:10px;">Customise per-client without a code change. Used in the sidebar workspace block, the dashboard chip, and DOCX cover pages (when set).</div>
      </div>
      <div><label class="label">Display name (overrides client_name on cover pages)</label><input class="input" name="brand_display_name" value="<%= ws.brand_display_name || '' %>" placeholder="e.g., Acme Health Tech Inc."></div>
      <div><label class="label">Sector</label>
        <select class="select" name="sector">
          <% const sectors = ['','SaaS','Fintech','Healthcare','Manufacturing','Public sector','MSP','Retail','Education','Other']; sectors.forEach(s => { %>
            <option value="<%= s %>" <%= (ws.sector || '') === s ? 'selected' : '' %>><%= s || '- none -' %></option>
          <% }) %>
        </select>
      </div>
      <div><label class="label">Primary color (#RRGGBB)</label>
        <div style="display:flex;gap:8px;align-items:center;">
          <input class="input" name="brand_primary_color" value="<%= ws.brand_primary_color || '' %>" placeholder="#0ea5e9" pattern="^#[0-9a-fA-F]{6}$" style="flex:1;font-family:monospace;">
          <% if (ws.brand_primary_color) { %>
            <span style="display:inline-block;width:32px;height:32px;border-radius:6px;background:<%= ws.brand_primary_color %>;border:1px solid var(--border);"></span>
          <% } %>
        </div>
      </div>
      <div><label class="label">Logo URL (path or full URL)</label><input class="input" name="brand_logo_path" value="<%= ws.brand_logo_path || '' %>" placeholder="https://…/logo.png"></div>

      <div class="col-full"><button class="btn btn-primary">Save</button></div>
    </form>
    <div style="margin-top:18px;padding-top:14px;border-top:1px solid var(--border);">
      <div class="text-xs" style="font-weight: 500;text-transform:uppercase;letter-spacing:0.05em;color:var(--danger,#b91c1c);margin-bottom:8px;">Danger zone</div>
      <details>
        <summary class="text-lg" style="cursor:pointer;color:var(--danger,#b91c1c);">Delete this client</summary>
        <div style="margin-top:10px;padding:12px;border:1px solid var(--danger,#b91c1c);border-radius:6px;background:rgba(185,28,28,0.04);">
          <div class="meta text-base" style="line-height:1.5;margin-bottom:10px;">
            Permanently removes this client and everything inside it: controls, gap-assessment passes, risks, evidence files (on disk and in DB), audits, MRMs, NCs, incidents, suppliers, documents, registers. Cannot be undone.
          </div>
          <form method="POST" action="/workspaces/<%= ws.id %>/delete" onsubmit="return appConfirmForm(event, 'Final check: delete &quot;<%= ws.client_name %>&quot; and everything under it?');">
            <label class="label text-base">Type <strong><%= ws.client_name %></strong> to confirm</label>
            <input class="input" name="confirm_name" required autocomplete="off" style="max-width:320px;margin-bottom:10px;">
            <div><button class="btn btn-xs" style="background:var(--danger,#b91c1c);color:#fff;border-color:var(--danger,#b91c1c);">Delete client</button></div>
          </form>
        </div>
      </details>
    </div>
  </div>
</details>

<script>
  // Open the Workspace-settings <details> AND focus the scope input when
  // arriving via #workspace-settings. Lands the user on the field they came
  // to edit, not on the summary line above an unopened collapsible.
  (function () {
    const focusScope = () => {
      if (window.location.hash !== '#workspace-settings') return;
      const det = document.getElementById('workspace-settings');
      const inp = document.getElementById('scope-input');
      if (det) det.open = true;
      // Two animation frames so the details has finished rendering its expanded
      // size before we scroll, otherwise the browser scrolls to a wrong offset
      // computed against the collapsed height.
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (inp) {
          inp.scrollIntoView({ behavior: 'smooth', block: 'center' });
          inp.focus({ preventScroll: true });
          inp.select();
        }
      }));
    };
    focusScope();
    window.addEventListener('hashchange', focusScope);
  })();
</script>

