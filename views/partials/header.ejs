<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<%# Cross-document View Transitions - modern browsers (Chrome/Edge/Safari) %>
<%# cross-fade between same-origin navigations so clicking a sidebar item %>
<%# stops feeling like an abrupt scroll-to-top jump. Firefox ignores this %>
<%# and falls back to the default behaviour gracefully. %>
<meta name="view-transition" content="same-origin">
<title><%= typeof title !== 'undefined' ? title : 'Dashboard' %> · Compliance Sphere</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<link rel="stylesheet" href="/fonts/inter.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
<link rel="stylesheet" href="/app.css?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '0' %>">
</head>
<body>
<% if (typeof user !== 'undefined' && user) { %>
<div class="app" id="app">
  <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar(false)"></div>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-section">
      <a class="sidebar-brand" href="/dashboard" aria-label="Compliance Sphere dashboard" style="display:flex;align-items:center;gap:8px;text-decoration:none;color:#1a1a1a;line-height:1.1;">
        <svg width="20" height="20" viewBox="0 0 22 22" aria-hidden="true" style="flex-shrink:0;">
          <circle cx="11" cy="11" r="9.5" fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
          <circle cx="11" cy="11" r="6"   fill="none" stroke="#1a1a1a" stroke-width="1.3"/>
          <circle cx="11" cy="11" r="2.5" fill="#1a1a1a"/>
        </svg>
        <span class="sidebar-brand-name" style="font-size:14.5px;font-weight:500;color:#1a1a1a;letter-spacing:-0.2px;">Compliance Sphere</span>
      </a>
      <%# Tenant switcher: shows the active firm name below the brand.
          Static text when only one firm exists (the common case); a
          dropdown when the user has access to multiple firms. Avoids
          forcing the consultant to navigate to /tenants every time. %>
      <% if (typeof activeFirm !== 'undefined' && activeFirm) { %>
        <% const otherFirms = (typeof allFirms !== 'undefined' ? allFirms : []).filter(f => f.id !== activeFirm.id); %>
        <% if (otherFirms.length === 0) { %>
          <div class="tenant-current" style="margin-top:10px;display:flex;align-items:center;gap:6px;font-size:11px;color:#6b6b66;">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:0.7;flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= activeFirm.name %></span>
          </div>
        <% } else { %>
          <details class="tenant-switcher" style="margin-top:10px;">
            <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:6px;font-size:11px;color:#3a3a3a;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:0.7;flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500;"><%= activeFirm.name %></span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div style="margin-top:6px;background:#ffffff;border:1px solid #ecebe5;border-radius:6px;max-height:260px;overflow-y:auto;">
              <% otherFirms.forEach(f => { %>
                <form method="POST" action="/tenants/<%= f.id %>/switch" style="margin:0;">
                  <% if (typeof csrfToken !== 'undefined') { %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% } %>
                  <button type="submit" style="display:flex;width:100%;align-items:center;gap:8px;padding:8px 12px;background:transparent;border:0;text-align:left;color:#1a1a1a;font-size:12px;cursor:pointer;border-bottom:1px solid #ecebe5;font-family:inherit;">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="opacity:0.5;flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                    <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= f.name %></span>
                    <span style="font-size:10px;color:#8a8a87;flex-shrink:0;"><%= f.workspace_count %> client<%= f.workspace_count === 1 ? '' : 's' %></span>
                  </button>
                </form>
              <% }) %>
              <a href="/tenants" style="display:block;padding:8px 12px;font-size:11px;color:#6b6b66;text-decoration:none;border-top:1px solid #ecebe5;background:rgba(26,26,26,0.04);">Manage firms →</a>
            </div>
          </details>
        <% } %>
      <% } %>
    </div>

    <% if (typeof ws !== 'undefined' && ws) { %>
    <%
      // Per-client brand color powers the left-rail accent on the sidebar
      // client context block. Falls back to the global accent.
      const brandColor = (ws.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(ws.brand_primary_color)) ? ws.brand_primary_color : null;
      const scopedHeaderContributor = user && user.user_type === 'client' && rbac.normalizeRole(ws._userRole || ws.role) === 'contributor';
      // Contributors are deliberately confined to a single engagement context.
      // Do not leak the names or sectors of other firm clients in the switcher.
      const otherWorkspaces = scopedHeaderContributor
        ? []
        : (typeof firmWorkspaces !== 'undefined' ? firmWorkspaces : []).filter(w => w.id !== ws.id);
    %>
    <div class="sidebar-section ws-context" style="<%= brandColor ? 'padding-left:11px;' : '' %>">
      <a class="text-xs" href="/dashboard" style="color:#6b6b66;text-decoration:none;">← All clients</a>
      <%# Client name is now the trigger for the switcher dropdown.
          On click expands a list of every other workspace in this firm so
          a consultant can jump between engagements without bouncing back
          to /dashboard first. Native <details>/<summary> = works with JS off. %>
      <%# Client switcher (label says "client" not "workspace" - workspace
          is the internal table name, never user-facing). The user is the
          firm; what they switch between is the client they're
          working on right now. %>
      <details class="ws-switcher" style="margin-top:10px;">
        <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:6px;color:#1a1a1a;">
          <span class="text-lg" style="font-weight: 500;letter-spacing:-0.005em;line-height:1.3;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= ws.brand_display_name || ws.client_name %></span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="ws-switcher-menu" style="margin-top:8px;background:#ffffff;border:1px solid #ecebe5;border-radius:6px;max-height:280px;overflow-y:auto;">
          <% if (otherWorkspaces.length === 0) { %>
            <div style="padding:10px 12px;font-size:12px;color:#8a8a87;">No other clients yet.</div>
          <% } else { %>
            <% otherWorkspaces.forEach(w => {
                 const dot = (w.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(w.brand_primary_color)) ? w.brand_primary_color : 'rgba(26,26,26,0.2)';
            %>
              <a href="/workspaces/<%= w.id %>" style="display:flex;align-items:center;gap:8px;padding:8px 12px;text-decoration:none;color:#1a1a1a;font-size:13px;border-bottom:1px solid #ecebe5;">
                <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:<%= dot %>;flex-shrink:0;"></span>
                <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= w.brand_display_name || w.client_name %></span>
                <% if (w.sector) { %><span style="font-size:10px;color:#8a8a87;flex-shrink:0;"><%= w.sector %></span><% } %>
              </a>
            <% }) %>
          <% } %>
          <a href="/dashboard" style="display:block;padding:8px 12px;font-size:12px;color:#6b6b66;text-decoration:none;border-top:1px solid #ecebe5;background:rgba(26,26,26,0.04);">All clients →</a>
        </div>
      </details>
      <div class="text-xs" style="margin-top:3px;color:#8a8a87;display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
        <% if (ws.sector) { %><span class="text-xxs" style="background:rgba(26,26,26,0.08);padding:1px 6px;border-radius:999px;font-weight:500;"><%= ws.sector %></span><% } %>
        <span><%= ws.industry || ws.stage.replace(/_/g,' ') %></span>
      </div>
    </div>
    <% } %>

    <nav class="sidebar-nav">
      <% if (typeof ws !== 'undefined' && ws) { %>
        <% const scopedClientContributor = user && user.user_type === 'client' && rbac.normalizeRole(ws._userRole || ws.role) === 'contributor'; %>
        <% if (scopedClientContributor) { %>
        <a href="/workspaces/<%= ws.id %>/client-portal" class="nav-item <%= (typeof active !== 'undefined' && active === 'client-portal') ? 'active' : '' %>" aria-current="page">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8M8 13h5"/></svg>
          <span class="nav-item-text">Client portal</span>
        </a>
        <% } %>
        <% if (!scopedClientContributor) { %>
          <%- include('client_navigation', {
            user, ws, rbac,
            active: typeof active !== 'undefined' ? active : '',
            openReviewCount: typeof openReviewCount !== 'undefined' ? openReviewCount : 0
          }) %>
        <% } %>
      <% } else { %>
        <%# Client switcher: on firm-level pages (Clients, Playbooks,
            Firm library, Glossary, Admin Email), give the consultant a
            one-click jump into any client. Replaces the old
            sticky "Back to <last>" button which always pointed at the
            same client forever - typically a stale demo. %>
        <% const allWs = (typeof firmWorkspaces !== 'undefined' ? firmWorkspaces : []); %>
        <% if (allWs.length > 0) { %>
          <details class="ws-switcher" style="margin:0 14px 12px;">
            <summary style="list-style:none;cursor:pointer;display:flex;align-items:center;gap:8px;padding:9px 11px;background:rgba(26,26,26,0.04);border-radius:6px;color:#1a1a1a;font-size:13px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity:0.7;flex-shrink:0;"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
              <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500;">Jump to a client</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="ws-switcher-menu" style="margin-top:6px;background:#ffffff;border:1px solid #ecebe5;border-radius:6px;max-height:340px;overflow-y:auto;">
              <% allWs.forEach(w => {
                   const dot = (w.brand_primary_color && /^#[0-9a-fA-F]{6}$/.test(w.brand_primary_color)) ? w.brand_primary_color : 'rgba(26,26,26,0.2)';
                   const isLast = (typeof lastWs !== 'undefined' && lastWs && lastWs.id === w.id);
              %>
                <a href="/workspaces/<%= w.id %>" style="display:flex;align-items:center;gap:8px;padding:8px 12px;text-decoration:none;color:#1a1a1a;font-size:13px;border-bottom:1px solid #ecebe5;<%= isLast ? 'background:rgba(26,26,26,0.04);' : '' %>">
                  <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:<%= dot %>;flex-shrink:0;"></span>
                  <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= w.brand_display_name || w.client_name %><% if (isLast) { %> <span style="font-size:10px;color:#8a8a87;font-weight:400;">· last viewed</span><% } %></span>
                  <% if (w.sector) { %><span style="font-size:10px;color:#8a8a87;flex-shrink:0;"><%= w.sector %></span><% } %>
                </a>
              <% }) %>
            </div>
          </details>
        <% } %>
        <%# Dropped the "Firm" group label - the firm is implicit when
            you're logged into it. Clients is the primary destination at
            firm-level; doesn't need a header above it. %>
        <a href="/dashboard" class="nav-item <%= (typeof active === 'undefined' || (active !== 'glossary' && active !== 'portfolio' && active !== 'firm-calendar')) ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
          <span class="nav-item-text">Clients</span>
        </a>
        <% if (user && user.user_type === 'firm' && rbac.rolePermissions(user.firm_role).includes('firm.cross_view')) { %>
          <a href="/delivery-portfolio" class="nav-item <%= (typeof active !== 'undefined' && active === 'delivery-portfolio') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14"/><path d="M8 7h8M8 11h8M8 15h5"/><path d="M2 19h20"/></svg>
            <span class="nav-item-text">Delivery QA</span>
          </a>
          <a href="/portfolio" class="nav-item <%= (typeof active !== 'undefined' && active === 'portfolio') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            <span class="nav-item-text">Portfolio</span>
          </a>
          <a href="/calendar" class="nav-item <%= (typeof active !== 'undefined' && active === 'firm-calendar') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span class="nav-item-text">Calendar</span>
          </a>
        <% } %>
        <div class="nav-group-label">Reference</div>
        <a href="/playbooks" class="nav-item <%= (typeof active !== 'undefined' && active === 'playbooks') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          <span class="nav-item-text">Playbooks</span>
        </a>
        <a href="/firm/library" class="nav-item <%= (typeof active !== 'undefined' && active === 'firm-library') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          <span class="nav-item-text">Library</span>
        </a>
        <a href="/glossary" class="nav-item <%= (typeof active !== 'undefined' && active === 'glossary') ? 'active' : '' %>">
          <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span class="nav-item-text">Glossary</span>
        </a>
        <% if (user && rbac.isManager(user.firm_role)) { %>
          <div class="nav-group-label">Admin</div>
          <a href="/admin/users" class="nav-item <%= (typeof active !== 'undefined' && active === 'admin-users') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span class="nav-item-text">Users &amp; access</span>
          </a>
          <a href="/admin/email" class="nav-item <%= (typeof active !== 'undefined' && active === 'admin-email') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span class="nav-item-text">Email</span>
          </a>
          <a href="/admin/activity" class="nav-item <%= (typeof active !== 'undefined' && active === 'admin-activity') ? 'active' : '' %>">
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <span class="nav-item-text">Activity</span>
          </a>
        <% } %>
      <% } %>
    </nav>

    <div class="sidebar-foot">
      <div class="avatar text-xs" title="<%= user.name %>" style="width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#71717a,#52525b);display:flex;align-items:center;justify-content:center;color:#fff;font-weight: 500;flex-shrink:0;"><%= user.name.charAt(0).toUpperCase() %></div>
      <div style="min-width:0;flex:1;">
        <div class="text-lg" style="font-weight:500;line-height:1.2;color:#1a1a1a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= user.name %></div>
        <div class="text-eyebrow" style="color:#8a8a87;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= user.email %></div>
      </div>
      <button class="sidebar-foot-action" onclick="toggleTheme()" title="Toggle theme" style="background:transparent;border:0;color:#6b6b66;cursor:pointer;padding:4px;display:flex;align-items:center;border-radius:4px;transition:all 0.12s;" onmouseover="this.style.color='#1a1a1a';this.style.background='rgba(26,26,26,0.06)'" onmouseout="this.style.color='#6b6b66';this.style.background='transparent'">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <form class="sidebar-foot-action" method="POST" action="/logout" style="margin:0;display:flex;">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button type="submit" title="Sign out" aria-label="Sign out" style="background:transparent;border:0;color:#6b6b66;cursor:pointer;padding:4px;display:flex;align-items:center;border-radius:4px;transition:all 0.12s;" onmouseover="this.style.color='#1a1a1a';this.style.background='rgba(26,26,26,0.06)'" onmouseout="this.style.color='#6b6b66';this.style.background='transparent'">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
      </form>
    </div>
  </aside>

  <main class="main">
    <div class="main-inner">
      <div class="topbar">
        <button class="icon-btn menu-toggle" onclick="toggleSidebar(true)" title="Menu" aria-label="Open menu">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <button class="icon-btn sidebar-collapse-toggle" id="sidebarCollapseButton" onclick="toggleSidebarCollapse()" title="Collapse sidebar" aria-label="Collapse sidebar" aria-pressed="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="11 17 6 12 11 7"/><polyline points="18 17 13 12 18 7"/></svg>
        </button>
        <button class="palette-trigger" onclick="openPalette()">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <span>Search or jump to…</span>
          <span class="kbd" id="kbdHint">⌘K</span>
        </button>
        <% // Tenant switcher - shows the active tenant (firm) and lets you switch.
           // Hidden if there's only one tenant and no point in cluttering the header. %>
        <% // Tenant switcher only matters when there is more than one firm. For
           // a solo consultant with a single firm, the client dashboard already
           // shows everything that matters - surfacing tenants here just invites
           // confusion between "tenant" (firm) and "workspace" (client). %>
        <% if (typeof allFirms !== 'undefined' && allFirms && allFirms.length > 1) { %>
          <div style="position:relative;" id="tenantSwitcher">
            <button type="button" class="palette-trigger text-base" onclick="document.getElementById('tenantMenu').style.display = (document.getElementById('tenantMenu').style.display === 'block' ? 'none' : 'block')" style="gap:6px;padding:5px 10px;" title="Switch tenant">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <span style="font-weight:500;"><%= activeFirm ? activeFirm.name : 'No tenant' %></span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div id="tenantMenu" style="display:none;position:absolute;top:calc(100% + 4px);left:0;background:var(--bg);border:1px solid var(--border);border-radius:6px;box-shadow:var(--shadow-lg);min-width:240px;z-index:50;overflow:hidden;">
              <div class="text-xxs text-secondary" style="padding:6px 10px;text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid var(--border);background:var(--bg-subtle);">Firms (<%= allFirms.length %>)</div>
              <% allFirms.forEach(f => {
                   const isActive = activeFirm && activeFirm.id === f.id;
              %>
                <% if (isActive) { %>
                  <div class="text-lg" style="padding:8px 12px;display:flex;justify-content:space-between;align-items:center;background:rgba(8,145,178,0.06);">
                    <span style="font-weight:500;"><%= f.name %></span>
                    <span class="meta text-eyebrow">active</span>
                  </div>
                <% } else { %>
                  <form method="POST" action="/tenants/<%= f.id %>/switch" style="margin:0;">
                    <button class="text-lg" type="submit" style="width:100%;text-align:left;background:none;border:none;padding:8px 12px;cursor:pointer;" onmouseover="this.style.background='var(--bg-subtle)'" onmouseout="this.style.background='none'"><%= f.name %></button>
                  </form>
                <% } %>
              <% }) %>
              <a class="text-base" href="/tenants" style="display:block;padding:8px 12px;border-top:1px solid var(--border);text-decoration:none;color:var(--accent);background:var(--bg-subtle);">Manage firms →</a>
            </div>
          </div>
          <script>
            // Close tenant menu when clicking outside.
            (function(){
              document.addEventListener('click', function(e){
                const sw = document.getElementById('tenantSwitcher');
                const m = document.getElementById('tenantMenu');
                if (sw && m && !sw.contains(e.target)) m.style.display = 'none';
              });
            })();
          </script>
        <% } %>
        <div class="topbar-spacer"></div>
        <% if (typeof entitySelectorWs !== 'undefined' && entitySelectorWs) { %>
          <a href="/workspaces/<%= entitySelectorWs.id %>/inbox" class="icon-btn" title="Inbox" style="position:relative;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
              <span style="position:absolute;top:-5px;right:-5px;background:#dc2626;color:white;font-size:9.5px;font-weight: 500;border-radius:9px;min-width:16px;height:16px;display:flex;align-items:center;justify-content:center;padding:0 3px;border:2px solid var(--bg-deep, var(--bg));"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
            <% } %>
          </a>
        <% } %>
        <button class="icon-btn" onclick="openHelp()" title="Keyboard shortcuts (?)" aria-label="Help">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </button>
      </div>
<% } else { %>
<div class="app" style="background:var(--bg-deep)">
  <main class="main">
    <div class="main-inner" style="max-width:420px;">
<% } %>
