<%- include('partials/header', { title: 'Security objectives', user, ws, active: 'objectives' }) %>

<div class="page-head">
  <div>
    <h1 class="page-title">Information security objectives</h1>
    <div class="page-subtitle">Clause 6.2 - measurable, time-bound goals consistent with the policy. Each must be monitored, communicated, updated as appropriate, and have a documented plan (target, measurement, owner, due date).</div>
  </div>
</div>

<details class="panel" style="margin-bottom:14px;" <%= rows.length === 0 ? 'open' : '' %>>
  <summary class="panel-pad" style="cursor:pointer;font-size:13px;font-weight:500;">+ Add objective</summary>
  <form method="POST" action="/workspaces/<%= ws.id %>/objectives" class="panel-pad" style="border-top:1px solid var(--border);background:var(--bg-subtle);display:grid;grid-template-columns:1fr 1fr;gap:10px;">
    <div class="col-full"><label class="label">Title <span class="meta">required - concrete, measurable</span></label><input class="input" name="title" required placeholder="e.g., Reduce mean time to patch critical vulnerabilities from 14 to 7 days"></div>
    <div class="col-full"><label class="label">Description</label><textarea class="textarea" name="description" rows="2" placeholder="Why this objective exists; how it ties to policy / risk / customer commitment."></textarea></div>
    <div><label class="label">Measurement <span class="meta">how progress is gauged</span></label><input class="input" name="measurement" placeholder="e.g., Monthly patching report, % within SLA"></div>
    <div><label class="label">Owner</label><input class="input" name="owner" placeholder="e.g., VP Engineering"></div>
    <div><label class="label">Target value</label><input class="input" name="target_value" placeholder="e.g., ≥ 95% within 7 days"></div>
    <div><label class="label">Current value</label><input class="input" name="current_value" placeholder="e.g., 78%"></div>
    <div><label class="label">Due date</label><input type="date" name="due_date" class="input"></div>
    <div><label class="label">Status</label>
      <select name="status" class="select">
        <option value="on_track">On track</option>
        <option value="at_risk">At risk</option>
        <option value="off_track">Off track</option>
        <option value="achieved">Achieved</option>
        <option value="paused">Paused</option>
      </select>
    </div>
    <div class="col-full"><button class="btn btn-primary">Add objective</button></div>
  </form>
</details>

<div class="panel" style="overflow:hidden;">
  <% if (rows.length === 0) { %>
    <div class="empty-state">
      <div class="empty-title">No objectives set yet</div>
      <div class="empty-sub">Required by clause 6.2. Aim for 3–7 objectives that the management review can meaningfully evaluate.</div>
    </div>
  <% } else { %>
    <table class="t">
      <thead><tr>
        <th>Objective</th>
        <th style="width:160px;">Measurement</th>
        <th style="width:110px;">Target</th>
        <th style="width:110px;">Current</th>
        <th style="width:120px;">Owner</th>
        <th style="width:110px;">Due</th>
        <th style="width:110px;">Status</th>
        <th style="width:80px;"></th>
      </tr></thead>
      <tbody>
        <% const statusColor = { on_track:'#15803d', at_risk:'#a16207', off_track:'#b91c1c', achieved:'#16a34a', paused:'#71717a' }; %>
        <% rows.forEach(r => {
             const today = new Date().toISOString().slice(0,10);
             const overdue = r.due_date && r.due_date < today && r.status !== 'achieved';
        %>
          <tr>
            <td>
              <strong class="text-lg"><%= r.title %></strong>
              <% if (r.description) { %><div class="meta" style="font-size:11.5px;margin-top:2px;line-height:1.4;"><%= r.description %></div><% } %>
            </td>
            <td class="text-base"><%= r.measurement || '-' %></td>
            <td class="num" style="font-size:12px;font-weight:500;"><%= r.target_value || '-' %></td>
            <td class="num text-base"><%= r.current_value || '-' %></td>
            <td class="text-base"><%= r.owner || '-' %></td>
            <td style="font-size:11.5px;<%= overdue ? 'color:#b91c1c;font-weight:600;' : '' %>"><%= r.due_date || '-' %><% if (overdue) { %> · overdue<% } %></td>
            <td><span class="tag" style="font-size:10.5px;background:<%= statusColor[r.status] || '#71717a' %>;color:white;border:0;"><%= (r.status || 'on_track').replace('_',' ') %></span></td>
            <td>
              <details>
                <summary class="btn btn-ghost btn-xs" style="font-size:11px;list-style:none;cursor:pointer;">Edit</summary>
                <form method="POST" action="/workspaces/<%= ws.id %>/objectives/<%= r.id %>" style="position:absolute;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:10px;z-index:30;box-shadow:var(--shadow-md);width:420px;display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:4px;right:18px;">
                  <input name="title" value="<%= r.title %>" class="input" style="font-size:12px;grid-column:1/-1;">
                  <textarea name="description" rows="2" class="textarea" style="font-size:12px;grid-column:1/-1;"><%= r.description || '' %></textarea>
                  <input name="measurement" value="<%= r.measurement || '' %>" placeholder="Measurement" class="input" style="font-size:12px;grid-column:1/-1;">
                  <input name="target_value" value="<%= r.target_value || '' %>" placeholder="Target" class="input text-base">
                  <input name="current_value" value="<%= r.current_value || '' %>" placeholder="Current" class="input text-base">
                  <input name="owner" value="<%= r.owner || '' %>" placeholder="Owner" class="input text-base">
                  <input type="date" name="due_date" value="<%= r.due_date || '' %>" class="input text-base">
                  <select name="status" class="select" style="font-size:12px;grid-column:1/-1;">
                    <% ['on_track','at_risk','off_track','achieved','paused'].forEach(s => { %><option value="<%= s %>" <%= r.status === s ? 'selected' : '' %>><%= s.replace('_',' ') %></option><% }) %>
                  </select>
                  <button class="btn btn-primary btn-xs col-full">Save</button>
                </form>
              </details>
              <form method="POST" action="/workspaces/<%= ws.id %>/objectives/<%= r.id %>/delete" style="display:inline;" onsubmit="return appConfirmForm(event, 'Delete this objective?')">
                <button class="btn btn-ghost btn-xs" style="font-size:11px;color:#b91c1c;">×</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/footer') %>
